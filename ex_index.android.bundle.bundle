.",error_dirty_waterbox_hoare_title:"V\xe9rifier le r\xe9servoir d\u2019eau sale",error_clear_waterbox_hoare_desc:"V\xe9rifiez le placement du r\xe9servoir ou rechargez-le si n\xe9cessaire.",error_clear_waterbox_hoare_title:"V\xe9rifiez le r\xe9servoir d\u2019eau propre",localization_strings_abort_current_task_and_start_remote:"L'activation de l'option \xab\xa0T\xe9l\xe9commande\xa0\xbb suspendra le nettoyage en cours",localization_strings_abort_current_task_and_start_goto:"Le d\xe9marrage de \xab\xa0Localiser et envoyer\xa0\xbb suspendra le nettoyage en cours.",robot_start_type_huawei:"HUAWEI",robot_start_type_hisense:"Hisense",robot_start_type_green_rice:"Aqara",robot_start_type_alipay:"Alipay",robot_start_type_wechat:"WeChat",robot_start_type_siri:"Siri",robot_start_type_jd:"Dingdong",robot_start_type_baidu:"Duer",robot_start_type_tmall:"TmallGenie",robot_start_type_little_love:"Xiaoai",robot_start_type_homekit:"HomeKit",robot_start_type_yandex:"Yandex",robot_start_type_ifttt:"IFTTT",robot_start_type_google:"Google",robot_start_type_alexa:"Alexa",video_error115_resolve:"Op\xe9ration trop fr\xe9quente. Veuillez r\xe9essayer plus tard.",video_error114_resolve:"Erreur de connexion du t\xe9l\xe9phone ou du robot. V\xe9rifiez la connexion r\xe9seau ou changez de r\xe9seau et r\xe9essayez.",video_error108_resolve:"Erreur de connexion r\xe9seau. V\xe9rifiez votre r\xe9seau et r\xe9essayez.",video_error107_resolve:"Ressource occup\xe9e. Veuillez r\xe9essayer plus tard.",video_error105_resolve:"Veuillez r\xe9initialiser le robot et r\xe9essayer.",video_error104_resolve:"V\xe9rifiez si la vid\xe9o est affich\xe9e sur un autre t\xe9l\xe9phone. Sinon, veuillez patienter une minute et r\xe9essayer.",video_error103_resolve:"Veuillez d\xe9sactiver puis r\xe9activer la fonction d\u2019affichage \xe0 distance ou red\xe9marrer l\u2019appareil et r\xe9essayer.",video_error102_resolve:"Erreur de cam\xe9ra. Veuillez red\xe9marrer le robot et r\xe9essayer.",video_error101_resolve:"Veuillez \xe9loigner l'appareil de la station de rechargement pour visionner la vid\xe9o.",video_error100_resolve:"\xc9chec de communication r\xe9seau. V\xe9rifiez le r\xe9seau du robot et r\xe9essayez.",dust_collection_info:"Le robot sera automatiquement vid\xe9 apr\xe8s un nettoyage. ",map_edit_carpet_ignore_confirm_cancel:"Apr\xe8s la suppression, la reconnaissance des moquettes/tapis sera r\xe9tablie lors du prochain nettoyage.",map_edit_carpet_ignore_confirm_ignore:"La reconnaissance des moquettes/tapis de cette zone sera d\xe9sactiv\xe9e apr\xe8s la suppression. ",map_edit_carpet_ignore_title:"Modifier le tapis",carpet_clean_mode_setting_ignore_carpet:"Une erreur de reconnaissance\xa0? Modifier.",manual_save_handler:"Si la carte n\u2019est pas enregistr\xe9e automatiquement, elle peut \xe9galement \xeatre enregistr\xe9e dans la section Mes cartes une fois le nettoyage termin\xe9",robot_clean_status_only_mop:"Laver",robot_clean_status_only_clean:"Aspirer",tanos_s_mop_mode_info1:"Le robot se d\xe9placera selon un parcours en forme de Z plus \xe9troit, couvrant deux fois chaque zone du sol. La puissance d\u2019aspiration sera \xe9galement r\xe9duite. Le lavage du sol \xe0 haute intensit\xe9 est recommand\xe9 uniquement pour les sols r\xe9cemment aspir\xe9s.",tanos_s_mop_mode_title:"Lavage du sol \xe0 haute intensit\xe9",multi_floor_edit:"Modifier",ask_whether_back_to_charge:"Appareil stopp\xe9. Souhaitez-vous qu\u2019il revienne \xe0 sa station\xa0?",map_edit_virtual_wall_and_forbidden_zone_info3:"Zones interdites\xa0: emp\xeachez le robot de p\xe9n\xe9trer dans une certaine zone lors du nettoyage.",home_dialog_begin_new_back_washing_duster:"Aller laver la serpilli\xe8re mettra en pause la t\xe2che en cours",robot_cmd_stop_washing_duster:"Arr\xeater le lavage",robot_cmd_start_washing_duster:"Laver la serpilli\xe8re",robot_status_back_dock_washing_duster:"Aller laver la serpilli\xe8re",robot_status_washing_duster:"Lavage de la serpilli\xe8re",map_edit_bottom_menu_order_info1:"D\xe9finissez le nettoyage de pi\xe8ces dans votre ordre de pr\xe9f\xe9rence.",map_edit_bottom_menu_order_title:"D\xe9finir la s\xe9quence de nettoyage",map_edit_virtual_wall_and_forbidden_zone_info2:"Zones sans serpilli\xe8re\xa0: emp\xeachent le robot de p\xe9n\xe9trer dans une certaine zone lorsque le support de serpilli\xe8re est install\xe9.",map_edit_virtual_wall_and_forbidden_zone_info1:"Zones interdites/mur invisibles\xa0: emp\xeachent le robot de p\xe9n\xe9trer dans une certaine zone lors du nettoyage.",map_edit_virtual_wall_and_forbidden_zone_title:"Gestion de la zone de nettoyage",map_edit_zone_zone_info:"Combinez, divisez et d\xe9nommez chaque pi\xe8ce de votre domicile.",map_edit_zone_title:"Modification des pi\xe8ces",room_name_already_in_use:"Nom d\xe9j\xe0 utilis\xe9. Cr\xe9ez un nouveau ou choisissez-en un autre.",tanos_custom_mode_title:"Nettoyage personnalis\xe9 des pi\xe8ces",tanos_s_mop_mode_strong:"Intense",tanos_s_mop_mode_middle:"Standard",tanos_s_mop_mode_weak:"Faible",room_count_reach_limit:"Limite de noms de pi\xe8ce atteinte.\xa0Impossible d\u2019ajouter d\u2019autres noms.",button_go_setting:"Modifier",tanos_custom_mode_des_info:"Apr\xe8s la personnalisation de votre nettoyage, chaque pi\xe8ce sera nettoy\xe9e selon vos param\xe8tres personnalis\xe9s.",tanos_s_mop_mode:"Parcours de nettoyage",tanos_s_mop_mode_general_frag:"Standard",tanos_s_mop_mode_fine_frag:"Approfondi",localization_strings_Common_custom_mode:"Perso",introduction_to_image_uploading8:"Veuillez v\xe9rifier que la photo ne contient pas vos informations personnelles",collecting_dusk_error35_desc:"Impossible de vider le bac \xe0 poussi\xe8re",collecting_dusk_error35_title:"Erreur de tension de la station de vidage automatique",collecting_dusk_error34_desc:"Bac \xe0 poussi\xe8re, filtre ou conduit d'air de la station d'accueil bloqu\xe9, veuillez v\xe9rifier et nettoyer.",collecting_dusk_error34_title:"Station de vidage automatique bloqu\xe9e",collecting_dusk_error33_desc:"Bac \xe0 poussi\xe8re ou filtre de la station d'accueil d\xe9plac\xe9.",collecting_dusk_error33_title:"Erreur du ventilateur de la station de vidage automatique",collecting_dusk_error32_desc:"Aucun bac \xe0 poussi\xe8re ou filtre install\xe9 dans la station",collecting_dusk_error32_title:"Aucun bac \xe0 poussi\xe8re ou filtre install\xe9",robot_status_collecting_dust:"Vidage",mainpage_stop_collect_dust:"Terminer le vidage",monitor_obstacle_tip_right:"Le robot ne peut pas se d\xe9placer vers la droite. Veuillez changer de direction.",monitor_obstacle_tip_left:"Le robot ne peut pas se d\xe9placer vers la gauche. Veuillez changer de direction.",monitor_obstacle_tip_front:"Le robot ne peut pas avancer. Veuillez changer de direction.",image_processing_failure:"\xc9chec du traitement",introduction_to_image_uploading7:"\xc9chec du t\xe9l\xe9chargement",introduction_to_image_uploading6:"T\xe9l\xe9chargement de la photo en cours\u2026",introduction_to_image_uploading5:"T\xe9l\xe9charger",introduction_to_image_uploading4:"Je confirme que la photo ne contient pas d'informations personnelles",introduction_to_image_uploading3:"3. Si vous avez des questions concernant la protection de votre vie priv\xe9e, veuillez vous r\xe9f\xe9rer \xe0 notre politique de confidentialit\xe9 et nous contacter \xe0 l'aide des coordonn\xe9es qui s'y trouvent.",introduction_to_image_uploading2:"2. En appuyant sur T\xe9l\xe9charger, la photo soumise et le type d'obstacle s\xe9lectionn\xe9 seront t\xe9l\xe9charg\xe9s sur le cloud de mani\xe8re anonyme. Avant le t\xe9l\xe9chargement de la photo, un algorithme de d\xe9sensibilisation sera utilis\xe9 pour traiter les informations sensibles que la photo est susceptible de contenir (telles que les informations faciales, etc.). La photo trait\xe9e sera affich\xe9e ci-dessus pour vous permettre de la consulter et de la confirmer.",introduction_to_image_uploading1:"1. Les donn\xe9es que vous choisissez de t\xe9l\xe9charger sont uniquement utilis\xe9es pour entra\xeener le mod\xe8le de reconnaissance, dans le but d'am\xe9liorer le taux de reconnaissance de l'appareil et de vous fournir de meilleurs services.",image_processing_result:"R\xe9sultats du traitement d'image",image_processing:"Traitement de l'image\u2026",obstacle_photo_page_feedback:"R\xe9troaction",obstacle_photo_page_ignore:"Ignorer",obstacle_photo_page_identify_mistakes:"Erreur de reconnaissance\xa0?",actual_type_of_obstacle:"Type d'obstacle existant",send_voice_again:"Envoyer \xe0 nouveau",monitor_privacy_dialog_title:"Politique de confidentialit\xe9 de l\u2019affichage \xe0 distance",alert_button_disagree:"Je ne suis pas d'accord",map_object_desc_sock:"En raison des limitations de hauteur du capteur LDS, le robot risque de ne pas \xeatre en mesure de d\xe9tecter des objets situ\xe9s pr\xe8s du sol dans votre maison, tels que les chaussettes. Ces objets peuvent s\u2019emm\xealer dans la brosse principale et interrompre le nettoyage. La reconnaissance par l\u2019IA aide le robot \xe0 \xe9viter ces objets, garantissant ainsi la r\xe9ussite de la t\xe2che de nettoyage.",map_object_name_sock:"Chaussettes",gesture_password_title:"Tracer votre sch\xe9ma",map_object_cancel_privacy_loading:"traitement des donn\xe9es\u2026",monitor_bumper_tip_right:"Zone interdite ou mur invisible d\xe9tect\xe9 \xe0 droite du robot",monitor_bumper_tip_left:"Zone interdite ou mur invisible d\xe9tect\xe9 \xe0 gauche du robot",monitor_bumper_tip_front:"Zone interdite ou mur invisible d\xe9tect\xe9 devant le robot",use_celluar_for_monitor_tip:"Vous visionnez la vid\xe9o \xe0 l\u2019aide de donn\xe9es cellulaires.",open_real_monitor_firstly_tip:"Activer d\u2019abord l\u2019affichage \xe0 distance",connecting_video_security_channel:"\xc9tablissement d\u2019un canal de transmission vid\xe9o s\xe9curis\xe9\u2026",map_object_cancel_privacy_stop:"Terminer",map_object_cancel_privacy_timeout:"D\xe9lai de r\xe9vocation expir\xe9. R\xe9essayez.",map_object_cancel_privacy_success:"R\xe9vocation r\xe9ussie",map_object_cancel_privacy_stop_robot_alert:"La r\xe9vocation de la politique de confidentialit\xe9 mettra fin \xe0 la t\xe2che en cours.",map_object_desc_general_structure_light:"Gr\xe2ce \xe0 la lumi\xe8re structur\xe9e prise en charge par toute une s\xe9rie d\u2019autres capteurs, le robot est capable d\u2019\xe9viter un large \xe9ventail d\u2019obstacles.",map_object_desc_general:"Gr\xe2ce \xe0 la vision st\xe9r\xe9oscopique prise en charge par toute une s\xe9rie d\u2019autres capteurs, le robot est capable d\u2019identifier et d\u2019\xe9viter un large \xe9ventail d\u2019obstacles.",map_object_privacy_alert_link:"Politique de confidentialit\xe9 des photos d\u2019obstacles",map_object_privacy_alert:"Apr\xe8s l\u2019activation, les images sont stock\xe9es dans la m\xe9moire du robot pour leur affichage. Pour plus de d\xe9tails, reportez-vous \xe0",map_object_privacy_reset_dialog_content:"Apr\xe8s la r\xe9vocation, vous ne pourrez plus afficher les photos d\u2019obstacles et vous devrez autoriser \xe0 nouveau la fonction avant de l\u2019utiliser.",map_object_privacy_title:"Politique de confidentialit\xe9 des photos d\u2019obstacles",map_object_enable_intro:"Visualisez les photos des obstacles identifi\xe9s sur la page de la carte.\n*\xa0Une image sera stock\xe9e \xe0 bord pour chaque obstacle reconnu. Il est possible que certaines images d\u2019obstacles ne soient pas stock\xe9es.",map_object_bubble_tip_avoid:"\xc9vit\xe9",realtime_video_info:"Pendant l\u2019affichage \xe0 distance",realtime_video_sub_title_3_1:"Le voyant clignotera sans alerte vocale.",realtime_video_title_3:"Intense",realtime_video_title_2:"L\xe9ger",realtime_video_title_1:"Flash",realtime_video_title:"Niveau d\u2019alerte",confirm_start:"nettoyer et cartographier",map_object_desc_henggan:"Mobilier muni d\u2019une barre transversale, p. ex. chaise cantilever, \xe9vit\xe9 pour emp\xeacher tout risque de blocage.",map_object_desc_poqi:"Ramasse-poussi\xe8re ou objets similaires \