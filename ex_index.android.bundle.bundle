rmukaan mop untuk menyental, berkesan dalam penyingkiran kotoran dari permukaan mop. Semasa proses mengemop, objek asing seperti rambut terbelit mungkin terkumpul, menjejaskan kesan mengemop. Anda disyorkan untuk menanggalkan dan membersihkannya setiap dua bulan.",home_page_supplies_cleaning_brush2:"Berus penyelenggaraan diganti. OK?",home_page_supplies_cleaning_brush1:"berus penyelenggaraan",home_page_supplies_cleaning_brush:"Berus penyelenggaraan perlu diganti.",inner_error_desc_149:"Ralat kedudukan berus penyelenggaraan - kanan",inner_error_desc_148:"Ralat kedudukan berus penyelenggaraan - tengah",inner_error_desc_147:"Ralat kedudukan berus penyelenggaraan - kiri",inner_error_desc_145:"Ralat pam air kotor",inner_error_desc_143:"Suhu motor roda kanan terlalu tinggi",inner_error_desc_141:"Suhu motor roda kiri terlalu tinggi",mode_setting_panel_custom_water_box_5:"Lembut",mode_setting_panel_custom_water_box_4:"Sederhana",mode_setting_panel_custom_water_box_3:"Moderat",mode_setting_panel_custom_water_box_2:"Tinggi",mode_setting_panel_custom_water_box_1:"Ekstrem",robot_is_warm_up_tip:"Memanaskan robot",start_washing_duster_noback_dock:"Basuh mop",custom_mode_panel_mop_gear_title:"Mop",custom_mop_mode_system_wetter_mop:"Mendalam",mop_mode_setting_page_wash_count:"Pencucian Mop",custom_mode_panel_tab_general:"Umum",custom_mode_panel_more_mode_title:"Lebih Banyak Mod",error_main_frame_exception_detail:"Periksa jika butang kedudukan tersekat, kemudian alihkan robot jauh dari dok dan mulakan semula.",error_main_frame_exception_desc:"Periksa jika butang kedudukan tersekat, kemudian alihkan robot dan mulakan semula.",error_main_frame_exception_title:"Ralat butang kedudukan",error_clean_brush_exception_detail:"Pastikan penapis air dipasang dengan betul dan berus pembersih tidak tersangkut, dan pasang semula mop dan pastikan ia lurus.",mop_cleaning_time:"Masa Pencucian",robot_start_type_clova:"Clova",next_step:"Seterusnya",cleanout_the_error:"Ralat Pencucian",map_edit_carpet_o