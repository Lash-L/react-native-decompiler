62f\u0648\u0642 \u0627\u0644\u0642\u0645\u0627\u0645\u0629 \u0623\u0648 \u0627\u0644\u0641\u0644\u062a\u0631",robot_status_collecting_dust:"\u062a\u0641\u0631\u064a\u063a",mainpage_stop_collect_dust:"\u0625\u0646\u0647\u0627\u0621 \u062a\u0641\u0631\u064a\u063a \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0642\u0645\u0627\u0645\u0629",monitor_obstacle_tip_right:"\u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0627\u0644\u062a\u062d\u0631\u0643 \u0625\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646. \u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0627\u062a\u062c\u0627\u0647.",monitor_obstacle_tip_left:"\u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0627\u0644\u062a\u062d\u0631\u0643 \u0625\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631. \u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0627\u062a\u062c\u0627\u0647.",monitor_obstacle_tip_front:"\u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0627\u0644\u062a\u062d\u0631\u0643 \u0625\u0644\u0649 \u0627\u0644\u0623\u0645\u0627\u0645. \u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0627\u062a\u062c\u0627\u0647.",image_processing_failure:"\u0641\u0634\u0644 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629",introduction_to_image_uploading7:"\u0641\u0634\u0644 \u0627\u0644\u062a\u062d\u0645\u064a\u0644",introduction_to_image_uploading6:"\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0648\u0631\u0629...",introduction_to_image_uploading5:"\u062a\u062d\u0645\u064a\u0644",introduction_to_image_uploading4:"\u0623\u0624\u0643\u062f \u0623\u0646 \u0627\u0644\u0635\u0648\u0631\u0629 \u0644\u0627 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u064a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",introduction_to_image_uploading3:"3. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0644\u062f\u064a\u0643 \u0623\u064a \u0623\u0633\u0626\u0644\u0629 \u0628\u062e\u0635\u0648\u0635 \u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0646\u0627 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0646\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0648\u0627\u0631\u062f\u0629 \u0641\u064a\u0647\u0627.",introduction_to_image_uploading2:"2. \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0642\u0631 \u0641\u0648\u0642 \"\u062a\u062d\u0645\u064a\u0644\"\u060c \u0633\u064a\u062a\u0645 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0631\u0633\u0644\u0629 \u0648\u0646\u0648\u0639 \u0627\u0644\u0639\u0627\u0626\u0642 \u0627\u0644\u0645\u062d\u062f\u062f \u0628\u0634\u0643\u0644 \u0639\u0634\u0648\u0627\u0626\u064a\u0627\u064b \u0625\u0644\u0649 \u0627\u0644\u0633\u062d\u0627\u0628\u0629. \u0642\u0628\u0644 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0635\u0648\u0631\u0629\u060c \u0633\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062e\u0648\u0627\u0631\u0632\u0645\u064a\u0629 \u0644\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u062d\u0633\u0627\u0633\u064a\u0629 \u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0633\u0629 \u0627\u0644\u062a\u064a \u0642\u062f \u062a\u0643\u0648\u0646 \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0627\u0644\u0635\u0648\u0631\u0629 (\u0645\u062b\u0644 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0648\u062c\u0647\u060c \u0648\u0645\u0627 \u0634\u0627\u0628\u0647). \u0633\u064a\u062a\u0645 \u0639\u0631\u0636 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u0645\u062a \u0645\u0639\u0627\u0644\u062c\u062a\u0647\u0627 \u0623\u0639\u0644\u0627\u0647 \u0644\u062a\u062a\u0645\u0643\u0646 \u0645\u0646 \u0639\u0631\u0636\u0647\u0627 \u0648\u062a\u0623\u0643\u064a\u062f\u0647\u0627.",introduction_to_image_uploading1:"1. \u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062e\u062a\u0627\u0631 \u062a\u062d\u0645\u064a\u0644\u0647\u0627 \u0641\u0642\u0637 \u0644\u062a\u062f\u0631\u064a\u0628 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u0639\u0631\u0641\u060c \u0648\u0630\u0644\u0643 \u0644\u062a\u062d\u0633\u064a\u0646 \u0645\u0639\u062f\u0644 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u062c\u0647\u0627\u0632 \u0648\u062a\u0632\u0648\u064a\u062f\u0643 \u0628\u062e\u062f\u0645\u0627\u062a \u0623\u0641\u0636\u0644.",image_processing_result:"\u0646\u062a\u0627\u0626\u062c \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0635\u0648\u0631\u0629",image_processing:"\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0635\u0648\u0631\u0629...",obstacle_photo_page_feedback:"\u062a\u0642\u062f\u064a\u0645 \u0645\u0644\u0627\u062d\u0638\u0627\u062a",obstacle_photo_page_ignore:"\u062a\u062c\u0627\u0647\u0644",obstacle_photo_page_identify_mistakes:"\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u062a\u0639\u0631\u0641\u061f",actual_type_of_obstacle:"\u0627\u0644\u0646\u0648\u0639 \u0627\u0644\u0641\u0639\u0644\u064a \u0644\u0644\u0639\u0627\u0626\u0642",send_voice_again:"\u0625\u0631\u0633\u0627\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649",monitor_privacy_dialog_title:"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0644\u0644\u0639\u0631\u0636 \u0639\u0646 \u0628\u064f\u0639\u062f",alert_button_disagree:"\u0631\u0641\u0636",map_object_desc_sock:"\u0646\u0638\u0631\u064b\u0627 \u0644\u0627\u0631\u062a\u0641\u0627\u0639 \u0642\u064a\u0648\u062f \u0645\u0633\u062a\u0634\u0639\u0631 LDS\u060c \u0642\u062f \u0644\u0627 \u064a\u062a\u0645\u0643\u0646 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0645\u0646 \u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0627\u0644\u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u0629 - \u0645\u062b\u0644 \u0627\u0644\u062c\u0648\u0627\u0631\u0628 - \u062f\u0627\u062e\u0644 \u0645\u0646\u0632\u0644\u0643. \u0642\u062f \u062a\u062a\u0634\u0627\u0628\u0643 \u0647\u0630\u0647 \u0627\u0644\u0623\u063a\u0631\u0627\u0636 \u0641\u064a \u0627\u0644\u0641\u0631\u0634\u0627\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648\u062a\u062a\u0633\u0628\u0628 \u0641\u064a \u062a\u0648\u0642\u0641 \u0627\u0644\u062a\u0646\u0638\u064a\u0641. \u064a\u0633\u0627\u0639\u062f \u0627\u0644\u062a\u0639\u0631\u0641 \u0627\u0644\u0630\u0643\u064a \u0641\u064a \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0639\u0644\u0649 \u062a\u062c\u0646\u0628 \u0647\u0630\u0647 \u0627\u0644\u0623\u063a\u0631\u0627\u0636\u060c \u0645\u0645\u0627 \u064a\u0636\u0645\u0646 \u0625\u0643\u0645\u0627\u0644 \u0645\u0647\u0645\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0628\u0646\u062c\u0627\u062d.",map_object_name_sock:"\u062c\u0648\u0627\u0631\u0628",gesture_password_title:"\u0627\u0631\u0633\u0645 \u0646\u0645\u0637\u0643",map_object_cancel_privacy_loading:"\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a...",monitor_bumper_tip_right:"\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u0623\u0648 \u062d\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0631\u0626\u064a \u064a\u0645\u064a\u0646 \u0627\u0644\u0631\u0648\u0628\u0648\u062a",monitor_bumper_tip_left:"\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u0623\u0648 \u062d\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0631\u0626\u064a \u0639\u0644\u0649 \u064a\u0633\u0627\u0631 \u0627\u0644\u0631\u0648\u0628\u0648\u062a",monitor_bumper_tip_front:"\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u0623\u0648 \u062d\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0631\u0626\u064a \u0623\u0645\u0627\u0645 \u0627\u0644\u0631\u0648\u0628\u0648\u062a",use_celluar_for_monitor_tip:"\u0623\u0646\u062a \u062a\u0634\u0627\u0647\u062f \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062e\u0644\u0648\u064a\u0629. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f",open_real_monitor_firstly_tip:"\u0642\u0645 \u0628\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0639\u0631\u0636 \u0639\u0646 \u0628\u064f\u0639\u062f \u0623\u0648\u0644\u0627\u064b",connecting_video_security_channel:"\u0625\u0646\u0634\u0627\u0621 \u0642\u0646\u0627\u0629 \u0625\u0631\u0633\u0627\u0644 \u0641\u064a\u062f\u064a\u0648 \u0622\u0645\u0646\u0629...",map_object_cancel_privacy_stop:"\u0627\u0644\u0625\u0646\u0647\u0627\u0621",map_object_cancel_privacy_timeout:"\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0647\u0644\u0629 \u0627\u0644\u0625\u0628\u0637\u0627\u0644 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",map_object_cancel_privacy_success:"\u062a\u0645 \u0627\u0644\u0625\u0628\u0637\u0627\u0644 \u0628\u0646\u062c\u0627\u062d",map_object_cancel_privacy_stop_robot_alert:"\u0633\u064a\u0624\u062f\u064a \u0625\u0628\u0637\u0627\u0644 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0625\u0644\u0649 \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0645\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629.",map_object_desc_general_structure_light:"\u064a\u0645\u0643\u0646 \u0644\u0644\u0631\u0648\u0628\u0648\u062a \u062a\u062c\u0646\u0628 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u0639\u0648\u0627\u0626\u0642 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u0645\u062c\u0633\u0645 \u0627\u0644\u0645\u062f\u0639\u0648\u0645 \u0628\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u0623\u062e\u0631\u0649.",map_object_desc_general:"\u064a\u0645\u0643\u0646 \u0644\u0644\u0631\u0648\u0628\u0648\u062a \u062a\u062d\u062f\u064a\u062f \u0648\u062a\u062c\u0646\u0628 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u0639\u0648\u0627\u0626\u0642 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u062c\u0633\u0645\u0629 \u0627\u0644\u062a\u064a \u062a\u062f\u0639\u0645\u0647\u0627 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u0623\u062e\u0631\u0649.",map_object_privacy_alert_link:"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0644\u0635\u0648\u0631 \u0627\u0644\u0639\u0648\u0627\u0626\u0642",map_object_privacy_alert:"\u0628\u0645\u062c\u0631\u062f \u0627\u0644\u062a\u0645\u0643\u064a\u0646\u060c \u064a\u062a\u0645 \u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0635\u0648\u0631 \u0641\u064a \u0645\u0633\u0627\u062d\u0629 \u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0644\u0644\u0639\u0631\u0636. \u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u0649",map_object_privacy_reset_dialog_content:"\u0628\u0645\u062c\u0631\u062f \u0627\u0644\u0625\u0628\u0637\u0627\u0644\u060c \u0644\u0627 \u064a\u0645\u0643\u0646 \u0639\u0631\u0636 \u0635\u0648\u0631\u0629 \u0627\u0644\u0639\u0627\u0626\u0642 \u0628\u0639\u062f \u0627\u0644\u0622\u0646 \u0648\u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0627\u0644\u062a\u0641\u0648\u064a\u0636 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0642\u0628\u0644 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645.",map_object_privacy_title:"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0644\u0635\u0648\u0631 \u0627\u0644\u0639\u0648\u0627\u0626\u0642",map_object_enable_intro:"\u0627\u0639\u0631\u0636 \u0635\u0648\u0631 \u0627\u0644\u0639\u0627\u0626\u0642 \u0627\u0644\u0645\u062d\u062f\u062f \u0639\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u062e\u0631\u064a\u0637\u0629.\n*\u0633\u064a\u062a\u0645 \u062a\u062e\u0632\u064a\u0646 \u0635\u0648\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u062f\u0627\u062e\u0644\u064a\u064b\u0627 \u0644\u0643\u0644 \u0639\u0627\u0626\u0642 \u064a\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0647. \u0642\u062f \u0644\u0627 \u062a\u064f\u062e\u0632\u0646 \u0628\u0639\u0636 \u0635\u0648\u0631 \u0627\u0644\u0639\u0627\u0626\u0642.",map_object_bubble_tip_avoid:"\u062a\u062c\u0646\u0628",realtime_video_info:"\u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0639\u0631\u0636 \u0639\u0646 \u0628\u064f\u0639\u062f",realtime_video_sub_title_3_1:"\u0633\u064a\u0648\u0645\u0636 \u0636\u0648\u0621 \u0627\u0644\u0645\u0624\u0634\u0631 \u0628\u062f\u0648\u0646 \u062a\u0646\u0628\u064a\u0647 \u0635\u0648\u062a\u064a.",realtime_video_title_3:"\u0642\u0648\u064a",realtime_video_title_2:"\u0645\u0639\u062a\u062f\u0644",realtime_video_title_1:"\u0648\u0645\u064a\u0636",realtime_video_title:"\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u0646\u0628\u064a\u0647",confirm_start:"\u062a\u0646\u0638\u064a\u0641&\u062a\u062e\u0637\u064a\u0637",map_object_desc_henggan:"\u0627\u0644\u0623\u062b\u0627\u062b \u0645\u0639 \u0627\u0644\u0639\u0627\u0631\u0636\u0629\u0