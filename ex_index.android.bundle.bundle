er_error_desc_152:"\u05e9\u05d2\u05d9\u05d0\u05d4 \u05d1\u05de\u05e9\u05d0\u05d1\u05ea \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e0\u05d9\u05e7\u05d5\u05d6-\u05e4\u05e8\u05d9\u05e7\u05d4",inner_error_desc_153:"\u05e9\u05d2\u05d9\u05d0\u05d4 \u05d1\u05d7\u05d9\u05d9\u05e9\u05df \u05d4\u05d5\u05dc \u05d1\u05e9\u05e1\u05ea\u05d5\u05dd \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05e0\u05d9 \u05e9\u05dc \u05db\u05e0\u05d9\u05e1\u05ea \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e0\u05d9\u05e7\u05d5\u05d6 \u05de\u05d9\u05dd/\u05de\u05e4\u05dc\u05e1 \u05de\u05d9\u05dd \u05e0\u05e7\u05d9\u05d9\u05dd ",inner_error_desc_154:"\u05ea\u05e7\u05dc\u05d4 \u05d1\u05de\u05d1\u05e8\u05e9\u05ea \u05e6\u05d3\u05d3\u05d9\u05ea.",inner_error_desc_158:"\u05e9\u05d2\u05d9\u05d0\u05d4 \u05d1\u05d7\u05d9\u05d9\u05e9\u05df \u05d4\u05d5\u05dc \u05e9\u05dc \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e0\u05d9\u05e7\u05d5\u05d6- \u05de\u05e4\u05dc\u05e1 \u05de\u05d9\u05dd \u05de\u05dc\u05d5\u05db\u05dc\u05db\u05d9\u05dd",inner_error_desc_159:"\u05e9\u05d2\u05d9\u05d0\u05d4 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e0\u05d9\u05e7\u05d5\u05d6",map_edit_furniture_floor_mirror:"\u05de\u05e8\u05d0\u05ea \u05e8\u05e6\u05e4\u05d4",map_edit_split_too_small:"\u05d4\u05d7\u05d3\u05e8 \u05e7\u05d8\u05df \u05de\u05d3\u05d9 \u05d5\u05dc\u05d0 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d7\u05dc\u05e7\u05d5 \u05dc\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd.",setting_auto_avoid_obstacle_title:"\u05d4\u05de\u05e0\u05e2\u05d5\u05ea \u05e8\u05d9\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05de\u05de\u05db\u05e9\u05d5\u05dc\u05d9\u05dd",setting_auto_avoid_obstacle_desc:"\u05d0\u05dc\u05d2\u05d5\u05e8\u05d9\u05ea\u05dd \u05d0\u05d5\u05e8 \u05de\u05d5\u05d1\u05e0\u05d4 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e8\u05d5\u05d1\u05d5\u05d8 \u05dc\u05d6\u05d4\u05d5\u05ea \u05de\u05db\u05e9\u05d5\u05dc\u05d9\u05dd \u05d5\u05dc\u05d4\u05de\u05e0\u05e2 \u05de\u05d4\u05dd \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05e