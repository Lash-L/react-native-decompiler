t_type_google:"Google",robot_start_type_alexa:"Alexa",video_error115_resolve:"Operare prea frecvent\u0103. \xcencerca\u021bi din nou mai t\xe2rziu.",video_error114_resolve:"Eroare de re\u021bea telefon sau robot. Verifica\u021bi conexiunea la re\u021bea sau comuta\u021bi la alt\u0103 re\u021bea \u0219i \xeencerca\u021bi din nou.",video_error108_resolve:"Eroare de conexiune re\u021bea. Verifica\u021bi re\u021beaua \u0219i \xeencerca\u021bi din nou.",video_error107_resolve:"Resurs\u0103 ocupat\u0103. \xcencerca\u021bi din nou mai t\xe2rziu.",video_error105_resolve:"Reseta\u021bi robotul \u0219i \xeencerca\u021bi din nou.",video_error104_resolve:"Verifica\u021bi dac\u0103 video-ul este afi\u0219at pe alt telefon. Dac\u0103 nu, a\u0219tepta\u021bi un minut \u0219i \xeencerca\u021bi din nou.",video_error103_resolve:"V\u0103 rug\u0103m s\u0103 dezactiva\u021bi \u0219i apoi s\u0103 activa\u021bi din nou func\u021bia de vizualizare de la distan\u021b\u0103 sau s\u0103 reporni\u021bi dispozitivul \u0219i s\u0103 \xeencerca\u021bi din nou.",video_error102_resolve:"Eroare camer\u0103. Reporni\u021bi robotul \u0219i \xeencerca\u021bi din nou.",video_error101_resolve:"\xcendep\u0103rta\u021bi dispozitivul de sta\u021bia de \xeenc\u0103rcare pentru a vizualiza video.",video_error100_resolve:"Comunicare re\u021bea e\u0219uat\u0103. Verifica\u021bi re\u021beaua robotului \u0219i \xeencerca\u021bi din nou.",dust_collection_info:"Robotul se va goli automat dup\u0103 efectuarea unui ciclu de cur\u0103\u021bare. ",map_edit_carpet_ignore_confirm_cancel:"Recunoa\u0219terea covoarelor va fi restabilit\u0103 la urm\u0103toarea cur\u0103\u021bare, dup\u0103 \u0219tergere.",map_edit_carpet_ignore_confirm_ignore:"Recunoa\u0219terea covoarelor din aceast\u0103 zon\u0103 va fi dezactivat\u0103 dup\u0103 \u0219tergere. ",map_edit_carpet_ignore_title:"Edita\u021bi covorul",carpet_clean_mode_setting_ignore_carpet:"Eroare de recunoa\u0219tere? Accesa\u021bi Settings (Set\u0103ri).",manual_save_handler:"Dac\u0103 nu este salvat automat, poate fi salvat \u0219i manual dup\u0103 finalizarea cur\u0103\u021b\u0103rii robotului",robot_clean_status_only_mop:"Mop",robot_clean_status_only_clean:"Aspir.",tanos_s_mop_mode_info1:"Robotul se va deplasa \xeen Zig-Zag, parcurg\xe2nd de dou\u0103 ori fiecare zon\u0103 a pardoselei. Puterea de aspirare va fi mult redus\u0103. Acest mod este potrivit numai pentru podelele recent aspirate.",tanos_s_mop_mode_title:"\u0218tergere \xeen profunzime pentru cur\u0103\u021bare intens\u0103",multi_floor_edit:"Editare",ask_whether_back_to_charge:"Dispozitivul s-a oprit. Dori\u021bi s\u0103 reveni\u021bi la doc?",map_edit_virtual_wall_and_forbidden_zone_info3:"Zone \u201eno-go\u201d: Robotul este prevenit s\u0103 intre \xeentr-o anumit\u0103 zon\u0103 \xeen timpul cur\u0103\u021beniei.",home_dialog_begin_new_back_washing_duster:"Cur\u0103\u021bare \xeen curs. Termina\u021bi sarcina curent\u0103 \u0219i \xeencepe\u021bi sp\u0103larea mopului?",robot_cmd_stop_washing_duster:"Oprire sp\u0103lare",robot_cmd_start_washing_duster:"Revenire la cur\u0103\u021bare mop",robot_status_back_dock_washing_duster:"Merg s\u0103 sp\u0103l mopul",robot_status_washing_duster:"Sp\u0103lare mop",map_edit_bottom_menu_order_info1:"Seta\u021bi cur\u0103\u021barea camerelor \xeen ordinea preferat\u0103.",map_edit_bottom_menu_order_title:"Gestionarea ordinii de cur\u0103\u021benie",map_edit_virtual_wall_and_forbidden_zone_info2:"Zon\u0103 \u201eno-mop\u201d (f\u0103r\u0103 mop): Robotul este prevenit s\u0103 intre \xeentr-o anumit\u0103 zon\u0103 atunci c\xe2nd este ata\u0219at suportul pentru mop.",map_edit_virtual_wall_and_forbidden_zone_info1:"Bariere virtuale/zone \u201eno-go\u201d: Robotul este prevenit s\u0103 intre \xeentr-o anumit\u0103 zon\u0103 \xeen timpul cur\u0103\u021beniei.",map_edit_virtual_wall_and_forbidden_zone_title:"Configura\u021bi zonele de cur\u0103\u021benie cu bariere virtuale",map_edit_zone_zone_info:"Combina\u021bi, diviza\u021bi \u0219i denumi\u021bi fiecare camer\u0103 din casa dvs.",map_edit_zone_title:"Editare camere",room_name_already_in_use:"Acest nume este deja utilizat. Alege\u021bi altul sau crea\u021bi un nume nou",tanos_custom_mode_title:"Personaliza\u021bi planul de cur\u0103\u021benie pentru fiecare camer\u0103",tanos_s_mop_mode_strong:"Puternic",tanos_s_mop_mode_middle:"Standard",tanos_s_mop_mode_weak:"U\u0219or",room_count_reach_limit:"S-a atins limita privind numele camerelor.\xa0Nu se pot ad\u0103uga nume suplimentare.",button_go_setting:"Accesa\u021bi Settings (Set\u0103ri)",tanos_custom_mode_des_info:"Prin setarea \u0219i activarea modului personalizat, robotul va cur\u0103\u021ba fiecare camer\u0103 \xeen func\u021bie de modul de setare pentru a r\u0103spunde nevoilor dvs. individuale.",tanos_s_mop_mode:"Traseul Mop",tanos_s_mop_mode_general_frag:"Standard",tanos_s_mop_mode_fine_frag:"Intens",localization_strings_Common_custom_mode:"Personalizare",introduction_to_image_uploading8:"Confirma\u021bi c\u0103 fotografia nu con\u021bine informa\u021biile dvs. cu caracter personal",collecting_dusk_error35_desc:"Recipientul de praf nu poate fi golit",collecting_dusk_error35_title:"Eroare tensiune Auto-Empty Dock (sta\u021bie de andocare cu golire automat\u0103)",collecting_dusk_error34_desc:"Sta\u021bie de andocare recipient de praf, filtru sau conduct\u0103 de aer blocate, verifica\u021bi \u0219i cur\u0103\u021ba\u021bi.",collecting_dusk_error34_title:"Auto-Empty Dock (sta\u021bie de andocare cu golire automat\u0103) blocat\u0103",collecting_dusk_error33_desc:"Sta\u021bia andocare a co\u0219ului de gunoi sau filtrul nu sunt \xeen pozi\u021bie.",collecting_dusk_error33_title:"Eroare ventilator Auto-Empty Dock (sta\u021bie de andocare cu golire automat\u0103)",collecting_dusk_error32_desc:"Sta\u021bie de andocare recipient de praf sau filtru neinstalate",collecting_dusk_error32_title:"Recipient de praf sau filtru neinstalate",robot_status_collecting_dust:"Golire",mainpage_stop_collect_dust:"Termina\u021bi golirea",monitor_obstacle_tip_right:"Robotul nu se poate deplasa la dreapta. Schimba\u021bi direc\u021bia.",monitor_obstacle_tip_left:"Robotul nu se poate deplasa la st\xe2nga. Schimba\u021bi direc\u021bia.",monitor_obstacle_tip_front:"Robotul nu se poate deplasa \xeenainte. Schimba\u021bi direc\u021bia.",image_processing_failure:"Procesare e\u0219uat\u0103",introduction_to_image_uploading7:"\xcenc\u0103rcare e\u0219uat\u0103",introduction_to_image_uploading6:"Se \xeencarc\u0103 fotografia...",introduction_to_image_uploading5:"\xcenc\u0103rcare",introduction_to_image_uploading4:"Confirm c\u0103 fotografia nu con\u021bine informa\u021bii cu caracter personal",introduction_to_image_uploading3:"3. Dac\u0103 ave\u021bi \xeentreb\u0103ri referitoare la protec\u021bia confiden\u021bialit\u0103\u021bii, v\u0103 rug\u0103m s\u0103 consulta\u021bi Politica noastr\u0103 de confiden\u021bialitate \u0219i s\u0103 ne contacta\u021bi utiliz\xe2nd informa\u021biile de contact furnizate.",introduction_to_image_uploading2:"2. Ating\xe2nd Upload (\xcenc\u0103rcare), fotografia trimis\u0103 \u0219i tipul selectat de obstacol vor fi \xeenc\u0103rcate anonim \xeen cloud. \xcenainte de \xeenc\u0103rcarea fotografiei, vom utiliza un algoritm de desensibilizare pentru procesarea informa\u021biilor sensibile care pot fi con\u021binute de fotografie (de ex., informa\u021bii faciale etc.) Fotografia procesat\u0103 va fi afi\u0219at\u0103 mai sus pentru a fi vizualizat\u0103 \u0219i confirmat\u0103 de dvs.",introduction_to_image_uploading1:"1. Datele selectate pentru \xeenc\u0103rcare sunt utilizate numai pentru instruirea modelului de recunoa\u0219tere, cu scopul de a \xeembun\u0103t\u0103\u021bi rata de recunoa\u0219tere a dispozitivului \u0219i de a v\u0103 oferi servicii mai bune.",image_processing_result:"Rezultatele proces\u0103rii imaginii",image_processing:"Se proceseaz\u0103 imaginea...",obstacle_photo_page_feedback:"Furnizare feedback",obstacle_photo_page_ignore:"Ignora\u021bi",obstacle_photo_page_identify_mistakes:"Eroare de recunoa\u0219tere?",actual_type_of_obstacle:"Tipul real de obstacol",send_voice_again:"Trimite\u021bi din nou",monitor_privacy_dialog_title:"Politica de confiden\u021bialitate privind video \xeen timp real",alert_button_disagree:"Nu sunt de acord",map_object_desc_sock:"Datorit\u0103 limit\u0103rilor de \xeen\u0103l\u021bime ale senzorului LDS, este posibil ca robotul s\u0103 nu poat\u0103 detecta obiecte aflate la o \xeen\u0103l\u021bime joas\u0103, cum ar fi \u0219osetele din casa dvs. Aceste obiecte se pot \xeencurca \xeen peria principal\u0103 \u0219i pot \xeentrerupe cur\u0103\u021barea. Recunoa\u0219terea AI ajut\u0103 robotul s\u0103 evite aceste obiecte, asigur\xe2nd terminarea cu succes a opera\u021biei de cur\u0103\u021bare.",map_object_name_sock:"\u0218osete",gesture_password_title:"Desena\u021bi modelul dvs.",map_object_cancel_privacy_loading:"se proceseaz\u0103 datele\u2026",monitor_bumper_tip_right:"Zon\u0103 \u201eno-go\u201d sau perete invizibil a fost detectat \xeen partea dreapt\u0103 a robotului",monitor_bumper_tip_left:"Zon\u0103 \u201eno-go\u201d sau perete invizibil a fost detectat \xeen partea st\xe2ng\u0103 a robotului",monitor_bumper_tip_front:"Zon\u0103 \u201eno-go\u201d sau perete invizibil a fost detectat \xeen fa\u021ba robotului",use_celluar_for_monitor_tip:"Viziona\u021bi video-ul utiliz\xe2nd date mobile.",open_real_monitor_firstly_tip:"Activa\u021bi mai \xeent\xe2i video \xeen timp real",connecting_video_security_channel:"Proces de stabilire a canalului de securitate pentru transmiterea video\u2026",map_object_cancel_privacy_stop:"Sf\xe2r\u0219it",map_object_cancel_privacy_timeout:"Timp de expirare revocare. \xcencerca\u021bi din nou.",map_object_cancel_privacy_success:"Revocat\u0103 cu succes",map_object_cancel_privacy_stop_robot_alert:"Revocarea politicii de confiden\u021bialitate va termina opera\u021bia curent\u0103.",map_object_desc_general_structure_light:"Folosind lumina structurat\u0103 permis\u0103 de o serie de al\u021bi senzori, robotul poate evita o gam\u0103 larg\u0103 de obstacole.",map_object_desc_general:"Folosind vederea stereoscopic\u0103 permis\u0103 de o serie de al\u021bi senzori, robotul poate identifica \u0219i evita o gam\u0103 larg\u0103 de obstacole.",map_object_privacy_alert_link:"Politica de confiden\u021bialitate privind imaginea \xeen timp real",map_object_privacy_alert:"Dup\u0103 activare, imaginile sunt stocate \xeen memoria intern\u0103 a robotului pentru a fi vizualizate. Pentru detalii, consulta\u021bi",map_object_privacy_reset_dialog_content:"Dup\u0103 ce este revocat\u0103, imaginea \xeen timp real nu mai poate fi vizualizat\u0103 \u0219i trebuie s\u0103 o autoriza\u021bi din nou \xeenainte de a o utiliza.",map_object_privacy_title:"Politica de confiden\u021bialitate privind imaginea \xeen timp real",map_object_enable_intro:"Vizualiza\u021bi fotografii ale obstacolelor identificate pe pagina h\u0103r\u021bii.\n*Pe dispozitiv va fi stocat\u0103 o imagine pentru fiecare obstacol recunoscut. Este posibil ca imaginile anumitor obstacole s\u0103 nu fie stocate.",map_object_bubble_tip_avoid:"Evitat",realtime_video_info:"La accesarea clipului video",realtime_video_sub_title_3_1:"Indicatorul luminos va lumina intermitent, f\u0103r\u0103 s\u0103 emit\u0103 vreo alert\u0103 vocal\u0103.",realtime_video_title_3:"Memento puternic",realtime_video_title_2:"Perturbare u\u0219oar\u0103",realtime_video_title_1:"Lumin\u0103 intermitent\u0103",realtime_video_title:"Nivelul de alert\u0103",confirm_start:"Cur\u0103\u021bare \u0219i cartografiere",map_object_desc_henggan:"Evitarea elementelor de mobilier prev\u0103zute cu o bar\u0103 transversal\u0103, de exemplu, scaun cantilever, pentru a preveni blocarea.",map_object_desc_poqi:"Evitarea f\u0103ra\u0219ului sau a unor obiecte asem\u0103n\u0103toare pentru a preveni blocarea.",map_object_desc_zhiwu:"Recunoa\u0219terea produselor textile pentru a preveni \xeencurcarea \u0219i blocarea.",map_object_desc_tizhongcheng:"Evitarea c\xe2ntarului pentru a preveni blocarea.",map_object_desc_dizuo:"Evitarea soclurilor pentru a preveni blocarea. Soclurile includ: scaune de bar, ventilatoare cu soclu, bazele aspiratoarelor Roborock f\u0103r\u0103 fir etc.",map_object_desc_shoe:"Evitarea pantofilor/papucilor pentru a preveni blocarea.",map_object_desc_baba:"Evitarea de\u0219eurilor derivate de la animalele de companie pentru a preveni mizeria.",map_object_desc_chapai:"Evitarea prelungitoarelor pentru a preveni blocarea.",map_object_desc_xian:"Evitarea cablului/firului pentru a preveni \xeencurcarea. Cablurile lungi \u0219i sub\u021biri se pot \xeencurca.",obstacle_photo_page_ignore_desc:"1. Aceast\u0103 func\u021bie este destinat\u0103 obstacolelor recunoscute eronat sau \xeen cazul \xeen care nu dori\u021bi ca robotul s\u0103 evite acest obiect \xeen viitor.\n2. Dup\u0103 \u0219tergere, robotul va ignora toate obiectele de acest tip din aceast\u0103 loca\u021bie.\n3. Pentru a restabili recunoa\u0219terea acestui obiect, \u0219terge\u021bi harta \u0219i reface\u021bi-o.",obstacle_photo_page_ignore_link:"Nu este nevoie s\u0103 evita\u021bi, ignora\u021bi?",obstacle_photo_page_percent:"\xcencredere:",obstacle_photo_page_subtitle:"Rezultate recunoa\u0219tere:",retry_after_30_seconds:"\xcencerca\u021bi din nou dup\u0103 30 de secunde",video_func_is_locked:"Parol\u0103 dezactivat\u0103",gesture_password_at_least_four_length:"Modelul de deblocare este format din cel pu\u021bin 4 puncte conectate.",reset_gesture_password_tip:"Dup\u0103 confirmare, parola va fi resetat\u0103 \u0219i videoclipul va fi \xeenchis, iar videoclipul de pornire trebuie reactivat.",forget_password:"Parol\u0103 uitat\u0103",title_skip:"Omitere",microphone_is_occupied:"Microfonul este ocupat. \xcencerac\u021bi mai t\xe2rziu",resetting_device_wifi_and_reconnecting:"Actualiza\u021bi modul WiFi, reseta\u021bi dispozitivul WiFi \u0219i reconecta\u021bi-v\u0103 pentru a utiliza aceast\u0103 func\u021bie",upgrading_the_App_to_the_latest_version:"Versiunea aplica\u021biei este sc\u0103zut\u0103, v\u0103 rug\u0103m s\u0103 face\u021bi upgrade la cea mai recent\u0103 versiune.",playing_now_please_try_again_later:"Redare voce, \xeencerca\u021bi din nou mai t\xe2rziu",no_recording_is_available:"F\u0103r\u0103 \xeenregistrare vocal\u0103",ask_if_go_record_setting:"Dori\u021bi s\u0103 activa\u021bi func\u021biile vocale?",whether_to_delete_the_recorded:"Confirma\u021bi \u0219tergerea acestei \xeenregistr\u0103ri?",let_go_of_send_up_slide_to_cancel:"Elibera\u021bi pentru trimitere, glisa\u021bi \xeen sus pentru a anula",up_to_15s_can_be_recorded:"Durata maxim\u0103 de \xeenregistrare este de 15 secunde",send_voice_fail:"Trimitere nereu\u0219it\u0103",send_voice_success:"Trimise",long_press_to_send_voice:"\u021aine\u021bi \u0219i vorbi\u021bi",send_voice_record:"Istoricul mesajelor",begin_draw_new_gesture_password:"Parol\u0103 nou\u0103",modify_gesture_password_successfully_tip:"Parol\u0103 modificat\u0103.",disable_gesture_password_successfully_tip:"Parol\u0103 dezactivat\u0103.",gesture_password_set_successfully_tip:"Parol\u0103 setat\u0103.",password_is_incorrect_tip:"Model gre\u0219it. Desena\u021bi-l din nou.",input_gestue_password_tip:"Parol\u0103 desenare model",draw_new_gestue_password_tip:"Desena\u021bi modelul de deblocare, conect\xe2nd cel pu\u021bin patru puncte.",verify_gesture_password:"Verificare parol\u0103",need_password_everytime:"Odat\u0103 activat\u0103, este necesar\u0103 o parol\u0103 pentru a accesa Vizualizare la distan\u021b\u0103.",modify_password:"Schimbare parol\u0103",title_password:"Parol\u0103 de model",enable_gesture_password:"Configurare parol\u0103 nou\u0103",disable_gesture_password:"Dezactiva\u021bi model de deblocare",password_is_not_same_with_older:"Cele dou\u0103 gesturi nu se potrivesc.",please_draw_again:"Redesena\u021bi modelul pentru a verifica parola",obstacle_pop_type_photo:"Fotografii reale",monitor_page_w