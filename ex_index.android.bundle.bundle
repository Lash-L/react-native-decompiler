\u0111\u1ea1t \u0111\u1ebfn s\u1ed1 v\u1ebft t\u1ed1i \u0111a",localization_strings_Setting_DoNotDisturbPage_3:"T\u1eaft t\xednh n\u0103ng qu\xe9t \u0111i\u1ec3m d\u1eebng",localization_strings_Setting_DoNotDisturbPage_4:"Gi\u1ea3m \xe2m l\u01b0\u1ee3ng",localization_strings_Setting_DoNotDisturbPage_5:"Gi\u1ea3m \u0111\u1ed9 s\xe1ng \u0111\xe8n c\u1ea3nh b\xe1o",localization_strings_Setting_DoNotDisturbPage_6:"T\u1eaft t\xednh n\u0103ng h\xfat b\u1ee5i t\u1ef1 \u0111\u1ed9ng",localization_strings_Setting_DoNotDisturbPage_7:"T\u1eaft ch\u1ebf \u0111\u1ed9 s\u1ea5y t\u1ef1 \u0111\u1ed9ng",localization_strings_Setting_DoNotDisturbPage_8:"Tu\u1ef3 ch\u1ec9nh ch\u1ebf \u0111\u1ed9 kh\xf4ng l\xe0m phi\u1ec1n",setting_section_title2:"Thi\u1ebft b\u1ecb \u0111i\u1ec1u khi\u1ec3n",map_edit_select_one_map:"Danh s\xe1ch b\u1ea3n \u0111\u1ed3",home_sepecial_tip_for_only_mop_collectdusk:"Ch\u1ec9 Lau | S\u1eed d\u1ee5ng M\u1ed9t l\u1ea7n",build_map_finish_guide_title:"Vi\u1ec7c x\xe2y d\u1ef1ng b\u1ea3n \u0111\u1ed3 \u0111\xe3 ho\xe0n th\xe0nh v\xe0 kh\xf4ng gian to\xe0n b\u1ed9 ng\xf4i nh\xe0 \u0111\u01b0\u1ee3c nh\u1eadn d\u1ea1ng m\u1ed9t c\xe1ch th\xf4ng minh.",build_map_finish_guide_content:"Ph\xe2n v\xf9ng ph\xf2ng, lo\u1ea1i v\xe0 v\u1eadt li\u1ec7u s\xe0n \u0111\xe3 \u0111\u01b0\u1ee3c x\xe1c \u0111\u1ecbnh v\xe0 b\u1ea3n \u0111\u1ed3 s\u1ebd ti\u1ebfp t\u1ee5c \u0111\u01b0\u1ee3c c\u1ea3i thi\u1ec7n trong qu\xe1 tr\xecnh d\u1ecdn d\u1eb9p.",build_map_map_edit_guide_title:"Ch\u1ec9nh s\u1eeda b\u1ea3n \u0111\u1ed3 \u0111\u1ec3 gi\xfap robot hi\u1ec3u h\u01a1n v\u1ec1 m\xf4i tr\u01b0\u1eddng c\u1ee7a gia \u0111\xecnh.",build_map_map_edit_guide_content:"X\xe1c nh\u1eadn k\u1ebft qu\u1ea3 nh\u1eadn d\u1ea1ng ph\xf2ng, \u0111\u1eb7t khu v\u1ef1c h\u1ea1n ch\u1ebf v\xe0 c\u1ea3i thi\u1ec7n ch\u1ea5t li\u1ec7u s\xe0n \u0111\u1ec3 robot d\u1ecdn d\u1eb9p t\u1ed1t h\u01a1n cho b\u1ea1n",home_new_control_start_dry:"s\u1ea5y kh\xf4",map_edit_door_sill_title:"v\xe1ch ng\u0103n",map_edit_door_sill_slide:"di chuy\u1ec3n v\xe1ch ng\u0103n",map_edit_door_sill_stone:"v\xe1ch \u0111\xe1",error_temperature_protection_desc:"Vui l\xf2ng \u0111\u1eb7t robot \u1edf v\u1ecb tr\xed c\xf3 nhi\u1ec7t \u0111\u1ed9 ph\xf2ng b\xecnh th\u01b0\u1eddng trong m\u1ed9t kho\u1ea3ng th\u1eddi gian sau khi t\xe1i s\u1eed d\u1ee5ng",error_temperature_protection_title:"B\u1ea3o v\u1ec7 nhi\u1ec7t \u0111\u1ed9 thi\u1ebft b\u1ecb",map_edit_add_ai_zone:"Thi\u1ebft l\u1eadp khu v\u1ef1c c\u1ea5m",map_edit_add_door_sill:"Thi\u1ebft l\u1eadp v\xe1ch ng\u0103n",map_edit_cliff_zone_adjust:"\u0110i\u1ec1u ch\u1ec9nh khu v\u1ef1c c\u1ea5m",map_edit_door_sill_title2:"Di chuy\u1ec3n th\xf4ng minh qua ng\u01b0\u1ee1ng \u0111\u1ec3 \xedt v\u01b0\u1edbng v\xe0o h\u01a1n.",map_edit_door_sill_detail:"Robot di chuy\u1ec3n th\xf4ng minh v\xe0 nh\u1eb9 nh\xe0ng qua ng\u01b0\u1ee1ng v\u01b0\u1edbng m\xe0 kh\xf4ng l\xe0m s\u1ea1ch.",map_edit_stuck_zone_title:"Khu v\u1ef1c v\u01b0\u1edbng",map_edit_stuck_zone_detail:"Robot b\u1ecb k\u1eb9t \u1edf c\xf9ng m\u1ed9t v\u1ecb tr\xed nhi\u1ec1u l\u1ea7n. N\xean thi\u1ebft l\u1eadp m\u1ed9t khu v\u1ef1c h\u1ea1n ch\u1ebf \u0111\u1ec3 tr\xe1nh b\u1ecb k\u1eb9t. *N\u1ebfu b\u1ea1n kh\xf4ng mu\u1ed1n \u0111\u1eb7t khu v\u1ef1c h\u1ea1n ch\u1ebf \u1edf \u0111\xe2y, b\u1ea1n c\xf3 th\u1ec3 \"b\u1ecf qua\"",map_edit_cliff_zone_title:"Khu v\u1ef1c c\u1ea5m l\xe0 v\xe1ch ng\u0103n",map_edit_cliff_zone_detail:"Robot c\u1ea3m nh\u1eadn \u0111\u01b0\u1ee3c s\u1ef1 r\u01a1i nhi\u1ec1u l\u1ea7n t\u1ea1i c\xf9ng m\u1ed9t v\u1ecb tr\xed v\xe0 t\u1ea1o ra c\xe1c khu v\u1ef1c h\u1ea1n ch\u1ebf m\u1ed9t c\xe1ch th\xf4ng minh. V\xf9ng lo\u1ea1i tr\u1eeb b\u01b0\u1edbc gi\xfap robot ho\xe0n th\xe0nh nhi\u1ec7m v\u1ee5 l\xe0m s\u1ea1ch hi\u1ec7u qu\u1ea3 h\u01a1n. * N\u1ebfu \u0111\xe2y kh\xf4ng ph\u1ea3i l\xe0 khu v\u1ef1c c\xf3 th\u1ec3 r\u01a1i, th\xec n\xean b\u1ecf qua * N\u1ebfu k\xedch th\u01b0\u1edbc v\xe0 v\u1ecb tr\xed c\u1ee7a khu v\u1ef1c h\u1ea1n ch\u1ebf kh\xf4ng ch\xednh x\xe1c, b\u1ea1n n\xean \u0111i\u1ec1u ch\u1ec9nh k\xedch th\u01b0\u1edbc;",setting_carpet_deep_clean_switch_title:"L\xe0m s\u1ea1ch th\u1ea3m k\u1ef9",setting_carpet_deep_clean_switch_desc:"Robot th\u1ef1c hi\u1ec7n \u0111\u1ed9ng t\xe1c l\xe0m s\u1ea1ch tic-tac-toe tr\xean khu v\u1ef1c th\u1ea3m \u0111\u1ec3 n\xe2ng cao hi\u1ec7u qu\u1ea3 l\xe0m s\u1ea1ch. *Hi\u1ec7u qu\u1ea3 l\xe0m s\u1ea1ch s\u1ebd gi\u1ea3m, ngo\u1ea1i tr\u1eeb th\u1ea3m tr\u1ea3i s\xe0n c\u1ee1 nh\u1ecf",map_ai_zone_bubble_set:"Nh\u1ea5n \u0111\u1ec3 x\xe1c nh\u1eadn khu v\u1ef1c v\u01b0\u1edbng",map_ai_zone_bubble_adjust:"Nh\u1ea5n \u0111\u1ec3 \u0111i\u1ec1u ch\u1ec9nh khu v\u1ef1c c\u1ea5m",warning_for_will_delete_wifi:"Sau khi xo\xe1, robot s\u1ebd d\u1eebng n\u1ed7 l\u1ef1c k\u1ebft n\u1ed1i v\u1edbi WiFi n\xe0y.",wifi_page_current_wifi:"K\u1ebft n\u1ed1i WiFi hi\u1ec7n t\u1ea1i",wifi_page_others_wifi:"K\u1ebft n\u1ed1i WiFi kh\xe1c",wifi_page_title:"WiFi",map_edit_floor_wood_width:"S\xe0n (Ngang)",map_edit_floor_wood_longti:"S\xe0n (D\u1ecdc)",ground_material_clean_direction_title:"L\xe0m s\u1ea1ch d\u1ecdc theo h\u01b0\u1edbng s\xe0n",ground_material_clean_direction_detail:"Khi v\u1ec7 sinh to\xe0n b\u1ed9 ng\xf4i nh\xe0 v\xe0 c\xe1c khu v\u1ef1c \u0111\u01b0\u1ee3c ch\u1ecdn, h\xe3y lau theo h\u01b0\u1edbng s\xe0n nh\xe0 \u0111\u1ec3 gi\u1ea3m tr\u1ea7y x\u01b0\u1edbc \u1edf c\xe1c \u0111\u01b0\u1eddng n\u1ed1i c\u1ee7a s\xe0n. *N\xf3 c\xf3 hi\u1ec7u l\u1ef1c sau khi thi\u1ebft l\u1eadp m\xf4i tr\u01b0\u1eddng m\u1eb7t \u0111\u1ea5t",map_edit_door_sill_exceed_limit:"V\xe1ch ng\u0103n \u0111\xe3 \u0111\u1ea1t \u0111\u1ebfn s\u1ed1 l\u01b0\u1ee3ng t\u1ed1i \u0111a",map_cliff_zone_guide_text:"Li\xean t\u1ee5c ph\xe1t hi\u1ec7n v\xe1ch ng\u0103n \u1edf \u0111\xe2y. T\u1ef1 \u0111\u1ed9ng c\xe0i \u0111\u1eb7t khu v\u1ef1c c\u1ea5m.",map_stuck_point_guide_text:"Robot \u0111\xe3 b\u1ecb k\u1eb9t \u1edf \u0111\xe2y nhi\u1ec1u l\u1ea7n. N\xean thi\u1ebft l\u1eadp m\u1ed9t khu v\u1ef1c h\u1ea1n ch\u1ebf.",map_door_sill_guide_text:"Ph\xe1t hi\u1ec7n c\xf3 v\xe1ch ng\u0103n \u1edf \u0111\xe2y, \u0111\u1ec1 xu\u1ea5t n\xean th\xeam v\xe1ch ng\u0103n",clean_route_fast_mode_title:"Nhanh",wifi_rssi_title:"C\u01b0\u1eddng \u0111\u1ed9 t\xedn hi\u1ec7u",map_object_desc_sanxian:"D\xe2y l\u1ecfng \u0111\u01b0\u1ee3c nh\u1eadn bi\u1ebft v\xe0 ch\u1ee7 \u0111\u1ed9ng tr\xe1nh \u0111\u1ec3 tr\xe1nh v\u01b0\u1edbng v\xe0o ch\u1ed5i ch\xednh ho\u1eb7c ch\u1ed5i ph\u1ee5. M\u1ed9t s\u1ed1 d\xe2y d\xe0i v\xe0 m\u1ecfng c\xf3 th\u1ec3 g\xe2y nguy c\u01a1 v\u01b0\u1edbng v\xedu",map_object_desc_chongwu:"Sau khi robot nh\u1eadn ra c\xf3 th\xfa c\u01b0ng, robot s\u1ebd c\u1ea9n th\u1eadn tr\xe1nh ch\xfang.",map_object_desc_zhituan:"Nh\u1eadn bi\u1ebft c\xe1c c\u1ee5c v\u1ea3i ho\u1eb7c gi\u1ea5y \u0111\u1ec3 tr\xe1nh b\u1ecb k\u1eb9t v\xe0o ch\u1ed5i ch\xednh khi\u1ebfn robot kh\xf4ng ho\u1ea1t \u0111\u1ed9ng b\xecnh th\u01b0\u1eddng.",map_object_name_loosewire:"C\xe1p/d\xe2y",map_object_name_cat:"Th\xfa c\u01b0ng",map_object_name_dog:"Th\xfa c\u01b0ng",map_object_name_curledfabric:"V\u1ea3i/c\u1ee5c gi\u1ea5y",auto_delivery_cleaning_fluid_title:"L\xe0m \u0111\u1ea7y n\u01b0\u1edbc lau s\xe0n th\xf4ng minh",auto_delivery_cleaning_fluid_desc:"T\u1ef1 \u0111\u1ed9ng th\xeam dung d\u1ecbch t\u1ea9y r\u1eeda khi lau c\xe2y lau nh\xe0 v\xe0 b\u1ed5 sung n\u01b0\u1edbc",clean_route_fast_mode_guide_title:"Ch\u1ebf \u0111\u1ed9 l\xe0m s\u1ea1ch nhanh mang l\u1ea1i hi\u1ec7u qu\u1ea3 t\u1ed1t h\u01a1n.",clean_route_fast_mode_guide_desc:"D\u1ea7n d\u1ea7n hi\u1ec3u r\xf5 m\xf4i tr\u01b0\u1eddng v\xe0 linh ho\u1ea1t \u0111i\u1ec1u ch\u1ec9nh l\u1ed9 tr\xecnh \u0111\u1ec3 n\xe2ng cao hi\u1ec7u qu\u1ea3. N\u1ebfu ranh gi\u1edbi c\u1ee7a ph\xf2ng kh\xf4ng \u0111\u01b0\u1ee3c l\xe0m s\u1ea1ch, c\xf3 th\u1ec3 kh\xf4ng l\xe0m s\u1ea1ch \u0111\u01b0\u1ee3c. Ch\u1ec9 n\xean s\u1eed d\u1ee5ng \u0111\u1ec3 b\u1ea3o tr\xec v\u1ec7 sinh h\xe0ng ng\xe0y kh\xf4ng th\u01b0\u1eddng xuy\xean.",clean_route_fast_mode_is_work:"Ch\u1ebf \u0111\u1ed9 l\xe0m s\u1ea1ch nhanh",home_sepecial_tip_cleanmop_fastroute:"Ch\u1ebf \u0111\u1ed9 l\xe0m s\u1ea1ch nhanh | D\xf9ng m\u1ed9t l\u1ea7n",livecall_autosoundoff_whenmoving_alerttitle:"G\u1ecdi khi \u0111ang di chuy\u1ec3n",livecall_autosoundoff_whenmoving_alertdesc:"Khi b\u1ea1n b\u1eaft \u0111\u1ea7u cu\u1ed9c g\u1ecdi khi \u0111ang di chuy\u1ec3n, cu\u1ed9c g\u1ecdi s\u1ebd t\u1ef1 \u0111\u1ed9ng b\u1ecb t\u1eaft ti\u1ebfng v\xe0 c\xf3 th\u1ec3 \u0111\u01b0\u1ee3c b\u1eadt theo c\xe1ch th\u1ee7 c\xf4ng.",carpet_clean_mode_detail4:"Khu v\u1ef1c th\u1ea3m s\u1ebd t\u1ef1 \u0111\u1ed9ng n\xe2ng c\xe2y lau l\xean \u0111\u1ec3 lau, ch\u1ec9 qu\xe9t ch\u1ee9 kh\xf4ng lau. (Khuy\u1ebfn ngh\u1ecb s\u1eed d\u1ee5ng cho th\u1ea3m c\xf3 c\u1ecdc ng\u1eafn ho\u1eb7c th\u1ea3m tr\u1ea3i s\xe0n)",clean_route_setting_title:"Tuy\u1ebfn \u0111\u01b0\u1eddng",map_object_desc_general_1:"Th\xf4ng qua ph\xe1n \u0111o\xe1n k\u1ebft h\u1ee3p \u0111a c\u1ea3m bi\u1ebfn v\xe0 tia laser, gi\xfap tr\xe1nh c\xe1c v\u1eadt d\u1ee5ng tr\xean s\xe0n m\u1ed9t c\xe1ch th\xf4ng minh c\xf3 th\u1ec3 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn vi\u1ec7c l\xe0m s\u1ea1ch robot",robot_play_soundpackage_exception:"Nghe th\u1eed th\u1ea5t b\u1ea1i. Th\u1eed s\u1eed d\u1ee5ng tr\u1ef1c ti\u1ebfp.",offline_map_guide_title:"B\u1ea3n \u0111\u1ed3 ngo\u1ea1i tuy\u1ebfn",offline_map_guide_desc1:"Thi\u1ebft b\u1ecb s\u1ebd t\u1ef1 \u0111\u1ed9ng t\u1eaft n\u1ebfu kh\xf4ng \u0111\u01b0\u1ee3c s\u1ea1c trong h\u01a1n 12 gi\u1edd. B\u1eadt B\u1ea3n \u0111\u1ed3 ngo\u1ea1i tuy\u1ebfn cho ph\xe9p b\u1ea1n bi\u1ebft v\u1ecb tr\xed thi\u1ebft b\u1ecb tr\u01b0\u1edbc khi n\xf3 chuy\u1ec3n sang tr\u1ea1ng th\xe1i ngo\u1ea1i tuy\u1ebfn.",offline_map_tips_title:"V\u1ecb tr\xed thi\u1ebft b\u1ecb tr\u01b0\u1edbc khi chuy\u1ec3n sang ngo\u1ea1i tuy\u1ebfn.",offline_map_tips_subtitle:"Robot xu\u1ea5t hi\u1ec7n \u1edf \u0111\xe2y tr\u01b0\u1edbc khi ngo\u1ea1i tuy\u1ebfn. Sau khi robot \u0111\u01b0\u1ee3c \u0111\u01b0a tr\u1edf l\u1ea1i tr\u1ea1m g\u1ed1c, n\xf3 s\u1ebd t\u1ef1 \u0111\u1ed9ng b\u1eadt v\xe0 k\u1ebft n\u1ed1i v\u1edbi m\u1ea1ng.",upgrade_progress_view_title:"C\u1eadp nh\u1eadt ph\u1ea7n m\u1ec1m \u0111i\u1ec1u khi\u1ec3n",upgrade_progress_view_desc:"Kh\xf4ng cho ph\xe9p thao t\xe1c. Vui l\xf2ng \u0111\u1ee3i.",offline_map_tips_off_line_date:"Th\u1eddi gian ngo\u1ea1i tuy\u1ebfn.",home_sepcial_info_airdry_finish_time_minute:"S\u1ea5y gi\u1ebb lau, \u01b0\u1edbc t\xednh ho\xe0n th\xe0nh sau: ${minute} ph\xfat",map_edit_furniture_open_cattoilet:"Khay v\u1ec7 sinh cho th\xfa c\u01b0ng",map_edit_furniture_cat_toilet:"Nh\xe0 v\u1ec7 sinh k\xedn cho th\xfa c\u01b0ng",map_edit_furniture_pet_cage:"Chu\u1ed3ng cho th\xfa c\u01b0ng",map_edit_furniture_pet_waterloo:"Gi\u01b0\u1eddng cho th\xfa c\u01b0ng",map_edit_furniture_pet_bowl:"B\xe1t cho th\xfa c\u01b0ng",unlock_clean_route_fast_mode_guide_title:"M\u1edf kh\xf3a Ch\u1ebf \u0111\u1ed9 L\xe0m s\u1ea1ch Nhanh",unlock_clean_route_fast_mode_guide_desc:"Robot c\u1ea7n k\xedch ho\u1ea1t ch\u1ebf \u0111\u1ed9 n\xe0y trong m\xf4i tr\u01b0\u1eddng quen thu\u1ed9c. Vui l\xf2ng t\u1ea1o b\u1ea3n \u0111\u1ed3 tr\u01b0\u1edbc khi tr\u1ea3i nghi\u1ec7m \"L\xe0m s\u1ea1ch nhanh\".",water_updown_self_clean_title:"T\u1ef1 L\xe0m s\u1ea1ch Dock s\u1ea1c v\xe0 C\u1ea5u ph\u1ea7n \u0110\u1ed5 \u0111\u1ea7y & Tho\xe1t n\u01b0\u1edbc",water_updown_self_clean_desc:"R\u1eeda s\u1ea1ch b\u1ec3 l\xe0m s\u1ea1ch tr\u1ea1m c\u01a1 s\u1edf v\xe0 b\u1ec3 ch\u1ee9a n\u01b0\u1edbc th\u1ea3i t\xedch h\u1ee3p, c\u0169ng c\xf3 th\u1ec3 \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 t\u1ef1 ki\u1ec3m tra c\u1ea5p tho\xe1t n\u01b0\u1edbc.",water_updown_self_clean_button_title:"B\u1eaft \u0111\u1ea7u T\u1ef1 L\xe0m s\u1ea1ch",water_updown_drain_title:"Tho\xe1t n\u01b0\u1edbc C\u1ea5u ph\u1ea7n \u0110\u1ed5 \u0111\u1ea7y & Tho\xe1t n\u01b0\u1edbc",water_updown_drain_desc:"N\u1ebfu b\u1ea1n c\u1ea7n thay th\u1ebf ho\u1eb7c di chuy\u1ec3n tr\u1ea1m g\u1ed1c, n\xf3 c\xf3 th\u1ec3 h\u1ed7 tr\u1ee3 x\u1ea3 h\u1ebft l\u01b0\u1ee3ng n\u01b0\u1edbc c\xf2n l\u1ea1i trong b\u1ec3 ch\u1ee9a n\u01b0\u1edbc th\u1ea3i t\xedch h\u1ee3p.",water_updown_drain_button_title:"B\u1eaft \u0111\u1ea7u Tho\xe1t n\u01b0\u1edbc",water_up_down_setting_item_title:"C\xe0i \u0111\u1eb7t \u0110\u1ed5 \u0111\u1ea7y & Tho\xe1t n\u01b0\u1edbc",water_up_down_setting_item_desc:"R\u1eeda s\u1ea1ch b\u1ec3 l\xe0m s\u1ea1ch c\u1ee7a tr\u1ea1m g\u1ed1c, b\u1ec3 n\xe0y c\u0169ng c\xf3 th\u1ec3 \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 t\u1ef1 ki\u1ec3m tra c\u1ea5p tho\xe1t n\u01b0\u1edbc.",product_info_dock_sn:"S\u1ed1 s\xea-ri Dock s\u1ea1c",product_info_dock_version:"Phi\xean b\u1ea3n Ph\u1ea7n s\u1ee5n Dock s\u1ea1c",error_up_water_title:"L\u1ed7i l\xe0m \u0111\u1ea7y",error_up_water_desc:"Vui l\xf2ng b\u1eadt v\xf2i v\xe0 x\xe1c nh\u1eadn r\u1eb1ng ngu\u1ed3n c\u1ea5p n\u01b0\u1edbc b\xecnh th\u01b0\u1eddng",error_up_water_detail:"Vui l\xf2ng x\xe1c nh\u1eadn xem ngu\u1ed3n c\u1ea5p n\u01b0\u1edbc \u1edf nh\xe0 c\xf3 b\u1ecb t\u1eaft hay kh\xf4ng. N\u1ebfu ngu\u1ed3n c\u1ea5p n\u01b0\u1edbc kh\xf4ng t\u1eaft, h\xe3y c\u1eafm v\xe0 r\xfat c\xe1p k\u1ebft n\u1ed1i c\u1ee7a b\u1ed9 c\u1ea5p tho\xe1t n\u01b0\u1edbc m\xe0 v\u1eabn kh\xf4ng th\u1ec3 ng\u1eaft \u0111\u01b0\u1ee3c. Vui l\xf2ng li\xean h\u1ec7 v\u1edbi b\u1ed9 ph\u1eadn t\u01b0 v\u1ea5n sau b\xe1n h\xe0ng.",error_drain_water_title:"L\u1ed7i tho\xe1t n\u01b0\u1edbc",error_drain_water_desc:"Vui l\xf2ng ki\u1ec3m tra v\u1eadt l\u1ea1 trong \u1ed1ng tho\xe1t n\u01b0\u1edbc",error_drain_water_detail:"Vui l\xf2ng l\xe0m s\u1ea1ch v\u1eadt l\u1ea1 \u1edf mi\u1ec7ng \u1ed1ng tho\xe1t n\u01b0\u1edbc. N\u1ebfu v\u1eabn kh\xf4ng th\u1ec3 lo\u1ea1i b\u1ecf \u0111\u01b0\u1ee3c, vui l\xf2ng li\xean h\u1ec7 b\u1ed9 ph\u1eadn t\u01b0 v\u1ea5n sau b\xe1n h\xe0ng.",error_clean_carousel_unsetuped_title:"Vui l\xf2ng ki\u1ec3m tra b\xecnh l\xe0m s\u1ea1ch.",error_clean_carousel_unsetuped_desc:"L\u1eafp r\xe1p l\u1ea1i b\xecnh l\xe0m s\u1ea1ch.",error_clean_carousel_unsetuped_detail:"1. X\xe1c nh\u1eadn r\u1eb1ng khay l\xe0m s\u1ea1ch \u0111\xe3 \u0111\u01b0\u1ee3c l\u1eafp \u0111\u1eb7t \u0111\xfang v\u1ecb tr\xed; 2. Ki\u1ec3m tra xem c\xf3 v\u1eadt l\u1ea1 n\xe0o b\u1ecb k\u1eb9t trong c\u1eeda tho\xe1t n\u01b0\u1edbc c\u1ee7a tr\u1ea1m g\u1ed1c hay kh\xf4ng 3. Vui l\xf2ng x\xe1c nh\u1eadn r\u1eb1ng n\u1eafp tr\xean c\u1ee7a b\u1ec3 ch\u1ee9a n\u01b0\u1edbc th\u1ea3i \u0111\xe3 \u0111\u01b0\u1ee3c g\u1eafn ch\u1eb7t.",error_clean_carousel_water_full_title:"B\xecnh l\xe0m s\u1ea1ch \u0111\u1ea7y.",error_clean_carousel_water_full_desc:"Ki\u1ec3m tra xem c\xf3 v\u1eadt g\xec ch\u1eb7n l\u1ed7 tho\xe1t n\u01b0\u1edbc kh\xf4ng v\xe0 l\u1ea5y ra",error_clean_carousel_water_full_detail:"C\u1eeda tho\xe1t n\u01b0\u1edbc c\u1ee7a tr\u1ea1m g\u1ed1c c\xf3 th\u1ec3 b\u1ecb t\u1eafc, vui l\xf2ng ki\u1ec3m tra v\xe0 l\xe0m s\u1ea1ch n\xf3; n\u1ebfu kh\xf4ng b\u1ecb t\u1eafc, vui l\xf2ng \u0111\u1ea3m b\u1ea3o n\u1eafp tr\xean c\u1ee7a b\u1ec3 ch\u1ee9a n\u01b0\u1edbc th\u1ea3i \u0111\u01b0\u1ee3c \u0111\xf3ng v\xe0 kh\xf3a \u0111\u01b0\u1ee3c bu\u1ed9c ch\u1eb7t.",map_edit_map_unsave:"Vui l\xf2ng l\u01b0u b\u1ea3n \u0111\u1ed3 tr\u01b0\u1edbc khi th\u1eed thao t\xe1c n\xe0y",charger_type_name_special:"Dock s\u1ea1c",valley_electricity_not_set_hint:"* Kh\xf4ng \u0111\u1eb7t th\u1eddi gian s\u1ea1c. S\u1ea1c ngo\xe0i gi\u1edd cao \u0111i\u1ec3m kh\xf4ng ho\u1ea1t \u0111\u1ed9ng.",dock_kit_setting0:"5 gi\u1edd",washing_mode_updown_water_selfcleaning:"T\u1ef1 l\xe0m s\u1ea1ch",washing_mode_updown_water_drain:"\u0110ang tho\xe1t n\u01b0\u1edbc c\u1ea5u ph\u1ea7n \u0111\u1ed5 \u0111\u1ea7y & tho\xe1t n\u01b0\u1edbc",wash_towel_mode_title_4:"C\u1ef1c S\xe2u",wash_towel_mode_desc_4:"Th\xedch h\u1ee3p cho c\xe1c t\xecnh hu\u1ed1ng c\u1ea5p tho\xe1t n\u01b0\u1edbc \u0111\u01b0\u1ee3c l\u1eafp \u0111\u1eb7t, v\u1ea3i gi\u1eb7t s\u1ea1ch h\u01a1n",dock_panel_function_section_title:"\u0110i\u1ec1u khi\u1ec3n Dock s\u1ea1c",dock_info_clear_water_box_title:"B\xecnh ch\u1ee9a N\u01b0\u1edbc S\u1ea1ch",dock_info_clear_water_box_exception1:"H\u1ebft n\u01b0\u1edbc",dock_info_dirty_water_box_title:"B\xecnh ch\u1ee9a N\u01b0\u1edbc B\u1ea9n",dock_info_dirty_water_box_exception1:"\u0110\u1ea7y/Ch\u01b0a l\u1eafp \u0111\u1eb7t",dock_info_clean_fluid_title:"B\xecnh ch\u1ee9a ch\u1ea5t l\xe0m s\u1ea1ch",dock_info_clean_fluid_exception:"\xcdt n\u01b0\u1edbc lau",dock_info_water_box_filter_title:"l\u01b0\u1edbi l\u1ecdc b\u1ed3n r\u1eeda",dock_info_item_gone_exception:"Ch\u01b0a l\u1eafp r\xe1p",dock_info_dust_bag_exception:"\u0110\u1ea7y",toast_clean_then_mop_24hour:"N\xean qu\xe9t s\xe0n tr\u01b0\u1edbc r\u1ed3i m\u1edbi lau \u0111\u1ec3 tr\xe1nh \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn hi\u1ec7u qu\u1ea3 l\xe0m s\u1ea1ch khi c\xf3 nhi\u1ec1u b\u1ee5i.",cliff_zones_save_failed:"Kh\xf4ng th\u1ec3 l\u01b0u khu v\u1ef1c c\u1ea5m l\xe0 v\xe1ch ng\u0103n",inner_error_desc_151:"L\u1ed7i qu\u1ea1t s\u1ea5y",inner_error_desc_152:"\u0110\u1ed5 \u0111\u1ea7y & Tho\xe1t n\u01b0\u1edbc-l\u1ed7i b\u01a1m x\u1ea3 n\u01b0\u1edbc",inner_error_desc_153:"\u0110\u1ed5 \u0111\u1ea7y & Tho\xe1t n\u01b0\u1edbc-l\u1ed7i c\u1ea3m bi\u1ebfn Hall cho van \u0111i\u1ec7n t\u1eed c\u1ea5p n\u01b0\u1edbc/m\u1ef1c n\u01b0\u1edbc s\u1ea1ch",inner_error_desc_154:"L\u1ed7i ch\u1ed5i b\xean",inner_error_desc_158:"\u0110\u1ed5 \u0111\u1ea7y & Tho\xe1t n\u01b0\u1edbc-l\u1ed7i c\u1ea3m bi\u1ebfn Hall cho m\u1ef1c n\u01b0\u1edbc b\u1ea9n",inner_error_desc_159:"L\u1ed7i c\u1ea5p tho\xe1t n\u01b0\u1edbc - truy\u1ec1n th\xf4ng tin",map_edit_furniture_floor_mirror:"G\u01b0\u01a1ng \u0111\u1ec3 S\xe0n",map_edit_split_too_small:"Di\u1ec7n t\xedch ph\xf2ng qu\xe1 nh\u1ecf, kh\xf4ng n\xean ph\xe2n chia ph\xf2ng.",setting_auto_avoid_obstacle_title:"Tr\xe1nh ch\u01b0\u1edbng ng\u1ea1i v\u1eadt ",setting_auto_avoid_obstacle_desc:"C\u1ea5u tr\xfac ph\u1ea1m vi ho\u1ea1t \u0111\u1ed9ng \xe1nh s\xe1ng, h\u1ed7 tr\u1ee3 t\u1ed5ng h\u1ee3p \u0111a c\u1ea3m bi\u1ebfn, tr\xe1nh ch\u01b0\u1edbng ng\u1ea1i v\u1eadt th\xf4ng minh",error_water_carriage_drop_title:"\u0110\u1ebf g\u1eafn gi\u1ebb lau b\u1ecb r\u01a1i. ",error_water_carriage_drop_desc:"Vui l\xf2ng l\u1eafp l\u1ea1i \u0111\u1ec3 robot ti\u1ebfp t\u1ee5c ho\u1ea1t \u0111\u1ed9ng.",error_water_carriage_drop_detail:"\u0110\u1ebf g\u1eafn gi\u1ebb lau b\u1ecb r\u01a1i, vui l\xf2ng l\u1eafp l\u1ea1i \u0111\u1ec3 robot ti\u1ebfp t\u1ee5c ho\u1ea1t \u0111\u1ed9ng.",supplies_pearl_strainer_name:"H\u1ed9p \u0111\u1ef1ng n\u01b0\u1edbc s\u1ea1ch",supplies_pearl_strainer_description:"T\u1ea5m l\xe0m s\u1ea1ch d\xf9ng \u0111\u1ec3 l\u1ecdc nh\u1eefng m\u1ea3nh r\xe1c l\u1edbn c\xf3 trong n\u01b0\u1edbc th\u1ea3i khi lau c\xe2y lau nh\xe0, tr\xe1nh l\xe0m t\u1eafc \u1ed1ng n\u01b0\u1edbc th\u1ea3i khi\u1ebfn b\u1ec3 ch\u1ee9a n\u01b0\u1edbc th\u1ea3i b\u01a1m k\xe9m. N\xean r\u1eeda s\u1ea1ch b\u1eb1ng n\u01b0\u1edbc s\u1ea1ch m\u1ed7i th\xe1ng m\u1ed9t l\u1ea7n ho\u1eb7c \xedt h\u01a1n",alert_pause_current_task_then_selfclean:"C\xf3 n\xean k\u1ebft th\xfac t\xe1c v\u1ee5 hi\u1ec7n t\u1ea1i v\xe0 b\u1eaft \u0111\u1ea7u t\u1ef1 d\u1ecdn d\u1eb9p hay kh\xf4ng",alert_pause_current_task_then_drain:"T\xe1c v\u1ee5 hi\u1ec7n t\u1ea1i ch\u01b0a ho\xe0n t\u1ea5t, vui l\xf2ng \u0111\u1ee3i k\u1ebft th\xfac t\xe1c v\u1ee5 hi\u1ec7n t\u1ea1i \u0111\u1ec3 s\u1eed d\u1ee5ng ch\u1ee9c n\u0103ng n\xe0y",close_auto_dry_alert_desc:"T\u1ef1 \u0111\u1ed9ng s\u1ea5y kh\xf4 c\xf3 th\u1ec3 gi\u1ea3m thi\u1ec3u m\xf9i h\xf4i do c\xe2y lau nh\xe0 t\u1ea1o ra. X\xe1c nh\u1eadn \u0111\u1ec3 t\u1eaft.",drain_left_water_tip1:"Vui l\xf2ng \u0111\u1eb7t m\xe1y ch\u1ee7 v\xe0o \u0111\u1ebf, ti\u1ebfp t\u1ee5c s\u1ea1c, ki\u1ec3m tra v\xe0 x\xe1c nh\u1eadn r\u1eb1ng b\xecnh ch\u1ee9a n\u01b0\u1edbc th\u1ea3i (ho\u1eb7c b\u1ed9 c\u1ea5p tho\xe1t n\u01b0\u1edbc) v\xe0 khay v\u1ec7 sinh \u0111\xe3 \u0111\u01b0\u1ee3c l\u1eafp v\xe0o \u0111\xfang v\u1ecb tr\xed, \u0111\u1ed3ng th\u1eddi th\xe1o gi\xe1 \u0111\u1ee1 c\xe2y lau nh\xe0",drain_left_water_tip2:"2. Nh\u1ea5n \"B\u1eaft \u0111\u1ea7u x\u1ea3 s\u1ea1ch l\u01b0\u1ee3ng n\u01b0\u1edbc c\xf2n l\u1ea1i\" v\xe0 ch\u1edd qu\xe1 tr\xecnh t\u1ef1 \u0111\u1ed9ng ho\xe0n th\xe0nh;",drain_left_water_tip3:"S\u1ebd m\u1ea5t kho\u1ea3ng 5-10 ph\xfat. Vui l\xf2ng ki\xean nh\u1eabn ch\u1edd \u0111\u1ee3i v\xe0 kh\xf4ng di chuy\u1ec3n robot v\xe0 \u0111\u1ebf s\u1ea1c.",drain_left_water_tip4:"Robot th\xf4ng b\xe1o r\u1eb1ng vi\u1ec7c tho\xe1t n\u01b0\u1edbc \u0111\xe3 ho\xe0n t\u1ea5t, cho bi\u1ebft l\u01b0\u1ee3ng n\u01b0\u1edbc d\u01b0 \u0111\xe3 \u0111\u01b0\u1ee3c x\u1ea3 h\u1ebft. Vui l\xf2ng \u0111\u1ed5 n\u01b0\u1edbc th\u1ea3i v\xe0o b\u1ec3 ch\u1ee9a n\u01b0\u1edbc th\u1ea3i (ho\u1eb7c b\u1ed9 c\u1ea5p n\u01b0\u1edbc v\xe0 tho\xe1t n\u01b0\u1edbc).",drain_left_water_title:"T\u1ef1 \u0111\u1ed9ng x\u1ea3 s\u1ea1ch l\u01b0\u1ee3ng n\u01b0\u1edbc c\xf2n l\u1ea1i",left_water_is_draining:"Robot \u0111ang tho\xe1t n\u01b0\u1edbc",start_drain_left_water:"B\u1eaft \u0111\u1ea7u x\u1ea3 s\u1ea1ch l\u01b0\u1ee3ng n\u01b0\u1edbc c\xf2n l\u1ea1i",left_water_drain_page_title:"Ch\u1ebf \u0111\u1ed9 H\u1ed7 tr\u1ee3 kh\xe1ch h\xe0ng",inner_error_desc_128:"M\xf4-\u0111un lau b\u1ecb \u0111o\u1ea3n m\u1ea1ch.",inner_error_desc_129:"M\xf4-\u0111un lau \u0111\xe3 b\u1ecb ng\u1eaft k\u1ebft n\u1ed1i.",setting_carpet_first_switch_title:"L\xe0m s\u1ea1ch th\u1ea3m tr\u01b0\u1edbc",setting_carpet_first_switch_desc:"Robot qu\xe9t th\u1ea3m tr\u01b0\u1edbc m\xe0 kh\xf4ng l\xe0m \u01b0\u1edbt c\xe2y lau nh\xe0, sau \u0111\xf3 s\u1ebd l\xe0m s\u1ea1ch c\xe1c khu v\u1ef1c kh\xe1c sau khi qu\xe9t xong. *Ngo\u1ea1i tr\u1eeb th\u1ea3m s\xe0n nh\u1ecf.",skip_current_cleanarea_buttontitle:"B\u1ecf qua khu v\u1ef1c hi\u1ec7n t\u1ea1i",pearl_supplies_strainer_reset_content:"R\u1eeda b\xecnh l\xe0m s\u1ea1ch. R\u1ed3i ch\u1ee9?",setting_back_wash_interval:"${minute} ph\xfat",inner_error_desc_156:"L\u1ed7i ODD Dock s\u1ea1c",robot_is_warm_up_tip_try:"Thi\u1ebft b\u1ecb \u0111ang \u0111\u01b0\u1ee3c chu\u1ea9n b\u1ecb. Vui l\xf2ng th\u1eed l\u1ea1i sau",localization_strings_Main_MainPage_12:"Kh\xf4i ph\u1ee5c",unsave_map_alert_mess:"B\u1ea3n c\u1eadp nh\u1eadt b\u1ea3n \u0111\u1ed3 s\u1ea1ch n\xe0y \u0111\xe3 thay \u0111\u1ed5i r\u1ea5t nhi\u1ec1u. B\u1ea1n c\xf3 mu\u1ed1n kh\xf4i ph\u1ee5c b\u1ea3n \u0111\u1ed3 \u0111\xe3 l\u01b0u g\u1ea7n \u0111\xe2y nh\u1ea5t kh\xf4ng?",unsave_map_alert_chargeroffset:"C\xf3 s\u1ef1 nghi ng\u1edd r\u1eb1ng b\u1ea3n \u0111\u1ed3 \u0111\xe3 thay \u0111\u1ed5i trong qu\xe1 tr\xecnh d\u1ecdn d\u1eb9p n\xe0y. B\u1ea1n c\xf3 mu\u1ed1n kh\xf4i ph\u1ee5c b\u1ea3n \u0111\u1ed3 \u0111\xe3 l\u01b0u kh\xf4ng?",donot_disturb_same_time_warning:"Th\u1eddi gian b\u1eaft \u0111\u1ea7u v\xe0 k\u1ebft th\xfac gi\u1ed1ng nhau. Vui l\xf2ng \u0111i\u1ec1u ch\u1ec9nh.",add_supplement_area_buttontitle:"Th\xeam khu v\u1ef1c d\u1ecdn d\u1eb9p",goto_supplememt_cleanarea_title:"Th\u1ef1c hi\u1ec7n L\xe0m s\u1ea1ch b\u1ed5 sung",home_page_pearl_supplies_strainer_upgrade_tip:"B\u1ec3 l\xe0m s\u1ea1ch kh\xf4ng \u0111\u01b0\u1ee3c l\xe0m s\u1ea1ch trong m\u1ed9t th\u1eddi gian d\xe0i. H\xe3y l\xe0m s\u1ea1ch n\xf3.",pearl_slow_mop_guide_title:"L\xe0m s\u1ea1ch s\xe2u c\xe1c g\xf3c v\xe0 t\u1ea1m bi\u1ec7t c\xe1c v\u1ebft b\u1ea9n c\u1ee9ng \u0111\u1ea7u",pearl_slow_mop_guide_detail:"Robot s\u1eed d\u1ee5ng \u0111\u01b0\u1eddng \u0111i h\xecnh c\xe1nh cung d\xe0y \u0111\u1eb7c h\u01a1n v\xe0 gi\u1ea3m t\u1ed1c \u0111\u1ed9 di chuy\u1ec3n, xo\u1eafn th\xe2n \u0111\u1ec3 c\u1ea3i thi\u1ec7n hi\u1ec7u qu\u1ea3 x\xf3a c\xe1c v\u1ebft b\u1ea9n n\u1eb7ng. N\xf3 ch\u1ec9 ph\xf9 h\u1ee3p v\u1edbi s\xe0n nh\xe0 sau khi qu\xe9t.",floor_map_name_no_emoji:"T\xean kh\xf4ng \u0111\u01b0\u1ee3c ch\u1ee9a bi\u1ec3u t\u01b0\u1ee3ng c\u1ea3m x\xfac.",smart_scene_sort:"S\u1eafp x\u1ebfp",supplement_zone_hint_view_title:"Th\u1ef1c hi\u1ec7n L\xe0m s\u