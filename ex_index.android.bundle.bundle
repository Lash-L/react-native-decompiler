b0u.",robot_status_quick_building_map:"Thi\u1ebft l\u1eadp b\u1ea3n \u0111\u1ed3",map_edit_mode_smart_tip_detail:"C\xe0i \u0111\u1eb7t lo\u1ea1i ph\xf2ng tr\u01b0\u1edbc. Nh\u1ea5n v\xe0o \"OK\" \u0111\u1ec3 \u0111\u1ebfn C\xe0i \u0111\u1eb7t.",map_edit_order_smart_tip:"T\u1ef1 \u0111\u1ed9ng thi\u1ebft l\u1eadp tr\xecnh t\u1ef1 l\xe0m s\u1ea1ch ph\xf2ng theo lo\u1ea1i ph\xf2ng.",multi_map_start_build_text_4:"4.\u0110\u1ec3 kh\xe1m ph\xe1 nhi\u1ec1u khu v\u1ef1c h\u01a1n robot s\u1ebd nh\u1ea5c c\xe2y lau nh\xe0 m\xe0 kh\xf4ng tr\xe1nh th\u1ea3m",led_status_detail1:"Robot b\u1eadt ngu\u1ed3n s\xe1ng ph\u1ee5 trong m\xf4i tr\u01b0\u1eddng t\u1ed1i \u0111\u1ec3 c\u1ea3i thi\u1ec7n kh\u1ea3 n\u0103ng nh\u1eadn di\u1ec7n.",led_status_title2:"T\u1ef1 \u0111\u1ed9ng",led_status_title1:"\u0110\xe8n h\u1ed7 tr\u1ee3 t\u1ea7m nh\xecn ban \u0111\xeam",map_object_desc_general1:"X\xe1c \u0111\u1ecbnh v\xe0 tr\xe1nh nh\u1eefng ch\u01b0\u1edbng ng\u1ea1i v\u1eadt c\xf3 th\u1ec3 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn c\xf4ng vi\u1ec7c c\u1ee7a robot ",quick_build_map_start:"L\u1eadp b\u1ea3n \u0111\u1ed3 nhanh",map_edit_zone_tag_toilet:"Ph\xf2ng t\u1eafm",map_edit_zone_tag_kitchen:"Ph\xf2ng b\u1ebfp",map_edit_zone_tag_diningroom:"Ph\xf2ng \u0103n",map_edit_zone_tag_study:"Ph\xf2ng \u0111\u1ecdc s\xe1ch",map_edit_zone_tag_vestibule:"H\xe0nh lang",map_edit_zone_tag_balcony:"Ban c\xf4ng",map_edit_zone_tag_livingroom:"Ph\xf2ng kh\xe1ch",map_edit_zone_tag_geustbedroom:"Ph\xf2ng ng\u1ee7 cho kh\xe1ch",map_edit_zone_tag_masterbedroom:"Ph\xf2ng ng\u1ee7 ch\xednh",map_edit_zone_tag_bedroom:"Ph\xf2ng ng\u1ee7",map_edit_zone_select_tag:"Vui l\xf2ng ch\u1ecdn lo\u1ea1i ph\xf2ng",set_timer_without_time_tip:"Kh\xf4ng c\xf3 l\u1ecbch tr\xecnh \u0111\u01b0\u1ee3c thi\u1ebft l\u1eadp",start_clean_roller_without_waterbox_carriage_tip:"Gi\xe1 \u0111\u1ee1 gi\u1ebb lau kh\xf4ng \u0111\u01b0\u1ee3c l\u1eafp \u0111\u1eb7t. Kh\xf4ng th\u1ec3 gi\u1eb7t gi\u1ebb lau.",start_clean_roller_without_waterbox_tip:"B\xecnh ch\u1ee9a n\u01b0\u1edbc c\u1ee7a m\xe1y ch\u1ee7 ch\u01b0a \u0111\u01b0\u1ee3c l\u1eafp \u0111\u1eb7t v\xe0 kh\xf4ng th\u1ec3 b\u1ed5 sung n\u01b0\u1edbc.",carpet_clean_mode_setting_title4:"N\xe2ng N\u0103ng \u0110\u1ed9ng",monitor_page_video_end:"\u0111\u1ed1i ph\u01b0\u01a1ng t\u1eaft m\xe1y th\xec video tr\u1ef1c ti\u1ebfp c\u0169ng s\u1ebd k\u1ebft th\xfac",back_dock_to_wash_alert_tip:"Sau khi gi\u1eb7t gi\u1ebb lau, robot s\u1ebd ti\u1ebfp t\u1ee5c lau s\xe0n t\u1eeb v\u1ecb tr\xed b\u1ecb b\u1ecf d\u1edf.",terminate_current_task_wash_then_back_dock:"K\u1ebft th\xfac v\xe0 gi\u1eb7t gi\u1ebb \u0111\u1ec3 s\u1ea1c",terminate_current_task_back_dock:"K\u1ebft th\xfac v\xe0 quay tr\u1edf v\u1ec1 tr\u1ea1m s\u1ea1c",terminate_current_task_back_dock_tip:"Quay tr\u1edf l\u1ea1i b\u1ebfn t\xe0u",back_wash_desc3:"Qu\xe1 tr\xecnh r\u1eeda ng\u01b0\u1ee3c c\xe2y lau nh\xe0 b\u1ecb \u1ea3nh h\u01b0\u1edfng b\u1edfi m\u1ee9c \u0111\u1ed9 b\u1ee5i b\u1ea9n tr\xean s\xe0n, m\xf4i tr\u01b0\u1eddng th\u1ea3m, l\u1ed9 tr\xecnh \u01b0u ti\xean,... Robot t\u1ef1 \u0111\u1ed9ng \u0111i\u1ec1u ch\u1ec9nh th\u1eddi gian r\u1eeda ng\u01b0\u1ee3c d\u1ef1a tr\xean th\u1eddi gian lau th\u1ef1c t\u1ebf v\xe0 th\u1eddi gian lau c\xf2n l\u1ea1i \u01b0\u1edbc t\xednh",back_wash_desc2:"Robot tr\u1edf l\u1ea1i \u0111\u1ec3 gi\u1eb7t gi\u1ebb lau sau khi l\xe0m s\u1ea1ch t\u1eebng ph\xf2ng \u0111\u1ec3 tr\xe1nh t\xecnh tr\u1ea1ng l\xe0m b\u1ea9n ch\xe9o gi\u1eefa c\xe1c ph\xf2ng. N\u1ebfu ph\xf2ng r\u1ed9ng th\xec t\u1ea7n su\u1ea5t gi\u1eb7t gi\u1ebb lau s\u1ebd nhi\u1ec1u h\u01a1n. N\u1ebfu ph\xf2ng qu\xe1 nh\u1ecf th\xec g\u1ed9p l\u1ea7n gi\u1eb7t gi\u1ebb lau n\xe0y v\xe0o t\xe1c v\u1ee5 gi\u1eb7t gi\u1ebb lau k\u1ebf ti\u1ebfp.",new_firmware_detected1:"Kh\xe1m ph\xe1 phi\xean b\u1ea3n m\u1edbi, t\u1ed1i \u01b0u h\xf3a tr\u1ea3i nghi\u1ec7m s\u1ea3n ph\u1ea9m v\xe0 \u0111\u1ec1 xu\u1ea5t n\xe2ng c\u1ea5p.",new_firmware_detected:"C\xf3 ph\u1ea7n m\u1ec1m \u0111i\u1ec1u khi\u1ec3n m\u1edbi",map_edit_furniture_toilet:"Ph\xf2ng v\u1ec7 sinh",map_edit_furniture_tea_table:"B\xe0n u\u1ed1ng tr\xe0",map_edit_furniture_tv_cabinet:"Gi\xe1 \u0111\u1ee1 Tivi",map_edit_furniture_dinner_table:"B\u1ed9 b\xe0n \u0103n",map_edit_furniture_double_bed:"Gi\u01b0\u1eddng \u0111\xf4i",map_edit_furniture_single_bed:"Gi\u01b0\u1eddng \u0111\u01a1n",map_edit_furniture_count_tip_miapp:"C\xf3 th\u1ec3 c\xf9ng l\xfac ch\u1ec9nh s\u1eeda t\u1ed1i \u0111a ${max} \u0111\u1ed3 n\u1ed9i th\u1ea5t. L\u01b0u \u0111\u1ec3 ch\u1ec9nh s\u1eeda ${count} \u0111\u1ed3 n\u1ed9t th\u1ea5t kh\xe1c.",map_edit_furniture_max_tip_miapp:"\u0110\xe3 \u0111\u1ea1t \u0111\u1ebfn gi\u1edbi h\u1ea1n ch\u1ec9nh s\u1eeda. L\u01b0u c\xe1c ch\u1ec9nh s\u1eeda hi\u1ec7n t\u1ea1i \u0111\u1ec3 ti\u1ebfp t\u1ee5c.",mode_setting_panel_custom_water_box_7:"Y\u1ebfu",mode_setting_panel_custom_water_box_6:"Th\u1ea5p",localization_strings_Main_Constants_127:"Vui l\xf2ng r\xfat ngu\u1ed3n \u0111i\u1ec7n v\xe0 th\u1eed l\u1ea1i",localization_strings_Main_Constants_126:"Ph\xe1t hi\u1ec7n b\u1ea5t th\u01b0\u1eddng b\xean trong \u0111\u1ebf, h\xe3y c\u1eafm v\xe0 r\xfat ngu\u1ed3n \u0111i\u1ec7n v\xe0 th\u1eed l\u1ea1i.",inner_error_desc_150:"L\u1ed7i van \u0111i\u1ec7n t\u1eeb",inner_error_desc_134:"L\u1ed7i c\xf4ng t\u1eafc m\xe1y b\u01a1m kh\xed",inner_error_desc_131:"Qu\xe1 d\xf2ng m\xe1y b\u01a1m nhu \u0111\u1ed9ng b\xecnh ch\u1ee9a n\u01b0\u1edbc s\u1ea1ch",inner_error_desc_130:"Kh\xf4ng c\xf3 d\u1eef li\u1ec7u t\u1eeb m\xe1y b\u01a1m nhu \u0111\u1ed9ng b\xecnh ch\u1ee9a n\u01b0\u1edbc s\u1ea1ch ODO",inner_error_desc_127:"L\u1ed7i tr\u1ea1m s\u1ea1c IIC",inner_error_desc_126:"L\u1ed7i qu\u1ea1t h\xfat b\u1ee5i",sound_package_download_failed:"T\u1ea3i gi\u1ecdng n\xf3i kh\xf4ng th\xe0nh c\xf4ng, vui l\xf2ng ki\u1ec3m tra k\u1ebft n\u1ed1i m\u1ea1ng",camera_setting_detail5:"T\xedch c\u1ef1c nh\u1eadn bi\u1ebft m\xf4i tr\u01b0\u1eddng trong nh\xe0 v\xe0 x\xe1c \u0111\u1ecbnh m\u1ed9t s\u1ed1 lo\u1ea1i s\xe0n nh\xe0 v\xe0 \u0111\u1ed3 \u0111\u1ea1c. *K\u1ebft qu\u1ea3 nh\u1eadn di\u1ec7n t\xf9y thu\u1ed9c v\xe0o \xe1nh s\xe1ng v\xe0 g\xf3c \u0111\u1ed9 v\xe0 ch\u1ec9 mang t\xednh tham kh\u1ea3o.",camera_setting_detail4:"Nh\u1eadn di\u1ec7n M\xf4i tr\u01b0\u1eddng AI",camera_setting_detail3:"Trong qu\xe1 tr\xecnh l\xe0m vi\u1ec7c c\u1ee7a robot, AI s\u1ebd x\xe1c \u0111\u1ecbnh v\xe0 tr\xe1nh c\xe1c ch\u01b0\u1edbng ng\u1ea1i v\u1eadt tr\xean m\u1eb7t \u0111\u1ea5t m\u1ed9t c\xe1ch th\xf4ng minh \u0111\u1ec3 gi\u1ea3m t\xecnh tr\u1ea1ng m\u1eafc k\u1eb9t.",camera_setting_detail2:"AI nh\u1eadn d\u1ea1ng v\xe0 tr\xe1nh ch\u01b0\u1edbng ng\u1ea1i v\u1eadt",camera_setting_detail1:"T\u1eaft video tr\u1ef1c ti\u1ebfp",smart_scene_firmware_zone_reach_max_count:"\u0110\xe3 \u0111\u1ea1t \u0111\u1ebfn s\u1ed1 l\u01b0\u1ee3ng ph\xf2ng t\u1ed1i \u0111a",map_edit_mode_smart_tip:"T\u1ef1 \u0111\u1ed9ng \u0111\u1eb7t ch\u1ebf \u0111\u1ed9 l\xe0m s\u1ea1ch theo lo\u1ea1i m\u1eb7t s\xe0n v\xe0 lo\u1ea1i ph\xf2ng.",map_edit_mode_smart:"Th\xf4ng minh",map_edit_floor_other:"M\u1eb7c \u0111\u1ecbnh",map_edit_floor_wood:"s\xe0n nh\xe0",map_edit_floor_tile:"g\u1ea1ch men",map_edit_floor_select_segment_tip:"Ch\u1ecdn m\u1ed9t khu v\u1ef1c \u0111\u1ec3 thi\u1ebft l\u1eadp s\xe0n",map_edit_floor:"Lo\u1ea1i S\xe0n",back_wash_desc1:"T\u1ef1 \u0111\u1ed9ng \u0111i\u1ec1u ch\u1ec9nh kho\u1ea3ng th\u1eddi gian gi\u1eb7t theo th\u1eddi gian \u0111\xe3 \u0111\u1eb7t v\xe0 t\u1ef1 \u0111\u1ed9ng gi\u1eb7t c\xe2y lau nh\xe0.",map_edit_furniture_title:"s\u1eafp x\u1ebfp \u0111\u1ed3 \u0111\u1ea1c",dust_collection_life14:"l\u1ea7n",dust_collection_life13:"Tr\u1ea1ng th\xe1i:  ${state}",dust_collection_life12:"C\u1ea7n ph\u1ea3i l\xe0m s\u1ea1ch",dust_collection_life11:"N\xean l\xe0m s\u1ea1ch",dust_collection_life10:"B\xecnh th\u01b0\u1eddng",smart_scene_global_no_map_tip:"Kh\xf4ng c\xf3 s\u1eb5n b\u1ea3n \u0111\u1ed3. Vui l\xf2ng t\u1ea1o b\u1ea3n \u0111\u1ed3 tr\u01b0\u1edbc.",screen_recording8:"Vui l\xf2ng c\u1ea5p quy\u1ec1n \u0111\u1ecdc v\xe0 ghi \u1ea3nh cho \u1ee8ng d\u1ee5ng trong c\xe0i \u0111\u1eb7t h\u1ec7 th\u1ed1ng \u0111i\u1ec7n tho\u1ea1i.",screen_recording7:"Kh\xf4ng th\u1ec3 truy c\u1eadp album.",screen_recording6:"Dung l\u01b0\u1ee3ng \u0111i\u1ec7n tho\u1ea1i kh\xf4ng \u0111\u1ee7, n\u1ed9i dung c\xf3 th\u1ec3 m\u1ea5t",screen_recording5:"Ch\u1ee5p m\xe0n h\xecnh th\u1ea5t b\u1ea1i.",screen_recording4:"Ch\u1ee5p \u1ea3nh m\xe0n h\xecnh th\xe0nh c\xf4ng.",screen_recording3:"K\u1ebft th\xfac ghi.",screen_recording2:"Qu\xe1 tr\xecnh ghi th\u1ea5t b\u1ea1i.",screen_recording1:"B\u1eaft \u0111\u1ea7u ghi.",dust_collection_life9:"D\u1ef1 ki\u1ebfn d\u1ecdn d\u1eb9p sau ${time} l\u1ea7n",dust_collection_life8:"T\xfai thu gom b\u1ee5i dung t\xedch l\u1edbn \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 thu gom r\xe1c trong h\u1ed9p ch\u1ee9a b\u1ee5i c\u1ee7a th\xe2n m\xe1y bay. Kh\xf4ng c\u1ea7n ph\u1ea3i th\u01b0\u1eddng xuy\xean \u0111\u1ed5 b\u1ee5i theo c\xe1ch th\u1ee7 c\xf4ng, s\u1ea1ch s\u1ebd v\xe0 kh\xf4ng c\u1ea7n lo l\u1eafng. \u0110\u1ec3 c\xf3 tr\u1ea3i nghi\u1ec7m v\u1ec7 sinh t\u1ed1t nh\u1ea5t, b\u1ea1n n\xean thay t\xfai ch\u1ee9a b\u1ee5i khi c\u1ea7n thi\u1ebft v\xe0 v\u1ec7 sinh th\xf9ng ch\u1ee9a b\u1ee5i m\u1ed7i th\xe1ng m\u1ed9t l\u1ea7n.",dust_collection_life5:"T\xfai \u0111\u1ef1ng b\u1ee5i",dust_collection_life4:"\u0110\u1ebf s\u1ea1c v\xe0 thu gom b\u1ee5i t\u1ef1 \u0111\u1ed9ng Roborock s\u1eed d\u1ee5ng b\u1ed9 t\xe1ch l\u1ed1c xo\xe1y m\u1ea1nh m\u1ebd 15 h\xecnh n\xf3n \u0111\u1ec3 n\xe9m b\u1ee5i v\xe0o th\xf9ng ch\u1ee9a b\u1ee5i. N\xf3 c\xf3 th\u1ec3 l\xe0m s\u1ea1ch b\u1ee5i ch\u1ec9 b\u1eb1ng m\u1ed9t c\xfa nh\u1ea5p chu\u1ed9t m\xe0 kh\xf4ng c\u1ea7n v\u1eadt t\u01b0 ti\xeau hao v\xe0 lu\xf4n duy tr\xec l\u1ef1c h\xfat h\xfat b\u1ee5i m\u1ea1nh. N\xean v\u1ec7 sinh dung t\xedch c\u1ef1c l\u1edbn 1,5L t\u1eeb 1 \u0111\u1ebfn 2 th\xe1ng m\u1ed9t l\u1ea7n.",dust_collection_life3:"H\u1ed9p b\u1ee5i tr\u1ed1ng. \u0110\u1ed3ng \xfd?",dust_collection_life2:"\u0110\xe3 \u0111\u1ebfn l\xfac l\xe0m tr\u1ed1ng h\u1ed9p b\u1ee5i.",dust_collection_life1:"H\u1ed9p b\u1ee5i",smart_scene_global_title:"L\u1eadp quy tr\xecnh",voice_chat_title2:"Kh\xf4ng th\u1ec3 s\u1eed d\u1ee5ng khi \u0111ang g\u1ecdi",voice_chat_title1:"D\u1eebng ghi m\xe0n h\xecnh.",home_page_supplies_cleaning_brush3:"B\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch c\u1ee7a tr\u1ea1m g\u1ed1c b\xe1m v\xe0o b\u1ec1 m\u1eb7t c\xe2y lau nh\xe0 \u1edf t\u1ed1c \u0111\u1ed9 cao v\xe0 quay qua l\u1ea1i \u0111\u1ec3 ch\xe0, lo\u1ea1i b\u1ecf m\u1ea1nh m\u1ebd b\u1ee5i b\u1ea9n tr\xean b\u1ec1 m\u1eb7t c\xe2y lau nh\xe0. Trong qu\xe1 tr\xecnh gi\u1eb7t c\xe2y lau nh\xe0, c\xf3 th\u1ec3 c\xf3 t\xf3c v\u01b0\u1edbng v\xe0 c\xe1c v\u1eadt l\u1ea1 kh\xe1c s\u1ebd \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn hi\u1ec7u qu\u1ea3 gi\u1eb7t c\xe2y lau nh\xe0. N\xean th\xe1o r\u1eddi v\xe0 l\xe0m s\u1ea1ch hai th\xe1ng m\u1ed9t l\u1ea7n.",home_page_supplies_cleaning_brush2:"B\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch \u0111\xe3 \u0111\u01b0\u1ee3c thay th\u1ebf?",home_page_supplies_cleaning_brush1:"b\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch",home_page_supplies_cleaning_brush:"B\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch c\u1ee7a tr\u1ea1m g\u1ed1c \u0111\xe3 l\xe2u kh\xf4ng \u0111\u01b0\u1ee3c l\xe0m s\u1ea1ch. H\xe3y l\xe0m s\u1ea1ch n\xf3.",inner_error_desc_149:"L\u1ed7i \u0111\u1ecbnh v\u1ecb b\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch - b\xean ph\u1ea3i",inner_error_desc_148:"L\u1ed7i \u0111\u1ecbnh v\u1ecb b\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch - \u1edf gi\u1eefa",inner_error_desc_147:"L\u1ed7i \u0111\u1ecbnh v\u1ecb b\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch - b\xean tr\xe1i",inner_error_desc_145:"L\u1ed7i b\u01a1m n\u01b0\u1edbc th\u1ea3i",inner_error_desc_143:"Nhi\u1ec7t \u0111\u1ed9 \u0111\u1ed9ng c\u01a1 b\xe1nh xe b\xean ph\u1ea3i qu\xe1 cao",inner_error_desc_141:"Nhi\u1ec7t \u0111\u1ed9 \u0111\u1ed9ng c\u01a1 b\xe1nh xe b\xean tr\xe1i qu\xe1 cao",mode_setting_panel_custom_water_box_5:"Nh\u1eb9",mode_setting_panel_custom_water_box_4:"Trung b\xecnh",mode_setting_panel_custom_water_box_3:"V\u1eeba",mode_setting_panel_custom_water_box_2:"Cao",mode_setting_panel_custom_water_box_1:"R\u1ea5t cao",robot_is_warm_up_tip:"Kh\u1edfi \u0111\u1ed9ng robot",start_washing_duster_noback_dock:"C\xe2y lau nh\xe0",custom_mode_panel_mop_gear_title:"Ch\u1ebf \u0111\u1ed9 lau nh\xe0",custom_mop_mode_system_wetter_mop:"L\xe0m s\u1ea1ch s\xe2u",mop_mode_setting_page_wash_count:"S\u1ed1 l\u1ea7n gi\u1eb7t gi\u1ebb lau",custom_mode_panel_tab_general:"Ch\u1ebf \u0111\u1ed9 th\xf4ng th\u01b0\u1eddng",custom_mode_panel_more_mode_title:"Xem th\xeam c\xe1c Ch\u1ebf \u0111\u1ed9",error_main_frame_exception_detail:"H\xe3y x\xe1c nh\u1eadn ki\u1ec3m tra xem n\xfat \u0111\u1ecbnh v\u1ecb c\xf3 b\u1ecb k\u1eb9t kh\xf4ng, sau \u0111\xf3 di chuy\u1ec3n robot ra xa kh\u1ecfi dock s\u1ea1c v\xe0 kh\u1edfi \u0111\u1ed9ng l\u1ea1i.",error_main_frame_exception_desc:"H\xe3y ki\u1ec3m tra xem n\xfat \u0111\u1ecbnh v\u1ecb c\xf3 b\u1ecb k\u1eb9t kh\xf4ng, sau \u0111\xf3 di chuy\u1ec3n robot v\xe0 kh\u1edfi \u0111\u1ed9ng l\u1ea1i.",error_main_frame_exception_title:"L\u1ed7i n\xfat \u0111\u1ecbnh v\u1ecb",error_clean_brush_exception_detail:"1. X\xe1c nh\u1eadn r\u1eb1ng b\u1ed9 l\u1ecdc b\u1ec3 l\xe0m s\u1ea1ch \u0111\xe3 \u0111\u01b0\u1ee3c l\u1eafp \u0111\u1eb7t \u0111\xfang ch\u1ed7; 2. Ki\u1ec3m tra xem c\xf3 v\u1eadt l\u1ea1 n\xe0o b\u1ecb k\u1eb9t \u1edf ph\xeda b\xean ph\u1ea3i c\u1ee7a b\u1ec3 l\xe0m s\u1ea1ch hay kh\xf4ng 3. \u0110\u1ea3m b\u1ea3o r\u1eb1ng c\xe2y lau nh\xe0 \u0111\u01b0\u1ee3c l\u1eafp \u0111\u1eb7t ngay ng\u1eafn 4. Ki\u1ec3m tra xem c\xf3 v\u1eadt l\u1ea1 n\xe0o b\u1ecb k\u1eb9t trong b\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch kh\xf4ng",mop_cleaning_time:"Th\u1eddi gian Gi\u1eb7t",robot_start_type_clova:"Clova",next_step:"Ti\u1ebfp theo",cleanout_the_error:"L\u1ed7i Gi\u1eb7t",map_edit_carpet_overlap_tip:"Kh\xf4ng \u0111\u1ec3 th\u1ea3m m\u1edbi ch\u1ed3ng l\xean th\u1ea3m \u0111\xe3 qua s\u1eed d\u1ee5ng",map_edit_carpet_unknown_tip:"Kh\xf4ng \u0111\u1eb7t th\u1ea3m ngo\xe0i khu v\u1ef1c b\u1ea3n \u0111\u1ed3",map_edit_carpet_ignore_edit_tip:"Ch\u1ec9nh s\u1eeda ho\u1eb7c x\xf3a th\u1ea3m b\u1ecb b\u1ecf qua",map_edit_carpet_ignore_tip:"T\xednh n\u0103ng nh\u1eadn di\u1ec7n th\u1ea3m s\u1ebd b\u1ecb v\xf4 hi\u1ec7u h\xf3a trong khu v\u1ef1c b\u1ecb b\u1ecf qua.",map_edit_carpet_add_edit_tip:"Ch\u1ec9nh s\u1eeda ho\u1eb7c x\xf3a th\u1ea3m m\u1edbi",map_edit_carpet_init_tip:"Nh\u1ea5n v\xe0o m\u1ed9t th\u1ea3m \u0111\u1ec3 ch\u1ec9nh s\u1eeda",back_to_the_wash_failure:"Kh\xf4ng th\u1ec3 quay tr\u1edf v\u1ec1 \u0111\u1ebf s\u1ea1c",error_filter_screen_exception_detail:"B\u1ed9 l\u1ecdc b\u1ec3 l\xe0m s\u1ea1ch c\xf3 th\u1ec3 b\u1ecb t\u1eafc, vui l\xf2ng ki\u1ec3m tra v\xe0 l\xe0m s\u1ea1ch n\xf3; n\u1ebfu n\xf3 kh\xf4ng b\u1ecb t\u1eafc, h\xe3y \u0111\u1ea3m b\u1ea3o b\u1ec3 ch\u1ee9a n\u01b0\u1edbc th\u1ea3i \u0111\u01b0\u1ee3c \u0111\u1eady k\xedn v\xe0 kh\xf3a ch\u1eb7t.",error_filter_screen_exception_desc:"Ki\u1ec3m tra v\xe0 l\xe0m s\u1ea1ch b\u1ed9 l\u1ecdc c\u1ee7a b\u1ec3 l\xe0m s\u1ea1ch",error_filter_screen_exception_title:"Ki\u1ec3m tra v\xe0 c\u1ed1 \u0111\u1ecbnh n\u1eafp b\xecnh ch\u1ee9a n\u01b0\u1edbc b\u1ea9n.",supplies_mop_swab_ecu_description:"C\xe2y lau nh\xe0 l\xe0 b\u1ed9 ph\u1eadn lau nh\xe0 ch\xednh c\u1ee7a robot v\xe0 c\xf3 th\u1ec3 lau s\u1ea1ch b\u1ee5i b\u1ea9n tr\xean s\xe0n nh\xe0 m\u1ed9t c\xe1ch hi\u1ec7u qu\u1ea3. Tuy nhi\xean, khi th\u1eddi gian lau nh\xe0 t\u0103ng l\xean, c\xe2y lau nh\xe0 s\u1ebd d\u1ea7n m\xf2n v\xe0 \u0111\u1ec3 l\u1ea1i nh\u1eefng v\u1ebft b\u1ea9n c\u1ee9ng \u0111\u1ea7u, \u0111i\u1ec1u n\xe0y s\u1ebd \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn hi\u1ec7u qu\u1ea3 lau nh\xe0, n\xean thay c\xe2y lau nh\xe0 m\u1edbi khi c\u1ea7n thi\u1ebft.",supplies_mop_swab_sub_desc:"H\xe3y thay th\u1ebf n\u1ebfu c\u1ea7n.",supplies_mop_swab_name:"Gi\u1ebb lau",wash_towel_mode_des_3:"Ph\xf9 h\u1ee3p \u0111\u1ec3 l\xe0m s\u1ea1ch s\xe2u th\u01b0\u1eddng xuy\xean, l\u01b0\u1ee3ng n\u01b0\u1edbc l\xe0m s\u1ea1ch l\u1edbn v\xe0 th\u1eddi gian l\xe0m s\u1ea1ch l\xe2u",wash_towel_mode_des_2:"Th\xedch h\u1ee3p cho m\xf4i tr\u01b0\u1eddng h\xe0ng ng\xe0y, v\u1edbi t\u1ed1c \u0111\u1ed9 v\xe0 hi\u1ec7u qu\u1ea3 l\xe0m s\u1ea1ch c\xe2n b\u1eb1ng nh\u1ea5t.",wash_towel_mode_des_1:"Ph\xf9 h\u1ee3p v\u1edbi c\xe1c m\xf4i tr\u01b0\u1eddng s\u1ea1ch, gi\xfap ti\u1ebft ki\u1ec7m th\u1eddi gian l\xe0m s\u1ea1ch v\xe0 l\u01b0\u1ee3ng n\u01b0\u1edbc ti\xeau th\u1ee5.",back_wash_desc:"T\u1ef1 \u0111\u1ed9ng \u0111i\u1ec1u ch\u1ec9nh kho\u1ea3ng th\u1eddi gian gi\u1eb7t theo th\u1eddi gian \u0111\xe3 \u0111\u1eb7t v\xe0 t\u1ef1 \u0111\u1ed9ng gi\u1eb7t c\xe2y lau nh\xe0.",back_wash_time_setting:"T\u1ea7n su\u1ea5t gi\u1eb7t kh\u0103n lau",robot_start_type_rr_intelligence_scene:"Kh\u1edfi \u0111\u1ed9ng l\u1ec7nh",smart_scene_firmware_will_support_alert_title:"###\u5f53\u524d\u8bbe\u5907\u6682\u4e0d\u652f\u6301\u8be5\u573a\u666f\u529f\u80fd\uff0c\u540e\u7eed\u4f1a\u66f4\u65b0\u4e0a\u7ebf\uff0c\u656c\u8bf7\u671f\u5f85",smart_scene_firmware_update_alert_confirm:"C\u1eadp nh\u1eadt ph\u1ea7n m\u1ec1m \u0111i\u1ec1u khi\u1ec3n",map_edit_rotate_right:"Xoay sang ph\u1ea3i",map_edit_rotate_left:"Xoay sang tr\xe1i",be_on_the_phone:"\u0110ang g\u1ecdi\u2026",click_to_start_call:"Ch\u1ea1m \u0111\u1ec3 b\u1eaft \u0111\u1ea7u cu\u1ed9c g\u1ecdi",click_to_end_call:"Ch\u1ea1m \u0111\u1ec3 k\u1ebft th\xfac cu\u1ed9c g\u1ecdi",voice_package_end_validtime_forever:"D\xe0i h\u1ea1n",rotate_map_rect_warning:"Kh\xf4ng \u0111\u1eb7t c\xe1c khu v\u1ef1c ngo\xe0i gi\u1edbi h\u1ea1n b\u1ea3n \u0111\u1ed3.",home_sepcial_info_airdry_finish_time:"C\xe2y lau nh\xe0 \u0111ang \u0111\u01b0\u1ee3c s\u1ea5y kh\xf4 v\xe0 d\u1ef1 ki\u1ebfn \u200b\u200bs\u1ebd ho\xe0n th\xe0nh sau ${hour} gi\u1edd.",robot_cmd_resume_back_washing:"ti\u1ebfp t\u1ee5c quay tr\u1edf l\u1ea1i",robot_cmd_pause_back_washing:"T\u1ea1m d\u1eebng",delete_new_map_if_switch_map_hint:"B\u1ea3n \u0111\u1ed3 hi\u1ec7n t\u1ea1i ch\u01b0a \u0111\u01b0\u1ee3c l\u01b0u v\xe0 s\u1ebd b\u1ecb x\xf3a sau khi chuy\u1ec3n \u0111\u1ed5i b\u1ea3n \u0111\u1ed3.",setting_section_title_more_info:"Th\xf4ng tin kh\xe1c",setting_section_title_clean_management:"Qu\u1ea3n l\xfd l\xe0m s\u1ea1ch",dust_collection_info_close:"N\xean b\u1eadt t\xednh n\u0103ng h\xfat b\u1ee5i t\u1ef1 \u0111\u1ed9ng \u0111\u1ec3 duy tr\xec hi\u1ec7u qu\u1ea3 h\xfat b\u1ee5i t\u1ed1t h\u01a1n. N\u1ebfu b\u1ea1n t\u1eaft t\xednh n\u0103ng h\xfat b\u1ee5i t\u1ef1 \u0111\u1ed9ng v\xe0 gi\u1ea3m t\u1ea7n su\u1ea5t h\xfat b\u1ee5i th\xec hi\u1ec7u qu\u1ea3 h\xfat b\u1ee5i c\xf3 th\u1ec3 b\u1ecb suy y\u1ebfu.",error_dock_error_title:"L\u1ed7i \u0111\u1ebf s\u1ea1c",home_special_info_timer:"Qu\xe1 tr\xecnh l\xe0m s\u1ea1ch ti\u1ebfp theo s\u1ebd b\u1eaft \u0111\u1ea7u v\xe0o l\xfac ${cleanTime} h\xf4m nay.",start_clean_with_manual_mode_alert_title:"M\xe1y h\xfat b\u1ee5i s\u1ebd ti\u1ebfn h\xe0nh l\xe0m s\u1ea1ch theo ${mapName}. \u0110\u1ea3m b\u1ea3o r\u1eb1ng m\xe1y h\xfat b\u1ee5i n\u1eb1m \u1edf \u0111\xfang v\u1ecb tr\xed.",smart_switch_section_title:"Chuy\u1ec3n \u0111\u1ed5i b\u1ea3n \u0111\u1ed3",manual_switch_tip:"Khi \u1ee9ng d\u1ee5ng kh\u1edfi \u0111\u1ed9ng, b\u1ea1n c\u1ea7n chuy\u1ec3n th\u1ee7 c\xf4ng sang b\u1ea3n \u0111\u1ed3 n\u01a1i \u0111\u1eb7t robot. *C\xe1c ph\u01b0\u01a1ng ph\xe1p kh\xe1c v\u1eabn s\u1ebd cho ph\xe9p nh\u1eadn d\u1ea1ng th\xf4ng minh.",manual_switch_pattern:"L\u1ef1a ch\u1ecdn Th\u1ee7 c\xf4ng",smart_switch_tip:"M\xe1y h\xfat b\u1ee5i \u0111\u1ee7 th\xf4ng minh \u0111\u1ec3 x\xe1c \u0111\u1ecbnh v\u1ecb tr\xed c\u1ee7a m\xecnh v\xe0 t\u1ef1 \u0111\u1ed9ng chuy\u1ec3n \u0111\u1ed5i gi\u1eefa c\xe1c b\u1ea3n \u0111\u1ed3, b\u1ea5t k\u1ec3 m\xe1y \u0111\u01b0\u1ee3c kh\u1edfi \u0111\u1ed9ng theo b\u1ea5t k\u1ef3 c\xe1ch n\xe0o.",smart_switch_pattern:"Nh\u1eadn di\u1ec7n Th\xf4ng minh",map_edit_carpet_zone_exceed_limit:"\u0110\xe3 \u0111\u1ea1t \u0111\u1ebfn s\u1ed1 l\u01b0\u1ee3ng th\u1ea3m t\u1ed1i \u0111a.",map_edit_carpet_add_tip:"Nh\u1ea5n v\xe0o m\u1ed9t th\u1ea3m hi\u1ec7n c\xf3 \u0111\u1ec3 ch\u1ec9nh s\u1eeda ho\u1eb7c x\xf3a.",map_edit_carpet_add_carpet:"Th\xeam Th\u1ea3m",error_clean_brush_exception_desc:"Ki\u1ec3m tra v\xe0 v\u1ec7 sinh modul b\xe0n ch\u1ea3i t\u1ef1 l\xe0m s\u1ea1ch",error_clean_bruch_exception_title:"Ki\u1ec3m tra xem b\u1ed9 l\u1ecdc n\u01b0\u1edbc \u0111\xe3 \u0111\u01b0\u1ee3c l\u1eafp \u0111\xfang c\xe1ch ch\u01b0a.",error_resolved:"\u0110\xe3 \u0111\u01b0\u1ee3c x\u1eed l\xfd",wash_towel_mode_title_3:"s\xe2u",wash_towel_mode_title_2:"C\xe2n b\u1eb1ng",wash_towel_mode_title_1:"Ti\u1ebft ki\u1ec7m n\u01b0\u1edbc",wash_towel_mode_title:"Ch\u1ebf \u0111\u1ed9 Gi\u1eb7t Gi\u1ebb lau",wash_towel_title:"C\xe0i \u0111\u1eb7t ch\u1ebf \u0111\u1ed9 gi\u1eb7t gi\u1ebb",avoid_collision_mode:"Ch\u1ebf \u0111\u1ed9 \xedt va ch\u1ea1m",charged_resume_clean_detail:"Sau khi b\u1eadt ch\u1ebf \u0111\u1ed9 Kh\xf4ng l\xe0m phi\u1ec1n, vui l\xf2ng kh\u1edfi \u0111\u1ed9ng \u0111\u1ec3 ti\u1ebfp t\u1ee5c d\u1ecdn d\u1eb9p.",clean_path_record_palyback:"Xem l\u1ea1i",clean_path_record_speed:"T\u1ed1c \u0111\u1ed9 g\u1ea5p \u0111\xf4i",clean_path_record_play:"Ti\u1ebfp t\u1ee5c xem l\u1ea1i",clean_path_record_pause:"T\u1ea1m d\u1eebng",home_page_supplies_strainer_upgrade_tip:"N\u1ebfu b\u1ed9 l\u1ecdc b\u1ec3 l\xe0m s\u1ea1ch kh\xf4ng \u0111\u01b0\u1ee3c l\xe0m s\u1ea1ch trong m\u1ed9t th\u1eddi gian d\xe0i, h\xe3y l\xe0m s\u1ea1ch n\xf3.",supplies_strainer_description:"B\u1ed9 l\u1ecdc n\u01b0\u1edbc \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 l\u1ecdc c\xe1c m\u1ea3nh r\xe1c l\u1edbn trong n\u01b0\u1edbc th\u1ea3i khi l\xe0m s\u1ea1ch c\xe2y lau nh\xe0, \u0111\u1ec3 tr\xe1nh l\xe0m t\u1eafc ngh\u1ebdn \u0111\u01b0\u1eddng \u1ed1ng n\u01b0\u1edbc th\u1ea3i. Khi th\u1eddi gian l\xe0m vi\u1ec7c t\u0103ng l\xean, b\u1ed9 l\u1ecdc s\u1ebd l\u1eafng \u0111\u1ecdng c\xe1c m\u1ea3nh v\u1ee5n. N\xean r\u1eeda s\u1ea1ch b\u1eb1ng n\u01b0\u1edbc s\u1ea1ch m\u1ed7i th\xe1ng m\u1ed9t l\u1ea7n ho\u1eb7c \xedt h\u01a1n.",supplies_strainer_reset_content:"\u0110\u1ea3m b\u1ea3o r\u1eb1ng b\u1ed9 l\u1ecdc n\u01b0\u1edbc \u0111\xe3 \u0111\u01b0\u1ee3c thay th\u1ebf.",supplies_strainer_name:"B\u1ed9 l\u1ecdc n\u01b0\u1edbc",dust_collection_desc_5:"Th\xedch h\u1ee3p cho c\u0103n h\u1ed9 l\u1edbn ho\u1eb7c m\xf4i tr\u01b0\u1eddng ph\u1ee9c t\u1ea1p h\u01a1n, kh\u1ea3 n\u0103ng h\xfat b\u1ee5i m\u1ea1nh, \u1ed3n \xe0o trong th\u1eddi gian d\xe0i",dust_collection_desc_3:"Ph\xf9 h\u1ee3p v\u1edbi nh\u1eefng c\u0103n nh\xe0 c\u1ee1 trung b\xecnh, c\xe2n b\u1eb1ng gi\u1eefa t\u1ed1c \u0111\u1ed9 l\xe0m tr\u1ed1ng v\xe0 hi\u1ec7u su\u1ea5t.",dust_collection_desc_2:"Ph\xf9 h\u1ee3p v\u1edbi nh\u1eefng m\xf4i tr\u01b0\u1eddng s\u1ea1ch s\u1ebd ho\u1eb7c nh\u1eefng c\u0103n nh\xe0 nh\u1ecf. Trong t\xfai ch\u1ee9a b\u1ee5i s\u1ebd c\xf2n l\u1ea1i m\u1ed9t ch\xfat b\u1ee5i.",dust_collection_desc_1:"T\u1ef1 \u0111\u1ed9ng \u0111i\u1ec1u ch\u1ec9nh th\u1eddi gian \u0111\u1ed5 r\xe1c \u0111\u1ec3 n\xe2ng cao hi\u1ec7u qu\u1ea3 thu gom b\u1ee5i.",dust_collection_desc_title:"Ch\u1ebf \u0111\u1ed9 h\xfat b\u1ee5i",dust_collection_title_5:"T\u1ed1i \u0111a",dust_collection_title_3:"C\xe2n b\u1eb1ng",dust_collection_title_2:"S\u01a1 qua",dust_collection_title_1:"Th\xf4ng minh",dust_collection_setting_title:"C\xe0i \u0111\u1eb7t t\u1ef1 \u0111\u1ed9ng l\xe0m tr\u1ed1ng t\u1ea1i dock s\u1ea1c",too_frequently_collect_dust_toast:"Qu\xe1 tr\xecnh X\u1ea3 s\u1ea1ch Th\u1ee7 c\xf4ng Ho\xe0n t\u1ea5t. Tr\xe1nh vi\u1ec7c x\u1ea3 s\u1ea1ch l\u1eb7p l\u1ea1i.",charger_type_name_normal:"Dock s\u1ea1c",no_disturb_with_dust_collection:"Trong th\u1eddi gian Kh\xf4ng l\xe0m phi\u1ec1n, qu\xe1 tr\xecnh qu\xe9t s\u1ebd kh\xf4ng t\u1ef1 \u0111\u1ed9ng ti\u1ebfp t\u1ee5c, \xe2m l\u01b0\u1ee3ng gi\u1ecdng n\xf3i v\xe0 \u0111\u1ed9