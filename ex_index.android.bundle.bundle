c78\ub808\ub85c \uad50\uccb4\ud558\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.",supplies_mop_swab_sub_desc:"\ud544\uc694\uc5d0 \ub530\ub77c \uad50\uccb4\ud569\ub2c8\ub2e4.",supplies_mop_swab_name:"\ubb3c\uac78\ub808",wash_towel_mode_des_3:"\ubb3c \uc18c\ube44\ub7c9\uc774 \ub9ce\uace0 \uccad\uc18c \uc2dc\uac04\uc774 \uae38\uba70 \uc7a6\uc740 \uc815\ubc00 \uccad\uc18c\uac00 \ud544\uc694\ud55c \ud658\uacbd\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",wash_towel_mode_des_2:"\uae30\ubcf8 \uccad\uc18c \uc18d\ub3c4\uc640 \uc131\ub2a5\uc774 \ud544\uc694\ud55c \uc911\uaddc\ubaa8 \uac00\uc815\ud658\uacbd\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",wash_towel_mode_des_1:"\uccad\uc18c \uc2dc\uac04\uc774 \uc9e7\uace0 \ubb3c \uc18c\ube44\ub7c9\uc774 \uc801\uc740 \uae68\ub057\ud55c \ud658\uacbd\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",back_wash_desc:"\ubd84\ud560 \uc601\uc5ed \uae30\ubc18\uc73c\ub85c \uc138\ucc99 \uac04\uaca9\uc744 \uc720\uc5f0\ud558\uac8c \uc870\uc808\ud558\uc5ec \ubb3c\uac78\ub808 \uc138\ucc99\uc744 \uc790\ub3d9\uc73c\ub85c \uc218\ud589\ud569\ub2c8\ub2e4.",back_wash_time_setting:"\ubb3c\uac78\ub808 \uc138\ucc99 \uac04\uaca9",robot_start_type_rr_intelligence_scene:"\ube60\ub978 \uba85\ub839",smart_scene_firmware_will_support_alert_title:"###\u5f53\u524d\u8bbe\u5907\u6682\u4e0d\u652f\u6301\u8be5\u573a\u666f\u529f\u80fd\uff0c\u540e\u7eed\u4f1a\u66f4\u65b0\u4e0a\u7ebf\uff0c\u656c\u8bf7\u671f\u5f85",smart_scene_firmware_update_alert_confirm:"\ud38c\uc6e8\uc5b4 \uc5c5\ub370\uc774\ud2b8",map_edit_rotate_right:"\uc624\ub978\ucabd\uc73c\ub85c \ud68c\uc804",map_edit_rotate_left:"\uc67c\ucabd\uc73c\ub85c \ud68c\uc804",be_on_the_phone:"\ud1b5\ud654 \uc911...",click_to_start_call:"\ud0ed\ud558\uc5ec \ud1b5\ud654 \uc2dc\uc791",click_to_end_call:"\ud0ed\ud558\uc5ec \ud1b5\ud654 \uc885\ub8cc",voice_package_end_validtime_forever:"\ub9cc\ub8cc\uae30\ud55c\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.",rotate_map_rect_warning:"\ud574\ub2f9 \ub9f5 \uc774\uc678\uc758 \uc601\uc5ed\uc73c\ub85c \uc774\ub3d9\ud558\uc9c