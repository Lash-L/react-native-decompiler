object_name_loosewire:"\u0428\u043d\u0443\u0440\u0438\xa0/ \u0434\u0440\u043e\u0442\u0438",map_object_name_cat:"\u0422\u0432\u0430\u0440\u0438\u043d\u0430",map_object_name_dog:"\u0422\u0432\u0430\u0440\u0438\u043d\u0430",map_object_name_curledfabric:"\u0442\u043a\u0430\u043d\u0438\u043d\u043d\u0456\xa0/ \u043f\u0430\u043f\u0435\u0440\u043e\u0432\u0456 \u043a\u0443\u043b\u0456",auto_delivery_cleaning_fluid_title:"\u0406\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0435 \u0434\u043e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u043c\u0438\u0439\u043d\u043e\u0433\u043e \u0437\u0430\u0441\u043e\u0431\u0443",auto_delivery_cleaning_fluid_desc:"\u041c\u0438\u0439\u043d\u0438\u0439 \u0437\u0430\u0441\u0456\u0431 \u0434\u043e\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u043e\u043b\u043e\u0441\u043a\u0430\u043d\u043d\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0439 \u0434\u043e\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u0438 \u0432 \u0431\u0430\u043a.",clean_route_fast_mode_guide_title:"\u0420\u0435\u0436\u0438\u043c \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0437 \u043a\u0440\u0430\u0449\u043e\u044e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044e.",clean_route_fast_mode_guide_desc:"\u0420\u043e\u0431\u043e\u0442 \u0432\u0438\u0432\u0447\u0430\u0454 \u043b\u043e\u043a\u0430\u0446\u0456\u044e \u0442\u0430 \u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u043a\u043e\u0440\u0438\u0433\u0443\u0454 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0434\u043b\u044f \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f. \u041a\u043e\u043d\u0442\u0443\u0440 \u043a\u0456\u043c\u043d\u0430\u0442\u0438 \u043d\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438\u043c\u0435\u0442\u044c\u0441\u044f. \u0426\u044f \u0444\u0443\u043d\u043a\u0446\u0456\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u043b\u0438\u0448\u0435 \u0434\u043b\u044f \u0435\u043f\u0456\u0437\u043e\u0434\u0438\u0447\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f.",clean_route_fast_mode_is_work:"\u0420\u0435\u0436\u0438\u043c \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f",home_sepecial_tip_cleanmop_fastroute:"\u0420\u0435\u0436\u0438\u043c \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f\xa0| \u041e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f",livecall_autosoundoff_whenmoving_alerttitle:"\u0412\u0438\u043a\u043b\u0438\u043a \u043f\u0456\u0434 \u0447\u0430\u0441 \u0440\u0443\u0445\u0443",livecall_autosoundoff_whenmoving_alertdesc:"\u0412\u0438\u043a\u043b\u0438\u043a \u043f\u043e\u0447\u0438\u043d\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0440\u0443\u0445\u0443. \u0417\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0437\u0432\u0443\u043a \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c, \u044f\u043a\u0449\u043e \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e.",carpet_clean_mode_detail4:"\u0417\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043e \u0446\u0438\u043d\u043e\u0432\u043e\u043a \u0430\u0431\u043e \u043d\u0435\u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u043a\u0438\u043b\u0438\u043c\u0456\u0432. \u042f\u043a\u0449\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f \u043a\u0438\u043b\u0438\u043c, \u0433\u0430\u043d\u0447\u0456