e\u043d\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430\xa0/ \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0425\u043e\u043b\u043b\u0430 \u0440\u0456\u0432\u043d\u044f \u0447\u0438\u0441\u0442\u043e\u0457 \u0432\u043e\u0434\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f",inner_error_desc_154:"\u041d\u0435\u0441\u043f\u0440\u0430\u0432\u043d\u0456\u0441\u0442\u044c \u0431\u0456\u0447\u043d\u043e\u0457 \u0449\u0456\u0442\u043a\u0438",inner_error_desc_158:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0425\u043e\u043b\u043b\u0430 \u0440\u0456\u0432\u043d\u044f \u0431\u0440\u0443\u0434\u043d\u043e\u0457 \u0432\u043e\u0434\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f",inner_error_desc_159:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u043e\u0431\u043c\u0456\u043d\u0443 \u0434\u0430\u043d\u0438\u043c\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f",map_edit_furniture_floor_mirror:"\u0414\u0437\u0435\u0440\u043a\u0430\u043b\u043e \u0432\u0456\u0434 \u043f\u0456\u0434\u043b\u043e\u0433\u0438",map_edit_split_too_small:"\u041f\u043b\u043e\u0449\u0430 \u043a\u0456\u043c\u043d\u0430\u0442\u0438 \u0437\u0430\u043c\u0430\u043b\u0430. \u0420\u043e\u0437\u043f\u043e\u0434\u0456\u043b \u043d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f.",setting_auto_avoid_obstacle_title:"\u0406\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0443\u043d\u0438\u043a\u043d\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0448\u043a\u043e\u0434",setting_auto_avoid_obstacle_desc:"\u0417\u0430\u0432\u0434\u044f\u043a\u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0432\u0430\u043d\u043e\u043c\u0443 \u0441\u0432\u0456\u0442\u043b\u0443 \u0440\u043e\u0431\u043e\u0442 \u0432\u0438\u044f\u0432\u043b\u044f\u0454 \u043f\u0435\u0440\u0435\u0448\u043a\u043e\u0434\u0438 \u0439 \u0443\u043d\u0438\u043a\u0430\u0454 \u0457\u0445 \u0443 \u0440\u0435\u0436\u0438\u043c\u0456 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0447\u0430\u0441\u0443 \u0442\u0430 \u0432\u043e\u0434\u043d\u043e\u0447\u0430\u0441 \u0437\u043c\u0435\u043d\u0448\u0443\u0454 \u0440\u0438\u0437\u0438\u043a \u0437\u0430\u0441\u0442\u0440\u044f\u0433\u043d\u0443\u0442\u0438.",error_water_carriage_drop_title:"\u0412\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043e \u043a\u0440\u0456\u043f\u043b\u0435\u043d\u043d\u044f \u0449\u0456\u0442\u043a\u0438 \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f. ",error_water_carriage_drop_desc:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u0434\u0435\u0442\u0430\u043b\u044c, \u0449\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443.",error_water_carriage_drop_detail:"\u041a\u0440\u0456\u043f\u043b\u0435\u043d\u043d\u044f \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0438 \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0432\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043e. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u0439\u043e\u0433\u043e, \u0449\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443.",supplies_pearl_strainer_name:"\u041f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438",supplies_pearl_strainer_description:"\u0412\u0435\u043b\u0438\u043a\u0456 \u0447\u0430\u0441\u0442\u043a\u0438, \u044f\u043a\u0456 \u0442\u0440\u0430\u043f\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438, \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u0432 \u043f\u0456\u0434\u0434\u043e\u043d\u0456 \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438, \u0449\u043e\u0431 \u0437\u0430\u043f\u043e\u0431\u0456\u0433\u0442\u0438 \u0437\u0430\u0441\u043c\u0456\u0447\u0435\u043d\u043d\u044e \u0442\u0440\u0443\u0431\u043a\u0438 \u0434\u043b\u044f \u043f\u043e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u0438. \u041f\u0440\u043e\u043c\u0438\u0432\u0430\u0439\u0442\u0435 \u043f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u043f\u0440\u0438\u043d\u0430\u0439\u043c\u043d\u0456 \u0440\u0430\u0437 \u043d\u0430 \u043c\u0456\u0441\u044f\u0446\u044c.",alert_pause_current_task_then_selfclean:"\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u043f\u043e\u0442\u043e\u0447\u043d\u0435 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f \u0439 \u043f\u043e\u0447\u0430\u0442\u0438 \u0441\u0430\u043c\u043e\u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f?",alert_pause_current_task_then_drain:"\u0417\u0430\u0432\u0434\u0430\u043d\u043d\u044f \u043d\u0435 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043e. \u041f\u0435\u0440\u0435\u0434 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0437\u0430\u0432\u0435\u0440\u0448\u0456\u0442\u044c \u043f\u043e\u0442\u043e\u0447\u043d\u0435 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f.",close_auto_dry_alert_desc:"\u042f\u043a\u0449\u043e \u0432\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0441\u0443\u0448\u0456\u043d\u043d\u044f, \u0442\u043e \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0430 \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0456\u0437 \u0447\u0430\u0441\u043e\u043c \u043d\u0430\u0431\u0443\u0434\u0435 \u043d\u0435\u043f\u0440\u0438\u0454\u043c\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0430\u0445\u0443. \u0414\u0456\u0439\u0441\u043d\u043e \u0432\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u0446\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u044e?",drain_left_water_tip1:"1. \u041f\u043e\u043c\u0456\u0441\u0442\u0456\u0442\u044c \u0440\u043e\u0431\u043e\u0442 \u0432 \u0431\u0430\u0437\u043e\u0432\u0443 \u0441\u0442\u0430\u043d\u0446\u0456\u044e. \u041d\u0435 \u0437\u0430\u0431\u0443\u0432\u0430\u0439\u0442\u0435 \u0437\u0430\u0440\u044f\u0434\u0436\u0430\u0442\u0438 \u0439\u043e\u0433\u043e. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0431\u0430\u043a \u0434\u043b\u044f \u0431\u0440\u0443\u0434\u043d\u043e\u0457 \u0432\u043e\u0434\u0438 (\u0430\u0431\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f) \u0456 \u043f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u043d\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456. \u0417\u043d\u0456\u043c\u0456\u0442\u044c \u043a\u0440\u0456\u043f\u043b\u0435\u043d\u043d\u044f \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0438 \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f.",drain_left_water_tip2:"2. \u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u043e\u043f\u0446\u0456\u0457 \xab\u041f\u043e\u0447\u0430\u0442\u0438 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u043b\u0438\u0448\u043a\u0456\u0432 \u0432\u043e\u0434\u0438\xbb \u0439 \u0437\u0430\u0447\u0435\u043a\u0430\u0439\u0442\u0435, \u0434\u043e\u043a\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u044e \u043d\u0435 \u0431\u0443\u0434\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043e.",drain_left_water_tip3:"3. \u041e\u043f\u0435\u0440\u0430\u0446\u0456\u044f \u0437\u0430\u0439\u043c\u0430\u0454 5\u201310\xa0\u0445\u0432\u0438\u043b\u0438\u043d. \u041f\u0456\u0434 \u0447\u0430\u0441 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457 \u043d\u0435 \u0440\u0443\u0445\u0430\u0439\u0442\u0435 \u0440\u043e\u0431\u043e\u0442\u0430 \u0439 \u0431\u0430\u0437\u043e\u0432\u0443 \u0441\u0442\u0430\u043d\u0446\u0456\u044e.",drain_left_water_tip4:"4. \u041f\u0456\u0441\u043b\u044f \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u043b\u0438\u0448\u043a\u0456\u0432 \u0432\u043e\u0434\u0438 \u043d\u0430 \u0440\u043e\u0431\u043e\u0442\u0456 \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0438\u0442\u044c\u0441\u044f \u0430\u0443\u0434\u0456\u043e\u0441\u043f\u043e\u0432\u0456\u0449\u0435\u043d\u043d\u044f \xab\u0417\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e\xbb. \u0421\u043f\u043e\u0440\u043e\u0436\u043d\u0456\u0442\u044c \u0431\u0430\u043a \u0434\u043b\u044f \u0431\u0440\u0443\u0434\u043d\u043e\u0457 \u0432\u043e\u0434\u0438 (\u0430\u0431\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f). ",drain_left_water_title:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0437\u043b\u0438\u0432\u0430\u0442\u0438 \u0437\u0430\u043b\u0438\u0448\u043a\u0438 \u0432\u043e\u0434\u0438",left_water_is_draining:"\u0422\u0440\u0438\u0432\u0430\u0454 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0432\u043e\u0434\u0438",start_drain_left_water:"\u041f\u043e\u0447\u0430\u0442\u0438 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u043b\u0438\u0448\u043a\u0456\u0432 \u0432\u043e\u0434\u0438",left_water_drain_page_title:"\u0420\u0435\u0436\u0438\u043c \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u0457 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438",inner_error_desc_128:"\u041a\u043e\u0440\u043e\u0442\u043a\u0435 \u0437\u0430\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u0432 \u043c\u043e\u0434\u0443\u043b\u0456 \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f.",inner_error_desc_129:"\u041c\u043e\u0434\u0443\u043b\u044c \u0434\u043b\u044f \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0432\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043e.",setting_carpet_first_switch_title:"\u041f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442 \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u043a\u0438\u043b\u0438\u043c\u0430",setting_carpet_first_switch_desc:"\u041f\u0456\u0441\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f \u0437 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0440\u043e\u0431\u043e\u0442 \u0443 \u043f\u0435\u0440\u0448\u0443 \u0447\u0435\u0440\u0433\u0443 \u043f\u043e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u043f\u0438\u043b\u043e\u0441\u043e\u0441\u043e\u043c \u0432\u043a\u0440\u0438\u0442\u0456 \u043a\u0438\u043b\u0438\u043c\u0430\u043c\u0438 \u0434\u0456\u043b\u044f\u043d\u043a\u0438 \u043f\u0456\u0434\u043b\u043e\u0433\u0438, \u0431\u0435\u0437 \u0437\u0432\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u044f \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0438 \u0448\u0432\u0430\u0431\u044