27 \u0643\u0627\u0646\u062a \u0625\u0645\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u064a\u0627\u0647 \u0644\u062f\u064a\u0643 \u0645\u062a\u0627\u062d\u0629. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0643\u0630\u0644\u0643\u060c \u0623\u0639\u062f \u062a\u0648\u0635\u064a\u0644 \u0643\u0627\u0628\u0644 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0644\u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641 \u062b\u0645 \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629. \u0625\u0630\u0627 \u0627\u0633\u062a\u0645\u0631\u062a \u0627\u0644\u0645\u0634\u0643\u0644\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u062f\u0639\u0645 \u0627\u0644\u0639\u0645\u0644\u0627\u0621.",error_drain_water_title:"\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u062a\u0635\u0631\u064a\u0641",error_drain_water_desc:"\u062a\u062d\u0642\u0642 \u0645\u0646 \u0648\u062c\u0648\u062f \u0623\u064a \u0634\u064a\u0621 \u064a\u0639\u064a\u0642 \u0645\u0646\u0641\u0630 \u0627\u0644\u062a\u0635\u0631\u064a\u0641 \u0648\u0623\u0632\u0644\u0647.",error_drain_water_detail:"\u062a\u062d\u0642\u0642 \u0645\u0646 \u0648\u062c\u0648\u062f \u0623\u064a \u0634\u064a\u0621 \u064a\u0639\u064a\u0642 \u0645\u0646\u0641\u0630 \u0627\u0644\u062a\u0635\u0631\u064a\u0641 \u0648\u0623\u0632\u0644\u0647. \u0625\u0630\u0627 \u0627\u0633\u062a\u0645\u0631\u062a \u0627\u0644\u0645\u0634\u0643\u0644\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u062f\u0639\u0645 \u0627\u0644\u0639\u0645\u0644\u0627\u0621.",error_clean_carousel_unsetuped_title:"\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641.",error_clean_carousel_unsetuped_desc:"\u0623\u0639\u062f \u062a\u062b\u0628\u064a\u062a \u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641.",error_clean_carousel_unsetuped_detail:"1.\u062b\u0628\u0651\u0650\u062a \u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0641\u064a \u0645\u0643\u0627\u0646\u0647 \u0628\u0625\u062d\u0643\u0627\u0645\u061b 2.\u062a\u062d\u0642\u0642 \u0645\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0623\u064a \u0634\u064a\u0621 \u0639\u0627\u0644\u0642 \u0641\u064a \u0645\u0646\u0641\u0630 \u0645\u064a\u0627\u0647 \u0627\u0644\u0642\u0627\u0639\u062f\u0629\u061b 3.\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u063a\u0637\u0627\u0621 \u062e\u0632\u0627\u0646 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0645\u062a\u0633\u062e\u0629 \u0648\u062a\u062b\u0628\u064a\u062a\u0647 \u0628\u0625\u062d\u0643\u0627\u0645.",error_clean_carousel_water_full_title:"\u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0645\u0645\u062a\u0644\u0626.",error_clean_carousel_water_full_desc:"\u062a\u062d\u0642\u0642 \u0645\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0623\u064a \u0634\u064a\u0621 \u064a\u0639\u064a\u0642 \u0645\u0646\u0641\u0630 \u0627\u0644\u0645\u064a\u0627\u0647 \u0648\u0623\u0632\u0644\u0647 \u0625\u0646 \u0648\u062c\u062f",error_clean_carousel_water_full_detail:"\u0642\u062f \u064a\u0643\u0648\u0646 \u0645\u0646\u0641\u0630 \u0645\u064a\u0627\u0647 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0645\u0633\u062f\u0648\u062f\u064b\u0627\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0623\u064a \u0634\u064a\u0621 \u0639\u0627\u0644\u0642 \u0648\u0625\u0632\u0627\u0644\u062a\u0647 \u0625\u0646 \u0648\u062c\u062f\u061b \u0648\u0625\u0630\u0627 \u0644\u0645 \u064a\u0648\u062c\u062f \u0634\u064a\u0621 \u0639\u0627\u0644\u0642\u060c \u0641\u062a\u062d\u0642\u0642 \u0645\u0646 \u063a\u0637\u0627\u0621 \u062e\u0632\u0627\u0646 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0645\u062a\u0633\u062e\u0629 \u0648\u0627\u0644\u0645\u0632\u0644\u0627\u062c \u0648\u0642\u0645 \u0628\u0625\u062d\u0643\u0627\u0645\u0647\u0645\u0627.",map_edit_map_unsave:"\u0628\u0631\u062c\u0627\u0621 \u062d\u0641\u0638 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0642\u0628\u0644 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629\u064b \u0623\u062e\u0631\u0649.",charger_type_name_special:"\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u062d\u0646",valley_electricity_not_set_hint:"* \u0644\u0645 \u064a\u062a\u0645 \u062a\u0639\u064a\u064a\u0646 \u0648\u0642\u062a \u0627\u0644\u0634\u062d\u0646. \u0627\u0644\u0634\u062d\u0646 \u0641\u064a \u063a\u064a\u0631 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0630\u0631\u0648\u0629 \u063a\u064a\u0631 \u0646\u0634\u0637.",dock_kit_setting0:"5 \u0633\u0627\u0639\u0627\u062a",washing_mode_updown_water_selfcleaning:"\u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0630\u0627\u062a\u064a",washing_mode_updown_water_drain:"\u062a\u0635\u0631\u064a\u0641 \u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641",wash_towel_mode_title_4:"\u0639\u0645\u064a\u0642 \u0644\u0644\u063a\u0627\u064a\u0629",wash_towel_mode_desc_4:"\u0645\u0646\u0627\u0633\u0628 \u0644\u062a\u0631\u0643\u064a\u0628 \u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641\u060c \u0648\u064a\u062d\u0633\u0646 \u063a\u0633\u064a\u0644 \u0627\u0644\u0645\u0645\u0633\u062d\u0629.",dock_panel_function_section_title:"\u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u062d\u0646",dock_info_clear_water_box_title:"\u062e\u0632\u0627\u0646 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0646\u0638\u064a\u0641\u0629",dock_info_clear_water_box_exception1:"\u0646\u0642\u0635 \u0641\u064a \u0627\u0644\u0645\u064a\u0627\u0647",dock_info_dirty_water_box_title:"\u062e\u0632\u0627\u0646 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0645\u062a\u0633\u062e\u0629",dock_info_dirty_water_box_exception1:"\u0645\u0645\u062a\u0644\u0626/\u063a\u064a\u0631 \u0645\u062b\u0628\u062a",dock_info_clean_fluid_title:"\u062e\u0631\u0637\u0648\u0634\u0629 \u0645\u0627\u062f\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0641",dock_info_clean_fluid_exception:"\u0633\u0627\u0626\u0644 \u0645\u0646\u062e\u0641\u0636",dock_info_water_box_filter_title:"\u0641\u0644\u062a\u0631 \u0627\u0644\u0645\u064a\u0627\u0647",dock_info_item_gone_exception:"\u063a\u064a\u0631 \u0645\u062b\u0628\u062a",dock_info_dust_bag_exception:"\u0645\u0645\u062a\u0644\u0626",toast_clean_then_mop_24hour:"\u0644\u062a\u062c\u0646\u0628 \u062a\u0631\u0627\u0643\u0645 \u0627\u0644\u0623\u0648\u0633\u0627\u062e \u0628\u0635\u0648\u0631\u0629 \u0643\u0628\u064a\u0631\u0629 \u0648\u0644\u0636\u0645\u0627\u0646 \u0623\u0641\u0636\u0644 \u0623\u062f\u0627\u0621 \u0641\u064a \u0627\u0644\u062a\u0646\u0638\u064a\u0641\u060c \u0646\u0638\u0641 \u0627\u0644\u0623\u0631\u0636\u064a\u0629 \u0628\u0627\u0644\u0645\u0643\u0646\u0633\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0642\u0628\u0644 \u0645\u0633\u062d\u0647\u0627.",cliff_zones_save_failed:"\u0641\u0634\u0644\u062a \u0639\u0645\u0644\u064a\u0629 \u062d\u0641\u0638 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u0645\u0646\u062d\u062f\u0631\u0629",inner_error_desc_151:"\u062e\u0637\u0623 \u0641\u064a \u0645\u0631\u0648\u062d\u0629 \u0627\u0644\u062a\u062c\u0641\u064a\u0641",inner_error_desc_152:"\u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641 - \u062e\u0637\u0623 \u0641\u064a \u0645\u0636\u062e\u0629 \u0627\u0644\u062a\u0641\u0631\u064a\u063a",inner_error_desc_153:"\u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641 - \u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0635\u0645\u0627\u0645 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0645\u0646\u0641\u0630 \u0627\u0644\u0645\u064a\u0627\u0647/\u062e\u0637\u0623 \u0641\u064a \u0645\u0633\u062a\u0634\u0639\u0631 \u0647\u0648\u0644 \u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0646\u0638\u064a\u0641\u0629",inner_error_desc_154:"\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0641\u0631\u0634\u0627\u0629 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629",inner_error_desc_158:"\u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641 - \u062e\u0637\u0623 \u0641\u064a \u0645\u0633\u062a\u0634\u0639\u0631 \u0647\u0648\u0644 \u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0645\u062a\u0633\u062e\u0629",inner_error_desc_159:"\u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641 - \u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644",map_edit_furniture_floor_mirror:"\u0645\u0631\u0622\u0629 \u0627\u0644\u0623\u0631\u0636\u064a\u0629",map_edit_split_too_small:"\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u063a\u0631\u0641\u0629 \u0635\u063a\u064a\u0631\u0629 \u062c\u062f\u064b\u0627 \u0648\u0644\u0627 \u064a\u064f\u0646\u0635\u062d \u0628\u062a\u0642\u0633\u064a\u0645\u0647\u0627.",setting_auto_avoid_obstacle_title:"\u062a\u062c\u0646\u0628 \u0627\u0644\u0639\u0648\u0627\u0626\u0642 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Reactive",setting_auto_avoid_obstacle_desc:"\u062a\u0633\u0645\u062d \u062e\u0648\u0627\u0631\u0632\u0645\u064a\u0629 \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u0645\u0646\u0638\u0645 \u0644\u0644\u0631\u0648\u0628\u0648\u062a \u0628\u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0639\u0648\u0627\u0626\u0642 \u0648\u062a\u062c\u0646\u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a\u060c \u0645\u0645\u0627 \u064a\u0642\u0644\u0644 \u0645\u0646 \u0645\u062d\u0627\u0635\u0631\u0629 \u0627\u0644\u0631\u0648\u0628\u0648\u062a.",error_water_carriage_drop_title:"\u0633\u0642\u0637 \u062d\u0627\u0645\u0644 \u0627\u0644\u0645\u0645\u0633\u062d\u0629. ",error_water_carriage_drop_desc:"\u064a\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062b\u0628\u064a\u062a\u0647 \u0644\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0627\u0644\u0639\u0645\u0644.",error_water_carriage_drop_detail:"\u0644\u0642\u062f \u0633\u0642\u0637 \u062d\u0627\u0645\u0644 \u0642\u0645\u0627\u0634 \u0627\u0644\u0645\u0645\u0633\u062d\u0629\u060c \u064a\u0631\u062c\u0649 \u0625\u0639\u0627\u062f\u0629 \u062a\u062b\u0628\u064a\u062a\u0647 \u0644\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0627\u0644\u0639\u0645\u0644.",supplies_pearl_strainer_name:"\u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641",supplies_pearl_strainer_description:"\u0633\u062a\u0638\u0644 \u0627\u0644\u062c\u0632\u064a\u0626\u0627\u062a \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0627\u0644\u062a\u064a \u064a\u064f\u0639\u062b\u0631 \u0639\u0644\u064a\u0647\u0627 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u063a\u0633\u0644 \u0627\u0644\u0645\u0645\u0633\u062d\u0629 \u0641\u064a \u062e\u0632\u0627\u0646 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0644\u0645\u0646\u0639 \u0627\u0646\u0633\u062f\u0627\u062f \u0623\u0646\u0628\u0648\u0628 \u0627\u0644\u0645\u064a\u0627\u0647. \u0627\u0634\u0637\u0641 \u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0634\u0647\u0631\u064a\u064b\u0627.",alert_pause_current_task_then_selfclean:"\u0647\u0644 \u062a\u0631\u064a\u062f \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0645\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0648\u0628\u062f\u0621 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0630\u0627\u062a\u064a\u061f",alert_pause_current_task_then_drain:"\u0644\u0645 \u062a\u0643\u062a\u0645\u0644 \u0627\u0644\u0645\u0647\u0645\u0629. \u0627\u0646\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0645\u0629 \u0642\u0628\u0644 \u0627\u0644\u062a\u062d\u0631\u064a\u0631.",close_auto_dry_alert_desc:"\u0642\u062f \u064a\u0643\u0648\u0646 \u0644\u0642\u0645\u0627\u0634 \u0627\u0644\u0645\u0645\u0633\u062d\u0629 \u0631\u0627\u0626\u062d\u0629 \u0643\u0631\u064a\u0647\u0629 \u0625\u0630\u0627 \u0623\u064f\u0648\u0642\u0641 \u062a\u0634\u063a\u064a\u0644 \u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u062a\u062c\u0641\u064a\u0641. \u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646\u0643 \u062a\u0631\u064a\u062f \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644\u0647\u0627\u061f",drain_left_water_tip1:"1. \u064a\u0631\u062c\u0649 \u0648\u0636\u0639 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u062d\u0646\u060c \u0648\u0625\u0628\u0642\u0627\u0626\u0647 \u0645\u0634\u062d\u0648\u0646\u064b\u0627. \u062a\u062d\u0642\u0642 \u0648\u062a\u0623\u0643\u062f \u0645\u0646 \u062a\u062b\u0628\u064a\u062a \u062e\u0632\u0627\u0646 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0645\u062a\u0633\u062e\u0629 (\u0623\u0648 \u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641) \u0648\u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0641\u064a \u0645\u0643\u0627\u0646\u0647\u0645\u0627\u060c \u062b\u0645 \u0642\u0645 \u0628\u0625\u0632\u0627\u0644\u0629 \u062d\u0627\u0645\u0644 \u0642\u0645\u0627\u0634 \u0627\u0644\u0645\u0645\u0633\u062d\u0629.",drain_left_water_tip2:"2. \u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \"\u0628\u062f\u0621 \u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0645\u0627\u0621 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\"\u060c \u0648\u0627\u0646\u062a\u0638\u0631 \u062d\u062a\u0649 \u064a\u0643\u062a\u0645\u0644 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627\u061b",drain_left_water_tip3:"3. \u064a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0623\u0645\u0631 \u062d\u0648\u0627\u0644\u064a 5-10 \u062f\u0642\u0627\u0626\u0642. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0644\u064a \u0628\u0627\u0644\u0635\u0628\u0631 \u0648\u0639\u062f\u0645 \u062a\u062d\u0631\u064a\u0643 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0648\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u062d\u0646\u061b",drain_left_water_tip4:"4. \u064a\u0635\u062f\u0631 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0635\u0648\u062a\u064b\u0627 \u062a\u0646\u0628\u064a\u0647\u064a\u064b\u0627 \"\u0627\u0643\u062a\u0645\u0644 \u0627\u0644\u062a\u0635\u0631\u064a\u0641\"\u060c \u0644\u064a\u064f\u0634\u064a\u0631 \u0625\u0644\u0649 \u0627\u0646\u062a\u0647\u0627\u0621 \u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0645\u0627\u0621 \u0627\u0644\u0645\u062a\u0628\u0642\u064a. \u064a\u0631\u062c\u0649 \u062a\u0641\u0631\u064a\u063a \u062e\u0632\u0627\u0646 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0645\u062a\u0633\u062e\u0629 (\u0623\u0648 \u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641). ",drain_left_water_title:"\u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0645\u0627\u0621 \u0627\u0644\u0645\u062a\u0628\u0642\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627",left_water_is_draining:"\u0627\u0644\u0631\u0648\u0628\u0648\u062a \u064a\u0642\u0648\u0645 \u0628\u0627\u0644\u062a\u0635\u0631\u064a\u0641",start_drain_left_water:"\u0628\u062f\u0621 \u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0645\u0627\u0621 \u0627\u0644\u0645\u062a\u0628\u0642\u064a",left_water_drain_page_title:"\u0648\u0636\u0639 \u062f\u0639\u0645 \u0627\u0644\u0639\u0645\u0644\u0627\u0621",inner_error_desc_128:"\u062d\u062f\u062b \u0642\u0635\u0631 \u0641\u064a \u062f\u0627\u0626\u0631\u0629 \u0648\u062d\u062f\u0629 \u0627\u0644\u0645\u0633\u062d.",inner_error_desc_129:"\u0648\u062d\u062f\u0629 \u0627\u0644\u0645\u0633\u062d \u063a\u064a\u0631 \u0645\u062a\u0635\u0644\u0629.",setting_carpet_first_switch_title:"\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u062c\u0627\u062f \u0623\u0648\u0644\u0627\u064b",setting_carpet_first_switch_desc:"\u0628\u0639\u062f \u0628\u062f\u0621 \u0645\u0647\u0645\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0641\u060c \u0633\u064a\u0639\u0637\u064a \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u063a\u0637\u0627\u0629 \u0628\u0627\u0644\u0633\u062c\u0627\u062f \u062f\u0648\u0646 \u0623\u0646 \u064a\u0628\u0644\u0644 \u0642\u0645\u0627\u0634 \u0627\u0644\u0645\u0645\u0633\u062d\u0629. \u0648\u0633\u064a\u0633\u062a\u0623\u0646\u0641 \u0645\u0647\u0645\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0628\u0639\u062f \u0630\u0644\u0643.\n*\u0644\u0627 \u064a\u0634\u0645\u0644 \u0630\u0644\u0643 \u0627\u0644\u062d\u0635\u064a\u0631.",skip_current_cleanarea_buttontitle:"\u062a\u062e\u0637\u064a \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629",pearl_supplies_strainer_reset_content:"\u062a\u0645 \u0634\u0637\u0641 \u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641. \u0645\u0648\u0627\u0641\u0642\u061f",setting_back_wash_interval:"\u062d\u0648\u0627\u0644\u064a ${minute} \u062f\u0642\u064a\u0642\u0629",inner_error_desc_156:"\u062e\u0637\u0623 \u0641\u064a ODD \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u062d\u0646",robot_is_warm_up_tip_try:"\u062c\u0627\u0631\u064a \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0644\u0627\u062d\u0642\u064b\u0627.",localization_strings_Main_MainPage_12:"\u0627\u0633\u062a\u0639\u0627\u062f\u0629",unsave_map_alert_mess:"\u0644\u0642\u062f \u062a\u063a\u064a\u0631\u062a \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0643\u062b\u064a\u0631\u0627. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629\u061f",unsave_map_alert_chargeroffset:"\u0631\u0628\u0645\u0627 \u062a\u063a\u064a\u0631\u062a \u0627\u0644\u062e\u0631\u064a\u0637\u0629. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629\u061f",donot_disturb_same_time_warning:"\u0648\u0642\u062a \u0627\u0644\u0628\u062f\u0621 \u0648\u0648\u0642\u062a \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u062a\u0637\u0627\u0628\u0642\u0627\u0646. \u064a\u0631\u062c\u0649 \u062a\u0639\u062f\u064a\u0644\u0647\u0645\u0627.",add_supplement_area_buttontitle:"\u0623\u0636\u0641 \u0645\u0646\u0637\u0642\u0629",goto_supplememt_cleanarea_title:"\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u062a\u0643\u0645\u064a\u0644\u064a",home_page_pearl_supplies_strainer_upgrade_tip:"\u0644\u0645 \u064a\u062a\u0645 \u062a\u0646\u0638\u064a\u0641 \u062f\u0631\u062c \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0644\u0641\u062a\u0631\u0629 \u0637\u0648\u064a\u0644\u0629. \u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u0646\u0638\u064a\u0641\u0647.",pearl_slow_mop_guide_title:"\u0645\u0633\u062d \u0645\u0643\u062b\u0641 \u0644\u0644\u0632\u0648\u0627\u064a\u0627",pearl_slow_mop_guide_detail:"\u064a\u062a\u062d\u0631\u0643 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0639\u0644\u0649 \u0637\u0648\u0644 \u0645\u0633\u0627\u0631 \u0643\u062b\u064a\u0641 \u0639\u0644\u0649 \u0634\u0643\u0644 \u0642\u0648\u0633 \u0628\u0633\u0631\u0639\u0629 \u0645\u0646\u062e\u0641\u0636\u0629\u060c \u0648\u064a\u0642\u0648\u0645 \u0628\u062a\u062f\u0648\u064a\u0631 \u062c\u0633\u0645\u0647 \u0644\u062a\u0639\u0632\u064a\u0632 \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0628\u0642\u0639 \u0627\u0644\u0635\u0639\u0628\u062