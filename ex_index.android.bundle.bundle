\u1ea3i l\xean c\xf3 th\u1ec3 ch\u1ee9a th\xf4ng tin c\xe1 nh\xe2n c\u1ee7a b\u1ea1n. Ch\xfang t\xf4i \u0111\u1ea3m b\u1ea3o r\u1eb1ng th\xf4ng tin c\u1ee7a b\u1ea1n s\u1ebd \u0111\u01b0\u1ee3c b\u1ea3o m\u1eadt.",log_for_v4_upload:"T\u1ea3i l\xean h\xecnh \u1ea3nh ch\u1ee5p trong 3 ng\xe0y g\u1ea7n nh\u1ea5t",log_for_v4_dialog_title:"Sau khi b\u1ea1n \u0111\u1ed3ng \xfd, trong qu\xe1 tr\xecnh ho\u1ea1t \u0111\u1ed9ng robot s\u1ebd t\u1ea3i l\xean h\xecnh \u1ea3nh c\u1ee7a 3 ng\xe0y g\u1ea7n nh\u1ea5t",map_object_name_henggan:"\u0110\u1ed3 \u0111\u1ea1c d\u1ec5 g\xe2y k\u1eb9t",map_object_name_poqi:"H\xf3t r\xe1c",map_object_name_zhiwu:"V\u1ea3i",map_object_name_tizhongcheng:"C\xe1i c\xe2n",map_object_name_dizuo:"c\xe1i b\u1ec7, c\xe1i \u0111\u1ebf",map_object_name_shoe:"Gi\xe0y d\xe9p",map_object_name_baba:"Ch\u1ea5t th\u1ea3i c\u1ee7a v\u1eadt nu\xf4i",map_object_name_chapai:"\u1ed4 c\u1eafm \u0111i\u1ec7n",map_object_name_xian:"cu\u1ed9n ch\u1ec9",map_obstacles_title:"ch\u01b0\u1edbng ng\u1ea1i v\u1eadt",monitor_video_net_speed_slow_hd:"T\u1ed1c \u0111\u1ed9 m\u1ea1ng hi\u1ec7n t\u1ea1i ch\u1eadm, n\xean chuy\u1ec3n \u0111\u1ed9 ph\xe2n gi\u1ea3i",monitor_video_net_speed_slow_sd:"T\u1ed1c \u0111\u1ed9 m\u1ea1ng ch\u1eadm:",monitor_page_robot_on_dock_tip:"\u0110ang s\u1ea1c, vui l\xf2ng \u0111i\u1ec1u ch\u1ec9nh g\xf3c robot \u0111\u1ec3 xem video",reset_monitor_privacy_dialog_content:"Sau khi \u1ee7y quy\u1ec1n b\u1ecb thu h\u1ed3i, ch\u1ee9c n\u0103ng video tr\u1ef1c ti\u1ebfp kh\xf4ng th\u1ec3 \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng v\xe0 c\u1ea7n ph\u1ea3i \u1ee7y quy\u1ec1n l\u1ea1i khi s\u1eed d\u1ee5ng l\u1ea1i.",reset_monitor_privacy_dialog_title:"X\xe1c nh\u1eadn thu h\u1ed3i \u1ee7y quy\u1ec1n?",reset_authoration:"Thu h\u1ed3i \u1ee7y quy\u1ec1n",camera_setting_monitor_off_tip:"Sau khi t\u1eaft, b\u1ea1n c\u1ea7n ph\u1ea3i m\u1edf kh\xf3a \u0111\u1ec3 s\u1eed d\u1ee5ng l\u1ea1i t\xednh n\u0103ng n\xe0y",video_load_failed:"T\u1ea3i video kh\xf4ng th\xe0nh c\xf4ng. Vui l\xf2ng th\u1eed l\u1ea1i",video_is_loading:"\u0110ang t\u1ea3i video...",real_time_monitor_privacy_desc:"Ch\u1ee9c n\u0103ng video tr\u1ef1c ti\u1ebfp s\u1ebd kh\xf4ng ti\u1ebft l\u1ed9 th\xf4ng tin ri\xeang t\u01b0 c\xe1 nh\xe2n c\u1ee7a b\u1ea1n. Video ch\u1ec9 h\u1ed7 tr\u1ee3 xem theo th\u1eddi gian th\u1ef1c v\xe0 s\u1ebd b\u1ecb h\u1ee7y sau khi xem. \u0110\u1ec3 bi\u1ebft th\xeam th\xf4ng tin xin vui l\xf2ng tham kh\u1ea3o",video_definition_normal:"LD",video_definition_high:"HD",button_title_agree:"\u0110\u1ed3ng \xfd",camera_setting_open_rrai_tip:"B\u1eadt Tr\xe1nh Ch\u01b0\u1edbng ng\u1ea1i v\u1eadt",camera_monitor_privacy_title:"Ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a video tr\u1ef1c ti\u1ebfp",home_load_map_title:"B\u1ea3n \u0111\u1ed3",setting_on:"B\u1eacT",setting_auto:"T\u1ef0 \u0110\u1ed8NG",map_save_pop_box_overwrite:"update",setting_realtime_monitor_switch_title:"video tr\u1ef1c ti\u1ebfp",robot_status_clean_mop_mode:"qu\xe9t v\xe0 lau",common_setting_secure_setting:"C\xe0i \u0111\u1eb7t b\u1ea3o m\u1eadt",share_view_device_from:"T\u1eeb:",error_visual_sensor_detail:"C\u1ea3m bi\u1ebfn t\u1ea7m nh\xecn b\u1ecb b\u1ee5i ho\u1eb7c b\u1ecb che khu\u1ea5t, vui l\xf2ng v\u1ec7 sinh c\u1ea3m bi\u1ebfn t\u1ea7m nh\xecn",error_visual_sensor_subtitle:"Vui l\xf2ng lau c\u1ea3m bi\u1ebfn t\u1ea7m nh\xecn",error_visual_sensor_title:"L\u1ed7i c\u1ea3m bi\u1ebfn t\u1ea7m nh\xecn",map_edit_virtual_wall_too_close_to_robot:"B\u1ee9c t\u01b0\u1eddng \u1ea3o qu\xe1 g\u1ea7n robot. H\xe3y \u0111i\u1ec1u ch\u1ec9nh v\u1ecb tr\xed c\u1ee7a b\u1ee9c t\u01b0\u1eddng \u1ea3o.",map_edit_forbidden_contain_robot:"Robot \u0111ang \u1edf trong khu v\u1ef1c h\u1ea1n ch\u1ebf. Vui l\xf2ng \u0111i\u1ec1u ch\u1ec9nh v\u1ecb tr\xed c\u1ee7a khu v\u1ef1c h\u1ea1n ch\u1ebf.",reminder_bad_network:"Kh\xf4ng th\u1ec3 \u0111\u1ed3ng b\u1ed9 d\u1eef li\u1ec7u b\u1ea3n \u0111\u1ed3. H\xe3y ki\u1ec3m tra t\u1ed1c \u0111\u1ed9 \u0111\u01b0\u1eddng truy\u1ec1n m\u1ea1ng.",localization_strings_Setting_RemoteControlPage_50:"C\u1eadp nh\u1eadt phi\xean b\u1ea3n \u1ee9ng d\u1ee5ng m\u1edbi nh\u1ea5t v\xe0 th\u1eed l\u1ea1i",localization_strings_Setting_General_index_5:"Th\xf4ng tin m\u1ea1ng",localization_strings_Setting_General_index_0:"Kh\xf4ng x\xe1c \u0111\u1ecbnh",localization_strings_CommonModules_NumberView_3:"Di\u1ec7n t\xedch nh\xe0 (\u01b0\u1edbc t\xednh)",localization_strings_Common_Constants_10:"L\u1ed7i s\u1ea1c",debug_info_copy_success:"\u0110\xe3 sao ch\xe9p",rubys_cleanmode_mop_alert_descript:"S\u1ebd gi\u1ea3m l\u1ef1c h\xfat v\u1ec1 m\u1ee9c t\u1ed1i thi\u1ec3u. Ch\u1ebf \u0111\u1ed9 n\xe0y ch\u1ec9 \u0111\u01b0\u1ee3c \xe1p d\u1ee5ng m\u1ed9t l\u1ea7n.",rubys_setting_guide_contact_report_succ:"\u0110ang t\u1ea3i l\xean",revert_agreement_privacy:"Thu h\u1ed3i Th\u1ecfa thu\u1eadn Ng\u01b0\u1eddi d\xf9ng v\xe0 Ch\xednh s\xe1ch v\u1ec1 Quy\u1ec1n ri\xeang t\u01b0.",check_and_read_agreement_privacy:"Xem Th\u1ecfa thu\u1eadn Ng\u01b0\u1eddi d\xf9ng v\xe0 Ch\xednh s\xe1ch v\u1ec1 Quy\u1ec1n ri\xeang t\u01b0",multi_map_function_description_text_1:"C\xf3 th\u1ec3 l\u01b0u t\u1ed1i \u0111a b\u1ed1n b\u1ea3n \u0111\u1ed3 c\u1ee7a m\u1ed9t t\xf2a nh\xe0 nhi\u1ec1u t\u1ea7ng. Robot s\u1ebd ph\xe1t hi\u1ec7n v\xe0 chuy\u1ec3n sang b\u1ea3n \u0111\u1ed3 li\xean quan.",multi_map_timer_select_map_title:"Khu v\u1ef1c l\xe0m s\u1ea1ch",multi_map_timer_select_map_stop_task_title:"K\u1ebft th\xfac v\xe0 xem",multi_map_timer_not_current_map_tip:"Robot \u0111ang d\u1ecdn d\u1eb9p c\xe1c khu v\u1ef1c kh\xe1c, vui l\xf2ng ki\u1ec3m tra sau khi ho\xe0n th\xe0nh t\xe1c v\u1ee5",new_map_entrance_in_multiMap_0:"T\u1ea1o b\u1ea3n \u0111\u1ed3 m\u1edbi",localization_strings_Setting_RemoteControlPage_41:"Robot \u0111\xe3 v\xe0o v\u1ecb tr\xed s\u1ea1c",localization_strings_Setting_RemoteControlPage_40:"Robot \u0111ang \u0111\u01b0\u1ee3c s\u1ea1c",localization_strings_Setting_RemoteControlPage_19:"L\xe0m s\u1ea1ch t\u1ea1i ch\u1ed7.",localizati