waterbox_hoare_title:"\u05e0\u05d0 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05de\u05d9\u05db\u05dc \u05d4\u05de\u05d9\u05dd \u05d4\u05e0\u05e7\u05d9\u05d9\u05dd",localization_strings_abort_current_task_and_start_remote:"\u05d4\u05e4\u05e2\u05dc\u05ea \"\u05e9\u05dc\u05d9\u05d8\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7\" \u05ea\u05e9\u05d4\u05d4 \u05d0\u05ea \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9",localization_strings_abort_current_task_and_start_goto:"\u05d4\u05e4\u05e2\u05dc\u05ea \"Pin n Go\" \u05ea\u05e9\u05d4\u05d4 \u05d0\u05ea \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9.",robot_start_type_huawei:"HUAWEI",robot_start_type_hisense:"Hisense",robot_start_type_green_rice:"Aqara",robot_start_type_alipay:"Alipay",robot_start_type_wechat:"WeChat",robot_start_type_siri:"Siri",robot_start_type_jd:"Dingdong",robot_start_type_baidu:"Duer",robot_start_type_tmall:"TmallGenie",robot_start_type_little_love:"Xiaoai",robot_start_type_homekit:"HomeKit",robot_start_type_yandex:"Yandex",robot_start_type_ifttt:"IFTTT",robot_start_type_google:"Google",robot_start_type_alexa:"Alexa",video_error115_resolve:"\u05e4\u05e2\u05d5\u05dc\u05d4 \u05ea\u05db\u05d5\u05e4\u05d4 \u05de\u05d3\u05d9. \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1 \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8.",video_error114_resolve:"\u05e9\u05d2\u05d9\u05d0\u05ea \u05e8\u05e9\u05ea \u05d1\u05d8\u05dc\u05e4\u05d5\u05df \u05d0\u05d5 \u05d1\u05e8\u05d5\u05d1\u05d5\u05d8. \u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8 \u05dc\u05e8\u05e9\u05ea \u05d0\u05d5 \u05e2\u05d1\u05d5\u05e8 \u05dc\u05e8\u05e9\u05ea \u05d0\u05d7\u05e8\u05ea \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",video_error108_resolve:"\u05e9\u05d2\u05d9\u05d0\u05ea \u05d7\u05d9\u05d1\u05d5\u05e8 \u05e8\u05e9\u05ea. \u05d0\u05e0\u05d0 \u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8 \u05e9\u05dc\u05da \u05dc\u05e8\u05e9\u05ea \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",video_error107_resolve:"\u05d4\u05de\u05e9\u05d0\u05d1 \u05ea\u05e4\u05d5\u05e1. \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1 \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8.",video_error105_resolve:"\u05d4\u05e4\u05e2\u05dc \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05d7\u05d3\u05e9 \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",video_error104_resolve:"\u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05d4\u05e1\u05e8\u05d8\u05d5\u05df \u05de\u05d5\u05e6\u05d2 \u05d1\u05d8\u05dc\u05e4\u05d5\u05df \u05d0\u05d7\u05e8. \u05d0\u05dd \u05dc\u05d0, \u05d4\u05de\u05ea\u05df \u05d3\u05e7\u05d4 \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",video_error103_resolve:"\u05d0\u05e0\u05d0 \u05d4\u05e9\u05d1\u05ea \u05d5\u05d0\u05d6 \u05d4\u05e4\u05e2\u05dc \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05d4\u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7 \u05d0\u05d5 \u05d4\u05ea\u05d7\u05dc \u05d0\u05ea \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05de\u05d7\u05d3\u05e9 \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",video_error102_resolve:"\u05e9\u05d2\u05d9\u05d0\u05ea \u05de\u05e6\u05dc\u05de\u05d4. \u05d4\u05e4\u05e2\u05dc \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",video_error101_resolve:"\u05d9\u05e9 \u05dc\u05d4\u05e8\u05d7\u05d9\u05e7 \u05d0\u05ea \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05de\u05ea\u05d7\u05e0\u05ea \u05d4\u05d8\u05e2\u05d9\u05e0\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05e1\u05e8\u05d8\u05d5\u05df.",video_error100_resolve:"\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05e8\u05e9\u05ea \u05e0\u05db\u05e9\u05dc\u05d4. \u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8 \u05dc\u05e8\u05e9\u05ea \u05e9\u05dc \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",dust_collection_info:"\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05ea\u05e8\u05d5\u05e7\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05e0\u05d9\u05e7\u05d5\u05d9. * \u05e8\u05d9\u05e7\u05d5\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05dc\u05d0 \u05d9\u05ea\u05e8\u05d7\u05e9 \u05d1\u05de\u05e6\u05d1 DND.",map_edit_carpet_ignore_confirm_cancel:"\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e9\u05d8\u05d9\u05d7\u05d9\u05dd \u05d9\u05d7\u05d6\u05d5\u05e8 \u05dc\u05e2\u05d1\u05d5\u05d3 \u05d1\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d1\u05d0 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05de\u05d7\u05d9\u05e7\u05d4.",map_edit_carpet_ignore_confirm_ignore:"\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e9\u05d8\u05d9\u05d7\u05d9\u05dd \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05d9\u05d5\u05e9\u05d1\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d4\u05de\u05d7\u05d9\u05e7\u05d4. ",map_edit_carpet_ignore_title:"\u05e2\u05e8\u05d5\u05da \u05e9\u05d8\u05d9\u05d7",carpet_clean_mode_setting_ignore_carpet:"\u05ea\u05e7\u05dc\u05d4 \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9? \u05e2\u05d1\u05d5\u05e8 \u05dc\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea.",manual_save_handler:"\u05d0\u05dd \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e0\u05e9\u05de\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea, \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05de\u05d5\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05d2\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9 \u05dc\u05d0\u05d7\u05e8 \u05e1\u05d9\u05d5\u05dd \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8",robot_clean_status_only_mop:"\u05e9\u05d8\u05d9\u05e4\u05d4",robot_clean_status_only_clean:"\u05e9\u05d0\u05d9\u05d1\u05d4",tanos_s_mop_mode_info1:"\u05db\u05d3\u05d9 \u05dc\u05d0\u05d6\u05df \u05d1\u05d9\u05df \u05d1\u05d9\u05e6\u05d5\u05e2\u05d9 \u05d4\u05e9\u05d8\u05d9\u05e4\u05d4 \u05dc\u05de\u05e9\u05da \u05d7\u05d9\u05d9 \u05d4\u05e1\u05d5\u05dc\u05dc\u05d4, \u05d4\u05e1\u05e4\u05e7 \u05d4\u05d9\u05e0\u05d9\u05e7\u05d4 \u05d9\u05e7\u05d8\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d5\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d9\u05d4\u05d9\u05d4 \u05dc\u05db\u05d5\u05d5\u05df \u05d0\u05d5\u05ea\u05d5 \u05d1\u05de\u05e6\u05d1 \u05e2\u05d5\u05de\u05e7. \u05de\u05e6\u05d1 \u05d6\u05d4 \u05de\u05ea\u05d0\u05d9\u05dd \u05d0\u05da \u05d5\u05e8\u05e7 \u05dc\u05e8\u05e6\u05e4\u05d4 \u05e9\u05e0\u05e9\u05d0\u05d1\u05d4.",tanos_s_mop_mode_title:"\u05e9\u05d8\u05d9\u05e4\u05d4 \u05e2\u05de\u05d5\u05e7\u05d4 \u05dc\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9",multi_floor_edit:"\u05e2\u05e8\u05d9\u05db\u05d4",ask_whether_back_to_charge:"\u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05e0\u05e2\u05e6\u05e8. \u05dc\u05d7\u05d6\u05d5\u05e8 \u05dc\u05ea\u05d7\u05e0\u05ea \u05d4\u05d8\u05e2\u05d9\u05e0\u05d4?",map_edit_virtual_wall_and_forbidden_zone_info3:"\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05d7\u05d5\u05e5 \u05dc\u05ea\u05d7\u05d5\u05dd: \u05de\u05e0\u05e2 \u05de\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05dc\u05d4\u05d9\u05db\u05e0\u05e1 \u05dc\u05d0\u05d6\u05d5\u05e8 \u05de\u05e1\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9.",home_dialog_begin_new_back_washing_duster:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05ea\u05d1\u05e6\u05e2. \u05dc\u05e1\u05d9\u05d9\u05dd \u05d0\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea \u05d5\u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05dc\u05e9\u05d8\u05d5\u05e3 \u05d0\u05ea \u05d4\u05e1\u05d7\u05d1\u05d4?",robot_cmd_stop_washing_duster:"\u05d4\u05e4\u05e1\u05e7 \u05e9\u05d8\u05d9\u05e4\u05d4",robot_cmd_start_washing_duster:"\u05d7\u05d6\u05d5\u05e8 \u05dc\u05e9\u05d8\u05d9\u05e4\u05ea \u05d4\u05e1\u05d7\u05d1\u05d4",robot_status_back_dock_washing_duster:"\u05d4\u05d5\u05dc\u05da \u05dc\u05e9\u05d8\u05d5\u05e3 \u05d0\u05ea \u05d4\u05de\u05d2\u05d1",robot_status_washing_duster:"\u05e9\u05d5\u05d8\u05e3 \u05d0\u05ea \u05d4\u05e1\u05d7\u05d1\u05d4",map_edit_bottom_menu_order_info1:"\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d3\u05e8 \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05e2\u05dc\u05d9\u05da \u05dc\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d7\u05d3\u05e8\u05d9\u05dd.",map_edit_bottom_menu_order_title:"\u05e0\u05d4\u05dc \u05d0\u05ea \u05e1\u05d3\u05e8 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9",map_edit_virtual_wall_and_forbidden_zone_info2:"\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e9\u05d8\u05d9\u05e4\u05d4: \u05de\u05e0\u05e2 \u05de\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05dc\u05d4\u05d9\u05db\u05e0\u05e1 \u05dc\u05d0\u05d6\u05d5\u05e8 \u05de\u05e1\u05d5\u05d9\u05d9\u05dd \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d2\u05d1 \u05de\u05d7\u05d5\u05d1\u05e8.",map_edit_virtual_wall_and_forbidden_zone_info1:"\u05de\u05d7\u05e1\u05d5\u05de\u05d9\u05dd \u05d5\u05d9\u05e8\u05d8\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd/\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05d7\u05d5\u05e5 \u05dc\u05ea\u05d7\u05d5\u05dd \u05de\u05e0\u05e2 \u05de\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05dc\u05d4\u05d9\u05db\u05e0\u05e1 \u05dc\u05d0\u05d6\u05d5\u05e8 \u05de\u05e1\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9.",map_edit_virtual_wall_and_forbidden_zone_title:"\u05d4\u05d2\u05d3\u05e8 \u05d0\u05d6\u05d5\u05e8\u05d9 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05dd \u05de\u05d7\u05e1\u05d5\u05de\u05d9\u05dd \u05d5\u05d9\u05e8\u05d8\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd",map_edit_zone_zone_info:"\u05e4\u05d4 \u05e0\u05d9\u05ea\u05df \u05dc\u05de\u05d6\u05d2, \u05dc\u05e4\u05e6\u05dc \u05d5\u05dc\u05ea\u05ea \u05e9\u05de\u05d5\u05ea \u05dc\u05db\u05dc \u05d4\u05d7\u05d3\u05e8\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea.",map_edit_zone_title:"\u05e2\u05e8\u05d9\u05db\u05ea \u05d7\u05d3\u05e8\u05d9\u05dd",room_name_already_in_use:"\u05d4\u05e9\u05dd \u05e9\u05dc \u05d7\u05d3\u05e8 \u05d6\u05d4 \u05db\u05d1\u05e8 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d6\u05d5\u05e8 \u05d0\u05d7\u05e8",tanos_custom_mode_title:"\u05d4\u05ea\u