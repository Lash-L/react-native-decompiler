05ea \u05de\u05e6\u05d1 \u05d4\"\u05e7\u05d5\u05e4\u05d9\u05d3\u05d5\u05df\"! \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4, \u05d4-Roborock \u05e9\u05dc\u05db\u05dd \u05d9\u05d1\u05d8\u05d0 \u05d0\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea\u05d9\u05d5 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05db\u05dc\u05e4\u05d9 \u05e9\u05d5\u05d0\u05d1\u05d9 \u05d0\u05d1\u05e7 \u05e8\u05d5\u05d1\u05d5\u05d8\u05d9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd. \u05d4\u05e9\u05d5\u05d0\u05d1 \u05d0\u05d1\u05e7 \u05dc\u05d0 \u05de\u05e4\u05dc\u05d4 \u05dc\u05e4\u05d9 \u05de\u05d5\u05ea\u05d2 \u05d0\u05d5 \u05e6\u05d1\u05e2. \u05db\u05e9\u05d4-S7 MaxV \u05e9\u05dc\u05db\u05dd \u05e8\u05d5\u05d0\u05d4 \u05e8\u05d5\u05d1\u05d5\u05d8 \u05d0\u05d7\u05e8, \u05d4\u05d5\u05d0 \u05d9\u05d1\u05d8\u05d0 \u05d0\u05ea \u05d7\u05d9\u05d1\u05ea\u05d5 \u05d0\u05dc\u05d9\u05d5 \u05e2\u05dd \u05e0\u05e9\u05d9\u05e7\u05d4 \u05e2\u05d3\u05d9\u05e0\u05d4.\n\n\u05d0\u05d6\u05d4\u05e8\u05d4: Roborock \u05d0\u05d9\u05e0\u05d4 \u05d0\u05d7\u05e8\u05d0\u05d9\u05ea \u05e2\u05dc \u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05e8\u05d5\u05d1\u05d5\u05d8\u05d9\u05d9\u05dd \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d0\u05d9\u05d7\u05d5\u05d3 \u05d6\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d5\u05e9\u05d0\u05ea \u05e9\u05d5\u05dd \u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05dc\u05d4\u05ea\u05e7\u05d5\u05de\u05de\u05d5\u05ea \u05d4\u05de\u05db\u05d5\u05e0\u05d5\u05ea.",egg_attack_start_title:"\u05d4\u05ea\u05d7\u05dc",armap_match_failed:"\u05de\u05e4\u05d4 \u05de\u05d5\u05ea\u05d0\u05de\u05ea",armap_match_success:"\u05de\u05e4\u05d4 \u05de\u05d5\u05ea\u05d0\u05de\u05ea",armap_delete_confirm:"\u05d4\u05d0\u05dd \u05d0\u05ea\u05d4 \u05d1\u05d8\u05d5\u05d7 \u05e9\u05d1\u05e8\u05e6\u05d5\u05e0\u05da \u05dc\u05de\u05d7\u05d5\u05e7 \u05d0\u05ea  \u05de\u05e4\u05ea Matrix?",armap_scan_save_mesh_failed_toast:"\u05e9\u05de\u05d9\u05e8\u05d4 \u05e0\u05db\u05e9\u05dc\u05d4",armap_scan_stop_confirm:"\u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 \u05de\u05d9\u05e4\u05d5\u05d9 Matrix?",monitor_voice_privacy_dialog_title:"\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 \u05e9\u05d9\u05d7\u05d5\u05ea \u05d5\u05d9\u05d3\u05d0\u05d5",camera_monitor_voice_privacy_title:"\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 \u05e9\u05d9\u05d7\u05d5\u05ea \u05d5\u05d9\u05d3\u05d0\u05d5 ",armap_guide_title3:"3. \u05d9\u05e9 \u05dc\u05e1\u05d9\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d5\u05d4\u05de\u05d9\u05e4\u05d5\u05d9 \u05d5\u05d0\u05d6 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05dc\u05d4\u05ea\u05d0\u05de\u05d4.",armap_guide_title2:"2. \u05d9\u05e9 \u05dc\u05e0\u05d5\u05e2 \u05de\u05e1\u05d1\u05d9\u05d1 \u05dc\u05d7\u05d3\u05e8, \u05ea\u05d5\u05da \u05e9\u05d0\u05ea\u05d4 \u05de\u05d5\u05d5\u05d3\u05d0 \u05dc\u05e1\u05e8\u05d5\u05e7 \u05d0\u05ea \u05db\u05dc \u05d4\u05e7\u05d9\u05e8\u05d5\u05ea, \u05d4\u05e8\u05e6\u05e4\u05d5\u05ea \u05d5\u05d4\u05e4\u05d9\u05e0\u05d5\u05ea.",armap_guide_title1:"1. \u05d9\u05e9 \u05dc\u05e1\u05e8\u05d5\u05e7 \u05d1-Matrix \u05d0\u05ea \u05d4\u05de\u05e4\u05d4 \u05d4\u05e2\u05d3\u05db\u05e0\u05d9\u05ea.",armap_guide_title:"\u05de\u05d3\u05e8\u05d9\u05da \u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05d9\u05e4\u05d5\u05d9 Matrix",armap_privacy_dialog_title1:"\u05dc\u05d0\u05d7\u05e8 \u05d4\u05e9\u05d9\u05de\u05d5\u05e9, \u05d3\u05d2\u05dd \u05d4\u05ea\u05dc\u05ea \u05de\u05d9\u05de\u05d3 \u05d9\u05d0\u05d5\u05d7\u05e1\u05df \u05d1\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05e6\u05d5\u05e8\u05da \u05de\u05d9\u05e4\u05d5\u05d9 Matrix. \u05e0\u05d0 \u05dc\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05d0\u05dc .",armap_privacy_dialog_title:"\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05dc\u05de\u05d9\u05e4\u05d5\u05d9 \u05d1\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05e8\u05d1\u05d5\u05d3\u05d4 (Matrix)",smart_scene_clean_mode