43\u0435\u043c\u043e\u0433\u043e \u043e\u0434\u043d\u0438\u043c \u043d\u0430\u0436\u0430\u0442\u0438\u0435\u043c, \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0440\u0430\u0441\u0445\u043e\u0434\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432 \u0438 \u043e\u0431\u043b\u0430\u0434\u0430\u0435\u0442 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c\u044e \u0432\u0441\u0430\u0441\u044b\u0432\u0430\u043d\u0438\u044f. \u041e\u0431\u044a\u0435\u043c \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0430 \u0434\u043b\u044f \u0441\u0431\u043e\u0440\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 1,5\xa0\u043b. \u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u043e\u043f\u043e\u0440\u043e\u0436\u043d\u044f\u0442\u044c \u0435\u0433\u043e \u043a\u0430\u0436\u0434\u044b\u0435 1 \u0438\u043b\u0438 2 \u043c\u0435\u0441\u044f\u0446\u0430.",dust_collection_life3:"\u041a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 \u0434\u043b\u044f \u0441\u0431\u043e\u0440\u0430 \u043f\u044b\u043b\u0438 \u043e\u043f\u043e\u0440\u043e\u0436\u043d\u0435\u043d. OK?",dust_collection_life2:"\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043e\u043f\u043e\u0440\u043e\u0436\u043d\u0438\u0442\u044c \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 \u0434\u043b\u044f \u0441\u0431\u043e\u0440\u0430 \u043f\u044b\u043b\u0438.",dust_collection_life1:"\u041a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440 \u0434\u043b\u044f \u0441\u0431\u043e\u0440\u0430 \u043f\u044b\u043b\u0438",smart_scene_global_title:"\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441",voice_chat_title2:"\u0412 \u0432\u0438\u0434\u0435\u043e\u0432\u044b\u0437\u043e\u0432\u0435. \u041d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c