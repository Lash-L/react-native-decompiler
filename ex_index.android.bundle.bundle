o:"Sau khi t\xf9y ch\u1ec9nh ch\u1ebf \u0111\u1ed9 l\xe0m s\u1ea1ch, t\u1eebng ph\xf2ng s\u1ebd \u0111\u01b0\u1ee3c l\xe0m s\u1ea1ch theo c\xe0i \u0111\u1eb7t c\xe1 nh\xe2n c\u1ee7a b\u1ea1n. *\u1ede nh\u1eefng khu v\u1ef1c ch\u01b0a \u0111\u01b0\u1ee3c \u0111\u1eb7t, robot s\u1ebd l\xe0m s\u1ea1ch theo ch\u1ebf \u0111\u1ed9 m\u1eb7c \u0111\u1ecbnh.",tanos_s_mop_mode:"Tuy\u1ebfn \u0111\u01b0\u1eddng lau",tanos_s_mop_mode_general_frag:"Th\xf4ng th\u01b0\u1eddng",tanos_s_mop_mode_fine_frag:"S\xe2u",localization_strings_Common_custom_mode:"T\xf9y ch\u1ec9nh",introduction_to_image_uploading8:"Xui l\xf2ng ki\u1ec3m tra \u0111\u1ec3 x\xe1c nh\u1eadn r\u1eb1ng \u1ea3nh kh\xf4ng ch\u1ee9a b\u1ea5t k\u1ef3 th\xf4ng tin c\xe1 nh\xe2n n\xe0o c\u1ee7a b\u1ea1n",collecting_dusk_error35_desc:"Kh\xf4ng th\u1ec3 l\xe0m tr\u1ed1ng h\u1ed9p \u0111\u1ef1ng b\u1ee5i",collecting_dusk_error35_title:"L\u1ed7i \u0111i\u1ec7n \xe1p b\u1ea5t th\u01b0\u1eddng c\u1ee7a \u0111\u1ebf s\u1ea1c",collecting_dusk_error34_desc:"H\u1ed9p \u0111\u1ef1ng b\u1ee5i tr\xean dock s\u1ea1c, b\u1ed9 l\u1ecdc ho\u1eb7c \u1ed1ng d\u1eabn kh\xed b\u1ecb k\u1eb9t, h\xe3y ki\u1ec3m tra v\xe0 v\u1ec7 sinh.",collecting_dusk_error34_title:"H\xe3y th\xe1o r\u1eddi v\xe0 l\xe0m s\u1ea1ch th\xf9ng ch\u1ee9a b\u1ee5i",collecting_dusk_error33_desc:"H\xe3y ki\u1ec3m tr\u1ecb v\u1ecb tr\xed l\u1eafp \u0111\u1eb7t c\u1ee7a th\xf9ng ch\u1ee9a b\u1ee5i v\xe0 m\xe0ng l\u1ecdc b\u1ee5i",collecting_dusk_error33_title:"L\u1ed7i qu\u1ea1t dock s\u1ea1c t\u1ef1 \u0111\u1ed9ng l\xe0m tr\u1ed1ng",collecting_dusk_error32_desc:"H\xe3y l\u1eafp th\xf9ng ch\u1ee9a b\u1ee5i v\xe0 m\xe0ng l\u1ecdc",collecting_dusk_error32_title:"H\u1ed9p b\u1ee5i ho\u1eb7c m\xe0ng l\u1ecdc ch\u01b0a \u0111\u01b0\u1ee3c l\u1eafp",robot_status_collecting_dust:"\u0110ang h\xfat b\u1ee5i",mainpage_stop_collect_dust:"D\u1eebng h\xfat b\u1ee5i",monitor_obstacle_tip_right:"Robot kh\xf4ng di chuy\u1ec3n sang ph\u1ea3i \u0111\u01b0\u1ee3c. Vui l\xf2ng \u0111\u1ed5i h\u01b0\u1edbng.",monitor_obstacle_tip_left:"Robot kh\xf4ng di chuy\u1ec3n sang tr\xe1i \u0111\u01b0\u1ee3c. Vui l\xf2ng \u0111\u1ed5i h\u01b0\u1edbng.",monitor_obstacle_tip_front:"Robot kh\xf4ng di chuy\u1ec3n v\u1ec1 ph\xeda tr\u01b0\u1edbc \u0111\u01b0\u1ee3c. Vui l\xf2ng \u0111\u1ed5i h\u01b0\u1edbng.",image_processing_failure:"X\u1eed l\xfd th\u1ea5t b\u1ea1i",introduction_to_image_uploading7:"T\u1ea3i l\xean th\u1ea5t b\u1ea1i",introduction_to_image_uploading6:"C\u1ea3m \u01a1n b\u1ea1n \u0111\xe3 \u0111\xf3ng g\xf3p cho s\u1ef1 c\u1ea3i thi\u1ec7n c\u1ee7a\u2026.",introduction_to_image_uploading5:"T\u1ea3i l\xean",introduction_to_image_uploading4:"T\xf4i x\xe1c nh\u1eadn r\u1eb1ng \u1ea3nh kh\xf4ng ch\u1ee9a b\u1ea5t k\u1ef3 th\xf4ng tin c\xe1 nh\xe2n n\xe0o c\u1ee7a t\xf4i",introduction_to_image_uploading3:"3. N\u1ebfu b\u1ea1n c\xf3 c\xe2u h\u1ecfi li\xean quan \u0111\u1ebfn v\u1ea5n \u0111\u1ec1 b\u1ea3o v\u1ec7 quy\u1ec1n ri\xeang t\u01b0, vui l\xf2ng tham kh\u1ea3o Ch\xednh s\xe1ch Quy\u1ec1n ri\xeang t\u01b0 v\xe0 li\xean h\u1ec7 v\u1edbi ch\xfang t\xf4i qua th\xf4ng tin li\xean h\u1ec7 \u0111\u01b0\u1ee3c cung c\u1ea5p t\u1ea1i \u0111\xf3.",introduction_to_image_uploading2:"2. B\u1eb1ng c\xe1ch nh\u1ea5n v\xe0o T\u1ea3i l\xean, \u1ea3nh \u0111\xe3 g\u1eedi v\xe0 lo\u1ea1i v\u1eadt c\u1ea3n \u0111\xe3 ch\u1ecdn s\u1ebd \u0111\u01b0\u1ee3c t\u1ea3i l\xean \u0111\xe1m m\xe2y d\u01b0\u1edbi h\xecnh th\u1ee9c \u1ea9n danh. Tr\u01b0\u1edbc khi \u1ea3nh \u0111\u01b0\u1ee3c t\u1ea3i l\xean m\xe1y ch\u1ee7, m\u1ed9t thu\u1eadt to\xe1n lo\u1ea1i b\u1ecf y\u1ebfu t\u1ed1 nh\u1ea1y c\u1ea3m s\u1ebd \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 x\u1eed l\xfd th\xf4ng tin nh\u1ea1y c\u1ea3m c\xf3 th\u1ec3 c\xf3 trong \u1ea3nh (ch\u1eb3ng h\u1ea1n nh\u01b0 th\xf4ng tin nh\u1eadn di\u1ec7n khu\xf4n m\u1eb7t, v.v.). \u1ea2nh \u0111\xe3 x\u1eed l\xfd s\u1ebd \u0111\u01b0\u1ee3c hi\u1ec3n th\u1ecb b\xean tr\xean \u0111\u1ec3 b\u1ea1n xem v\xe0 x\xe1c nh\u1eadn.",introduction_to_image_uploading1:"1. D\u1eef li\u1ec7u b\u1ea1n l\u1ef1a ch\u1ecdn t\u1ea3i l\xean ch\u1ec9 \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 hu\u1ea5n luy\u1ec7n m\xf4 h\xecnh nh\u1eadn di\u1ec7n nh\u1eb1m m\u1ee5c \u0111\xedch c\u1ea3i thi\u1ec7n t\u1ef7 l\u1ec7 nh\u1eadn di\u1ec7n c\u1ee7a thi\u1ebft b\u1ecb v\xe0 cung c\u1ea5p cho b\u1ea1n d\u1ecbch v\u1ee5 t\u1ed1t h\u01a1n.",image_processing_result:"K\u1ebft qu\u1ea3 x\u1eed l\xfd \u1ea3nh",image_processing:"\u0110ang x\u1eed l\xfd \u1ea3nh...",obstacle_photo_page_feedback:"\u0110\u01b0a ra ph\u1ea3n h\u1ed3i",obstacle_photo_page_ignore:"Bo\u0309 qua",obstacle_photo_page_identify_mistakes:"L\u1ed7i nh\u1eadn di\u1ec7n?",actual_type_of_obstacle:"Ch\u01b0\u1edbng ng\u1ea1i v\u1eadt lo\u1ea1i th\u1ef1c t\u1ebf",send_voice_again:"G\u1eedi l\u1ea1i",monitor_privacy_dialog_title:"Ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0  xem video tr\u1ef1c ti\u1ebfp",alert_button_disagree:"Kh\xf4ng \u0111\u1ed3ng \xfd",map_object_desc_sock:"V\xec c\u1ea3m bi\u1ebfn LDS c\xf3 h\u1ea1n ch\u1ebf v\u1ec1 \u0111\u1ed9 cao n\xean robot c\xf3 th\u1ec3 kh\xf4ng nh\u1eadn di\u1ec7n \u0111\u01b0\u1ee3c c\xe1c \u0111\u1ed3 v\u1eadt \u1edf d\u01b0\u1edbi th\u1ea5p trong nh\xe0, v\xed d\u1ee5 nh\u01b0 t\u1ea5t. Nh\u1eefng \u0111\u1ed3 v\u1eadt n\xe0y c\xf3 th\u1ec3 khi\u1ebfn ch\u1ed5i ch\xednh v\xe0 ch\u1ed5i c\u1ea1nh b\u1ecb v\u01b0\u1edbng v\xe0 gi\xe1n \u0111o\u1ea1n c\xf4ng vi\u1ec7c l\xe0m s\u1ea1ch. Nh\u1eadn di\u1ec7n b\u1eb1ng AI gi\xfap robot tr\xe1nh c\xe1c \u0111\u1ed3 v\u1eadt n\xe0y, \u0111\u1ea3m b\u1ea3o t\xe1c v\u1ee5 l\xe0m s\u1ea1ch \u0111\u01b0\u1ee3c ho\xe0n th\xe0nh t\u1ed1t.",map_object_name_sock:"T\u1ea5t",gesture_password_title:"Vui l\xf2ng v\u1ebd m\u1eadt kh\u1ea9u",map_object_cancel_privacy_loading:"\u0111ang x\u1eed l\xfd d\u1eef li\u1ec7u...",monitor_bumper_tip_right:"Ph\xe1t hi\u1ec7n khu v\u1ef1c kh\xf4ng \u0111\u01b0\u1ee3c v\xe0o ho\u1eb7c t\u01b0\u1eddng v\xf4 h\xecnh b\xean ph\u1ea3i robot",monitor_bumper_tip_left:"Ph\xe1t hi\u1ec7n khu v\u1ef1c kh\xf4ng \u0111\u01b0\u1ee3c v\xe0o ho\u1eb7c t\u01b0\u1eddng v\xf4 h\xecnh b\xean tr\xe1i robot",monitor_bumper_tip_front:"Ph\xe1t hi\u1ec7n khu v\u1ef1c kh\xf4ng \u0111\u01b0\u1ee3c v\xe0o ho\u1eb7c t\u01b0\u1eddng v\xf4 h\xecnh ph\xeda tr\u01b0\u1edbc robot",use_celluar_for_monitor_tip:"B\u1ea1n \u0111ang xem video b\u1eb1ng d\u1eef li\u1ec7u di \u0111\u1ed9ng.",open_real_monitor_firstly_tip:"Vui l\xf2ng b\u1eadt ch\u1ee9c n\u0103ng xem video tr\u1ef1c ti\u1ebfp",connecting_video_security_channel:"\u0110ang thi\u1ebft l\u1eadp k\xeanh b\u1ea3o m\u1eadt \u0111\u1ec3 tuy\u1ec1n t\u1ea3i video...",map_object_cancel_privacy_stop:"K\u1ebft th\xfac",map_object_cancel_privacy_timeout:"H\u1ebft th\u1eddi gian thu h\u1ed3i. Th\u1eed l\u1ea1i.",map_object_cancel_privacy_success:"Thu h\u1ed3i th\xe0nh c\xf4ng",map_object_cancel_privacy_stop_robot_alert:"Vi\u1ec7c thu h\u1ed3i ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 s\u1ebd k\u1ebft th\xfac t\xe1c v\u1ee5 hi\u1ec7n t\u1ea1i.",map_object_desc_general_structure_light:"B\u1eb1ng c\xe1ch s\u1eed d\u1ee5ng \xe1nh s\xe1ng c\u1ea5u tr\xfac nh\u1edd s\u1ef1 h\u1ed7 tr\u1ee3 c\u1ee7a m\u1ed9t lo\u1ea1t c\xe1c c\u1ea3m bi\u1ebfn kh\xe1c, robot c\xf3 th\u1ec3 tr\xe1nh m\u1ed9t lo\u1ea1t c\xe1c ch\u01b0\u1edbng ng\u1ea1i v\u1eadt kh\xe1c nhau.",map_object_desc_general:"Th\xf4ng qua camera hai m\u1eaft v\xe0 kh\u1ea3 n\u0103ng ph\xe1n \u0111o\xe1n t\u1ed5ng h\u1ee3p \u0111a c\u1ea3m bi\u1ebfn, robot c\xf3 th\u1ec3 tr\xe1nh c\xe1c v\u1eadt d\u1ee5ng tr\xean s\xe0n m\u1ed9t c\xe1ch th\xf4ng minh c\xf3 th\u1ec3 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn qu\xe1 tr\xecnh l\xe0m s\u1ea1ch c\u1ee7a robot.",map_object_privacy_alert_link:"Ch\xednh s\xe1ch Quy\u1ec1n ri\xeang t\u01b0 v\u1ec1 h\xecnh \u1ea3nh tr\u1ef1c ti\u1ebfp",map_object_privacy_alert:"Khi \u0111\xe3 k\xedch ho\u1ea1t, h\xecnh \u1ea3nh s\u1ebd \u0111\u01b0\u1ee3c l\u01b0u trong b\u1ed9 nh\u1edb c\u1ee7a robot \u0111\u1ec3 xem l\u1ea1i. \u0110\u1ec3 bi\u1ebft th\xeam chi ti\u1ebft, h\xe3y tham kh\u1ea3o",map_object_privacy_reset_dialog_content:"Sau khi \u1ee7y quy\u1ec1n b\u1ecb thu h\u1ed3i, b\u1ea1n s\u1ebd kh\xf4ng th\u1ec3 s\u1eed d\u1ee5ng ch\u1ee9c n\u0103ng \u1ea3nh tr\u1ef1c ti\u1ebfp n\u1eefa v\xe0 b\u1ea1n s\u1ebd c\u1ea7n ph\u1ea3i \u1ee7y quy\u1ec1n l\u1ea1i.",map_object_privacy_title:"Ch\xednh s\xe1ch Quy\u1ec1n ri\xeang t\u01b0 v\u1ec1 h\xecnh \u1ea3nh tr\u1ef1c ti\u1ebfp",map_object_enable_intro:"Nh\u1ea5p v\xe0o bi\u1ec3u t\u01b0\u1ee3ng ch\u01b0\u1edbng ng\u1ea1i v\u1eadt tr\xean b\u1ea3n \u0111\u1ed3 \u0111\u1ec3 xem \u1ea3nh c\u1ee7a \u0111\u1ed1i t\u01b0\u1ee3ng. *Ch\u1ec9 c\xf3 m\u1ed9t b\u1ee9c \u1ea3nh c\u1ee7a m\u1ed7i \u0111\u1ed1i t\u01b0\u1ee3ng tr\xe1nh ch\u01b0\u1edbng ng\u1ea1i v\u1eadt \u0111\u01b0\u1ee3c l\u01b0u tr\u1eef tr\xean m\xe1y. Do \u1ea3nh h\u01b0\u1edfng c\u1ee7a \xe1nh s\xe1ng, g\xf3c quay, v.v., c\xf3 th\u1ec3 kh\xf4ng c\xf3 \u1ea3nh.",map_object_bubble_tip_avoid:"\u0110\xe3 tr\xe1nh",realtime_video_info:"Khi m\u1edf video",realtime_video_sub_title_3_1:"\u0110\xe8n b\xe1o s\u1ebd ch\u1edbp s\xe1ng nh\u01b0ng kh\xf4ng c\xf3 c\u1ea3nh b\xe1o b\u1eb1ng gi\u1ecdng n\xf3i.",realtime_video_title_3:"Nh\u1eafc nh\u1edf nhi\u1ec1u l\u1ea7n",realtime_video_title_2:"Nh\u1eafc nh\u1edf nh\u1eb9",realtime_video_title_1:"H\u01a1i l\xe0m phi\u1ec1n",realtime_video_title:"C\u1ea5p \u0111\u1ed9 c\u1ea3nh b\xe1o",confirm_start:"L\xe0m s\u1ea1ch & l\u1eadp b\u1ea3n \u0111\u1ed3",map_object_desc_henggan:"Tr\xe1nh \u0111\u1ed3 n\u1ed9i th\u1ea5t c\xf3 x\xe0 ngang, ch\u1eb3ng h\u1ea1n nh\u01b0 gh\u1ebf c\xf3 khung, \u0111\u1ec3 ng\u0103n kh\xf4ng b\u1ecb v\u01b0\u1edbng v\xe0o.",map_object_desc_poqi:"Tr\xe1nh x\u1ebbng h\u1ed1t r\xe1c v\xe0 nh\u1eefng v\u1eadt t\u01b0\u01a1ng t\u1ef1 \u0111\u1ec3 ng\u0103n kh\xf4ng \u0111\u1ec3 k\u1eb9t.",map_object_desc_zhiwu:"Nh\u1eadn di\u1ec7n v\u1ea3i, ng\u0103n ng\u1eeba r\u1ed1i v\xe0 b\u1ecb qu\u1ea5n v\u1ea3i.",map_object_desc_tizhongcheng:"Nh\u1eadn bi\u1ebft c\xe2n v\xe0 quay m\xe1y tr\xe1nh tr\u01b0\u1edbc \u0111\u1ec3 tr\xe1nh b\u1ecb \u0111\u1ea9y c\xe2n ho\u1eb7c b\u1ecb k\u1eb9t tr\xean c\xe2n.",map_object_desc_dizuo:"Nh\u1eadn bi\u1ebft c\xe1c \u0111\u1ed3 v\u1eadt gi\u1ed1ng \u0111\u1ebf v\xe0 quay \u0111\u1ea7u tr\xe1nh tr\u01b0\u1edbc \u0111\u1ec3 tr\xe1nh b\u1ecb m\u1eafc k\u1eb9t tr\xean \u0111\u1ebf.",map_object_desc_shoe:"Tr\xe1nh gi\xe0y/d\xe9p \u0111i trong nh\xe0 \u0111\u1ec3 ng\u0103n kh\xf4ng b\u1ecb v\u01b0\u1edbng v\xe0o.",map_object_desc_baba:"Tr\xe1nh ch\u1ea5t th\u1ea3i v\u1eadt nu\xf4i \u0111\u1ec3 kh\xf4ng g\xe2y b\u1ea9n, k\u1eb9t.",map_object_desc_chapai:"Nh\u1eadn bi\u1ebft \u1ed5 c\u1eafm \u0111i\u1ec7n \u0111\u1ec3 kh\xf4ng b\u1ecb v\u01b0\u1edbng.",map_object_desc_xian:"Nh\u1eadn bi\u1ebft c\xe1c c\u1ee5m c\xe1p d\u1eef li\u1ec7u v\xe0 c\xe1p ngu\u1ed3n  \u0111\u1ec3 ch\u1ee7 \u0111\u1ed9ng tr\xe1nh v\u01b0\u1edbng v\xe0o ch\u1ed5i ch\xednh ho\u1eb7c ch\u1ed5i ph\u1ee5. M\u1ed9t s\u1ed1 d\xe2y d\xe0i v\xe0 m\u1ecfng c\xf3 th\u1ec3 g\xe2y v\u01b0\u1edbng v\xedu.",obstacle_photo_page_ignore_desc:"1. N\xf3 ph\xf9 h\u1ee3p v\u1edbi nh\u1eefng robot x\xe1c \u0111\u1ecbnh sai ch\u01b0\u1edbng ng\u1ea1i v\u1eadt v\xe0 b\u1ecf s\xf3t vi\u1ec7c qu\xe9t ho\u1eb7c kh\xf4ng c\u1ea7n tr\xe1nh ch\u01b0\u1edbng ng\u1ea1i v\u1eadt.                      2. Khi \u0111\xe3 x\xf3a, robot s\u1ebd b\u1ecf qua m\u1ecdi \u0111\u1ed3 v\u1eadt t\u01b0\u01a1ng t\u1ef1 \u1edf v\u1ecb tr\xed n\xe0y.\r\n3. N\u1ebfu b\u1ea1n mu\u1ed1n kh\xf4i ph\u1ee5c nh\u1eadn d\u1ea1ng c\xe1c \u0111\u1ed3 v\u1eadt \u0111\xf3 \u1edf v\u1ecb tr\xed n\xe0y, vui l\xf2ng x\xf3a b\u1ea3n \u0111\u1ed3 n\xe0y v\xe0 ti\u1ebfn h\xe0nh thi\u1ebft l\u1eadp l\u1ea1i.",obstacle_photo_page_ignore_link:"Kh\xf4ng c\u1ea7n tr\xe1nh, b\u1ecf qua?",obstacle_photo_page_percent:"\u0110\u1ed9 tin c\u1eady:",obstacle_photo_page_subtitle:"K\u1ebft qu\u1ea3 nh\u1eadn di\u1ec7n:",retry_after_30_seconds:"Th\u1eed l\u1ea1i sau 30 gi\xe2y",video_func_is_locked:"\u0110\xe3 kh\xf3a m\u1eadt kh\u1ea9u h\xecnh m\u1edf kh\xf3a",gesture_password_at_least_four_length:"M\u1eadt kh\u1ea9u h\xecnh m\u1edf kh\xf3a \u0111\u01b0\u1ee3c t\u1ea1o b\u1eb1ng \xedt nh\u1ea5t 4 \u0111i\u1ec3m \u0111\u01b0\u1ee3c n\u1ed1i v\u1edbi nhau.",reset_gesture_password_tip:"Sau khi x\xe1c nh\u1eadn, m\u1eadt kh\u1ea9u s\u1ebd \u0111\u01b0\u1ee3c \u0111\u1eb7t l\u1ea1i v\xe0 video s\u1ebd b\u1ecb \u0111\xf3ng v\xe0 video kh\u1edfi \u0111\u1ed9ng c\u1ea7n \u0111\u01b0\u1ee3c k\xedch ho\u1ea1t l\u1ea1i.",forget_password:"Qu\xean m\u1eadt kh\u1ea9u",title_skip:"B\u1ecf qua",microphone_is_occupied:"Micro \u0111ang \u0111\u01b0\u1ee3c d\xf9ng. H\xe3y th\u1eed l\u1ea1i sau.",resetting_device_wifi_and_reconnecting:"N\xe2ng c\u1ea5p m\xf4 \u0111un WiFi, vui l\xf2ng kh\u1edfi \u0111\u1ed9ng l\u1ea1i thi\u1ebft b\u1ecb WiFi v\xe0 k\u1ebft n\u1ed1i l\u1ea1i \u0111\u1ec3 s\u1eed d\u1ee5ng ch\u1ee9c n\u0103ng n\xe0y",upgrading_the_App_to_the_latest_version:"Phi\xean b\u1ea3n \u1ee9ng d\u1ee5ng th\u1ea5p, vui l\xf2ng n\xe2ng c\u1ea5p l\xean phi\xean b\u1ea3n m\u1edbi nh\u1ea5t.",playing_now_please_try_again_later:"\u0110ang ph\xe1t gi\u1ecdng n\xf3i, vui l\xf2ng th\u1eed l\u1ea1i sau",no_recording_is_available:"Kh\xf4ng c\xf3 b\u1ea3n ghi gi\u1ecdng n\xf3i",ask_if_go_record_setting:"B\u1ea1n c\xf3 mu\u1ed1n k\xedch ho\u1ea1t c\xe1c t\xednh n\u0103ng gi\u1ecdng n\xf3i?",whether_to_delete_the_recorded:"X\xe1c nh\u1eadn x\xf3a b\u1ea3n ghi \xe2m n\xe0y?",let_go_of_send_up_slide_to_cancel:"K\xe9o xu\u1ed1ng \u0111\u1ec3 g\u1eedi, tr\u01b0\u1ee3t l\xean \u0111\u1ec3 h\u1ee7y",up_to_15s_can_be_recorded:"Th\u1eddi l\u01b0\u1ee3ng ghi \xe2m t\u1ed1i \u0111a l\xe0 15 gi\xe2y",send_voice_fail:"Kh\xf4ng th\u1ec3 g\u1eedi",send_voice_success:"\u0110\xe3 g\u1eedi",long_press_to_send_voice:"Nh\u1ea5n v\xe0 gi\u1eef \u0111\u1ec3 truy\u1ec1n/ph\xe1t",send_voice_record:"Ghi l\u1ea1i gi\u1ecdng n\xf3i",begin_draw_new_gesture_password:"B\u1eaf