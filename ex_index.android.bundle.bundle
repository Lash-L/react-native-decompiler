 TV",map_edit_furniture_dinner_table:"Set Meja Makan",map_edit_furniture_double_bed:"Katil",map_edit_furniture_single_bed:"Katil",map_edit_furniture_count_tip_miapp:"Sehingga ${max} item perabot boleh diedit sekali gus. Simpan untuk mengedit ${count} item lain.",map_edit_furniture_max_tip_miapp:"Had edit dicapai. Simpan pengeditan semasa untuk meneruskan.",mode_setting_panel_custom_water_box_7:"Sedikit",mode_setting_panel_custom_water_box_6:"Rendah",localization_strings_Main_Constants_127:"Sila pasang dan cabut bekalan kuasa dan cuba lagi.",localization_strings_Main_Constants_126:"Kelainan di dalam pangkalan dikesan, pasang dan cabut bekalan elektrik dan cuba lagi.",inner_error_desc_150:"Ralat injap solenoid",inner_error_desc_134:"Ralat suis pam udara",inner_error_desc_131:"Lebihan arus pam peristaltik tangki air bersih",inner_error_desc_130:"Tiada data daripada ODO pam peristaltik tangki air bersih",inner_error_desc_127:"Ralat IIC Dok",inner_error_desc_126:"Ralat Kipas Dok",sound_package_download_failed:"muat turun gagal",camera_setting_detail5:"Memantau persekitaran rumah secara aktif dan mengenal pasti beberapa jenis perabot dan lantai. *Hasil pengecaman bergantung kepada pencahayaan dan sudut serta hanya sebagai rujukan.",camera_setting_detail4:"Pengecaman Persekitaran AI",camera_setting_detail3:"AI mengenal pasti dan mengelakkan halangan lantai dengan pintar bagi mengurangkan kemalangan.",camera_setting_detail2:"Pengelakan Halangan Reaktif",camera_setting_detail1:"Matikan video langsung",smart_scene_firmware_zone_reach_max_count:"Bilangan maksimum bilik telah dicapai",map_edit_mode_smart_tip:"Menetapkan mod pembersihan untuk setiap bilik mengikut jenis lantai dan bilik secara automatik.",map_edit_mode_smart:"Pintar",map_edit_floor_other:"Lalai",map_edit_floor_wood:"Kayu",map_edit_floor_tile:"Jubin",map_edit_floor_select_segment_tip:"Pilih bilik untuk menetapkan jenis lantai",map_edit_floor:"Jenis Lantai",back_wash_desc1:"Tetapkan Kekerapan Cucian (dalam minit)"