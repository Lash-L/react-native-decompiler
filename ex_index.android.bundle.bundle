\u05dd \u05dc\u05d4\u05e1\u05ea\u05d1\u05da.",obstacle_photo_page_ignore_desc:"1. \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05d6\u05d0\u05ea \u05e0\u05d5\u05e2\u05d3\u05d4 \u05dc\u05de\u05db\u05e9\u05d5\u05dc\u05d9\u05dd \u05e9\u05d6\u05d5\u05d4\u05d5 \u05dc\u05d0 \u05e0\u05db\u05d5\u05df \u05d0\u05d5 \u05d0\u05dd \u05d0\u05ea\u05d4 \u05dc\u05d0 \u05e8\u05d5\u05e6\u05d4 \u05e9\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05de\u05e0\u05e2 \u05de\u05d7\u05e4\u05e5 \u05d6\u05d4 \u05d1\u05e2\u05ea\u05d9\u05d3.\n2. \u05dc\u05d0\u05d7\u05e8 \u05d4\u05de\u05d7\u05d9\u05e7\u05d4, \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05ea\u05e2\u05dc\u05dd \u05de\u05db\u05dc \u05d4\u05d7\u05e4\u05e6\u05d9\u05dd \u05de\u05e1\u05d5\u05d2 \u05d6\u05d4 \u05d1\u05d0\u05d6\u05d5\u05e8.\n3. \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e8\u05d5\u05d1\u05d5\u05d8 \u05dc\u05d6\u05d4\u05d5\u05ea \u05d7\u05e4\u05e5 \u05d6\u05d4 \u05e9\u05d5\u05d1, \u05d9\u05e9 \u05dc\u05de\u05d7\u05d5\u05e7 \u05d0\u05ea \u05d4\u05de\u05e4\u05d4 \u05d5\u05dc\u05d1\u05e6\u05e2 \u05de\u05d9\u05e4\u05d5\u05d9 \u05de\u05d7\u05d3\u05e9.",obstacle_photo_page_ignore_link:"\u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05dc\u05d4\u05ea\u05d7\u05de\u05e7, \u05dc\u05d4\u05ea\u05e2\u05dc\u05dd?",obstacle_photo_page_percent:"\u05d1\u05d9\u05d8\u05d7\u05d5\u05df:",obstacle_photo_page_subtitle:"\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d6\u05d9\u05d4\u05d5\u05d9:",retry_after_30_seconds:"\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1 \u05dc\u05d0\u05d7\u05e8 30 \u05e9\u05e0\u05d9\u05d5\u05ea",video_func_is_locked:"\u05d4\u05e1\u05d9\u05e1\u05de\u05d4 \u05d1\u05d5\u05d8\u05dc\u05d4",gesture_password_at_least_four_length:"\u05ea\u05d1\u05e0\u05d9\u05ea \u05d1\u05d9\u05d8\u05d5\u05dc \u05e0\u05e2\u05d9\u05dc\u05d4 \u05de\u05d0\u05e8\u05d1\u05e2 \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05de\u05d7\u05d5\u05d1\u05e8\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea.",reset_gesture_password_tip:"\u05dc\u05d0\u05d7\u05e8 \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8, \u05d4\u05e1\u05d9\u05e1\u05de\u05d4 \u05ea\u05d0\u05d5\u05e4\u05e1 \u05d5\u05d4\u05e1\u05e8\u05d8\u05d5\u05df \u05d9\u05d9\u05e1\u05d2\u05e8, \u05d5\u05d9\u05e9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4.",forget_password:"\u05e9\u05db\u05d7\u05ea\u05d9 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e1\u05de\u05d4",title_skip:"\u05d3\u05dc\u05d2",microphone_is_occupied:"\u05d4\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05ea\u05e4\u05d5\u05e1. \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1 \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8.",resetting_device_wifi_and_reconnecting:"\u05e9\u05d3\u05e8\u05d5\u05d2 \u05de\u05d5\u05d3\u05d5\u05dc Wi-Fi. \u05d1\u05e6\u05e2 \u05d0\u05d9\u05e4\u05d5\u05e1 \u05e9\u05dc \u05d4-Wi-Fi \u05e9\u05dc \u05d4\u05d4\u05ea\u05e7\u05df \u05d5\u05d4\u05ea\u05d7\u05d1\u05e8 \u05de\u05d7\u05d3\u05e9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05d6\u05d5",upgrading_the_App_to_the_latest_version:"\u05d2\u05e8\u05e1\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e0\u05de\u05d5\u05db\u05d4, \u05d0\u05e0\u05d0 \u05e9\u05d3\u05e8\u05d2 \u05dc\u05d2\u05d9\u05e8\u05e1\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4.",playing_now_please_try_again_later:"\u05de\u05e9\u05de\u05d9\u05e2 \u05e7\u05d5\u05dc, \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1 \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8",no_recording_is_available:"\u05dc\u05dc\u05d0 \u05d4\u05e7\u05dc\u05d8\u05ea \u05e7\u05d5\u05dc",ask_if_go_record_setting:"\u05d4\u05d0\u05dd \u05d1\u05e8\u05e6\u05d5\u05e0\u05da \u05dc\u05d0\u05e4\u05e9\u05e8 \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05e7\u05d5\u05dc?",whether_to_delete_the_recorded:"\u05d0\u05e9\u05e8 \u05de\u05d7\u05d9\u05e7\u05ea \u05d4\u05e7\u05dc\u05d8\u05d4 \u05d6\u05d5?",let_go_of_send_up_slide_to_cancel:"\u05e9\u05d7\u05e8\u05e8 \u05d