n_title_more_info:"\u0414\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u0432\u0456\u0434\u043e\u043c\u043e\u0441\u0442\u0456",setting_section_title_clean_management:"\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f\u043c",dust_collection_info_close:"\u0414\u043b\u044f \u043f\u043e\u0432\u043d\u043e\u0457 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0456\u0457 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0441\u043f\u043e\u0440\u043e\u0436\u043d\u0435\u043d\u043d\u044f. \u042f\u043a\u0449\u043e \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u0440\u043e\u0436\u043d\u0435\u043d\u043d\u044f \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e, \u0441\u043f\u043e\u0440\u043e\u0436\u043d\u0435\u043d\u043d\u044f \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0430\u043a\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447.",error_dock_error_title:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0441\u0442\u0430\u043d\u0446\u0456\u0457",home_special_info_timer:"\u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0440\u043e\u0437\u043f\u043e\u0447\u043d\u0435\u0442\u044c\u0441\u044f \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u043e ${cleanTime}.",start_clean_with_manual_mode_alert_title:"\u0420\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438\u043c\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043a\u0430\u0440\u0442\u0438 \xab${mapName}\xbb. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u0440\u043e\u0437\u0442\u0430\u0448\u043e\u0432\u0430\u043d\u0438\u0439 \u0443 \u043c\u0435\u0436\u0430\u0445 \u043a\u0430\u0440\u0442\u0438.",smart_switch_section_title:"\u0417\u043c\u0456\u043d\u0430 \u043a\u0430\u0440\u0442\u0438",manual_switch_tip:"\u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043a\u0430\u0440\u0442\u0443, \u043a\u043e\u043b\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454\u0442\u0435 \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u0456\u0437 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438. \u041f\u0456\u0441\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0454 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043a\u0430\u0440\u0442\u0438, \u044f\u043a\u0430 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u043d\u0456\u0439 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438*. \u041a\u043e\u043b\u0438 \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u0456\u043d\u0448\u0438\u0445 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0430\u0445, \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0456\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0435 \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f.",manual_switch_pattern:"\u0412\u0438\u0431\u0456\u0440 \u0443\u0440\u0443\u0447\u043d\u0443",smart_switch_tip:"\u041f\u0456\u0441\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u