43b\u0435\u0441\u043e\u0441 \u0431\u0443\u0434\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0443\u0431\u043e\u0440\u043a\u0443 \u0432\u0434\u043e\u043b\u044c \u0431\u043e\u043b\u0435\u0435 \u0434\u043b\u0438\u043d\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043a\u043e\u043c\u043d\u0430\u0442\u044b, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043e\u0447\u0438\u0441\u0442\u043a\u0438.",ground_clean_direct_plus_switch:"\u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0443\u0431\u043e\u0440\u043a\u0438",ground_clean_direct_plus_switch_tip:"\u0420\u043e\u0431\u043e\u0442 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f \u0432 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438, \u043f\u0435\u0440\u043f\u0435\u043d\u0434\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u043c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0443\u0431\u043e\u0440\u043a\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0435\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c.\r\n*\xa0\u0423\u0431\u043e\u0440\u043a\u0430 \u0437\u0430\u0439\u043c\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438.",ground_clean_direct_plus_floor:"\u0423\u0431\u043e\u0440\u043a\u0430 \u043f\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044e \u0443\u043a\u043b\u0430\u0434\u043a\u0438 \u043d\u0430\u043f\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u044f",ground_clean_direct_plus_floor_tip:"\u0412 \u0440\u0435\u0436\u0438\u043c\u0435 \xab\u041f\u043e\u043b\u043d\u044b\u0439 \u0446\u0438\u043a\u043b \u0443\u0431\u043e\u0440\u043a\u0438\xbb \u0438\u043b\u0438 \xab\u0412\u044b\u0431\u043e\u0440\u043e\u0447\u043d\u0430\u044f \u0443\u0431\u043e\u0440\u043a\u0430 \u043a\u043e\u043c\u043d\u0430\u0442\xbb \u0440\u043e\u0431\u043e\u0442 \u0431\u0443\u0434\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0443\u0431\u043e\u0440\u043a\u0443 \u043f\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044e \u0443\u043a\u043b\u0430\u0434\u043a\u0438 \u043d\u0430\u043f\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0437\u043d\u043e\u0441 \u0435\u0433\u043e \u0441\u0442\u044b\u043a\u043e\u0432 \u0438\u043b\u0438 \u0448\u0432\u043e\u0432. *\xa0\u0427\u0442\u043e\u0431\u044b \u044d\u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430, \u0437\u0430\u0434\u0430\u0439\u0442\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u043d\u0430\u043f\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u043a\u0440\u044b\u0442\u0438\u044f. \u0420\u043e\u0431\u043e\u0442 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0443\u0431\u043e\u0440\u043a\u0443 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043e\u0434\u043d\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438.",timer_workday:"\u0420\u0430\u0431\u043e\u0447\u0438\u0435 \u0434\u043d\u0438",timer_holiday:"\u0412\u044b\u0445\u043e\u0434\u043d\u044b\u0435 \u0434\u043d\u0438",dock_item_fan_running_tip:"\u0412\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440 \u0437\u0430\u043f\u0443\u0449\u0435\u043d, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u0438\u0437\u0438\u0442\u044c \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u0432\u043d\u0443\u0442\u0440\u0438 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u0438.",dock_item_hatch_door_title:"\u041b\u044e\u043a",dock_item_hatch_door_exception:"\u041e\u0448\u0438\u0431\u043a\u0430",dock_panel_close_dock_coolfan:"\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440",charging_title_support_couple_dock:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u0443\u0431\u043e\u0440\u043a\u0438. \u0423\u0434\u0430\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u043c\u043e\u0436\u043d\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u0438\u043b\u0438 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f.",robot_start_type_coupledock:"\u041b\u044e\u043a",setting_carpet_long_haired_title:"\u041f\u043e\u0434\u044a\u0435\u043c \u043a\u043e\u0440\u043f\u0443\u0441\u0430 \u0434\u043b\u044f \u043e\u0447\u0438\u0441\u0442\u043a\u0438 \u043a\u043e\u0432\u0440\u0430",setting_carpet_long_haire_desc:"\u0415\u0441\u043b\u0438 \u0437\u0430\u0434\u0430\u043d \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0443\u0431\u043e\u0440\u043a\u0438 \u043f\u043e\u043a\u0440\u044b\u0442\u043e\u0439 \u043a\u043e\u0432\u0440\u0430\u043c\u0438 \u0437\u043e\u043d\u044b, \u0440\u043e\u0431\u043e\u0442 \u043f\u043e\u0434\u043d\u0438\u043c\u0435\u0442 \u043a\u043e\u0440\u043f\u0443\u0441, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043e\u0447\u0438\u0441\u0442\u043a\u0438 \u043a\u043e\u0432\u0440\u043e\u0432 \u0441 \u0434\u043b\u0438\u043d\u043d\u044b\u043c \u0432\u043e\u0440\u0441\u043e\u043c.",setting_carpet_long_haire_desc_disable:"\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0441\u0443\u0445\u0