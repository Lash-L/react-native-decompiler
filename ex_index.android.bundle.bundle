id_collision_mode_des_sensitive:"C\u1ed1 g\u1eafng tr\xe1nh va ch\u1ea1m v\u1edbi \u0111\u1ed3 \u0111\u1ea1c, b\xe0n gh\u1ebf v\xe0 ch\xe2n gi\u01b0\u1eddng. Do \u0111\xf3, c\xf3 th\u1ec3 qu\xe9t s\xf3t khu v\u1ef1c xung quanh b\xe0n gh\u1ebf v\xe0 ch\xe2n b\xe0n gh\u1ebf.",map_edit_zone_tag_entryway:"S\u1ea3nh",ground_material_clean_direction_warn:"B\u1ea3n \u0111\u1ed3 hi\u1ec7n t\u1ea1i kh\xf4ng \u0111\u1eb7t h\u01b0\u1edbng s\xe0n. Vui l\xf2ng chuy\u1ec3n \u0111\u1ebfn m\xf4i tr\u01b0\u1eddng m\u1eb7t \u0111\u1ea5t \u0111\u1ec3 \u0111\u1eb7t h\u01b0\u1edbng.",localization_strings_setting_voice_tone:"Ng\xf4n ng\u1eef",localization_strings_setting_voice_record:"Nh\u1eadt k\xfd H\u1ed9i tho\u1ea1i",localization_strings_setting_voice_assistant:"Tr\u1ee3 l\xfd Gi\u1ecdng n\xf3i",localization_strings_setting_voice_skill:"Tr\u1ee3 l\xfd Gi\u1ecdng n\xf3i",localization_strings_setting_voice_assistant_switch:"Sau khi \u0111\u01b0\u1ee3c b\u1eadt, robot c\xf3 th\u1ec3 nh\u1eadn bi\u1ebft kh\u1ea9u l\u1ec7nh v\xe0 th\u1ef1c hi\u1ec7n c\xe1c h\xe0nh \u0111\u1ed9ng t\u01b0\u01a1ng \u1ee9ng",whether_to_delete_all_the_recorded:"Quy\u1ec1n x\xf3a t\u1ea5t c\u1ea3 b\u1ea3n ghi",add_smart_command:"Th\xeam Lu\u1ed3ng c\xf4ng vi\u1ec7c",powerful_clean:"Qu\xe9t M\u1ea1nh",slow_mop:"Lau ch\u1eadm v\xe0 k\u1ef9",recommend_deep_clean_hint:"L\xe0m s\u1ea1ch K\u1ef9. Ph\xf9 h\u1ee3p \u0111\u1ec3 l\xe0m s\u1ea1ch tri\u1ec7t \u0111\u1ec3 v\xe0o cu\u1ed1i tu\u1ea7n.",recommend_powerful_clean:"H\xfat b\u1ee5i v\u1edbi l\u1ef1c m\u1ea1nh \u0111\u1ec3 l\xe0m s\u1ea1ch s\xe0n m\xe0 kh\xf4ng c\u1ea7n lau.",recommend_slow_mop:"L\xe0m s\u1ea1ch ho\xe0n to\xe0n v\u1ebft b\u1ea9n c\u1ee9ng \u0111\u1ea7u tr\xean s\xe0n m\xe0 kh\xf4ng c\u1ea7n h\xfat b\u1ee5i.",home_new_control_start_charge:"Quay tr\u1edf v\u1ec1 dock s\u1ea1c",choose_map_hint_new_map:"B\u1ea3n \u0111\u1ed3 l\xe0m s\u1ea1ch hi\u1ec7n t\u1ea1i",unsave_map_alert_chargeroffset_title:"Thay \u0111\u1ed5i v\u1ecb tr\xed dock s\u1ea1c",unsav