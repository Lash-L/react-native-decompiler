_cliff_zone_title:"\u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u0645\u0646\u062d\u062f\u0631\u0629",map_edit_cliff_zone_detail:"\u064a\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0645\u0646\u062d\u062f\u0631 \u0647\u0646\u0627 \u0628\u0634\u0643\u0644 \u0645\u062a\u0643\u0631\u0631. \u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627. \u064a\u0633\u0645\u062d \u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0645\u0646\u062d\u062f\u0631 \u0643\u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u0644\u0644\u0631\u0648\u0628\u0648\u062a \u0628\u0627\u0644\u0639\u0645\u0644 \u0628\u0643\u0641\u0627\u0621\u0629 \u0623\u0643\u0628\u0631.\r\n*\u0625\u0630\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0645\u0639\u0631\u0636 \u0644\u062e\u0637\u0631 \u0627\u0644\u0633\u0642\u0648\u0637 \u0647\u0646\u0627\u060c \u0641\u064a\u0645\u0643\u0646\u0643 \u062a\u062c\u0627\u0647\u0644\u0647.\r\n*\u0625\u0630\u0627 \u0643\u0627\u0646 \u062d\u062c\u0645 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u062d\u0638\u0648\u0631\u0629 \u0648\u0645\u0648\u0642\u0639\u0647\u0627 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d\u064a\u0646\u060c \u0641\u0642\u0645 \u0628\u0627\u0644\u0636\u0628\u0637 \u0648\u0641\u0642\u064b\u0627 \u0644\u0630\u0644\u0643.",setting_carpet_deep_clean_switch_title:"\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u062c\u0627\u062f \u0627\u0644\u0643\u062b\u064a\u0641",setting_carpet_deep_clean_switch_desc:"\u0628\u0639\u062f \u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u063a\u0631\u0641\u0629\u060c \u0633\u064a\u0646\u0638\u0641 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0627\u0644\u0633\u062c\u0627\u062f \u0628\u0634\u0643\u0644 \u0645\u0646\u0641\u0635\u0644 \u0641\u064a \u0643\u0644 \u063a\u0631\u0641\u0629. \n*\u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0627\u0644\u062d\u0635\u064a\u0631.",map_ai_zone_bubble_set:"\u0627\u0636\u063a\u0637 \u0644\u062a\u0623\u0643\u064a\u062f \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0627\u062d\u062a\u062c\u0627\u0632",map_ai_zone_bubble_adjust:"\u0627\u0636\u063a\u0637 \u0644\u0636\u0628\u0637 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u062d\u0638\u0648\u0631\u0629",warning_for_will_delete_wifi:"\u0628\u0639\u062f \u0627\u0644\u062d\u0630\u0641\u060c \u0633\u064a\u0648\u0642\u0641 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0634\u0628\u0643\u0629 WiFi \u0647\u0630\u0647.",wifi_page_current_wifi:"\u0627\u062a\u0635\u0627\u0644 WiFi \u0627\u0644\u062d\u0627\u0644\u064a",wifi_page_others_wifi:"\u0627\u062a\u0635\u0627\u0644\u0627\u062a WiFi \u0627\u0644\u0623\u062e\u0631\u0649",wifi_page_title:"WiFi",map_edit_floor_wood_width:"\u0627\u0644\u0623\u0631\u0636\u064a\u0629 (\u0623\u0641\u0642\u064a)",map_edit_floor_wood_longti:"\u0627\u0644\u0623\u0631\u0636\u064a\u0629 (\u0631\u0623\u0633\u064a)",ground_material_clean_direction_title:"\u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0639\u0644\u0649 \u0637\u0648\u0644 \u0627\u062a\u062c\u0627\u0647 \u0627\u0644\u0623\u0631\u0636\u064a\u0629",ground_material_clean_direction_detail:"\u0641\u064a \u0648\u0636\u0639 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0643\u0627\u0645\u0644 \u0623\u0648 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0626\u064a \u0644\u0644\u063a\u0631\u0641\u0629\u060c \u0633\u064a\u0646\u0638\u0641 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0627\u0644\u0623\u0631\u0636\u064a\u0629 \u0639\u0644\u0649 \u0637\u0648\u0644 \u0627\u062a\u062c\u0627\u0647\u0647\u0627 \u0644\u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u0627\u062d\u062a\u0643\u0627\u0643 \u0628\u0648\u0635\u0644\u0627\u062a \u0627\u0644\u0623\u0631\u0636\u064a\u0627\u062a.\r\n*\u0642\u0645 \u0628\u062a\u0639\u064a\u064a\u0646 \u0645\u0648\u0627\u062f \u0627\u0644\u0623\u0631\u0636\u064a\u0627\u062a \u0644\u062a\u0639\u0645\u0644 \u0647\u0630\u0647 \u0627\u0644\u0648\u0638\u064a\u0641\u0629. \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0641\u064a \u0627\u062a\u062c\u0627\u0647 \u0648\u0627\u062d\u062f \u0641\u0642\u0637.",map_edit_door_sill_exceed_limit:"\u062a\u0645 \u0628\u0644\u0648\u063a \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0639\u062f\u062f \u0639\u062a\u0628\u0627\u062a \u0627\u0644\u0623\u0628\u0648\u0627\u0628.",map_cliff_zone_guide_text:"\u064a\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0645\u0646\u062d\u062f\u0631 \u0647\u0646\u0627 \u0628\u0634\u0643\u0644 \u0645\u062a\u0643\u0631\u0631. \u062a\u0645 \u062a\u0639\u064a\u064a\u0646 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627.",map_stuck_point_guide_text:"\u064a\u0639\u0644\u0642 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0647\u0646\u0627 \u0628\u0634\u0643\u0644 \u0645\u062a\u0643\u0631\u0631. \u0642\u0645 \u0628\u062a\u0639\u064a\u064a\u0646 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629.",map_door_sill_guide_text:"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0639\u062a\u0628\u0629 \u0647\u0646\u0627. \u0642\u0645 \u0628\u062a\u0639\u064a\u064a\u0646 \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0638\u0648\u0631\u0629.",clean_route_fast_mode_title:"\u0633\u0631\u064a\u0639",wifi_rssi_title:"\u0642\u0648\u0629 \u0627\u0644\u0625\u0634\u0627\u0631\u0629",map_object_desc_sanxian:"\u062a\u0645 \u062a\u062c\u0646\u0628 \u0627\u0644\u0623\u0633\u0644\u0627\u0643 / \u0627\u0644\u0643\u0627\u0628\u0644\u0627\u062a \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u0634\u0627\u0628\u0643. \u0644\u0627 \u064a\u0632\u0627\u0644 \u0645\u0646 \u0627\u0644\u0645\u0645\u0643\u0646 \u0623\u0646 \u062a\u062a\u0634\u0627\u0628\u0643 \u0627\u0644\u0623\u0633\u0644\u0627\u0643 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0648\u0627\u0644\u0631\u0641\u064a\u0639\u0629.",map_object_desc_chongwu:"\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629\u060c \u0645\u0645\u0627 \u064a\u0645\u0646\u062d \u0627\u0644\u062a\u0635\u0627\u062f\u0645 \u0648\u0627\u0644\u062a\u0634\u0648\u064a\u0634.",map_object_desc_zhituan:"\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0643\u0631\u0627\u062a \u0627\u0644\u0642\u0645\u0627\u0634\u064a\u0629/\u0627\u0644\u0648\u0631\u0642\u064a\u0629\u060c \u0645\u0645\u0627 \u064a\u0645\u0646\u0639 \u0627\u0644\u062a\u0634\u0627\u0628\u0643 \u0648\u0627\u0644\u0627\u0646\u062d\u0635\u0627\u0631.",map_object_name_loosewire:"\u0627\u0644\u0623\u0633\u0644\u0627\u0643 / \u0627\u0644\u0643\u0627\u0628\u0644\u0627\u062a",map_object_name_cat:"\u062d\u064a\u0648\u0627\u0646 \u0623\u0644\u064a\u0641",map_object_name_dog:"\u062d\u064a\u0648\u0627\u0646 \u0623\u0644\u064a\u0641",map_object_name_curledfabric:"\u0643\u0631\u0627\u062a \u0642\u0645\u0627\u0634\u064a\u0629/\u0648\u0631\u0642\u064a\u0629",auto_delivery_cleaning_fluid_title:"\u062a\u0639\u0628\u0626\u0629 \u0645\u062d\u0644\u0648\u0644 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0630\u0643\u064a",auto_delivery_cleaning_fluid_desc:"\u062a\u062a\u0645 \u0625\u0636\u0627\u0641\u0629 \u0645\u062d\u0644\u0648\u0644 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0641\u064a \u0623\u062b\u0646\u0627\u0621 \u063a\u0633\u0644 \u0627\u0644\u0645\u0645\u0633\u062d\u0629 \u0648\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u0628\u0626\u0629 \u0627\u0644\u062e\u0632\u0627\u0646.",clean_route_fast_mode_guide_title:"\u0648\u0636\u0639 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u0631\u064a\u0639 \u0630\u0648 \u0627\u0644\u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0623\u0639\u0644\u0649.",clean_route_fast_mode_guide_desc:"\u064a\u062a\u0639\u0631\u0641 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0639\u0644\u0649 \u0627\u0644\u0645\u0643\u0627\u0646\u060c \u0648\u064a\u0639\u062f\u0644 \u0645\u0633\u0627\u0631\u0647 \u0648\u0641\u0642\u064b\u0627 \u0644\u0630\u0644\u0643 \u0645\u0646 \u0623\u062c\u0644 \u062a\u0646\u0638\u064a\u0641 \u0623\u0641\u0636\u0644. \u0633\u064a\u062a\u0645 \u062a\u062e\u0637\u064a \u062d\u062f\u0648\u062f \u0627\u0644\u063a\u0631\u0641\u0629. \u0647\u0630\u0647 \u0627\u0644\u0648\u0638\u064a\u0641\u0629 \u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0646 \u062d\u064a\u0646 \u0644\u0622\u062e\u0631 \u0641\u0642\u0637.",clean_route_fast_mode_is_work:"\u0648\u0636\u0639 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u0631\u064a\u0639",home_sepecial_tip_cleanmop_fastroute:"\u0648\u0636\u0639 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u0631\u064a\u0639 | \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629",livecall_autosoundoff_whenmoving_alerttitle:"\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u062d\u0631\u0643",livecall_autosoundoff_whenmoving_alertdesc:"\u064a\u062a\u0645 \u0628\u062f\u0621 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u062d\u0631\u0643. \u064a\u062a\u0645 \u0627\u0644\u0643\u062a\u0645 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u064b\u0627. \u0648\u064a\u062a\u0645 \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0643\u062a\u0645 \u0639\u0646\u062f \u0627\u0644\u0636\u0631\u0648\u0631\u0629.",carpet_clean_mode_detail4:"\u064a\u0646\u0637\u0628\u0642 \u0639\u0644\u0649 \u0627\u0644\u062d\u0635\u064a\u0631 \u0623\u0648 \u0627\u0644\u0633\u062c\u0627\u062f \u0635\u063a\u064a\u0631 \u0627\u0644\u062d\u062c\u0645. \u0639\u0646\u062f \u0627\u0643\u062a\u0634\u0627\u0641 \u0633\u062c\u0627\u062f\u0629\u060c \u064a\u062a\u0645 \u0631\u0641\u0639 \u0627\u0644\u0645\u0645\u0633\u062d\u0629 \u0648\u0625\u064a\u0642\u0627\u0641 \u062a\u062f\u0641\u0642 \u0627\u0644\u0645\u0627\u0621 \u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u062c\u0627\u062f\u0629 \u0628\u0627\u0644\u0645\u0643\u0646\u0633\u0629.",clean_route_setting_title:"\u0627\u0644\u0645\u0633\u0627\u0631",map_object_desc_general_1:"\u064a\u0645\u0643\u0646 \u0644\u0644\u0631\u0648\u0628\u0648\u062a \u062a\u062d\u062f\u064a\u062f \u0648\u062a\u062c\u0646\u0628 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u0639\u0648\u0627\u0626\u0642 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0644\u064a\u0632\u0631 \u0627\u0644\u062e\u0637\u064a \u0627\u0644\u0645\u062f\u0639\u0648\u0645 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0639\u0627\u0631 \u0627\u0644\u0623\u062e\u0631\u0649.",robot_play_soundpackage_exception:"\u0641\u0634\u0644 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a. \u062c\u0631\u0628 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u0645\u0628\u0627\u0634\u0631\u0629\u064b.",offline_map_guide_title:"\u062e\u0631\u064a\u0637\u0629 \u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644",offline_map_guide_desc1:"\u0633\u064a\u062a\u0645 \u0625\u064a\u0642\u0627\u0641 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062c\u0647\u0627\u0632 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0625\u0630\u0627 \u062a\u064f\u0631\u0643 \u0628\u062f\u0648\u0646 \u0634\u062d\u0646 \u0644\u0645\u062f\u0629 \u062a\u0632\u064a\u062f \u0639\u0646 12 \u0633\u0627\u0639\u0629. \u064a\u062a\u064a\u062d \u0644\u0643 \u062a\u0645\u0643\u064a\u0646 \u062e\u0631\u064a\u0637\u0629 \u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644 \u0645\u0639\u0631\u0641\u0629 \u0645\u0643\u0627\u0646 \u0627\u0644\u062c\u0647\u0627\u0632 \u0642\u0628\u0644 \u0642\u0637\u0639 \u0627\u062a\u0635\u0627\u0644\u0647 \u0628\u0627\u0644\u0634\u0628\u0643\u0629.",offline_map_tips_title:"\u0645\u0648\u0642\u0639 \u0627\u0644\u062c\u0647\u0627\u0632 \u0642\u0628\u0644 \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",offline_map_tips_subtitle:"\u0643\u0627\u0646 \u0627\u0644\u062c\u0647\u0627\u0632 \u0647\u0646\u0627 \u0642\u0628\u0644 \u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644. \u0636\u0639\u0647 \u0639\u0644\u0649 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0648\u0633\u064a\u0628\u062f\u0623 \u062a\u0634\u063a\u064a\u0644\u0647 \u0648\u062a\u0648\u0635\u064a\u0644\u0647 \u0628\u0627\u0644\u0634\u0628\u0643\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627.",upgrade_progress_view_title:"\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u062b\u0627\u0628\u062a\u0629",upgrade_progress_view_desc:"\u063a\u064a\u0631 \u0645\u0633\u0645\u0648\u062d \u0628\u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u0639\u0645\u0644\u064a\u0627\u062a. \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631.",offline_map_tips_off_line_date:"\u0648\u0642\u062a \u0639\u062f\u0645 \u0627\u0644\u0627\u062a\u0635\u0627\u0644",home_sepcial_info_airdry_finish_time_minute:"\u062a\u062c\u0641\u064a\u0641 \u0627\u0644\u0645\u0645\u0633\u062d\u0629\u060c \u0648\u0642\u062a \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0645\u0642\u062f\u0651\u0631 \u0628\u0639\u062f: ${minute} \u0645\u0646 \u0627\u0644\u062f\u0642\u0627\u0626\u0642",map_edit_furniture_open_cattoilet:"\u0635\u0646\u062f\u0648\u0642 \u0641\u0636\u0644\u0627\u062a \u0627\u0644\u0642\u0637\u0637",map_edit_furniture_cat_toilet:"\u0635\u0646\u062f\u0648\u0642 \u0641\u0636\u0644\u0627\u062a \u0645\u063a\u0644\u0642",map_edit_furniture_pet_cage:"\u0642\u0641\u0635 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629",map_edit_furniture_pet_waterloo:"\u0633\u0631\u064a\u0631 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629",map_edit_furniture_pet_bowl:"\u0623\u0648\u0639\u064a\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629",unlock_clean_route_fast_mode_guide_title:"\u0625\u0644\u063a\u0627\u0621 \u0642\u0641\u0644 \u0648\u0636\u0639 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0633\u0631\u064a\u0639",unlock_clean_route_fast_mode_guide_desc:"\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0641\u064a \u0645\u0643\u0627\u0646 \u0645\u0623\u0644\u0648\u0641 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639. \u0628\u0631\u062c\u0627\u0621 \u062d\u0641\u0638 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0642\u0628\u0644 \u062a\u062c\u0631\u0628\u0629 \u0647\u0630\u0627 \u0627\u0644\u0648\u0636\u0639.",water_updown_self_clean_title:"\u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0630\u0627\u062a\u064a \u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u062d\u0646 \u0648\u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u062a\u0635\u0631\u064a\u0641",water_updown_self_clean_desc:"\u064a\u063a\u0633\u0644 \u062d\u0648\u0636 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0648\u062e\u0632\u0627\u0646 \u0627\u0644\u0635\u0631\u0641 \u0627\u0644\u0645\u062f\u0645\u062c \u0644\u0639\u0646\u0635\u0631 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u0648\u0627\u0644\u0635\u0631\u0641\u061b \u0648\u064a\u062c\u0631\u064a \u0641\u062d\u0635\u0627 \u0630\u0627\u062a\u064a\u0627 \u0644\u0644\u0639\u0646\u0635\u0631.",water_updown_self_clean_button_title:"\u0628\u062f\u0621 \u0627\u0644\u062a\u0646\u0638\u064