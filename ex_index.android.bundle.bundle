9\u05dc \u05de\u05db\u05e9\u05d5\u05dc\u05d9\u05dd \u05e9\u05d6\u05d5\u05d4\u05d5 \u05d1\u05e2\u05de\u05d5\u05d3 \u05d4\u05de\u05e4\u05d4.\n\u05ea\u05de\u05d5\u05e0\u05d4 \u05d0\u05d7\u05ea \u05ea\u05e9\u05de\u05e8 \u05e2\u05dc \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05dc\u05db\u05dc \u05de\u05db\u05e9\u05d5\u05dc \u05e9\u05d6\u05d5\u05d4\u05d4. \u05d9\u05ea\u05db\u05df \u05e9\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05de\u05e1\u05d5\u05d9\u05de\u05d5\u05ea \u05e9\u05dc \u05de\u05db\u05e9\u05d5\u05dc\u05d9\u05dd \u05dc\u05d0 \u05d9\u05e9\u05de\u05e8\u05d5.",map_object_bubble_tip_avoid:"\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea",realtime_video_info:"\u05d1\u05e2\u05ea \u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7",realtime_video_sub_title_3_1:"\u05d0\u05d5\u05e8 \u05d4\u05de\u05d7\u05d5\u05d5\u05df \u05d9\u05d4\u05d1\u05d4\u05d1 \u05dc\u05dc\u05d0 \u05d4\u05ea\u05e8\u05d0\u05ea \u05e7\u05d5\u05dc.",realtime_video_title_3:"\u05d7\u05d6\u05e7",realtime_video_title_2:"\u05e2\u05d3\u05d9\u05df",realtime_video_title_1:"\u05e4\u05dc\u05d0\u05e9",realtime_video_title:"\u05d4\u05ea\u05e8\u05d0\u05d4 \u05db\u05e9\u05e6\u05d5\u05e4\u05d9\u05dd \u05d1\u05d5\u05d9\u05d3\u05d0\u05d5",confirm_start:"\u05e0\u05e7\u05d9 \u05d5\u05de\u05d9\u05e4\u05d5\u05d9",map_object_desc_henggan:"\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d4\u05d9\u05de\u05e6\u05d0\u05d5\u05ea \u05e8\u05d9\u05d4\u05d5\u05d8 \u05e2\u05dd \u05d1\u05e1\u05d9\u05e1 \u05e6\u05d5\u05dc\u05d1, \u05db\u05d2\u05d5\u05df \u05db\u05d9\u05e1\u05d0 \u05e7\u05e0\u05d8\u05d9\u05dc\u05d1\u05e8, \u05de\u05d5\u05e0\u05e2\u05ea \u05dc\u05db\u05d9\u05d3\u05d4.",map_object_desc_poqi:"\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05de\u05d2\u05e2 \u05e2\u05dd \u05d9\u05e2\u05d4 \u05d0\u05d5 \u05d7\u05e4\u05e6\u05d9\u05dd \u05d3\u05d5\u05de\u05d9\u05dd, \u05e0\u05de\u05e0\u05e2\u05d4 \u05dc\u05db\u05d9\u05d3\u05d4.",map_object_desc_zhiwu:"\u05d6\u05d9\u05d4\u05d5\u05d9 \u0