o_setting_on:"\ud655\uc778",open_map_save_mode_tip:"\uc9c0\ub3c4 \uc800\uc7a5 \ubaa8\ub4dc\ub97c \uba3c\uc800 \ud65c\uc131\ud654\ud574\uc8fc\uc138\uc694.",delete_map_hint_when_cleaning:"\ud604\uc7ac \uc9c0\ub3c4\uac00 \uc0ac\uc6a9 \uc911\uc785\ub2c8\ub2e4. \uc9c0\ub3c4\ub97c \uc0ad\uc81c\ud558\uba74 \ud604\uc7ac \uc791\uc5c5\uc774 \uc885\ub8cc\ub429\ub2c8\ub2e4.",zero_water_will_be_first_short:"\ubc29\uc744 \ub9e8 \uba3c\uc800 \uccad\uc18c\ud569\ub2c8\ub2e4.",effect_only_once_tip:"\ud55c\ubc88\ub9cc \uc0ac\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4",tanosv_title_guide_6:"\uae30\ud0c0 \uc815\ubcf4",tanosv_title_guide_5:"\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38",tanosv_title_guide_4:"\uc815\uae30 \uc720\uc9c0 \ubcf4\uc218",tanosv_title_guide_2:"\uc124\uce58 \uc124\uba85",tanosv_title_guide_1:"\uc81c\ud488 \uc18c\uac1c",localization_strings_Setting_Guide_index_6:"\ubb38\uc81c \ud574\uacb0",localization_strings_Setting_Guide_index_5:"\uc720\uc9c0 \ubcf4\uc218",localization_strings_Setting_Guide_index_3:"\uba3c\uc9c0\ud1b5\uacfc \ud544\ud130\ub97c \uccad\uc18c\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?",localization_strings_Setting_Guide_index_2:"\ub85c\ubd07 \uc9c4\uacf5\uccad\uc18c\uae30\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?",localization_strings_Setting_Guide_index_1:"\ube60\ub978 \uc2dc\uc791 \uac00\uc774\ub4dc",localization_strings_Setting_Guide_index_0:"\ub85c\ubd07 \uc9c4\uacf5\uccad\uc18c\uae30\uc5d0 \ub300\ud574 \uc790\uc138\ud788 \uc54c\uc544\ubcf4\uc138\uc694.",timer_disable:"\ubc29\uc774 \ubcc0\uacbd\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774 \ubc29\uc758 \uc608\uc57d \uccad\uc18c\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4.",ask_if_stop_for_change_map:"\ud604\uc7ac \uc791\uc5c5\uc744 \uc885\ub8cc\ud558\uace0 \uc9c0\ub3c4\ub97c \ubcc0\uacbd\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",please_input_map_name:"\uc9c0\ub3c4 \uc774\ub984\uc744 \uc785\ub825\ud558\uc138\uc694.",set_map_name:"\uc9c0\ub3c4 \uc774\ub984\uc744 \uc9c0\uc815\ud558