1\u0442\u0430\u043d\u0446\u0456\u044e.",robot_status_quick_building_map:"\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043a\u0430\u0440\u0442\u0438",map_edit_mode_smart_tip_detail:"\u0421\u043f\u0435\u0440\u0448\u0443 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0442\u0438\u043f \u043a\u0456\u043c\u043d\u0430\u0442\u0438. \u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f \u041e\u041a, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c.",map_edit_order_smart_tip:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u043e\u0441\u0442\u0456 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0437\u0430 \u0442\u0438\u043f\u0430\u043c\u0438 \u043a\u0456\u043c\u043d\u0430\u0442.",multi_map_start_build_text_4:"4. \u0420\u043e\u0431\u043e\u0442 \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0454 \u043a\u0438\u043b\u0438\u043c\u0456\u0432, \u0449\u043e\u0431 \u0434\u043e\u0441\u043b\u0456\u0434\u0438\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u0437\u043e\u043d\u0438.",led_status_detail1:"\u0420\u043e\u0431\u043e\u0442 \u0432\u043c\u0438\u043a\u0430\u0454 \u0456\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0432 \u0442\u0435\u043c\u0440\u044f\u0432\u0456, \u0449\u043e\u0431 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f.",led_status_title2:"\u0410\u0432\u0442\u043e",led_status_title1:"\u0414\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0435 \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u043d\u044f",map_object_desc_general1:"\u0420\u043e\u0437\u0443\u043c\u043d\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0439\u0442\u0435 \u0442\u0430 \u0443\u043d\u0438\u043a\u0430\u0439\u0442\u0435 \u043d\u0430\u0437\u0435\u043c\u043d\u0438\u0445 \u043e\u0431'\u0454\u043a\u0442\u0456\u0432, \u044f\u043a\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u0440\u043e\u0431\u043e\u0442\u0443 \u0440\u043e\u0431\u043e\u0442\u0430.",quick_build_map_start:"\u0428\u0432\u0438\u0434\u043a\u0435 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f",map_edit_zone_tag_toilet:"\u0412\u0430\u043d\u043d\u0430",map_edit_zone_tag_kitchen:"\u041a\u0443\u0445\u043d\u044f",map_edit_zone_tag_diningroom:"\u0407\u0434\u0430\u043b\u044c\u043d\u044f",map_edit_zone_tag_study:"\u0420\u043e\u0431\u043e\u0447\u0438\u0439 \u043a\u0430\u0431\u0456\u043d\u0435\u0442",map_edit_zone_tag_vestibule:"\u041a\u043e\u0440\u0438\u0434\u043e\u0440",map_edit_zone_tag_balcony:"\u0411\u0430\u043b\u043a\u043e\u043d",map_edit_zone_tag_livingroom:"\u0412\u0456\u0442\u0430\u043b\u044c\u043d\u044f",map_edit_zone_tag_geustbedroom:"\u0413\u043e\u0441\u0442\u044c\u043e\u0432\u0430 \u0441\u043f\u0430\u043b\u044c\u043d\u044f",map_edit_zone_tag_masterbedroom:"\u0425\u0430\u0437\u044f\u0439\u0441\u044c\u043a\u0430 \u0441\u043f\u0430\u043b\u044c\u043d\u044f",map_edit_zone_tag_bedroom:"\u0421\u043f\u0430\u043b\u044c\u043d\u044f",map_edit_zone_select_tag:"\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0442\u0438\u043f \u043a\u0456\u043c\u043d\u0430\u0442\u0438",set_timer_without_time_tip:"\u0420\u043e\u0437\u043a\u043b\u0430\u0434 \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e",start_clean_roller_without_waterbox_carriage_tip:"\u041a\u0440\u043e\u043d\u0448\u0442\u0435\u0439\u043d \u0434\u043b\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0439. \u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u043f\u043e\u043c\u0438\u0442\u0438 \u0448\u0432\u0430\u0431\u0440\u0443.",start_clean_roller_without_waterbox_tip:"\u0411\u0430\u043a \u0434\u043b\u044f \u0432\u043e\u0434\u0438 \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e. \u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u043f\u043e\u043f\u043e\u0432\u043d\u0438\u0442\u0438.",carpet_clean_mode_setting_title4:"\u0414\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u0438\u0439 \u043f\u0456\u0434\u0439\u043e\u043c",monitor_page_video_end:"\u0406\u043d\u0448\u0430 \u0441\u0442\u043e\u0440\u043e\u043d\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0430 \u0432\u0438\u043a\u043b\u0438\u043a.",back_dock_to_wash_alert_tip:"\u041f\u0456\u0441\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0440\u043e\u0431\u043e\u0442 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u044c \u043c\u0438\u0442\u0442\u044f \u0437 \u0442\u043e\u0433\u043e \u043c\u0456\u0441\u0446\u044f, \u0434\u0435 \u0437\u0443\u043f\u0438\u043d\u0438\u0432\u0441\u044f.",terminate_current_task_wash_then_back_dock:"\u041c\u0438\u0442\u0442\u044f \u0439 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0456\u044f",terminate_current_task_back_dock:"\u0414\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0456\u044f",terminate_current_task_back_dock_tip:"\u041f\u043e\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u043d\u0430 \u043b\u0430\u0432\u0443 \u043f\u0456\u0434\u0441\u0443\u0434\u043d\u0438\u0445",back_wash_desc3:"\u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0431\u0443\u0434\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0440\u0435\u0433\u0443\u043b\u044e\u0432\u0430\u0442\u0438\u0441\u044f \u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u0437\u0430\u0431\u0440\u0443\u0434\u043d\u0435\u043d\u043e\u0441\u0442\u0456 \u043f\u0456\u0434\u043b\u043e\u0433\u0438, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a \u043a\u0438\u043b\u0438\u043c\u043e\u0432\u043e\u0433\u043e \u043f\u043e\u043a\u0440\u0438\u0442\u0442\u044f, \u0431\u0430\u0436\u0430\u043d\u043e\u0433\u043e \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443, \u0444\u0430\u043a\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0447\u0430\u0441\u0443 \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0442\u0430 \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u0447\u0430\u0441\u0443 \u0432\u043e\u043b\u043e\u0433\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f, \u0449\u043e \u0437\u0430\u043b\u0438\u0448\u0438\u0432\u0441\u044f.",back_wash_desc2:"\u041f\u0456\u0441\u043b\u044f \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u043e\u0457 \u043a\u0456\u043c\u043d\u0430\u0442\u0438 \u0440\u043e\u0431\u043e\u0442 \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0456 \u043c\u0438\u0454 \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0443, \u0449\u043e\u0431 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438 \u043f\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u043d\u043e\u0433\u043e \u0437\u0430\u0431\u0440\u0443\u0434\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u0438\u043c\u0456\u0449\u0435\u043d\u044c. \u042f\u043a\u0449\u043e \u043a\u0456\u043c\u043d\u0430\u0442\u0430 \u0432\u0435\u043b\u0438\u043a\u0430, \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u043c\u0438\u0442\u0442\u044f \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0438 \u0431\u0443\u0434\u0435 \u0431\u0456\u043b\u044c\u0448\u043e\u044e. \u042f\u043a\u0449\u043e \u043a\u0456\u043c\u043d\u0430\u0442\u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430, \u043c\u0438\u0442\u0442\u044f \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0438 \u0431\u0443\u0434\u0435 \u043e\u0431\u2019\u0454\u0434\u043d\u0430\u043d\u043e \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043c \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f\u043c \u043c\u0438\u0442\u0442\u044f \u0433\u0430\u043d\u0447\u0456\u0440\u043a\u0438.",new_firmware_detected1:"\u041e\u043d\u043e\u0432\u0456\u0442\u044c \u043c\u0456\u043a\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443, \u0449\u043e\u0431 \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044f \u0432\u0441\u0456\u043c\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u043c\u0438 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f\u043c\u0438.",new_firmware_detected:"\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043d\u043e\u0432\u0430 \u0432\u0435\u0440\u0441\u0456\u044f \u043c\u0456\u043a\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438",map_edit_furniture_toilet:"\u0422\u0443\u0430\u043b\u0435\u0442",map_edit_furniture_tea_table:"\u0416\u0443\u0440\u043d\u0430\u043b\u044c\u043d\u0438\u0439 \u0441\u0442\u043e\u043b\u0438\u043a",map_edit_furniture_tv_cabinet:"\u0421\u0442\u0456\u0439\u043a\u0430 \u0434\u043b\u044f \u0442\u0435\u043b\u0435\u0432\u0456\u0437\u043e\u0440\u0430",map_edit_furniture_dinner_table:"\u0421\u0442\u043e\u043b\u043e\u0432\u0438\u0439 \u0433\u0430\u0440\u043d\u0456\u0442\u0443\u0440",map_edit_furniture_double_bed:"\u041b\u0456\u0436\u043a\u043e",map_edit_furniture_single_bed:"\u041b\u0456\u0436\u043a\u043e",map_edit_furniture_count_tip_miapp:"\u0417\u0430 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u043c\u043e\u0436\u043d\u0430 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u043f\u0435\u0432\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043c\u0435\u0431\u043b\u0456\u0432 (${max}). \u0417\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044c \u0437\u043c\u0456\u043d\u0438, \u0449\u043e\u0431 \u0432\u0456\u0434\u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0448\u0456 \u043f\u0440\u0435\u0434\u043c\u