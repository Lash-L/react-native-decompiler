u05e0\u05ea \u05dc\u05d9\u05e6\u05d5\u05e8 \u05de\u05e4\u05d4 \u05e2\u05dd \u05db\u05dc \u05d4\u05d7\u05d3\u05e8\u05d9\u05dd \u05e9\u05d6\u05d5\u05d4\u05d5.",build_map_map_edit_guide_title:"\u05e2\u05e8\u05d5\u05da \u05d0\u05ea \u05d4\u05de\u05e4\u05d4 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d9\u05d9\u05d3\u05e2 \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05e2\u05dc \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05d1\u05d9\u05d9\u05ea\u05d9\u05ea \u05e9\u05dc\u05da.",build_map_map_edit_guide_content:"\u05e0\u05d5\u05d5\u05d8 \u05dc\u05ea\u05e4\u05e8\u05d9\u05d8 \u05e2\u05e8\u05d9\u05db\u05ea \u05de\u05e4\u05d5\u05ea \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05d0\u05ea \u05e1\u05d3\u05e8 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9, \u05d0\u05d9\u05d6\u05d5\u05e8\u05d9 \u05d0\u05d9\u05df \u05db\u05e0\u05d9\u05e1\u05d4 \u05d0\u05d5 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e2\u05e8\u05d5\u05da \u05d0\u05ea \u05d4\u05d7\u05d3\u05e8 \u05dc\u05d7\u05d5\u05d5\u05d9\u05ea \u05e0\u05d9\u05e7\u05d9\u05d5\u05df \u05d8\u05d5\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8. ",home_new_control_start_dry:"\u05d9\u05d1\u05e9",map_edit_door_sill_title:"\u05de\u05e4\u05ea\u05df \u05ea\u05e7\u05d9\u05e2\u05d4",map_edit_door_sill_slide:"\u05de\u05e4\u05ea\u05df \u05d0\u05d6\u05d5\u05e8 \u05de\u05e2\u05d1\u05e8 \u05e6\u05e8",map_edit_door_sill_stone:"\u05de\u05e4\u05ea\u05df \u05d0\u05d1\u05df",error_temperature_protection_desc:"\u05d4\u05d6\u05d6 \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05dc\u05de\u05e7\u05d5\u05dd \u05d1\u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05ea \u05d7\u05d3\u05e8 \u05d5\u05d7\u05db\u05d4 \u05ea\u05e7\u05d5\u05e4\u05ea \u05d6\u05de\u05df \u05de\u05e1\u05d5\u05d9\u05d9\u05de\u05ea.",error_temperature_protection_title:"\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d2\u05e0\u05d4 \u05de\u05e4\u05e0\u05d9 \u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d4 \u05e0\u05de\u05d5\u05db\u05d4/\u05db\u05d1\u05d5\u05d4\u05d4 \u05de\u05d9\u05d3\u05d9",map_edit_add_ai_zone:"\u05d4\u05d2\u05d3\u05e8 \u05d0\u05d6\u05d5\u05e8 '\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8'",map_edit_add_door_sill:"\u05d4\u05d2\u05d3\u05e8 \u05de\u05e4\u05ea\u05df",map_edit_cliff_zone_adjust:"\u05e9\u05e0\u05d4 \u05d0\u05d6\u05d5\u05e8 '\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8'",map_edit_door_sill_title2:"\u05de\u05e2\u05d1\u05e8 \u05d7\u05db\u05dd \u05de\u05e2\u05dc \u05de\u05e4\u05ea\u05e0\u05d9\u05dd \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e6\u05de\u05e6\u05dd \u05de\u05e7\u05e8\u05d9 \u05ea\u05e7\u05d9\u05e2\u05d4",map_edit_door_sill_detail:"\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05e2\u05d5\u05d1\u05e8 \u05de\u05e2\u05dc \u05de\u05e4\u05ea\u05e0\u05d9\u05dd \u05d4\u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05e1\u05db\u05e0\u05ea \u05ea\u05e7\u05d9\u05e2\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d7\u05db\u05dd \u05dc\u05dc\u05d0 \u05e0\u05d9\u05e7\u05d5\u05d9.",map_edit_stuck_zone_title:"\u05d0\u05d6\u05d5\u05e8 ,\u05ea\u05e7\u05d9\u05e2\u05d4",map_edit_stuck_zone_detail:"\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05e0\u05ea\u05e7\u05e2 \u05e4\u05d4 \u05de\u05e1\u05e4\u05e8 \u05e4\u05e2\u05de\u05d9\u05dd. \u05d4\u05d2\u05d3\u05e8 \u05d0\u05d6\u05d5\u05e8 '\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8' \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d4\u05db\u05e8\u05d9\u05d7 \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05dc\u05e2\u05d1\u05d5\u05e8 \u05de\u05e1\u05d1\u05d9\u05d1.\n*\u05d0\u05dd \u05d0\u05ea\u05d4 \u05dc\u05d0 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea \u05d6\u05d0\u05ea, \u05d4\u05e7\u05e9 \u05e2\u05dc '\u05d4\u05ea\u05e2\u05dc\u05dd'.",map_edit_cliff_zone_title:"\u05e6\u05d5\u05e7 \u05db\u05d0\u05d6\u05d5\u05e8 '\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8'",map_edit_cliff_zone_detail:"\u05d1\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05d4\u05ea\u05d2\u05dc\u05d4 \u05e6\u05d5\u05e7 \u05de\u05e1\u05e4\u05e8 \u05e4\u05e2\u05de\u05d9\u05dd. \u05d0\u05d6\u05d5\u05e8 '\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8' \u05d4\u05d5\u05d2\u05d3\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea. \u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05e6\u05d5\u05e7 \u05db\u05d0\u05d6\u05d5\u05e8 '\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8' \u05ea\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e8\u05d5\u05d1\u05d5\u05d8 \u05dc\u05e2\u05d1\u05d5\u05d3 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d4 \u05d9\u05d5\u05ea\u05e8.\r\n*\u05d0\u05dd \u05d0\u05d9\u05df \u05e4\u05d4 \u05e1\u05db\u05e0\u05ea \u05e0\u05e4\u05d9\u05dc\u05d4, \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05ea\u05e2\u05dc\u05dd \u05de\u05d4\u05e6\u05d5\u05e7.\r\n*\u05d0\u05dd \u05d4\u05d2\u05d5\u05d3\u05dc \u05d0\u05d5 \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05e9\u05dc \u05d4\u05d0\u05d6\u05d5\u05e8 '\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8' \u05d0\u05d9\u05e0\u05dd \u05e0\u05db\u05d5\u05e0\u05d9\u05dd, \u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05e7\u05df \u05d0\u05d5\u05ea\u05dd \u05db\u05e0\u05d3\u05e8\u05e9.",setting_carpet_deep_clean_switch_title:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e9\u05d8\u05d9\u05d7\u05d9\u05dd \u05e2\u05de\u05d5\u05e7",setting_carpet_deep_clean_switch_desc:"\u05dc\u05d0\u05d7\u05e8 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d7\u05d3\u05e8\u05d9\u05dd, \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05e0\u05e7\u05d4 \u05e9\u05d8\u05d9\u05d7\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e0\u05e4\u05e8\u05d3 \u05d1\u05db\u05dc \u05d7\u05d3\u05e8. \n*\u05dc\u05d0 \u05db\u05d5\u05dc\u05dc \u05e9\u05d8\u05d9\u05d7\u05d5\u05e0\u05d9\u05dd.",map_ai_zone_bubble_set:"\u05d4\u05e7\u05e9 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d0\u05e9\u05e8 \u05d0\u05d6\u05d5\u05e8 \u05ea\u05e7\u05d9\u05e2\u05d4",map_ai_zone_bubble_adjust:"\u05d4\u05e7\u05e9 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e9\u05e0\u05d5\u05ea '\u05d0\u05d6\u05d5\u05e8 \u05d7\u05e1\u05d5\u05dd'",warning_for_will_delete_wifi:"\u05dc\u05d0\u05d7\u05e8 \u05de\u05d7\u05d9\u05e7\u05d4, \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05e4\u05e1\u05d9\u05e7 \u05dc\u05e0\u05e1\u05d5\u05ea \u05dc\u05d4\u05ea\u05d7\u05d1\u05e8 \u05dc\u05e8\u05e9\u05ea \u05d0\u05dc\u05d7\u05d5\u05d8\u05d9\u05ea (WiFi) \u05d6\u05d0\u05ea.",wifi_page_current_wifi:"\u05d7\u05d9\u05d1\u05d5\u05e8 WiFi \u05e0\u05d5\u05db\u05d7\u05d9",wifi_page_others_wifi:"\u05d7\u05d9\u05d1\u05d5\u05e8\u05d9 WiFi \u05d0\u05d7\u05e8\u05d9\u05dd",wifi_page_title:"WiFi",map_edit_floor_wood_width:"\u05e8\u05e6\u05e4\u05d4 (\u05de\u05d0\u05d5\u05d6\u05e0\u05ea)",map_edit_floor_wood_longti:"\u05e8\u05e6\u05e4\u05d4 (\u05d0\u05e0\u05db\u05d9\u05ea)",ground_material_clean_direction_title:"\u05e0\u05e7\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05e8\u05e6\u05e4\u05d4",ground_material_clean_direction_detail:"\u05d1\u05de\u05e6\u05d1 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05dc\u05d0 \u05d0\u05d5 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d7\u05d3\u05e8\u05d9\u05dd \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9, \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05e0\u05e7\u05d4 \u05d0\u05ea \u05d4\u05e8\u05e6\u05e4\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05dc\u05d4 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e6\u05de\u05e6\u05dd \u05e9\u05e4\u05e9\u05d5\u05e4\u05d9\u05dd \u05db\u05e0\u05d2\u05d3 \u05d7\u05d9\u05d1\u05d5\u05e8\u05d9\u05dd \u05d1\u05e8\u05e6\u05e4\u05d4.\r\n*\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05d7\u05d5\u05de\u05e8 \u05de\u05de\u05e0\u05d5 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05d4\u05e8\u05e6\u05e4\u05d4 \u05e2\u05dc \u05de\u05e0\u05ea \u05e9\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05d6\u05d0\u05ea \u05ea\u05e2\u05d1\u05d5\u05d3. \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05db\u05d5\u05dc \u05dc\u05e0\u05e7\u05d5\u05ea \u05e8\u05e7 \u05d1\u05db\u05d9\u05d5\u05d5\u05df \u05d0\u05d7\u05d3.",map_edit_door_sill_exceed_limit:"\u05d4\u05d2\u05e2\u05ea \u05dc\u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05d9\u05e8\u05d1\u05d9 \u05e9\u05dc \u05de\u05e4\u05ea\u05e0\u05d9 \u05d3\u05dc\u05ea.",map_cliff_zone_guide_text:"\u05d1\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05d4\u05ea\u05d2\u05dc\u05ea\u05d4 \u05de\u05d3\u05e8\u05d2\u05d4 \u05de\u05e1\u05e4\u05e8 \u05e4\u05e2\u05de\u05d9\u05dd. \u05d4\u05d0\u05d6\u05d5\u05e8 \u05d4\u05d5\u05d2\u05d3\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05db'\u05d0\u05d6\u05d5\u05e8 \u05d7\u05e1\u05d5\u05dd'.",map_stuck_point_guide_text:"\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05e0\u05ea\u05e7\u05e2 \u05e4\u05d4 \u05de\u05e1\u05e4\u05e8 \u05e4\u05e2\u05de\u05d9\u05dd. \u05d4\u05d2\u05d3\u05e8 '\u05d0\u05d6\u05d5\u05e8 \u05d7\u05e1\u05d5\u05dd'.",map_door_sill_guide_text:"\u05de\u05e4\u05ea\u05df \u05d6\u05d5\u05d4\u05d4 \u05e4\u05d4. \u05d4\u05d2\u05d3\u05e8 \u05d0\u05d6\u05d5\u05e8 \u05de\u05e4\u05ea\u05df.",clean_route_fast_mode_title:"\u05de\u05d4\u05e8",wifi_rssi_title:"\u05e2\u05d5\u05e6\u05de\u05ea \u05d0\u05d5\u05ea",map_object_desc_sanxian:"\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05de\u05d2\u05e2 \u05e2\u05dd \u05d7\u05d5\u05d8\u05d9\u05dd/\u05db\u05d1\u05dc\u05d9\u05dd, \u05e0\u05de\u05e0\u05e2\u05d4 \u05d4\u05e1\u05ea\u05d1\u05db\u05d5\u05ea. \u05d7\u05d5\u05d8\u05d9\u05dd \u05d0\u05e8\u05d5\u05db\u05d9\u05dd \u05d5\u05d3\u05e7\u05d9\u05dd \u05e2\u05d3\u05d9\u05d9\u05df \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e1\u05d1\u05d5\u05db\u05d9\u05dd.",map_object_desc_chongwu:"\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d7\u05d9\u05d5\u05ea \u05de\u05d7\u05de\u05d3 \u05de\u05d5\u05e0\u05e2\u05ea \u05d4\u05ea\u05e0\u05d2\u05e9\u05d5\u05ea \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea.",map_object_desc_zhituan:"\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d1\u05d3/\u05db\u05d3\u05d5\u05e8\u05d9 \u05e0\u05d9\u05d9\u05e8 \u05de\u05d5\u05e0\u05e2\u05ea \u05d4\u05e1\u05ea\u05d1\u05db\u05d5\u05d9\u05d5\u05ea \u05d5\u05dc\u05db\u05d9\u05d3\u05d4.",map_object_name_loosewire:"\u05d7\u05d5\u05d8\u05d9\u05dd/\u05db\u05d1\u05dc\u05d9\u05dd",map_object_name_cat:"\u05d7\u05d9\u05d9\u05ea \u05de\u05d7\u05de\u05d3",map_object_name_dog:"\u05d7\u05d9\u05d9\u05ea \u05de\u05d7\u05de\u05d3",map_object_name_curledfabric:"\u05d1\u05d3/\u05db\u05d3\u05d5\u05e8\u05d9 \u05e0\u05d9\u05d9\u05e8",auto_delivery_cleaning_fluid_title:"\u05de\u05d9\u05dc\u05d5\u05d9 \u05d7\u05db\u05dd \u05dc\u05ea\u05de\u05d9\u05e1\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9",auto_delivery_cleaning_fluid_desc:"\u05d4\u05d5\u05e1\u05e4\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05e9\u05dc \u05ea\u05de\u05d9\u05e1\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d1\u05e2\u05ea \u05e9\u05d8\u05d9\u05e4\u05ea \u05d4\u05de\u05d8\u05dc\u05d9\u05ea \u05d5\u05de\u05d9\u05dc\u05d5\u05d9 \u05d4\u05de\u05db\u05dc.",clean_route_fast_mode_guide_title:"\u05de\u05e6\u05d1 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05d4\u05d9\u05e8 \u05e2\u05dd \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8.",clean_route_fast_mode_guide_desc:"\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05dc\u05d5\u05de\u05d3 \u05d0\u05ea \u05d4\u05de\u05e8\u05d7\u05d1 \u05d5\u05de\u05e9\u05e0\u05d4 \u05d0\u05ea \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d1\u05d4\u05ea\u05d0\u05dd \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d0\u05e4\u05e9\u05e8 \u05e0\u05d9\u05e7\u05d9\u05d5\u05df \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8. \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05d3\u05dc\u05d2 \u05e2\u05dc \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d4\u05d7\u05d3\u05e8. \u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05d6\u05d0\u05ea \u05e0\u05d5\u05e2\u05d3\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d3\u05d9 \u05e4\u05e2\u05dd \u05d1\u05dc\u05d1\u05d3.",clean_route_fast_mode_is_work:"\u05de\u05e6\u05d1 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05d4\u05d9\u05e8",home_sepecial_tip_cleanmop_fastroute:"\u05de\u05e6\u05d1 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05d4\u05d9\u05e8 | \u05e9\u05d9\u05de\u05d5\u05e9 \u05d9\u05d7\u05d9\u05d3",livecall_autosoundoff_whenmoving_alerttitle:"\u05e9\u05d9\u05d7\u05d4 \u05d1\u05ea\u05e0\u05d5\u05e2\u05d4",livecall_autosoundoff_whenmoving_alertdesc:"\u05e9\u05d9\u05d7\u05d4 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05db\u05e9\u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05d1\u05ea\u05e0\u05d5\u05e2\u05d4. \u05d4\u05e9\u05d9\u05d7\u05d4 \u05de\u05d5\u05e9\u05ea\u05e7\u05ea \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc. \u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05d8\u05dc \u05d0\u05ea \u05d4\u05d4\u05e9\u05ea\u05e7\u05d4 \u05d1\u05de\u05d9\u05d3\u05ea \u05d4\u05e6\u05d5\u05e8\u05da.",carpet_clean_mode_detail4:"\u05ea\u05e7\u05e3 \u05dc\u05e9\u05d8\u05d9\u05d7\u05d5\u05e0\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d8\u05d9\u05d7\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd. \u05db\u05e9\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05d6\u05d4\u05d4 \u05e9\u05d8\u05d9\u05d7, \u05d4\u05de\u05d8\u05dc\u05d9\u05ea \u05de\u05d5\u05e8\u05de\u05ea \u05de\u05e2\u05dc\u05d4 \u05d5\u05d6\u05e8\u05d9\u05de\u05ea \u05d4\u05de\u05d9\u05dd \u05de\u05d5\u05e4\u05e1\u05e7\u05ea \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e9\u05d0\u05d5\u05d1 \u05d0\u05d1\u05e7 \u05de\u05d4\u05e9\u05d8\u05d9\u05d7.",clean_route_setting_title:"\u05de\u05e1\u05dc\u05d5\u05dc",map_object_desc_general_1:"\u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05dc\u05d9\u05d9\u05d6\u05e8 \u05e7\u05d5\u05d5\u05d9 \u05d4\u05e0\u05ea\u05de\u05da \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05d2\u05d5\u05d5\u05df \u05d7\u05d9\u05d9\u05e9\u05e0\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd, \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05db\u05d5\u05dc \u05dc\u05d6\u05d4\u05d5\u05ea \u05d5\u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05de\u05d2\u05d5\u05d5\u05df \u05e8\u05d7\u05d1 \u05e9\u05dc \u05de\u05db\u05e9\u05d5\u05dc\u05d9\u05dd.",robot_play_soundpackage_exception:"\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05d0\u05d6\u05e0\u05d4 \u05e0\u05db\u05e9\u05dc. \u05e0\u05e1\u05d4 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d9\u05e9\u05d9\u05e8.",offline_map_guide_title:"\u05de\u05e4\u05d4 \u05dc\u05d0\u05d9\u05ea\u05d5\u05e8 \u05d4\u05ea\u05e7\u05df \u05dc\u05d0 \u05de\u05e7\u05d5\u05d5\u05df",offline_map_guide_desc1:"\u05d0\u05dd \u05d4\u05d4\u05ea\u05e7\u05df \u05dc\u05d0 \u05d4\u05d5\u05d8\u05e2\u05df \u05de\u05e2\u05dc 12 \u05e9\u05e2\u05d5\u05ea, \u05d4\u05d5\u05d0 \u05d9\u05db\u05d1\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea. \u05d4\u05e4\u05e2\u05dc\u05ea \u05d4\u05de\u05e4\u05d4 \u05dc\u05d0\u05d9\u05ea\u05d5\u05e8 \u05d4\u05ea\u05e7\u05df \u05dc\u05d0 \u05de\u05e7\u05d5\u05d5\u05df \u05ea\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d0\u05ea\u05e8 \u05d0\u05d9\u05e4\u05d4 \u05d4\u05d9\u05d4 \u05d4\u05d4\u05ea\u05e7\u05df \u05dc\u05e4\u05e0\u05d9 \u05e9\u05db\u05d1\u05d4.",offline_map_tips_title:"\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05d4\u05ea\u05e7\u05df \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05e4\u05da \u05dc\u05dc\u05d0 \u05de\u05e7\u05d5\u05d5\u05df.",offline_map_tips_subtitle:"\u05d4\u05d4\u05ea\u05e7\u05df \u05d0\u05d5\u05ea\u05e8 \u05d1\u05de\u05d9\u05e7\u05d5\u05dd \u05d6\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05e4\u05da \u05dc\u05dc\u05d0 \u05de\u05e7\u05d5\u05d5\u05df. \u05d4\u05e0\u05d7 \u05d0\u05d5\u05ea\u05d5 \u05d7\u05d6\u05e8\u05d4 \u05e2\u05dc \u05ea\u05d7\u05e0\u05ea \u05d4\u05e2\u05d2\u05d9\u05e0\u05d4 \u05d5\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d9\u05d5\u05e4\u05e2\u05dc \u05d5\u05d9\u05ea\u05d7\u05d1\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05e8\u05e9\u05ea.",upgrade_progress_view_title:"\u05e2\u05d3\u05db\u05d5\u05df \u05e7\u05d5\u05e9\u05d7\u05d4",upgrade_progress_view_desc:"\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05e6\u05e2 \u05e9\u05d5\u05dd \u05e4\u05e2\u05d5\u05dc\u05d4. \u05d0\u05e0\u05d0 \u05d4\u05de\u05ea\u05df.",offline_map_tips_off_line_date:"\u05d6\u05de\u05df \u05dc\u05d0 \u05de\u05e7\u05d5\u05d5\u05df",home_sepcial_info_airdry_finish_time_minute:" \u05d9\u05d1\u05d5\u05e9 \u05d4\u05de\u05d8\u05dc\u05d9\u05ea, \u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd \u05de\u05e9\u05d5\u05e2\u05e8: ${minute} \u05d3\u05e7\u05d5\u05ea",map_edit_furniture_open_cattoilet:"\u05d0\u05e8\u05d2\u05d6 \u05d7\u05d5\u05dc \u05dc\u05d7\u05ea\u05d5\u05dc\u05d9\u05dd",map_edit_furniture_cat_toilet:"\u05d0\u05e8\u05d2\u05d6 \u05d7\u05d5\u05dc",map_edit_furniture_pet_cage:"\u05db\u05dc\u05d5\u05d1 \u05dc\u05d7\u05d9\u05d5\u05ea \u05de\u05d7\u05de\u05d3",map_edit_furniture_pet_waterloo:"\u05de\u05d9\u05d8\u05ea \u05d7\u05d9\u05d9\u05ea \u05de\u05d7\u05de\u05d3",map_edit_furniture_pet_bowl:"\u05e7\u05e2\u05e8\u05ea \u05d0\u05d5\u05db\u05dc/\u05de\u05d9\u05dd \u05e9\u05dc \u05d7\u05d9\u05d9\u05ea \u05de\u05d7\u05de\u05d3",unlock_clean_route_fast_mode_guide_title:"\u05d1\u05d9\u05d8\u05d5\u05dc \u05e0\u05e2\u05d9\u05dc\u05d4 \u05dc\u05de\u05e6\u05d1 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05d4\u05d9\u05e8",unlock_clean_route_fast_mode_guide_desc:"\u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05d5\u05db\u05e8\u05ea \u05d1\u05e9\u05d1\u05d9\u05dc \u05de\u05e6\u05d1 \u05d6\u05d4. \u05e9\u05de\u05e8\u05d5 \u05d0\u05ea \u05d4\u05de\u05e4\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e4\u05e2\u05dc\u05ea \u05de\u05e6\u05d1 \u05d6\u05d4.",water_updown_self_clean_title:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05e9\u05dc \u05ea\u05d7\u05e0\u05ea \u05d4\u05d8\u05e2\u05d9\u05e0\u05d4 \u05d5\u05d0\u05dc\u05de\u05e0\u05d8 \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e8\u05d9\u05e7\u05d5\u05df",water_updown_self_clean_desc:"\u05e9\u05d5\u05d8\u05e3 \u05d0\u05ea \u05e7\u05e2\u05e8\u05ea \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d5\u05de\u05db\u05dc \u05d4\u05d1\u05d9\u05d5\u05d1 \u05d4\u05de\u05d5\u05d1\u05e0\u05d4 \u05e9\u05dc \u05d4\u05d0\u05dc\u05de\u05e0\u05d8 \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e8\u05d9\u05e7\u05d5\u05df; \u05de\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05dc\u05de\u05e0\u05d8.",water_updown_self_clean_button_title:"\u05d4\u05ea\u05d7\u05dc\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9",water_updown_drain_title:"\u05e8\u05d9\u05e7\u05d5\u05df \u05d0\u05dc\u05de\u05e0\u05d8 \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e8\u05d9\u05e7\u05d5\u05df",water_updown_drain_desc:"\u05e8\u05d5\u05e7\u05e0\u05d5 \u05d0\u05ea \u05d9\u05ea\u05e8\u05ea \u05d4\u05de\u05d9\u05dd \u05de\u05de\u05d9\u05db\u05dc \u05d4\u05d1\u05d9\u05d5\u05d1 \u05d4\u05de\u05d5\u05d1\u05e0\u05d4.",water_updown_drain_button_title:"\u05d4\u05ea\u05d7\u05dc\u05ea \u05e8\u05d9\u05e7\u05d5\u05df",water_up_down_setting_item_title:"\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e8\u05d9\u05e7\u05d5\u05df",water_up_down_setting_item_desc:"\u05e9\u05d5\u05d8\u05e3 \u05d0\u05ea \u05e7\u05e2\u05e8\u05ea \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9; \u05de\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05dc\u05de\u05e0\u05d8.",product_info_dock_sn:"\u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9 \u05e9\u05dc \u05d4\u05ea\u05d7\u05e0\u05d4",product_info_dock_version:"\u05d2\u05e8\u05e1\u05ea \u05e7\u05d5\u05d7\u05e9\u05d4 \u05e9\u05dc \u05d4\u05ea\u05d7\u05e0\u05d4",error_up_water_title:"\u05e9\u05d2\u05d9\u05d0\u05ea \u05de\u05d9\u05dc\u05d5\u05d9",error_up_water_desc:"\u05d1\u05d3\u05e7\u05d5 \u05e9\u05d4\u05d1\u05e8\u05d6 \u05e4\u05ea\u05d5\u05d7 \u05d5\u05d5\u05d3\u05d0\u05d5 \u05e9\u05d4\u05de\u05d9\u05dd \u05d6\u05d5\u05e8\u05de\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e8\u05d2\u05d9\u05dc.",error_up_water_detail:"\u05d0\u05e0\u05d0 \u05d1\u05d3\u05e7\u05d5 \u05e9\u05d9\u05e9\u05e0\u05d4 \u05d0\u05e1\u05e4\u05e7\u05ea \u05de\u05d9\u05dd. \u05d0\u05dd \u05d0\u05e1\u05e4\u05ea \u05d4\u05de\u05d9\u05dd \u05ea\u05e7\u05d9\u05e0\u05d4, \u05d0\u05e0\u05d0 \u05d7\u05d1\u05e8\u05d5 \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05d4\u05db\u05d1\u05dc \u05e9\u05dc \u05d0\u05dc\u05de\u05e0\u05d8 \u05d4\u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e8\u05d9\u05e7\u05d5\u05df \u05d5\u05e0\u05e1\u05d5 \u05e9\u05e0\u05d9\u05ea \u05d0\u05dd \u05d4\u05d1\u05e2\u05d9\u05d4 \u05e0\u05de\u05e9\u05db\u05ea, \u05d9\u05e9 \u05dc\u05e4\u05e0\u05d5\u05ea \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05e7\u05d5\u05d7\u05d5\u05ea.",error_drain_water_title:"\u05e9\u05d2\u05d9\u05d0\u05ea \u05e8\u05d9\u05e7\u05d5\u05df",error_drain_water_desc:"\u05d1\u05d3\u05e7\u05d5 \u05e9\u05d0\u05d9\u05df \u05d7\u05e1\u05d9\u05de\u05d4 \u05d1\u05d9\u05e6\u05d9\u05d0\u05ea \u05e8\u05d9\u05e7\u05d5\u05df \u05d4\u05de\u05d9\u05dd \u05d5\u05d0\u05dd \u05d9\u05e9 \u05d0\u05d7\u05ea \u05d4\u05e1\u05d9\u05e8\u05d5 \u05d0\u05d5\u05ea\u05d4.",error_drain_water_detail:"\u05d1\u05d3\u05e7\u05d5 \u05e9\u05d0\u05d9\u05df \u05d7\u05e1\u05d9\u05de\u05d4 \u05d1\u05d9\u05e6\u05d9\u05d0\u05ea \u05e8\u05d9\u05e7\u05d5\u05df \u05d4\u05de\u05d9\u05dd \u05d5\u05d0\u05dd \u05d9\u05e9 \u05d0\u05d7\u05ea \u05d4\u05e1\u05d9\u05e8\u05d5 \u05d0\u05d5\u05ea\u05d4. \u05d0\u05dd \u05d4\u05d1\u05e2\u05d9\u05d4 \u05e0\u05de\u05e9\u05db\u05ea, \u05d9\u05e9 \u05dc\u05e4\u05e0\u05d5\u05ea \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05e7\u05d5\u05d7\u05d5\u05ea.",error_clean_carousel_unsetuped_title:"\u05d0\u05e0\u05d0 \u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05de\u05d2\u05e9 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9.",error_clean_carousel_unsetuped_desc:"\u05d4\u05ea\u05e7\u05df \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05de\u05d2\u05e9 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9.",error_clean_carousel_unsetuped_detail:"1.\u05d0\u05d1\u05d8\u05d7 \u05d0\u05ea \u05de\u05d2\u05e9 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d1\u05de\u05e7\u05d5\u05de\u05d5;2.\u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05de\u05e9\u05d4\u05d5 \u05e0\u05ea\u05e7\u05e2 \u05d1\u05e4\u05ea\u05d7 \u05d9\u05e6\u05d9\u05d0\u05ea \u05d4\u05de\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05d7\u05e0\u05d4;3.\u05d0\u05e0\u05d0 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05d5\u05d0\u05d1\u05d8\u05d7 \u05d0\u05ea \u05de\u05db\u05e1\u05d4 \u05de\u05db\u05dc \u05d4\u05de\u05d9\u05dd \u0