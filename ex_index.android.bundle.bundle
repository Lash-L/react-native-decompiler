\u01b0\u1eddng v\xf4 h\xecnh \u0111\u1ec3 b\u1ea3o v\u1ec7 tr\u01b0\u1edbc c\xe1c m\u1ed1i nguy h\u1ea1i",map_edit_relocate_error_timed_clean:"Kh\xf4ng \u0111\u1ecbnh v\u1ecb \u0111\u01b0\u1ee3c. H\u1ee7y l\u1ecbch tr\xecnh l\xe0m s\u1ea1ch",map_edit_relocate_error_spot:"L\u1ed7i \u0111\u1ecbnh v\u1ecb. Kh\xf4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c b\u1ea3n \u0111\u1ed3. Ti\u1ebfp t\u1ee5c l\xe0m s\u1ea1ch t\u1ea1i ch\u1ed7.",map_edit_robot_in_forbidden:"Ph\xe1t hi\u1ec7n khu v\u1ef1c kh\xf4ng \u0111\u01b0\u1ee3c v\xe0o ho\u1eb7c t\u01b0\u1eddng v\xf4 h\xecnh. \u0110\u01b0a robot \u0111\u1ebfn v\u1ecb tr\xed m\u1edbi",map_edit_virtual_wall_too_close_to_dock:"T\u01b0\u1eddng \u1ea3o qu\xe1 g\u1ea7n \u0111\u1ebf s\u1ea1c, vui l\xf2ng \u0111i\u1ec1u ch\u1ec9nh v\u1ecb tr\xed t\u01b0\u1eddng \u1ea3o ",map_edit_forbidden_too_close_to_dock:"Khu v\u1ef1c kh\xf4ng \u0111\u01b0\u1ee3c v\xe0o qu\xe1 g\u1ea7n dock s\u1ea1c",map_edit_relocate_error_back_to_charge:"L\u1ed7i \u0111\u1ecbnh v\u1ecb. Kh\xf4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c b\u1ea3n \u0111\u1ed3. L\xe0m s\u1ea1ch l\u1ea1i",map_edit_relocate_error_new_clean:"Kh\xf4ng \u0111\u1ecbnh v\u1ecb \u0111\u01b0\u1ee3c. B\u1eaft \u0111\u1ea7u l\u1ea7n l\xe0m s\u1ea1ch m\u1edbi",map_edit_map_edit_reset_remind:"Sau khi b\u1ea3n \u0111\u1ed3 b\u1ecb x\xf3a, c\xe1c t\xe1c v\u1ee5 v\xe0 c\u1ea5u h\xecnh \u0111\xe3 l\xean l\u1ecbch li\xean quan s\u1ebd kh\xf4ng c\xf2n h\u1ee3p l\u1ec7 v\xe0 kh\xf4ng th\u1ec3 kh\xf4i ph\u1ee5c b\u1ea3n \u0111\u1ed3.",map_edit_map_lab_close_warn:"Sau khi \u0111\xf3ng, b\u1ea3n \u0111\u1ed3 v\xe0 c\xe1c c\xe0i \u0111\u1eb7t li\xean quan s\u1ebd b\u1ecb x\xf3a \u0111\u1ed3ng th\u1eddi v\xe0 kh\xf4ng th\u1ec3 kh\xf4i ph\u1ee5c b\u1ea3n \u0111\u1ed3!",map_edit_map_lab_save_map_kindly_remind3:"Sau khi l\u01b0u b\u1ea3n \u0111\u1ed3, n\u1ebfu b\u1ea1n th\u1ea5y b\u1ea3n \u0111\u1ed3 ho\u1eb7c l\u1ed9 tr\xecnh d\u1ecdn d\u1eb9p kh\xf3 hi\u1ec3u ho\u1eb7c h\xe0nh vi d\u1ecdn d\u1eb9p kh\xf4ng b\xecnh th\u01b0\u1eddng, vui l\xf2ng x\xf3a b\u1ea3n \u0111\u1ed3 v\xe0 t\u1ea1o l\u1ea1i.",map_edit_map_lab_save_map_kindly_remind2:"Di chuy\u1ec3n robot b\u1eb1ng tay trong qu\xe1 tr\xecnh l\xe0m s\u1ea1ch c\xf3 th\u1ec3 g\xe2y ra l\u1ed7i v\u1ecb tr\xed v\xe0 s\u1ebd kh\xf4ng l\u01b0u \u0111\u01b0\u1ee3c b\u1ea3n \u0111\u1ed3",map_edit_map_lab_save_map_kindly_remind1:"Robot s\u1ebd xu\u1ea5t ph\xe1t t\u1eeb \u0111\u1ebf s\u1ea1c, sau khi v\u1ec7 sinh v\xe0 t\u1ef1 \u0111\u1ed9ng s\u1ea1c l\u1ea1i, robot s\u1ebd t\u1ef1 \u0111\u1ed9ng l\u01b0u b\u1ea3n \u0111\u1ed3 v\xe0 ph\xe2n v\xf9ng.",map_edit_map_lab_save_map_kindly_remind:"H\u01b0\u1edbng d\u1eabn s\u1eed d\u1ee5ng",map_edit_map_lab_save_map_des:"Sau khi b\u1ea3n \u0111\u1ed3 \u0111\u01b0\u1ee3c l\u01b0u, robot s\u1ebd l\xean k\u1ebf ho\u1ea1ch d\u1ecdn d\u1eb9p m\u1ed9t c\xe1ch th\xf4ng minh d\u1ef1a tr\xean c\xe1c ph\xf2ng. B\u1ea1n c\xf3 th\u1ec3 ch\u1ec9 \u0111\u1ecbnh c\xe1c ph\xf2ng c\u1ea7n d\u1ecdn d\u1eb9p, \u0111\u1eb7t c\xe1c khu v\u1ef1c h\u1ea1n ch\u1ebf, v.v. \u0111\u1ec3 m\u1edf kh\xf3a c\xe1c ph\u01b0\u01a1ng ph\xe1p d\u1ecdn d\u1eb9p \u0111\u01b0\u1ee3c c\xe1 nh\xe2n h\xf3a h\u01a1n.",map_edit_map_lab_save_map:"\u0110ang l\u01b0u b\u1ea3n \u0111\u1ed3",map_edit_no_save:"Kh\xf4ng",map_edit_forbidden_zone_exceed_limit:"S\u1ed1 l\u01b0\u1ee3ng khu v\u1ef1c h\u1ea1n ch\u1ebf \u0111\xe3 \u0111\u1ea1t \u0111\u1ebfn gi\u1edbi h\u1ea1n",map_edit_virtual_wall_exceed_limit:"S\u1ed1 l\u01b0\u1ee3ng t\u01b0\u1eddng \u1ea3o \u0111\xe3 \u0111\u1ea1t \u0111\u1ebfn gi\u1edbi h\u1ea1n",map_edit_title:"Qu\u1ea3n l\xfd b\u1ea3n \u0111\u1ed3",map_edit_button_text_save:"L\u01b0u",rubys_history_del_toast_failed:"X\xf3a kh\xf4ng th\xe0nh c\xf4ng. Ki\u1ec3m tra k\u1ebft n\u1ed1i m\u1ea1ng",rubys_history_del_toast_succ:"\u0110\xe3 x\xf3a",rubys_history_del_button:"X\xf3a b\u1ea3n \u0111\u1ed3",rubys_location_confirm_button_confirm:"OK",rubys_main_alert_title_privacy:"Ch\xednh s\xe1ch Quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a Robot h\xfat b\u1ee5i Roborock",rubys_setting_guide_contact_report_for_reference:"Xem chi ti\u1ebft",rubys_setting_guide_contact_report_tip:"Nh\u1eadt k\xfd \u0111\u01b0\u1ee3c b\xe1o c\xe1o c\xf3 th\u1ec3 ch\u1ee9a th\xf4ng tin c\xe1 nh\xe2n c\u1ee7a b\u1ea1n v\xe0 ch\xfang t\xf4i s\u1ebd \u0111\u1ea3m b\u1ea3o t\xednh b\u1ea3o m\u1eadt cho th\xf4ng tin c\u1ee7a b\u1ea1n",rubys_setting_guide_contact_report_log:"B\xe1o c\xe1o nh\u1eadt k\xfd s\u1ef1 c\u1ed1",rubys_main_diag_update_map:"\u0110ang c\u1eadp nh\u1eadt b\u1ea3n \u0111\u1ed3",rubys_error_23_description:"Vui l\xf2ng d\u1ecdn s\u1ea1ch c\xe1c v\u1eadt c\u1ea3n xung quanh khu v\u1ef1c truy\u1ec1n t\xedn hi\u1ec7u c\u1ee7a \u0111\u1ebf s\u1ea1c v\xe0 gi\u1eef cho khu v\u1ef1c truy\u1ec1n t\xedn hi\u1ec7u lu\xf4n th\xf4ng tho\xe1ng. N\u1ebfu s\u1ef1 c\u1ed1 v\u1eabn ti\u1ebfp di\u1ec5n, vui l\xf2ng r\xfat ph\xedch c\u1eafm v\xe0 r\xfat \u0111\u1ebf s\u1ea1c r\u1ed3i th\u1eed l\u1ea1i.",rubys_error_23_subtitle:"H\xe3y v\u1ec7 sinh khu v\u1ef1c truy\u1ec1n t\xedn hi\u1ec7u c\u1ee7a \u0111\u1ebf s\u1ea1c",rubys_error_23_title:"S\u1ea1c th\u1ea5t b\u1ea1i",rubys_error_22_description:"Vui l\xf2ng lau c\u1ea3m bi\u1ebfn s\u1ea1c c\u1ee7a m\xe1y ch\u1ee7 b\u1eb1ng v\u1ea3i kh\xf4 tr\u01b0\u1edbc khi s\u1ea1c.",rubys_error_22_subtitle:"V\u1ec7 sinh c\u1ea3m bi\u1ebfn s\u1ea1c",rubys_error_22_title:"L\u1ed7i c\u1ea3m bi\u1ebfn s\u1ea1c",rubys_error_21_description:"C\u1ea3m bi\u1ebfn \xe1p su\u1ea5t \u0111\u1ea7u laser b\u1ecb k\u1eb9t ho\u1eb7c b\u1ecb \u0111\xe8. Vui l\xf2ng lo\u1ea1i b\u1ecf v\u1eadt l\u1ea1 ho\u1eb7c di chuy\u1ec3n \u0111\u1ebfn v\u1ecb tr\xed m\u1edbi \u0111\u1ec3 b\u1eaft \u0111\u1ea7u.",rubys_error_21_subtitle:"H\xe3y l\xe0m s\u1ea1ch v\u1eadt l\u1ea1 tr\xean n\u1eafp \u0111\u1ea7u laser",rubys_error_21_title:"C\u1ea3m bi\u1ebfn \xe1p su\u1ea5t \u0111\u1ea7u laser b\u1ecb l\u1ed7i",rubys_main_goto_cancel_alet:"X\xe1c \u0111\u1ecbnh n\u01a1i d\u1eebng l\u1ea1i",rubys_main_goto_click_text:"H\xe3y click v\xe0o b\u1ea3n \u0111\u1ed3 \u0111\u1ec3 \u0111\u1eb7t \u0111i\u1ec3m m\u1ee5c ti\xeau",rubys_main_segment_clean_alert:"Khu v\u1ef1c \u01b0u ti\xean l\xe0m s\u1ea1ch",rubys_main_toast_zoned_part_finish:"M\u1ed9t s\u1ed1 khu v\u1ef1c kh\xf4ng th\u1ec3 ti\u1ebfp c\u1eadn \u0111\u01b0\u1ee3c v\xe0 nhi\u1ec7m v\u1ee5 \u0111\xe3 k\u1ebft th\xfac.",rubys_main_toast_goto_not_finish:"Kh\xf4ng th\u1ec3 \u0111i t\u1edbi v\u1ecb tr\xed ch\u1ec9 \u0111\u1ecbnh.",rubys_main_toast_goto_finish:"\xa0\u0110\xe3 t\u1edbi v\u1ecb tr\xed ch\u1ec9 \u0111\u1ecbnh, khu v\u1ef1c l\xe0m s\u1ea1ch t\u1ea1i ch\u1ed7 l\xe0 1,5m x 1,5m.",rubys_main_button_text_goto_cmd:"\u0110i",rubys_main_subtitle_goto_target:"\u0110i t\u1edbi v\u1ecb tr\xed ch\u1ec9 \u0111\u1ecbnh",rubys_main_zone_max_tips:"Th\xeam t\u1ed1i \u0111a 5 khu v\u1ef1c",rubys_main_button_text_add:"Th\xeam",rubys_main_button_text_zone:"L\xe0m s\u1ea1ch khu v\u1ef1c",rubys_main_button_text_goto:"X\xe1c \u0111\u1ecbnh v\u1ecb tr\xed",setting_volume_tips_text:"B\u1ea1n c\xf3 th\u1ec3 k\xe9o thanh tr\u01b0\u1ee3t \u0111\u1ec3 \u0111i\u1ec1u ch\u1ec9nh v\xe0 nghe \xe2m l\u01b0\u1ee3ng gi\u1ecdng n\xf3i c\u1ee7a robot.",setting_carpet_mode_text:"Robot s\u1ebd t\u0103ng l\u1ef1c h\xfat \u1edf khu v\u1ef1c th\u1ea3m v\xe0 tr\u1edf v\u1ec1 l\u1ef1c h\xfat b\xecnh th\u01b0\u1eddng sau khi r\u1eddi kh\u1ecfi th\u1ea3m.",setting_carpet_mode_title:"T\u0103ng c\u01b0\u1eddng v\u1ec7 sinh th\u1ea3m",setting_robot_setting:"C\xe0i \u0111\u1eb7t nhi\u1ec1u ch\u1ee9c n\u0103ng",setting_timezone_remark:"N\u1ebfu m\xfai gi\u1edd c\u1ee7a robot kh\xf4ng ch\xednh x\xe1c, th\u1eddi gian \u0111\u1ecbnh gi\u1edd v\xe0 th\u1eddi gian kh\xf4ng l\xe0m phi\u1ec1n s\u1ebd b\u1ecb gi\xe1n \u0111o\u1ea1n.",setting_timezone_text:"B\u1ea1n c\xf3 th\u1ec3 \u0111\u1ed3ng b\u1ed9 h\xf3a m\xfai gi\u1edd c\u1ee7a \u0111i\u1ec7n tho\u1ea1i di \u0111\u1ed9ng v\u1edbi robot. Vui l\xf2ng \u0111\u1ea3m b\u1ea3o r\u1eb1ng \u0111i\u1ec7n tho\u1ea1i di \u0111\u1ed9ng v\xe0 robot \u1edf c\xf9ng khu v\u1ef1c.",setting_timezone_button:"\u0110\u1ed3ng b\u1ed9 m\xfai gi\u1edd \u0111i\u1ec7n tho\u1ea1i di \u0111\u1ed9ng v\u1edbi robot",setting_timezone_title:"M\xfai gi\u1edd c\u1ee7a robot",supplies_sensors_reset_button:"\u0110\xe3 l\xe0m s\u1ea1ch (\u0111\u1eb7t l\u1ea1i th\u1eddi gian)",supplies_sensors_reset_content:"X\xe1c nh\u1eadn c\xe1c c\u1ea3m bi\u1ebfn \u0111\xe3 s\u1ea1ch",supplies_sensors_text:"Trong qu\xe1 tr\xecnh l\xe0m s\u1ea1ch robot, c\xe1c c\u1ea3m bi\u1ebfn v\xe0 c\xe1c b\u1ed9 ph\u1eadn kh\xe1c s\u1ebd b\u1ecb d\xednh b\u1ee5i v\xe0 c\xe1c ch\u1ea5t l\u1ea1 kh\xe1c, c\xf3 th\u1ec3 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn hi\u1ec7u qu\u1ea3 l\xe0m s\u1ea1ch b\u1eb1ng kh\u0103n gi\u1ea5y sau khi l\xe0m vi\u1ec7c t\u1eeb 30 gi\u1edd tr\u1edf xu\u1ed1ng.",supplies_sensors_name:"C\xe1c c\u1ea3m bi\u1ebfn",remote_control_segment_joystick:"C\u1ea7n \u0111i\u1ec1u khi\u1ec3n",remote_control_segment_key:"\u1ea4n n\xfat",localization_strings_Main_Error_Constants_23:"L\u1ed7i c\u1ea3m bi\u1ebfn t\u01b0\u1eddng",localization_strings_Main_Error_Constants_22:"L\u1ed7i kh\u1edfi ch\u1ea1y c\u1ea3m bi\u1ebfn t\u01b0\u1eddng",localization_strings_Main_Error_Constants_21:"L\u1ed7i kh\u1edfi ch\u1ea1y \xe2m thanh",localization_strings_Main_Error_Constants_20:"\u0110\u1ed3ng h\u1ed3 t\u1ed1c \u0111\u1ed9 b\xe1nh xe b\xean ph\u1ea3i kh\xf4ng c\xf3 d\u1eef li\u1ec7u",localization_strings_Main_Error_Constants_19:"\u0110\u1ed3ng h\u1ed3 t\u1ed1c \u0111\u1ed9 b\xe1nh xe b\xean tr\xe1i kh\xf4ng c\xf3 d\u1eef li\u1ec7u",localization_strings_Main_Error_Constants_18:"L\u1ed7i thi\u1ebft b\u1ecb c\u1ee7a \u0111\u1ed3ng h\u1ed3 t\u1ed1c \u0111\u1ed9",localization_strings_Main_Error_Constants_17:"L\u1ed7i m\xf4 \u0111un WiFi 2",localization_strings_Main_Error_Constants_16:"L\u1ed7i m\xf4 \u0111un WiFi 1",localization_strings_Main_Error_Constants_15:"L\u1ed7i NVRAM",localization_strings_Main_Error_Constants_14:"L\u1ed7i IC s\u1ea1c",localization_strings_Main_Error