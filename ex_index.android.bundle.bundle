istory_record_all:"Toate",error_detail_55:"1. Verifica\u021bi dac\u0103 tava de cur\u0103\u021bare este instalat\u0103 la locul s\u0103u. 2. Verifica\u021bi dac\u0103 nu este nimic blocat \xeen scurgerea docului. 3. Verifica\u021bi dac\u0103 docul evacueaz\u0103 apa conform a\u0219tept\u0103rilor.",download_photo_title:"Desc\u0103rcare fotografie",video_load_failed_view:"\xcenc\u0103rcarea \xeenregistr\u0103rii video a e\u0219uat",setting_item_ground_desc:"Regleaz\u0103 set\u0103rile pentru covoare \u0219i pardoseli.",setting_item_dock_desc:"Regleaz\u0103 modul de sp\u0103lare, golire \u0219i uscare a mopului.",add_zone_on3d_maptype_tip:"Comuta\u021bi la modul 2D pentru a ad\u0103uga o zon\u0103.",setting_history_data_last_cleantime:"Durata ultimei cur\u0103\u021b\u0103ri",setting_history_data_last_cleanarea:"Ultima suprafa\u021b\u0103 de cur\u0103\u021bare",setting_search_placeholder_text:"C\u0103utare",total_clean_time_area:"Durata \u0219i suprafa\u021ba de cur\u0103\u021bare acumulat\u0103",retry_reached_maximum_text:"A fost atins num\u0103rul maxim de re\xeencerc\u0103ri.",unknown_error_text:"Intervalul de \xeenc\u0103rcare a \xeenregistr\u0103rii video a e\u0219uat. \xcencerca\u021bi din nou.",error_31_title:"Eroare la senzorii din fa\u021b\u0103 \u0219i din spate",error_31_desc:"\u0218terge\u021bi \u0219i porni\u021bi din nou",error_31_detail:"\u0218terge\u021bi senzorii din fa\u021b\u0103 \u0219i din spate \u0219i porni\u021bi din nou robotul.",error_36_title:"Senzorul din fa\u021b\u0103 este murdar",error_36_desc:"\u0218terge\u021bi cu o lavet\u0103 uscat\u0103",error_36_detail:"Folosi\u021bi o lavet\u0103 uscat\u0103 pentru a cur\u0103\u021ba senzorul.",error_37_title:"Senzorul din spate este murdar",error_37_detail:"Folosi\u021bi o lavet\u0103 uscat\u0103 pentru a cur\u0103\u021ba senzorul.",patral_point_add_over_30_text:"A fost atins num\u0103rul maxim de puncte de pornire a deplas\u0103rii.",no_command_tip:"Niciun flux de lucru",setting_page_lab:"Laborat