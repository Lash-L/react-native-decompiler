_5:"Khi m\u1edf ho\u1eb7c t\u1eaft video tr\u1ef1c ti\u1ebfp, robot s\u1ebd ph\xe1t ra l\u1eddi nh\u1eafc b\u1eb1ng gi\u1ecdng n\xf3i.",egg_page_attack_title:"T\xecm ki\u1ebfm",egg_page_stop_button_title:"D\u1eebng",start_egg_attack_with_other_task_tip:"Th\u1ef1c hi\u1ec7n thao t\xe1c n\xe0y s\u1ebd k\u1ebft th\xfac qu\xe1 tr\xecnh l\xe0m s\u1ea1ch hi\u1ec7n t\u1ea1i. ",egg_page_title:"Ch\u1ebf \u0111\u1ed9 T\xecnh y\xeau",defender_mode_introduction:"Gi\u1edbi thi\u1ec7u Ch\u1ebf \u0111\u1ed9 T\xecnh y\xeau, t\u1ea1i \u0111\xe2y, Roborock c\u1ee7a b\u1ea1n c\xf3 th\u1ec3 th\u1ec3 hi\u1ec7n c\u1ea3m x\xfac th\u1eadt v\u1edbi nh\u1eefng robot h\xfat b\u1ee5i kh\xe1c. Roborock kh\xf4ng ph\xe2n bi\u1ec7t th\u01b0\u01a1ng hi\u1ec7u hay m\xe0u s\u1eafc, khi S7 MaxV c\u1ee7a b\u1ea1n nh\xecn th\u1ea5y m\u1ed9t robot kh\xe1c, m\xe1y s\u1ebd b\xe0y t\u1ecf t\xecnh y\xeau b\u1eb1ng m\u1ed9t n\u1ee5 h\xf4n kh\u1ebd.\r\n\r\nC\u1ea2NH B\xc1O: Roborock kh\xf4ng ch\u1ecbu tr\xe1ch nhi\u1ec7m v\u1edbi em b\xe9 robot n\xe0o ho\u1eb7c trong tr\u01b0\u1eddng h\u1ee3p m\xe1y m\xf3c tr\u1ed7i d\u1eady.",egg_attack_start_title:"B\u1eaft \u0111\u1ea7u",armap_match_failed:"K\u1ebft n\u1ed1i b\u1ea3n \u0111\u1ed3 th\u1ea5t b\u1ea1i",armap_match_success:"K\u1ebft n\u1ed1i b\u1ea3n \u0111\u1ed3 th\xe0nh c\xf4ng",armap_delete_confirm:"B\u1ea1n c\xf3 ch\u1eafc mu\u1ed1n x\xf3a b\u1ea3n \u0111\u1ed3 theo c\xf4ng ngh\u1ec7 th\u1ef1c t\u1ebf t\u0103ng c\u01b0\u1eddng (Matrix) kh\xf4ng?",armap_scan_save_mesh_failed_toast:"L\u01b0u kh\xf4ng th\xe0nh c\xf4ng",armap_scan_stop_confirm:"D\u1eebng thi\u1ebft l\u1eadp b\u1ea3n \u0111\u1ed3 theo c\xf4ng ngh\u1ec7 th\u1ef1c t\u1ebf t\u0103ng c\u01b0\u1eddng (Matrix)?",monitor_voice_privacy_dialog_title:"Ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a video v\xe0 gi\u1ecdng n\xf3i tr\u1ef1c ti\u1ebfp",camera_monitor_voice_privacy_title:"Ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a video v\xe0 gi\u1ecdng n\xf3i tr\u1ef1c ti\u1ebfp",armap_guide_