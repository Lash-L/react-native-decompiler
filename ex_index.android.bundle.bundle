\uc8fc\uc138\uc694.\r\n* \uae08\uc9c0 \uc601\uc5ed\uc758 \ud06c\uae30\uc640 \uc704\uce58 \uc815\ubcf4\uac00 \uc815\ud655\ud558\uc9c0 \uc54a\uc740 \uacbd\uc6b0, \ud06c\uae30\ub97c \uc870\uc808\ud574 \uc8fc\uc138\uc694.",setting_carpet_deep_clean_switch_title:"\uce74\ud3ab \uc815\ubc00 \uccad\uc18c",setting_carpet_deep_clean_switch_desc:"\uccad\uc18c \ud6c4 \ud574\ub2f9 \uc601\uc5ed \ub0b4 \uce74\ud3ab\uc5d0 \ub300\ud574 2\ucc28 \uccad\uc18c\ub97c \uc9c4\ud589\ud569\ub2c8\ub2e4.\n* \uc791\uc740 \ub9e4\ud2b8\ub294 \uc81c\uc678",map_ai_zone_bubble_set:"\ud074\ub9ad\ud558\uc5ec \uac78\ub9bc \uc601\uc5ed\uc744 \ud655\uc778\ud574 \uc8fc\uc138\uc694",map_ai_zone_bubble_adjust:"\ud074\ub9ad\ud558\uc5ec \uc9c4\uc785 \uae08\uc9c0 \uc601\uc5ed\uc744 \uc870\uc808\ud574 \uc8fc\uc138\uc694",warning_for_will_delete_wifi:"\uc0ad\uc81c\ud558\uba74 \ubcf8\uccb4\ub294 \ub354\uc774\uc0c1 \ud574\ub2f9 WIFI\ub97c \uc5f0\uacb0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",wifi_page_current_wifi:"\ud604\uc7ac WIFI",wifi_page_others_wifi:"\uae30\ud0c0 WIFI",wifi_page_title:"WIFI",map_edit_floor_wood_width:"\ubc14\ub2e5(\uac00\ub85c)",map_edit_floor_wood_longti:"\ubc14\ub2e5(\uc138\ub85c)",ground_material_clean_direction_title:"\ubc14\ub2e5\uc7ac \ubc29\ud5a5\uc5d0 \ub530\ub77c \uccad\uc18c",ground_material_clean_direction_detail:"\uc804\uccb4 \uccad\uc18c/\ubc29 \uc9c0\uc815 \uccad\uc18c \uc9c4\ud589 \uc2dc, \ubc14\ub2e5\uc7ac \ubc29\ud5a5\uc5d0 \ub530\ub77c \uccad\uc18c\ud558\uc5ec \uae30\uae30\uc640 \ud2c8\uc0c8 \uc0ac\uc774\uc758 \ub9c8\ucc30\uc744 \uac10\uc18c\ud569\ub2c8\ub2e4.\r\n* \ubc14\ub2e5\uc7ac \uc7ac\uc9c8 \uc124\uc815 \ud544\uc694. \ub2e8\uc77c \ubc29\ud5a5 \uccad\uc18c\ub9cc \uc9c0\uc6d0.",map_edit_door_sill_exceed_limit:"\ubb38\ud131 \uc218\uac00 \uc0c1\ud55c\uc5d0 \ub3c4\ub2ec\ud558\uc600\uc2b5\ub2c8\ub2e4.",map_cliff_zone_guide_text:"\ub099\ud558 \uc704\ud5d8\uc774 \uc5ec\ub7ec \ubc88 \uac10\uc9c0\ub418\uc5b4 \uae08\uc9c0 \uc601\uc5ed\uc73c\ub85c \uc790\ub3d9 \uc124\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",map_stuck_point_guide_text:"\uccad\uc18c\uae30\uac00 \uc5ec\uae30\uc5d0\uc11c \uc5ec\ub7ec \ubc88 \uac78\ub9bc \uc704\ud5d8\uc774 \ubc1c\uc0dd\ud558\uc5ec \uc9c4\uc785 \uae08\uc9c0 \uc601\uc5ed\uc73c\ub85c \uc124\uc815\ud560 \uac83\uc744 \uad8c\uc7a5\ud574 \ub4dc\ub9bd\ub2c8\ub2e4.",map_door_sill_guide_text:"\ubb38\ud131\uc774 \uac10\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ubb38\ud131 \uc601\uc5ed \uc124\uc815.",clean_route_fast_mode_title:"\ucf8c\uc18d",wifi_rssi_title:"\uc2e0\ud638 \uac15\ub3c4",map_object_desc_sanxian:"\ub298\uc5b4\uc9c4 \ucf00\uc774\ube14\uc744 \uc778\uc2dd\ud558\uace0 \ud68c\ud53c\ud558\uc5ec \uba54\uc778 \ube0c\ub7ec\uc2dc \ub610\ub294 \uc0ac\uc774\ub4dc \ube0c\ub7ec\uc2dc \uac10\uae40 \uc704\ud5d8\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4. \uc77c\ubd80 \uac00\ub298\uace0 \uae34 \ucf00\uc774\ube14\uc740 \uac10\uae38 \uc704\ud5d8\uc774 \uc788\uc2b5\ub2c8\ub2e4.",map_object_desc_chongwu:"\uace0\uc591\uc774, \uac15\uc544\uc9c0 \ub4f1 \uc560\uc644\ub3d9\ubb3c\uc744 \uac10\uc9c0\ud558\uc5ec \ubd80\ub52a\uce68\uc744 \ubc29\uc9c0\ud558\uace0 \uc790\uace0 \uc788\ub294 \uc560\uc644\ub3d9\ubb3c\uc744 \ubc29\ud574\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",map_object_desc_zhituan:"\uc9c1\ubb3c \ubb49\uce58 \ub610\ub294 \uc885\uc774 \ubb49\uce58\ub97c \uc790\ub3d9\uc801\uc73c\ub85c \uc2dd\ubcc4\ud558\uc5ec \uba54\uc778 \ube0c\ub7ec\uc2dc \uac10\uae40\uc73c\ub85c \uc778\ud55c \ub85c\ubd07 \uc791\uc5c5 \uc624\ub958\ub97c \ubc29\uc9c0\ud569\ub2c8\ub2e4.",map_object_name_loosewire:"\uc640\uc774\uc5b4\ub958",map_object_name_cat:"\uc560\uc644 \ub3d9\ubb3c",map_object_name_dog:"\uc560\uc644 \ub3d9\ubb3c",map_object_name_curledfabric:"\uc9c1\ubb3c \ubb49\uce58/\uc885\uc774 \ubb49\uce58",auto_delivery_cleaning_fluid_title:"\uc790\ub3d9 \ud22c\uc785",auto_delivery_cleaning_fluid_desc:"\ubb3c\uac78\ub808 \uc138\ucc99 \ubc0f \ubb3c \ubcf4\ucda9 \uc2dc \uc790\ub3d9\uc73c\ub85c \uc138\uc815\uc81c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4.",clean_route_fast_mode_guide_title:"\ucf8c\uc18d \uccad\uc18c \ubaa8\ub4dc, \uc720\uc5f0\ud55c \uc870\uc808\ub85c \ud6a8\uc728 \ud5a5\uc0c1",clean_route_fast_mode_guide_desc:"\uc810\ucc28\uc801\uc73c\ub85c \ud658\uacbd\uc744 \ud30c\uc545\ud558\uace0 \uc774\uc5d0 \uae30\ubc18\ud558\uc5ec \uacbd\ub85c\ub97c \uc870\uc808\ud558\uc5ec \ud6a8\uc728\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \ubd84\ud560 \uc601\uc5ed \uac00\uc7a5\uc790\ub9ac\ub294 \uccad\uc18c\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \ub204\ub77d\ub420 \uac00\ub2a5\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uac00\ub054 \uac04\ub2e8\ud55c \ud658\uacbd \uc720\uc9c0\uac00 \ud544\uc694\ud560 \ub54c\uc5d0\ub9cc \uc0ac\uc6a9\ud558\uc2e4 \uac83\uc744 \uad8c\uc7a5\ud574 \ub4dc\ub9bd\ub2c8\ub2e4.",clean_route_fast_mode_is_work:"\ucf8c\uc18d \uccad\uc18c \uc911",home_sepecial_tip_cleanmop_fastroute:"\ucf8c\uc18d \uccad\uc18c \uc911. 1\ud68c\ub9cc \uc801\uc6a9",livecall_autosoundoff_whenmoving_alerttitle:"\uc8fc\ud589 \uc2dc \ud1b5\ud654",livecall_autosoundoff_whenmoving_alertdesc:"\uc8fc\ud589 \uc2dc \ud1b5\ud654 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uae30\ubcf8 \uc124\uc815\uc740 \uc74c\uc18c\uac70 \uc0c1\ud0dc\uc774\uba70 \uc218\ub3d9\uc73c\ub85c \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",carpet_clean_mode_detail4:"\ub9e4\ud2b8 \ub610\ub294 \uc791\uc740 \uce74\ud3ab\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \uce74\ud3ab\uc774 \uac10\uc9c0\ub418\uba74 \ubb3c\uac78\ub808 \uccad\uc18c \ubaa8\ub4c8\uc744 \uc790\ub3d9\uc801\uc73c\ub85c \ub4e4\uc5b4\uc62c\ub824 \ubb3c \ubc29\ucd9c\uc744 \uc911\ub2e8\ud558\uace0 \uce74\ud3ab \uccad\uc18c\ub9cc \uc9c4\ud589\ud569\ub2c8\ub2e4.",clean_route_setting_title:"\uacbd\ub85c \uc124\uc815",map_object_desc_general_1:"\ub85c\ubd07\uc740 \ub77c\uc778 \ub808\uc774\uc800\uc640 \uc5ec\ub7ec \uac1c \uc13c\uc11c\ub97c \ud1b5\ud574 \uccad\uc18c\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\ub294 \ubc14\ub2e5 \ubb3c\ud488\uc744 \ud310\ub2e8\ud558\uace0 \ud68c\ud53c\ud569\ub2c8\ub2e4.",robot_play_soundpackage_exception:"\ubbf8\ub9ac\ub4e3\uae30 \uc2e4\ud328. \uc9c1\uc811 \uc0ac\uc6a9\ud574 \ubcf4\uc138\uc694.",offline_map_guide_title:"\uc624\ud504\ub77c\uc778 \uc9c0\ub3c4",offline_map_guide_desc1:"\uae30\uae30\ub294 \ube44\ucda9\uc804 \uc0c1\ud0dc\uc5d0\uc11c 12\uc2dc\uac04\uc774 \uc9c0\ub098\uba74 \uc790\ub3d9\uc73c\ub85c \uc804\uc6d0\uc744 \ucc28\ub2e8\ud569\ub2c8\ub2e4. \uc624\ud504\ub77c\uc778 \uc9c0\ub3c4\ub97c \ud65c\uc131\ud654\ud558\uba74 \uc624\ud504\ub77c\uc778 \uc804 \uc704\uce58\ub97c \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4.",offline_map_tips_title:"\uae30\uae30 \uc624\ud504\ub77c\uc778 \uc804 \uc704\uce58",offline_map_tips_subtitle:"\uae30\uae30\ub294 \uc624\ud504\ub77c\uc778 \uc804 \uc5ec\uae30\uc5d0 \uc704\uce58\ud574 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. \uae30\uae30\ub97c \ucda9\uc804 \ub3c4\ud06c\uc5d0 \uc62c\ub824\ub450\uba74 \uc790\ub3d9\uc73c\ub85c \uc804\uc6d0\uc744 \ucf1c\uace0 \ub124\ud06c\uc6cc\ud06c\ub97c \uc5f0\uacb0\ud569\ub2c8\ub2e4.",upgrade_progress_view_title:"\ud38c\uc6e8\uc5b4 \uc5c5\uadf8\ub808\uc774\ub4dc \uc911",upgrade_progress_view_desc:"\ub85c\ubd07 \uc0ac\uc6a9 \ubd88\uac00. \uc7a0\uc2dc\ub9cc \uae30\ub2e4\ub824 \uc8fc\uc138\uc694",offline_map_tips_off_line_date:"\uc624\ud504\ub77c\uc778 \uc2dc\uac04",home_sepcial_info_airdry_finish_time_minute:"\ubb3c\uac78\ub808 \uac74\uc870 \uc9c4\ud589 \uc911. ${minute}\ubd84 \ud6c4 \uc644\ub8cc\ub420 \uc608\uc815\uc785\ub2c8\ub2e4.",map_edit_furniture_open_cattoilet:"\uc624\ud508\ud615 \uace0\uc591\uc774 \ubc30\ubcc0\ud1b5",map_edit_furniture_cat_toilet:"\ud3d0\uc1c4\ud615 \uace0\uc591\uc774 \ubc30\ubcc0\ud1b5",map_edit_furniture_pet_cage:"\uc560\uc644\ub3d9\ubb3c \ucf00\uc774\uc9c0",map_edit_furniture_pet_waterloo:"\uc560\uc644\ub3d9\ubb3c \uc7a0\uc790\ub9ac",map_edit_furniture_pet_bowl:"\uc560\uc644\ub3d9\ubb3c \uc2dd\uae30 \uc601\uc5ed",unlock_clean_route_fast_mode_guide_title:"[\ucf8c\uc18d \uccad\uc18c] \uc7a0\uae08 \ud574\uc81c",unlock_clean_route_fast_mode_guide_desc:"'\ucf8c\uc18d \uccad\uc18c' \ubaa8\ub4dc\ub294 \uc775\uc219\ud55c \ud658\uacbd\uc5d0\uc11c\ub9cc \uc791\ub3d9\ud569\ub2c8\ub2e4. \uba3c\uc800 \uc9c0\ub3c4\ub97c \uc0dd\uc131\ud558\uace0 \uc0ac\uc6a9\ud574 \uc8fc\uc138\uc694.",water_updown_self_clean_title:"\ub3c4\ud06c \uae09\ubc30\uc218 \uc140\ud504 \uc138\ucc99",water_updown_self_clean_desc:"\ub3c4\ud06c\uc758 \uc138\ucc99 \ud0f1\ud06c \ubc0f \ub0b4\uc7a5 \uc624\uc218\ud1b5\uc744 \uc138\ucc99\ud558\uac70\ub098 \uae09\ubc30\uc218 \uc0c1\ud0dc\ub97c \uc810\uac80\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.",water_updown_self_clean_button_title:"\uc140\ud504 \uc138\ucc99 \uc2dc\uc791",water_updown_drain_title:"\uae09\ubc30\uc218 \uc21c\ud658",water_updown_drain_desc:"\ub0b4\uc7a5\ub41c \uc624\uc218\ud0f1\ud06c\uc5d0 \ub0a8\uc740 \ubb3c\uc744 \ubc30\uc218\ud558\uc138\uc694.",water_updown_drain_button_title:"\uae09\ubc30\uc218 \uc21c\ud658 \uc2dc\uc791",water_up_down_setting_item_title:"\uae09\ubc30\uc218 \uc124\uc815",water_up_down_setting_item_desc:"\ub3c4\ud06c\uc758 \uc138\ucc99 \ud0f1\ud06c\ub97c \uc138\ucc99\ud558\uac70\ub098 \uae09\ubc30\uc218 \uc0c1\ud0dc\ub97c \uc810\uac80\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.",product_info_dock_sn:"\ub3c4\ud06c \uc2dc\ub9ac\uc5bc \ub118\ubc84",product_info_dock_version:"\ub3c4\ud06c \ubc84\uc804",error_up_water_title:"\uae09\uc218 \uc624\ub958",error_up_water_desc:"\uc218\ub3c4\uaf2d\uc9c0\ub97c \uc5f4\uc5b4 \ubb3c\uc774 \uc815\uc0c1\uc801\uc73c\ub85c \uacf5\uae09\ub418\ub294\uc9c0 \ud655\uc778\ud574 \uc8fc\uc138\uc694.",error_up_water_detail:"\uba3c\uc800 \ub2e8\uc218\uac00 \ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud574 \uc8fc\uc138\uc694. \uadf8\ub807\uc9c0 \uc54a\uc740 \uacbd\uc6b0 \uae09\ubc30\uc218 \ubaa8\ub4c8\uc758 \uc5f0\uacb0\uc120\uc744 \ube7c\uace0 \ub2e4\uc2dc \uc5f0\uacb0\ud574 \ubcf4\uc138\uc694. \ubb38\uc81c\uac00 \uc5ec\uc804\ud788 \uc9c0\uc18d\ub41c\ub2e4\uba74 \uace0\uac1d\uc13c\ud130\ub85c \ubb38\uc758\ud574 \uc8fc\uc138\uc694.",error_drain_water_title:"\ubc30\uc218 \uc624\ub958",error_drain_water_desc:"\ubc30\uc218\uad6c \uc774\ubb3c\uc9c8\uc744 \uc81c\uac70\ud574 \uc8fc\uc138\uc694.",error_drain_water_detail:"\ubc30\uc218\uad6c \uc774\ubb3c\uc9c8\uc744 \uc81c\uac70\ud574 \uc8fc\uc138\uc694. \ubb38\uc81c\uac00 \uc5ec\uc804\ud788 \uc9c0\uc18d\ub41c\ub2e4\uba74 \uace0\uac1d\uc13c\ud130\ub85c \ubb38\uc758\ud574 \uc8fc\uc138\uc694.",error_clean_carousel_unsetuped_title:"\uc138\ucc99 \ud2b8\ub808\uc774\ub97c \uc810\uac80\ud574 \uc8fc\uc138\uc694.",error_clean_carousel_unsetuped_desc:"\uc138\ucc99 \ud2b8\ub808\uc774\ub97c \uc81c\ub300\ub85c \uc7a5\ucc29\ud574 \uc8fc\uc138\uc694.",error_clean_carousel_unsetuped_detail:"1. \uc138\ucc99 \ud2b8\ub808\uc774\uac00 \uc81c\ub300\ub85c \uc7a5\ucc29\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud574 \uc8fc\uc138\uc694.\n2. \ub3c4\ud06c \ubc30\uc218\uad6c\uc5d0 \uc774\ubb3c\uc9c8\uc774 \ub07c\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud574 \uc8fc\uc138\uc694.\n3. \uc624\uc218\ud1b5 \uc0c1\ub2e8 \ucee4\ubc84 \ub798\uce58\uac00 \uc81c\ub300\ub85c \uccb4\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud574 \uc8fc\uc138\uc694.",error_clean_carousel_water_full_title:"\uc138\ucc99 \ud2b8\ub808\uc774\uc5d0 \ubb3c\uc774 \uac00\ub4dd \ucc38",error_clean_carousel_water_full_desc:"\ubc30\uc218\uad6c \uc774\ubb3c\uc9c8\uc744 \ud655\uc778 \ubc0f \uc81c\uac70\ud574 \uc8fc\uc138\uc694.",error_clean_carousel_water_full_detail:"\ub3c4\ud06c \ubc30\uc218\uad6c\uac00 \ub9c9\ud600 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ubb3c\uc9c8\uc774 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uace0 \uc81c\uac70\ud574 \uc8fc\uc138\uc694. \uc774\ubb3c\uc9c8\uc774 \uc5c6\ub294 \uacbd\uc6b0 \uc624\uc218\ud1b5 \uc0c1\ub2e8 \ucee4\ubc84 \ubc0f \ub798\uce58\uac00 \uc81c\ub300\ub85c \uccb4\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud574 \uc8fc\uc138\uc694.",map_edit_map_unsave:"\uc9c0\ub3c4\ub97c \uc800\uc7a5\ud55c \ud6c4 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694.",charger_type_name_special:"\ub3c4\ud06c",valley_electricity_not_set_hint:"* \ucda9\uc804 \uc2dc\uac04\uc744 \uc124\uc815\ud558\uc9c0 \uc54a\uc544 \uc624\ud504 \ud53c\ud06c \ucda9\uc804 \uae30\ub2a5\uc774 \ud65c\uc131\ud654 \ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.",dock_kit_setting0:"5\uc2dc\uac04",washing_mode_updown_water_selfcleaning:"\uc140\ud504 \uc138\ucc99\uc911",washing_mode_updown_water_drain:"\uae09\ubc30\uc218 \uc21c\ud658 \uc9c4\ud589 \uc911",wash_towel_mode_title_4:"\ucd08\uc815\ubc00 \uc138\ucc99",wash_towel_mode_desc_4:"\ub354\uc6b1 \uae68\ub057\ud55c \ubb3c\uac78\ub808 \uc138\ucc99\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uae09\ubc30\uc218 \ubaa8\ub4c8 \uc124\uce58 \ud658\uacbd\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uac83\uc744 \uad8c\uc7a5\ud569\ub2c8\ub2e4.",dock_panel_function_section_title:"\ub3c4\ud06c \uc81c\uc5b4",dock_info_clear_water_box_title:"\uc815\uc218\ud1b5",dock_info_clear_water_box_exception1:"\ubb3c \ubd80\uc871",dock_info_dirty_water_box_title:"\uc624\uc218\ud1b5",dock_info_dirty_water_box_exception1:"\ubb3c \uac00\ub4dd \ucc38/\ubbf8\uc7a5\ucc29",dock_info_clean_fluid_title:"\uc138\ucc99\uc561\ud1b5",dock_info_clean_fluid_exception:"\uc794\ub7c9 \ubd80\uc871",dock_info_water_box_filter_title:"\uc6cc\ud130 \ud544\ud130",dock_info_item_gone_exception:"\ubbf8\uc7a5\ucc29",dock_info_dust_bag_exception:"\ub354\uc2a4\ud2b8\ubc31 \uac00\ub4dd\ucc38",toast_clean_then_mop_24hour:"\uba3c\uc9c0\uac00 \ub9ce\uc740 \ud658\uacbd\uc5d0\uc11c\ub294 \ubb3c\uac78\ub808 \uccad\uc18c\ub97c \uc9c4\ud589\ud558\uae30 \uc804\uc5d0 \uba3c\uc800 \uc9c4\uacf5 \uccad\uc18c\ub97c \uc9c4\ud589\ud560 \uac83\uc744 \uad8c\uc7a5\ud574\ub4dc\ub9bd\ub2c8\ub2e4.",cliff_zones_save_failed:"\ub099\ud558 \uae08\uc9c0 \uc601\uc5ed \uc800\uc7a5 \uc2e4\ud328",inner_error_desc_151:"\uac74\uc870 \ud32c \uc624\ub958",inner_error_desc_152:"\uae09\ubc30\uc218-\ubc30\uc218 \ud38c\ud504 \uc624\ub958",inner_error_desc_153:"\uae09\ubc30\uc218-\uae09\uc218 \uc804\uc790 \ubc38\ube0c/\ubb3c\ud1b5 \uc218\uc704 \uc13c\uc11c \uc624\ub958",inner_error_desc_154:"\uc0ac\uc774\ub4dc \ube0c\ub7ec\uc2dc \uc624\ub958",inner_error_desc_158:"\uae09\ubc30\uc218-\uc624\uc218\ud1b5 \uc218\uc704 \uc13c\uc11c \uc624\ub958",inner_error_desc_159:"\uae09\ubc30\uc218-\ud1b5\uc2e0 \uc624\ub958",map_edit_furniture_floor_mirror:"\uc804\uc2e0\uac70\uc6b8",map_edit_split_too_small:"\uba74\uc801\uc774 \uc791\uc544 \ubd84\ud560 \uccad\uc18c\ub97c \uad8c\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",setting_auto_avoid_obstacle_title:"\uc2a4\ub9c8\ud2b8 \uc7a5\uc560\ubb3c \ud68c\ud53c",setting_auto_avoid_obstacle_desc:"\uad6c\uc870\uad11 \uc561\ud2f0\ube0c \uce21\uc815 \uae30\ub2a5, \ub2e4\uc911 \uc13c\uc11c \uc735\ud569\uc73c\ub85c \uc2a4\ub9c8\ud2b8\ud55c \uc7a5\uc560\ubb3c \ud68c\ud53c",error_water_carriage_drop_title:"\ubb3c\uac78\ub808 \ubc1b\uce68\ub300\uac00 \ud0c8\ub77d\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",error_water_carriage_drop_desc:"\uc7a5\ucc29\ud558\uc5ec \uc791\uc5c5\uc744 \uacc4\uc18d\ud558\uc138\uc694.",error_water_carriage_drop_detail:"\ubb3c\uac78\ub808 \ubc1b\uce68\ub300\uac00 \ud0c8\ub77d\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc7a5\ucc29\ud558\uc5ec \uc791\uc5c5\uc744 \uacc4\uc18d\ud558\uc138\uc694.",supplies_pearl_strainer_name:"\uc138\ucc99 \ud2b8\ub808\uc774",supplies_pearl_strainer_description:"\uc138\ucc99 \ud2b8\ub808\uc774\ub294 \ubb3c\uac78\ub808\ub97c \uc138\ucc99\ud558\uba74\uc11c \ub098\uc624\ub294 \ud070 \uc774\ubb3c\uc9c8\uc744 \uac78\ub7ec\ub0b4\uc5b4 \ubc30\uc218\uad00 \ub9c9\ud798\uc744 \ubc29\uc9c0\ud558\uace0 \uc624\uc218\ud1b5\uc758 \uc6d0\ud65c\ud55c \ubc30\uc218\ub97c \ub3c4\uc640\uc90d\ub2c8\ub2e4. \ub9e4\uc6d4 1\ud68c \uc774\uc0c1 \uae68\ub057\ud55c \ubb3c\ub85c \uc138\ucc99 \ud2b8\ub808\uc774\ub97c \uc138\ucc99\ud558\uc138\uc694.",alert_pause_current_task_then_selfclean:"\ud604\uc7ac \uc791\uc5c5\uc744 \uc885\ub8cc\ud558\uace0 \uae09\ubc30\uc218 \uc140\ud504 \uc138\ucc99\uc744 \uc2dc\uc791\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",alert_pause_current_task_then_drain:"\ud604\uc7ac \uc791\uc5c5\uc774 \uc644\ub8cc\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc885\ub8cc \ud6c4 \uc0ac\uc6a9\ud558\uc138\uc694.",close_auto_dry_alert_desc:"\uac74\uc870 \uae30\ub2a5\uc744 \ube44\ud65c\uc131\ud654\ud558\uba74 \ubb3c\uac78\ub808\uc5d0\uc11c \ubd88\ucf8c\ud55c \ub0c4\uc0c8\uac00 \ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\ud65c\uc131\ud654\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",drain_left_water_tip1:"1. \ubcf8\uccb4\ub97c \ub3c4\ud06c\uc5d0 \uc62c\ub824\ub193\uace0 \ucda9\uc804 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud574 \uc8fc\uc138\uc694. \uc624\uc218\ud1b5(\ub610\ub294 \uae09\ubc30\uc218 \uc138\ud2b8), \uc138\ucc99 \ud2b8\ub808\uc774\uac00 \uc81c\ub300\ub85c \uc7a5\ucc29\ub418\uc5c8\ub294\uc9c0 \uc810\uac80\ud558\uace0 \ubb3c\uac78\ub808 \ubc1b\uce68\ub300\ub97c \ubd84\ub9ac\ud558\uc138\uc694.",drain_left_water_tip2:"2. \"\uc794\uc5ec \ubb3c\uae30 \ube44\uc6c0 \uc2dc\uc791\"\uc744 \ub204\ub978 \ud6c4 \uc791\uc5c5\uc774 \uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub824\uc8fc\uc138\uc694.",drain_left_water_tip3:"3. 5~10\ubd84\uc758 \uc2dc\uac04\uc774 \uc18c\uc694\ub429\ub2c8\ub2e4. \ubcf8\uccb4\uc640 \ub3c4\ud06c\ub97c \uc62e\uae30\uc9c0 \ub9c8\uc138\uc694.",drain_left_water_tip4:"4. \ubcf8\uccb4\uc5d0\uc11c '\ubc30\uc218\uac00 \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4' \ub77c\ub294 \uc54c\ub9bc\uc774 \ub098\uc624\uba74 \ube44\uc6c0 \uc791\uc5c5\uc774 \uc644\ub8cc\ub41c \uac83\uc785\ub2c8\ub2e4. \uc624\uc218\ud1b5(\ub610\ub294 \uae09\ubc30\uc218 \uc138\ud2b8) \ub0b4 \uc624\uc218\ub97c \ube44\uc6cc \uc8fc\uc138\uc694.",drain_left_water_title:"\uc794\uc5ec \ubb3c\uae30 \uc790\ub3d9 \ube44\uc6c0",left_water_is_draining:"\ubcf8\uccb4 \ubc30\uc218 \uc911",start_drain_left_water:"\uc794\uc5ec \ubb3c\uae30 \ube44\uc6c0 \uc2dc\uc791",left_water_drain_page_title:"\uace0\uac1d\uc9c0\uc6d0 \ubaa8\ub4dc",inner_error_desc_128:"\ubb3c\uac78\ub808 \ubaa8\ub4c8\uc758 \ubaa8\ud130 \ud68c\ub85c\uac00 \ub2e8\ub77d\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",inner_error_desc_129:"\ubb3c\uac78\ub808 \ubaa8\ub4c8\uc758 \ubaa8\ud130 \ud68c\ub85c\uac00 \ucc28\ub2e8\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",setting_carpet_first_switch_title:"\uce74\ud3ab \uc6b0\uc120 \uccad\uc18c",setting_carpet_first_switch_desc:"\uc6b0\uc120 \uce74\ud3ab \uc601\uc5ed\uc5d0 \ub300\ud574 \uc9c4\uacf5 \uccad\uc18c\ub97c \uc218\ud589\ud558\uace0 \ub2e4\ub978 \uc601\uc5ed\uc744 \uccad\uc18c\ud569\ub2c8\ub2e4. \n* \uc791\uc740 \ub9e4\ud2b8 \uc81c\uc678.",skip_current_cleanarea_buttontitle:"\uc2a4\ud0b5 \uc601\uc5ed",pearl_supplies_strainer_reset_content:"\uc138\ucc99 \ud2b8\ub808\uc774\ub97c \uc138\ucc99\ud558\uc168\uc2b5\ub2c8\uae4c?",setting_back_wash_interval:"\uc57d ${minute}\ubd84",inner_error_desc_156:"\ub3c4\ud06c ODD \uc624\ub958",robot_is_warm_up_tip_try:"\ub85c\ubd07\uc744 \uc608\uc5f4 \uc911\uc785\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624.",localization_strings_Main_MainPage_12:"\ubcf5\uad6c",unsave_map_alert_mess:"\ubcc0\uacbd \ub0b4\uc6a9\uc774 \ub9ce\uc774 \ubc1c\uc0dd\ud558\uc600\uc2b5\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc800\uc7a5\ub41c \ub9f5\uc744 \ubcf5\uad6c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",unsave_map_alert_chargeroffset:"\uccad\uc18c \ub3c4\uc911 \ub9f5\uc774 \ubcc0\uacbd\ub41c \uac83 \uac19\uc2b5\ub2c8\ub2e4. \uc800\uc7a5\ub41c \ub9f5\uc744 \ubcf5\uad6c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?",donot_disturb_same_time_warning:"\uc2dc\uc791 \uc2dc\uac04\uacfc \uc885\ub8cc \uc2dc\uac04\uc774 \uac19\uc2b5\ub2c8\ub2e4. \ubcc0\uacbd\ud574 \uc8fc\uc138\uc694",add_supplement_area_buttontitle:"\uc9c0\uc5ed \ucd94\uac00",goto_supplememt_cleanarea_title:"\ucd94\uac00 \uccad\uc18c\ud558\uae30",home_page_pearl_supplies_strainer_upgrade_tip:"\uc624\ub7ab\ub3d9\uc548 \uad00\ub9ac\ud558\uc9c0 \uc54a\uc740 \uc138\ucc99 \ud2b8\ub808\uc774\ub97c \uccad\uc18c\ud574 \uc8fc\uc138\uc694.",pearl_slow_mop_guide_title:"\ubaa8\uc11c\ub9ac \ub525 \ud074\ub9ac\ub2dd, \uc5bc\ub8e9 \uc81c\uac70",pearl_slow_mop_guide_detail:"\ub85c\ubd07\uc774 \ubcf4\ub2e4 \uc138\ubc00\ud55c \uc9c0\uadf8\uc7ac\uadf8 \ud328\ud134 \ubc0f \ub2a6\uc740 \uc8fc\ud589 \uc18d\ub3c4\uc5d0 \ub530\ub77c \ubcf8\uccb4\ub97c \uc8c4\uc6b0 \ud68c\uc804\ud558\uba74\uc11c \uccad\uc18c\ub97c \uc218\ud589\ud558\uc5ec \uc2ec\ud55c \uc624\uc5fc\ubb3c\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4. \ud574\ub2f9 \ubaa8\ub4dc\ub294 \uc9c4\uacf5 \uccad\uc18c\uac00 \uc644\ub8cc\ub41c \ubc14\ub2e5\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",floor_map_name_no_emoji:"\uc774\ub984\uc5d0 \uc774\ubaa8\ud2f0\ucf58\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4",smart_scene_sort:"\ubd84\ub958",supplement_zone_hint_view_title:"\ucd94\uac00 \uc120\ud0dd \uccad\uc18c \uad6c\uc5ed",supplement_zone_hint_view_desc:"\ucd94\uac00 \uccad\uc18c \ud6c4 \ud604\uc7ac \uccad\uc18c \uc791\uc5c5 \uc644\ub8cc\ud558\uae30",skip_current_area_alert_tip:"\uace7 \ud604\uc7ac \uad6c\uc5ed\uc744 \uac74\ub108\ub6f0\uace0 \ub2e4\uc74c \uad6c\uc5ed\uc744 \uccad\uc18c\ud569\ub2c8\ub2e4. \n*\uc774\ubc88 \uc791\uc5c5\uc5d0\uc11c\ub294 \ud574\ub2f9 \uad6c\uc5ed\uc744 \uccad\uc18c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",corner_clean_switch_title:"\ubaa8\uc11c\ub9ac \ub525 \ud074\ub9ac\ub2dd",corner_clean_switch_desc:"\ubaa8\uc11c\ub9ac \ubd80\ubd84\uc5d0 \ub525 \ud074\ub9ac\ub2dd \uc9c4\ud589. 1\ud68c\ub9cc \uc218\ud589",cannot_cornerclean_withfastclean_toast:"\ucf8c\uc18d \uccad\uc18c \uc2dc\uc5d0\ub294 \uae30\uae30\uac00 \ubcbd\uba74\uc744 \ub530\ub77c \uc6c0\uc9c1\uc774\uc9c0 \uc54a\uc73c\ubbc0\ub85c \ubaa8\uc11c\ub9ac \ub525 \ud074\ub9ac\ub2dd\uc744 \uc9c4\ud589\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4",switchfastroute_withcornerclean_toast:"\ubaa8\uc11c\ub9ac \ub525 \ud074\ub9ac\ub2dd' \ubaa8\ub4dc\ub97c \ube44\ud65c\uc131\ud654\ud55c \ud6c4 '\ucf8c\uc18d \uccad\uc18c'\ub97c \uc9c4\ud589\ud574 \uc8fc\uc138\uc694",sub_cleanstatus_supplement_clean:"\ucd94\uac00 \uc9c4\uacf5 \uccad\uc18c \uc911",sub_cleanstatus_dirtyrepeat_clean:"\ubc18\ubcf5 \ubb3c\uac78\ub808 \uccad\uc18c \uc911",toast_supplementclean_status_notready:"\ud604 \uc0c1\ud0dc\uc5d0\uc11c\ub294 \ucd94\uac00 \uc9c4\uacf5 \uccad\uc18c\uac00 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4",toast_supplementclean_finish:"\ucd94\uac00 \uc9c4\uacf5 \uccad\uc18c\uac00 \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uacc4\uc18d\ud574\uc11c \ub2e4\ub978 \uc601\uc5ed\uc744 \uccad\uc18c\ud569\ub2c8\ub2e4",toast_supplementclean_notreach:"\ucd94\uac00 \uc9c4\uacf5 \uccad\uc18c\uac00 \uc124\uc815\ub41c \uad6c\uc5ed\uc5d0 \uc811\uadfc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",toast_supplementclean_partly_notreach:"\ucd94\uac00 \uc9c4\uacf5 \uccad\uc18c\uac00 \uc124\uc815\ub41c \uc77c\ubd80 \uad6c\uc5ed\uc5d0 \uc811\uadfc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.",alert_new_supplementcleantask_willoverride_oldtask:"\uc2e0\uaddc \ucd94\uac00 \uccad\uc18c \uc791\uc5c5\uc744 \uc2dc\uc791\ud558\uba74 \ud604\uc7ac \uc9c4\ud589 \uc911\uc778 \ucd94\uac00 \uccad\uc18c \uc791\uc5c5\uc774 \uc790\ub3d9\uc73c\ub85c \uc885\ub8cc\ub429\ub2c8\ub2e4.",home_specialtip_for_maxplus_clean:"Max+ | 1\ud68c \uc801\uc6a9",charging_resume_clean_page_title:"\ucda9\uc804 \ubc0f \uc774\ub825\uc11c",reminder_second_page_check:"\uc54c\uc558\uc5b4\uc694",reminder_second_page_stop_task:"\ud604\uc7ac \uc791\uc5c5 \uc885\ub8cc",mode_panel_cleancount_title:"\uccad\uc18c \ud69f\uc218",clean_count_times:"${count}\ud68c",mode_setting_panel_cleanmop_tip:"\ub300\ubd80\ubd84 \uc77c\ubc18 \uccad\uc18c\uc5d0 \uc801\ud569",mode_setting_panel_pureclean_tip:"\uccad\uc18c\ub9cc \uc9c4\ud589. 1\ud68c\ub9cc \uc801\uc6a9 \uac00\ub2a5",mode_setting_panel_puremop_tip:"\uba3c\uc9c0 \ud761\uc785 \uc81c\uc678. 1\ud68c\ub9cc \uc801\uc6a9 \uac00\ub2a5",cleanmode_maxplus_footnote:"\uc804\ub825 \uc18c\ube44\ub7c9\uc774 \ub192\uc544 \ubc30\ud130\ub9ac \uc9c0\uc18d \uc2dc\uac04\uc774 \uc904\uc5b4\ub4ec",charging_dialog_title:"\ucda9\uc804 \uc0c1\ud0dc\uc5d0\uc11c \uc601\uc0c1 \uae30\ub2a5\uc744 \ud65c\uc131\ud574 \uc8fc\uc138\uc694",setting_realtime_video_switch_detail:"\ud65c\uc131\ud654\ud558\uba74 \uc9d1\uc548 \uc0c1\ud669\uc744 \uc2e4\uc2dc\uac04\uc73c\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",real_time_video_call_volume_title_text:"\ud1b5\ud654 \uc74c\ub7c9",real_time_video_call_volume_subtitle_text:"\ud1b5\ud654 \uc2dc \ub85c\ubd07 \uc2a4\ud53c\ucee4 \uc74c\ub7c9 \uc870\uc808",real_time_video_waiting_dialog_before_top_title:"\ud65c\uc131\ud654 \ub300\uae30 \uc911...",recommend_global_hint:"\uc815\ubc00\ud55c \ubc14\ub2e5 \uccad\uc18c \uc218\ud589. \uc8fc\ub9d0 \ub300\uccad\uc18c\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",recommend_dining_area_hint:"\uc2dd\uc0ac \ud6c4 \uc8fc\ubc29 \ubc0f \ub2e4\uc774\ub2dd \uad6c\uc5ed \uccad\uc18c\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",recommend_clean_then_mop_hint:"\ub354\uc6b1 \uae68\ub057\ud55c \uccad\uc18c\ub97c \uc704\ud574 \uc9c4\uacf5 \uccad\uc18c \uc644\ub8cc \ud6c4 \ubb3c\uac78\ub808\uc9c8\uc744 \uc218\ud589\ud569\ub2c8\ub2e4.",setting_carpet_first_switch_desc_nocarpet:"\uce74\ud3ab\uc744 \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. '\ubc14\ub2e5 \uc7ac\uc9c8 \ud3b8\uc9d1' \ud398\uc774\uc9c0\uc5d0\uc11c \uc124\uc815\ud574 \uc8fc\uc138\uc694.",setting_ground_clean_setting:"\ubc14\ub2e5 \uccad\uc18c \uc124\uc815",setting_ground_clean_setting_title:"\ubc14\ub2e5 \uc7ac\uc9c8 \ud3b8\uc9d1",setting_ground_clean_setting_detail:"\ubc14\ub2e5 \uc790\uc7ac\ub97c \uac1c\uc120\ud558\uc5ec \uccad\uc18c \ud6a8\uacfc\ub97c \ub192\uc785\ub2c8\ub2e4.",setting_ground_dirty_replenish_title:"\uc624\uc5fc \uad6c\uc5ed \uc790\ub3d9 \uc7ac\uccad\uc18c",setting_ground_dirty_replenish_detail:"\uc624\uc5fc \uad6c\uc5ed\uc774 \uac10\uc9c0\ub418\uba74 \ubb3c\uac78\ub808\ub97c \uc138\ucc99\ud558\uace0 \ud574\ub2f9 \uad6c\uc5ed\uc5d0 \ub300\ud574 \ub2e4\uc2dc \ubb3c\uac78\ub808 \uccad\uc18c\ub97c \uc218\ud589\ud569\ub2c8\ub2e4.",toast_start_goto_supplementzone:"\ucd94\uac00 \uccad\uc18c \uad6c\uc5ed\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4.",toast_will_leave_skipped_area:"\ud6