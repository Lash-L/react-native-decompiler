 \xe9l\xe9ments",exhibition_mode_steering:"Moteur de direction",exhibition_mode_main_brush_fan:"Brosses principales et puissance d\u2019aspiration",exhibition_mode_shake_mop:"Serpilli\xe8re VibraRise",exhibition_mode_srotating_mop:"Serpilli\xe8re rotative",exhibition_mode_up:"Position relev\xe9e",exhibition_mode_down:"Position abaiss\xe9e",exhibition_shake_mode_start:"Vibrer",exhibition_mode_stop:"Arr\xeater",exhibition_mode_start:"D\xe9marrer",exhibition_mode_rotating_start:"Tourner",exhibition_mode_expansion:"\xc9tendre",exhibition_mode_anastole:"R\xe9tracter",exhibition_mode_steering_up:"Roulette omnidirectionnelle relev\xe9e",exhibition_mode_steering_down:"Roulette omnidirectionnelle abaiss\xe9e",exhibition_mode_move_steering_up:"Roulettes principales relev\xe9es",exhibition_mode_move_steering_down:"Roulettes principales abaiss\xe9es",exhibition_mode_left_move_steering_up:"Roulette principale gauche relev\xe9e",exhibition_mode_left_move_steering_down:"Roulette principale gauche abaiss\xe9e",exhibition_mode_right_move_steering_up:"Roulette principale droite relev\xe9e",exhibition_mode_right_move_steering_down:"Roulette principale droite abaiss\xe9e",exhibition_mode_all_move_steering_up:"Toutes les roulettes relev\xe9es",exhibition_mode_all_move_steering_down:"Toutes les roulettes abaiss\xe9es",robot_start_type_smart_command_voice:"Usages par des commandes vocales",robot_start_type_smart_command_manual:"Usages manuels",robot_start_type_smart_command_timer:"Usages programm\xe9s","error59.wav":"Erreur 59\xa0: roulettes principales coinc\xe9es. V\xe9rifiez s\u2019il y a des obstructions.","error60.wav":"Erreur 60\xa0: roulette omnidirectionnelle coinc\xe9e. V\xe9rifiez s\u2019il y a des obstructions.",undefined:"D\xe9sol\xe9, je ne sais parler qu\u2019en chinois pour le moment. Je vais m\u2019efforcer d\u2019apprendre d\u2019autres langues.","error36.wav":"Le capteur de navigation avant est peut-\xeatre sale. Nettoyez-le.","error37.wav":"Le capteur de navigation arri