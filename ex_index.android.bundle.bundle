44 \uc791\ub3d9\ud558\uba74 \uc2a4\ub9c8\ud2b8 \uc778\uc2dd \ubaa8\ub4dc\uac00 \uc801\uc6a9\ub429\ub2c8\ub2e4.",manual_switch_pattern:"\uc218\ub3d9 \uc120\ud0dd \ubaa8\ub4dc",smart_switch_tip:"\uae30\uae30\uac00 \uc791\ub3d9\ub418\uba74 \uc790\ub3d9\uc73c\ub85c \uc9c0\ub3c4 \ubc0f \ud604\uc7ac \uc704\uce58\ub97c \uc778\uc2dd\ud569\ub2c8\ub2e4.",smart_switch_pattern:"\uc2a4\ub9c8\ud2b8 \uc778\uc2dd \ubaa8\ub4dc",map_edit_carpet_zone_exceed_limit:"\ucd5c\ub300 \uce74\ud3ab \uc218\uc5d0 \ub3c4\ub2ec\ud588\uc2b5\ub2c8\ub2e4.",map_edit_carpet_add_tip:"\uae30\uc874 \uce74\ud3ab\uc744 \ud0ed\ud558\uba74 \ud3b8\uc9d1\ud558\uac70\ub098 \uc0ad\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",map_edit_carpet_add_carpet:"\uce74\ud3ab \ucd94\uac00",error_clean_brush_exception_desc:"\uccad\uc18c \ube0c\ub7ec\uc2dc \uc138\ucc99",error_clean_bruch_exception_title:"\uc6cc\ud130 \ud544\ud130\uac00 \uc62c\ubc14\ub974\uac8c \uc7a5\ucc29\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.",error_resolved:"\ud574\uacb0\ub428",wash_towel_mode_title_3:"\uc815\ubc00 \uc138\ucc99",wash_towel_mode_title_2:"\uc77c\ubc18 \uc138\ucc99",wash_towel_mode_title_1:"\ucf8c\uc18d \uc138\ucc99",wash_towel_mode_title:"\ubb3c\uac78\ub808 \uc138\ucc99 \ubaa8\ub4dc",wash_towel_title:"\ubb3c\uac78\ub808 \uccad\uc18c \uc124\uc815",avoid_collision_mode:"\ucda9\ub3cc \uac10\uc18c \ubaa8\ub4dc",charged_resume_clean_detail:"\ucda9\uc804\uc774 \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub85c\ubd07\uc744 \uc791\ub3d9\ud558\uc5ec \uccad\uc18c\ub97c \uacc4\uc18d\ud558\uc138\uc694.",clean_path_record_palyback:"###\u56de\u653e|\u5185\u6d4b",clean_path_record_speed:"###\u500d\u901f",clean_path_record_play:"\uc7ac\uc0dd \uc7ac\uac1c",clean_path_record_pause:"\uc7ac\uc0dd \uc77c\uc2dc \uc911\uc9c0",home_page_supplies_strainer_upgrade_tip:"\uc6cc\ud130 \ud544\ud130\ub97c \uc624\ub7ab\ub3d9\uc548 \uc138\ucc99\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc6cc\ud130 \ud544\ud130\ub97c \uc138\ucc99\ud558\uc138\uc694.",supplies_strainer_description:"\ub3c4\ud06c\uc758 \uc6cc\ud130 \ud544\ud130\ub294 \ub354\ub7ec\uc6b4 \ubb3c\uc5d0\uc11c \uc774\ubb3c\uc9c8\uc744 \uac78\ub7ec\ub0b4 \ub9c9\ud798\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4. \ucd5c\uc18c \ud55c \ub2ec\uc5d0 \ud55c \ubc88 \ubb3c\ud544\ud130\ub97c \uc138\ucc99\ud558\uc138\uc694.",supplies_strainer_reset_content:"\uc6cc\ud130 \ud544\ud130\uac00 \uad50\uccb4\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.",supplies_strainer_name:"\uc6cc\ud130 \ud544\ud130",dust_collection_desc_5:"\ub300\uaddc\ubaa8 \uac00\uc815\ud658\uacbd \ubc0f \uba3c\uc9c0\uac00 \ub9ce\uc740 \ud658\uacbd\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4.",dust_collection_desc_3:"\uc911\uaddc\ubaa8 \uac00\uc815\ud658\uacbd\uc5d0 \uc801\ud569\ud558\uba70, \ube44\uc6c0 \uc18d\ub3c4\uc640 \uc131\ub2a5\uc758 \uade0\ud615\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4.",dust_collection_desc_2:"\uae68\ub057\ud55c \ud658\uacbd\uc774\ub098 \uc18c\uaddc\ubaa8 \uac00\uc815\ud658\uacbd\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \uc77c\ubd80 \uc794\ub958 \uba3c\uc9c0\uac00 \uba3c\uc9c0\ud1b5\uc5d0 \ub0a8\uc544 \uc788\uac8c \ub429\ub2c8\ub2e4.",dust_collection_desc_1:"\uba3c\uc9c0\ud1b5 \uc0c1\ud0dc\ub97c \uc608\uce21\ud558\uc5ec \uc790\ub3d9\uc73c\ub85c \uc870\uc808\ud568\uc73c\ub85c\uc368 \uc9d1\uc9c4 \ud6a8\uc728\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4.",dust_collection_desc_title:"\ube44\uc6c0 \ubaa8\ub4dc",dust_collection_title_5:"\ucd5c\ub300 \ubaa8\ub4dc",dust_collection_title_3:"\ubc38\ub7f0\uc2a4 \ubaa8\ub4dc",dust_collection_title_2:"\uac04\ud3b8 \ubaa8\ub4dc",dust_collection_title_1:"\uc2a4\ub9c8\ud2b8 \ubaa8\ub4dc",dust_collection_setting_title:"\uc790\ub3d9 \uba3c\uc9c0 \ube44\uc6c0 \uc124\uc815",too_frequently_collect_dust_toast:"\uc218\ub3d9 \ube44\uc6c0\uc774 \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc911\ubcf5 \ube44\uc6c0\uc744 \ubc29\uc9c0\ud558\uc138\uc694.",charger_type_name_normal:"\ub3c4\ud06c",no_disturb_with_dust_collection:"\ubc29\ud574 \uae08\uc9c0 \ubaa8\ub4dc\ua