637 \u0627\u0644\u0637\u0627\u0642\u0629 \u0644\u062a\u062c\u0646\u0628 \u0627\u0644\u0627\u0646\u0632\u0644\u0627\u0642.",map_object_desc_xian:"\u062a\u0645 \u062a\u062c\u0646\u0628 \u0627\u0644\u0633\u0644\u0643 / \u0627\u0644\u0643\u0627\u0628\u0644 \u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u0634\u0627\u0628\u0643. \u0642\u062f \u062a\u062a\u0634\u0627\u0628\u0643 \u0627\u0644\u0623\u0633\u0644\u0627\u0643 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0648\u0627\u0644\u0631\u0641\u064a\u0639\u0629.",obstacle_photo_page_ignore_desc:"1. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u062e\u0635\u0635\u0629 \u0644\u0644\u0639\u0648\u0627\u0626\u0642 \u0627\u0644\u062a\u064a \u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u064a\u0647\u0627 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d \u0623\u0648 \u0639\u0646\u062f\u0645\u0627 \u0644\u0627 \u062a\u0631\u064a\u062f \u0623\u0646 \u064a\u062a\u062c\u0646\u0628 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0647\u0630\u0627 \u0627\u0644\u062c\u0633\u0645 \u0641\u064a \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644.\n2. \u0628\u0645\u062c\u0631\u062f \u0627\u0644\u062d\u0630\u0641\u060c \u0633\u064a\u062a\u062c\u0627\u0647\u0644 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u062c\u0633\u0627\u0645 \u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0646\u0648\u0639 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639.\n3. \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0633\u0645\u060c \u0627\u062d\u0630\u0641 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0648\u0623\u0639\u062f \u062a\u0639\u064a\u064a\u0646\u0647\u0627.",obstacle_photo_page_ignore_link:"\u0644\u0627 \u062d\u0627\u062c\u0629 \u0644\u0644\u062a\u062c\u0646\u0628\u060c \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u062a\u062c\u0627\u0647\u0644\u061f",obst