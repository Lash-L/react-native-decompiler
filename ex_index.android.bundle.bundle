__d(function(e,i,a,o,t,r,n){t.exports={recover_map_hint:"Dopo il ripristino della mappa di backup sar\xe0 necessario ricreare tutti i flussi di lavoro e le pianificazioni correlate.",invalid_task_detected_hint:"Una o pi\xf9 attivit\xe0 non sono valide.",map_edit_ground_material_title:"Modifica superficie",map_edit_split_restriction_point_adjust:"Regola la linea di demarcazione finch\xe9 non appare una linea continua",home_new_control_start_wash:"Mocio lavabile",home_new_control_back_charge:"Base di ricarica",home_new_control_dock_unfold_title:"Base di ricarica",terminate_current_task_then_wash:"Mocio lavabile",smart_custom_order_guide_tip_text:"Regola automaticamente la sequenza di pulizia delle stanze in base ai tipi delle stanze.",smart_custom_mode_guide_tip_text:"Imposta automaticamente la modalit\xe0 di pulizia in base ai tipi dei pavimenti e delle stanze.",tanos_s_mop_mode_info2:"Nella modalit\xe0 Profondo+, il robot si muover\xe0 pi\xf9 lentamente, facendo meno rumore.",video_error116_resolve:"Impossibile attivare la visualizzazione remota. Svuotamento in corso.",map_element_furnitures:"Arredamento",map_element_custom_props:"Personalizza",map_element_room_props:"NomeStanza",map_element_switcher_title:"Dettagli della mappa",default_room_name:"Stanza",mop_method_careful_slow:"Profondo+",realtime_video_sub_title_3_6:"Gli avvisi vocali verranno emessi ogni 15 secondi durante la visualizzazione remota.",realtime_video_sub_title_3_5:"Gli avvisi vocali verranno emessi entrando e uscendo dalla visualizzazione remota.",egg_page_attack_title:"Cerca",egg_page_stop_button_title:"Interrompi",start_egg_attack_with_other_task_tip:"Effettuare questa azione terminer\xe0 la pulizia corrente. ",egg_page_title:"Modalit\xe0 Cupido",defender_mode_introduction:"Ecco la modalit\xe0 Cupido, in cui il tuo Roborock pu\xf2 esprimere i suoi veri sentimenti nei confronti di altri robot aspirapolvere. Questo senza distinguere in base a marca o colore: quando il tuo S7 MaxV vede un altro robot esprimer\xe0 il suo amore con un gentile bacio.\n\nAVVERTENZA: Roborock non \xe8 responsabile per eventuali neonati robot aspirapolvere o per la supremazia delle macchine.",egg_attack_start_title:"Avvia",armap_match_failed:"Corrispondenza non riuscita",armap_match_success:"Corrispondenza mappa riuscita",armap_delete_confirm:"Confermi di volere cancellare la mappa Matrix?",armap_scan_save_mesh_failed_toast:"Salvataggio non riuscito",armap_scan_stop_confirm:"Arrestare mappatura Matrix?",monitor_voice_privacy_dialog_title:"Politica sulla privacy per le video chiamate",camera_monitor_voice_privacy_title:"Politica sulla privacy per le video chiamate ",armap_guide_title3:"3. Termina la scansione e la mappatura, poi attendi la corrispondenza.",armap_guide_title2:"2. Muoviti nella stanza, assicurandoti di scansionare tutte le pareti, i pavimenti e gli angoli.",armap_guide_title1:"1. Avvia scansione Matrix della mappa corrente.",armap_guide_title:"Mappatura Matrix \u2013 Guida per l\u2019utente",armap_privacy_dialog_title1:"Una volta usato, il modello 3D verr\xe0 conservato nel telefono per la mappatura Matrix. Fare riferimento alla ",armap_privacy_dialog_title:"Informativa sulla privacy per la mappatura Matrix",smart_scene_clean_mode_setting_item_title:"Modalit\xe0 pulizia",main_control_pause_quick_build_map:"Pausa",main_control_resume_quick_build_map:"Mappatura",go_update:"Aggiornare",clean_mode_max_plus:"MAX+",go_to_settings:"Vai al set",quick_create_map_alert_title:"Impossibile eseguire la mappatura rapida nella modalit\xe0 di evitamento del tappeto",led_alert_detail:"I risultati del riconoscimento degli oggetti verranno influenzati quando la luce di riempimento \xe8 spenta.",tap_charge_when_quick_building_map_tip:"Mappatura sospesa. La mappa verr\xe0 cancellata quando il robot arriver\xe0 alla stazione di ricarica.",robot_status_quick_building_map:"Mappatura in corso",map_edit_mode_smart_tip_detail:"Impostare prima il tipo di stanza. Toccare \u201cOK\u201d per andare alle Impostazioni.",map_edit_order_smart_tip:"Imposta automaticamente la sequenza di pulizia delle stanze in base ai tipi delle stanze.",multi_map_start_build_text_4:"4. Il robot non evita i tappeti per esplorare altre aree.",led_status_detail1:"Il robot accende la luce di riempimento in un ambiente poco illuminato per migliorare le capacit\xe0 di riconoscimento.",led_status_title2:"Automatico",led_status_title1:"Luce di riempimento",map_object_desc_general1:"Identifica ed evita in modo intelligente gli ostacoli a terra che potrebbero influenzare il lavoro del robot.",quick_build_map_start:"Mappatura rapida",map_edit_zone_tag_toilet:"Bagno",map_edit_zone_tag_kitchen:"Cucina",map_edit_zone_tag_diningroom:"Sala da pranzo",map_edit_zone_tag_study:"Studio",map_edit_zone_tag_vestibule:"Corridoio",map_edit_zone_tag_balcony:"Balcone",map_edit_zone_tag_livingroom:"Soggiorno",map_edit_zone_tag_geustbedroom:"Camera da letto per gli ospiti",map_edit_zone_tag_masterbedroom:"Camera da letto principale",map_edit_zone_tag_bedroom:"Camera da letto",map_edit_zone_select_tag:"Seleziona un tipo di stanza",set_timer_without_time_tip:"Nessun programma impostato",start_clean_roller_without_waterbox_carriage_tip:"Il supporto del panno non \xe8 installato. Impossibile lavare il panno.",start_clean_roller_without_waterbox_tip:"Il serbatoio dell'acqua non \xe8 installato. Impossibile riempire.",carpet_clean_mode_setting_title4:"Sollevamento dinamico",monitor_page_video_end:"L'altra parte ha terminato la chiamata. Chiamata terminata.",back_dock_to_wash_alert_tip:"Dopo aver lavato il panno, il robot continuer\xe0 a lavare da dove si era interrotto.",terminate_current_task_wash_then_back_dock:"Lava e carica",terminate_current_task_back_dock:"Stazione di ricarica",terminate_current_task_back_dock_tip:"Ritorno al molo",back_wash_desc3:"La frequenza di lavaggio del panno verr\xe0 modificata in base allo sporco del pavimento, alla situazione dei tappeti, alle preferenze del percorso, al tempo di pulizia effettivo e al tempo di pulizia rimanente stimato.",back_wash_desc2:"Dopo aver pulito ogni stanza, il robot torna indietro per lavare il panno, per evitare la contaminazione incrociata delle stanze. Se la stanza \xe8 grande, la frequenza di lavaggio del panno sar\xe0 maggiore. Se la stanza \xe8 troppo piccola, il lavaggio del panno verr\xe0 effettuato insieme a quello successivo.",new_firmware_detected1:"Aggiornare il firmware per usufruire di tutti gli ultimi aggiornamenti.",new_firmware_detected:"Nuovo firmware disponibile",map_edit_furniture_toilet:"Toilette",map_edit_furniture_tea_table:"Caff\xe8",map_edit_furniture_tv_cabinet:"Supporto TV",map_edit_furniture_dinner_table:"Set tinello",map_edit_furniture_double_bed:"Letto",map_edit_furniture_single_bed:"Letto",map_edit_furniture_count_tip_miapp:"\xc8 possibile modificare fino a ${max} elementi di arredo per volta. Salva per modificare altri ${count} elementi.",map_edit_furniture_max_tip_miapp:"\xc8 stato raggiunto il limite di modifiche. Salva le modifiche correnti per continuare.",mode_setting_panel_custom_water_box_7:"Lieve",mode_setting_panel_custom_water_box_6:"Basso",localization_strings_Main_Constants_127:"Collega e scollega l'alimentatore e riprova.",localization_strings_Main_Constants_126:"Viene rilevata un'anomalia all'interno della base, collegare e scollegare l'alimentatore e riprovare.",inner_error_desc_150:"Errore della valvola a solenoide",inner_error_desc_134:"Errore interruttore della pompa dell'aria",inner_error_desc_131:"Sovracorrente della pompa peristaltica del serbatoio dell'acqua pulita",inner_error_desc_130:"Nessun dato dall'ODO della pompa peristaltica del serbatoio dell'acqua pulita",inner_error_desc_127:"Errore IIC della stazione di ricarica",inner_error_desc_126:"Errore ventola della stazione di ricarica",sound_package_download_failed:"scaricamento fallito",camera_setting_detail5:"Percepisce attivamente l\u2019ambiente domestico e identifica alcuni mobili e tipologie di pavimento. *I risultati del riconoscimento sono influenzati dalla luce e dall'angolazione e hanno unicamente scopo di riferimento.",camera_setting_detail4:"Riconoscimento degli ambienti con IA",camera_setting_detail3:"L'IA identifica ed evita in modo intelligente gli ostacoli a terra per ridurre gli incidenti.",camera_setting_detail2:"Aggiramento ostacoli reattivo",camera_setting_detail1:"Disattiva video in diretta",smart_scene_firmware_zone_reach_max_count:"\xc8 stato raggiunto il numero massimo di stanze",map_edit_mode_smart_tip:"Imposta automaticamente la modalit\xe0 di pulizia in ogni stanza, in base ai tipi dei pavimenti e delle stanze.",map_edit_mode_smart:"Smart",map_edit_floor_other:"Predefinito",map_edit_floor_wood:"Legno",map_edit_floor_tile:"Piastrelle",map_edit_floor_select_segment_tip:"Selezionare una stanza per impostarne il tipo di pavimento",map_edit_floor:"Tipo di pavimento",back_wash_desc1:"Imposta la frequenza del lavaggio (in minuti)",map_edit_furniture_title:"Modifica mobili",dust_collection_life14:"volte",dust_collection_life13:"Stato:  ${state}",dust_collection_life12:"Pulizia obbligatoria",dust_collection_life11:"Pulisci quanto suggerito",dust_collection_life10:"Normale",smart_scene_global_no_map_tip:"Nessuna mappa disponibile. Crea prima una mappa.",screen_recording8:"Si invita a concedere alle foto dell\u2019app le autorizzazioni di lettura e scrittura nelle impostazioni di sistema del telefono.",screen_recording7:"Impossibile accedere all\u2019album.",screen_recording6:"Spazio di archiviazione insufficiente. Alcuni contenuti potrebbero essere persi.",screen_recording5:"Acquisizione schermata effettuata non riuscita.",screen_recording4:"Acquisizione schermata effettuata correttamente.",screen_recording3:"Termina registrazione.",screen_recording2:"Registrazione non riuscita.",screen_recording1:"Avvia registrazione.",dust_collection_life9:"Circa ${time} volte prima dello svuotamento",dust_collection_life8:"Il sacchetto per la polvere di grande capacit\xe0 viene utilizzato per raccogliere la spazzatura dal cestino della polvere del robot, eliminando la necessit\xe0 di frequenti svuotamenti manuali e garantendo un\u2019esperienza pulita e senza problemi. Per una migliore esperienza di pulizia si consiglia di sostituire il sacchetto per la polvere in base alla necessit\xe0 e di pulire il cestino della polvere una volta al mese.",dust_collection_life5:"Sacchetto per la polvere",dust_collection_life4:"La stazione di ricarica con svuotamento automatico Roborock \xe8 dotata di un separatore a ciclone a 15 coni per spostare la polvere nel cestino della polvere, con un dispositivo di apertura del cestino della polvere a singola pressione, nessun materiale di consumo e un'aspirazione potente e duratura. Il cestino della polvere ha una capacit\xe0 di 1,5 litri; si raccomanda di svuotarlo ogni 1-2 mesi.",dust_collection_life3:"Cestino della polvere svuotato. OK?",dust_collection_life2:"Il cestino della polvere deve essere svuotato.",dust_collection_life1:"Cestino della polvere",smart_scene_global_title:"Flusso di lavoro",voice_chat_title2:"In video chiamata. Impossibile registrare.",voice_chat_title1:"Arresta registrazione video.",home_page_supplies_cleaning_brush3:"La spazzola di manutenzione della stazione ruota avanti e indietro ad alta velocit\xe0, aderendo strettamente alla superficie del panno da strofinare, rimuovendo efficacemente lo sporco dalla superficie del panno. Durante la pulizia \xe8 possibile che si accumulino oggetti estranei, come peli aggrovigliati, che influiscono sul risultato della pulizia. Si consiglia di smontare e pulire ogni due mesi.",home_page_supplies_cleaning_brush2:"Spazzola di manutenzione sostituita. OK?",home_page_supplies_cleaning_brush1:"Spazzola di manutenzione",home_page_supplies_cleaning_brush:"La spazzola di manutenzione deve essere sostituita.",inner_error_desc_149:"Errore di posizionamento della spazzola di manutenzione \u2013 destra",inner_error_desc_148:"Errore di posizionamento della spazzola di manutenzione \u2013 centro",inner_error_desc_147:"Errore di posizionamento della spazzola di manutenzione \u2013 sinistra",inner_error_desc_145:"Errore pompa dell\u2019acqua sporca",inner_error_desc_143:"Temperatura del motore della ruota di destra troppo elevata",inner_error_desc_141:"Temperatura del motore della ruota di sinistra troppo elevata",mode_setting_panel_custom_water_box_5:"Delicato",mode_setting_panel_custom_water_box_4:"Medio",mode_setting_panel_custom_water_box_3:"Moderato",mode_setting_panel_custom_water_box_2:"Alto",mode_setting_panel_custom_water_box_1:"Estremo",robot_is_warm_up_tip:"Robot in riscaldamento",start_washing_duster_noback_dock:"Mocio lavabile",custom_mode_panel_mop_gear_title:"Lavaggio",custom_mop_mode_system_wetter_mop:"Profonda",mop_mode_setting_page_wash_count:"Lavaggi panno",custom_mode_panel_tab_general:"Generale",custom_mode_panel_more_mode_title:"Altre modalit\xe0",error_main_frame_exception_detail:"Verifica se il pulsante di posizionamento \xe8 bloccato, quindi allontanare il robot dalla stazione di ricarica e riavvia.",error_main_frame_exception_desc:"Verifica se il pulsante di posizionamento \xe8 bloccato, quindi sposta il robot e riavvia.",error_main_frame_exception_title:"Errore pulsante di posizionamento",error_clean_brush_exception_detail:"Verificare che il filtro dell'acqua sia installato correttamente e che la spazzola di pulizia non sia inceppata e reinstallare il panno assicurandosi che sia piatto.",mop_cleaning_time:"Tempo di lavaggio",robot_start_type_clova:"Clova",next_step:"Avanti",cleanout_the_error:"Errore di lavaggio",map_edit_carpet_overlap_tip:"Il nuovo tappeto non pu\xf2 sovrapporsi a un tappeto ignorato.",map_edit_carpet_unknown_tip:"Il tappeto deve essere posto sulla mappa.",map_edit_carpet_ignore_edit_tip:"Modifica o cancella il tappeto ignorato",map_edit_carpet_ignore_tip:"Nella zona ignorata il riconoscimento dei tappeti sar\xe0 disabilitato.",map_edit_carpet_add_edit_tip:"Modifica o cancella il nuovo tappeto",map_edit_carpet_init_tip:"Tocca su un tappeto per modificare",back_to_the_wash_failure:"Impossibile tornare alla stazione di ricarica",error_filter_screen_exception_detail:"Filtro dell'acqua bloccato. Pulire e reinstallare. Se il problema persiste, verificare che il coperchio del serbatoio dell'acqua sporca sia chiuso e bloccato.",error_filter_screen_exception_desc:"Pulire il filtro dell'acqua della stazione di ricarica",error_filter_screen_exception_title:"Controllare e fissare il coperchio del serbatoio dell'acqua sporca",supplies_mop_swab_ecu_description:"Il panno \xe8 il principale componente di pulizia del robot e rimuove efficacemente lo sporco dal pavimento. Tuttavia, con il prolungarsi del tempo di pulizia, il panno si consumer\xe0 gradualmente e non riuscir\xe0 a eliminare le macchie ostinate, compromettendo l\u2019efficacia della pulizia. Si consiglia, quando necessario, di sostituire il panno con uno nuovo.",supplies_mop_swab_sub_desc:"Sostituire in base alle necessit\xe0.",supplies_mop_swab_name:"Panno",wash_towel_mode_des_3:"Adatto per pulizia profonda occasionale, con un maggiore consumo d\u2019acqua e un tempo di pulizia prolungato.",wash_towel_mode_des_2:"Adatto per abitazioni di medie dimensioni, per bilanciare la rapidit\xe0 della pulizia con la sua efficacia.",wash_towel_mode_des_1:"Adatto per ambienti puliti, con tempo di pulizia e consumo di acqua ridotti.",back_wash_desc:"Regola dinamicamente l\u2019intervallo di lavaggio in base alla suddivisione della stanza, ritorna e lava automaticamente il panno.",back_wash_time_setting:"Intervallo lavaggio panno",robot_start_type_rr_intelligence_scene:"Routine",smart_scene_firmware_will_support_alert_title:"###\u5f53\u524d\u8bbe\u5907\u6682\u4e0d\u652f\u6301\u8be5\u573a\u666f\u529f\u80fd\uff0c\u540e\u7eed\u4f1a\u66f4\u65b0\u4e0a\u7ebf\uff0c\u656c\u8bf7\u671f\u5f85",smart_scene_firmware_update_alert_confirm:"Aggiorna firmware",map_edit_rotate_right:"Ruota a destra",map_edit_rotate_left:"Ruota a sinistra",be_on_the_phone:"Chiamata in corso\u2026",click_to_start_call:"Tocca per iniziare la chiamata",click_to_end_call:"Tocca per terminare la chiamata",voice_package_end_validtime_forever:"Permanente",rotate_map_rect_warning:"Non spostare nella zona esterna alla mappa.",home_sepcial_info_airdry_finish_time:"Panno in asciugatura all\u2019aria, l\u2019operazione dovrebbe essere completata fra ${hour} ora(e).",robot_cmd_resume_back_washing:"continuare a ritornare",robot_cmd_pause_back_washing:"Pausa",delete_new_map_if_switch_map_hint:"La mappa corrente non \xe8 salvata e verr\xe0 cancellata dopo il passaggio a una mappa diversa.",setting_section_title_more_info:"Maggiori informazioni",setting_section_title_clean_management:"Gestione della pulizia",dust_collection_info_close:"Per la completa automazione \xe8 necessaria l'attivazione dello svuotamento automatico. Se lo svuotamento automatico \xe8 disattivato, lo svuotamento deve essere attivato dall'utente.",error_dock_error_title:"Errore stazione",home_special_info_timer:"La prossima pulizia inizier\xe0 oggi alle ${cleanTime}.",start_clean_with_manual_mode_alert_title:"Il robot effettuer\xe0 la pulizia in base alla ${mapName}. Accertarsi che il robot sia collocato all\u2019interno della mappa.",smart_switch_section_title:"Passaggio fra mappe diverse",manual_switch_tip:"\xc8 possibile selezionare una mappa quando si avvia il robot tramite l\u2019app. Dopo essere stato avviato, il robot effettuer\xe0 la pulizia in base alla mappa sulla pagina iniziale dell\u2019app.\n* Il riconoscimento intelligente si applica quando il robot venga avviato in modi diversi.",manual_switch_pattern:"Selezione manuale",smart_switch_tip:"Il robot riconosce automaticamente la sua posizione e passa fra mappe diverse all\u2019avvio.",smart_switch_pattern:"Riconoscimento intelligente",map_edit_carpet_zone_exceed_limit:"\xc8 stato raggiunto il numero massimo di tappeti.",map_edit_carpet_add_tip:"Tocca un tappeto esistente per modificarlo o rimuoverlo.",map_edit_carpet_add_carpet:"Aggiungi tappeto",error_clean_brush_exception_desc:"Pulire le spazzole di pulizia",error_clean_bruch_exception_title:"Verificare che il filtro dell'acqua sia stato installato correttamente.",error_resolved:"Gestito",wash_towel_mode_title_3:"Profondo",wash_towel_mode_title_2:"Bilanciato",wash_towel_mode_title_1:"Modalit\xe0 risparmio acqua",wash_towel_mode_title:"Modalit\xe0 lavaggio panno",wash_towel_title:"Impostazioni della lavaggio",avoid_collision_mode:"Meno collisioni",charged_resume_clean_detail:"Ricarica completata. Avviare il robot per continuare la pulizia.",clean_path_record_palyback:"###\u56de\u653e|\u5185\u6d4b",clean_path_record_speed:"###\u500d\u901f",clean_path_record_play:"Riprendere la riproduzione",clean_path_record_pause:"Metti in pausa la riproduzione",home_page_supplies_strainer_upgrade_tip:"Il filtro dell'acqua ha raggiunto il limite della sua vita utile. Sostituirlo immediatamente.",supplies_strainer_description:"Il filtro dell'acqua della stazione di ricarica separa le particelle dall'acqua sporca per evitare ostruzioni. Risciacquare il filtro dell'acqua almeno una volta al mese.",supplies_strainer_reset_content:"Accertarsi che il filtro dell\u2019acqua sia stato sostituito.",supplies_strainer_name:"Filtro dell\u2019acqua",dust_collection_desc_5:"Adatta per abitazioni di grandi dimensioni e ambienti pi\xf9 sporchi.",dust_collection_desc_3:"Adatta per abitazioni di medie dimensioni, bilancia la rapidit\xe0 dello svuotamento con la sua efficacia.",dust_collection_desc_2:"Adatta per ambienti puliti o piccole abitazioni. Nel cestino della polvere rimarr\xe0 un po' di sporco residuo.",dust_collection_desc_1:"Regola automaticamente la durata dello svuotamento per migliorare l\u2019efficienza della raccolta della polvere.",dust_collection_desc_title:"Modalit\xe0 di svuotamento",dust_collection_title_5:"Max",dust_collection_title_3:"Medio",dust_collection_title_2:"Light",dust_collection_title_1:"Smart",dust_collection_setting_title:"Param\xe8tres de la svuotamento automatico",too_frequently_collect_dust_toast:"Svuotamento manuale completato. Evitare lo svuotamento ripetuto.",charger_type_name_normal:"Stazione di ricarica",no_disturb_with_dust_collection:"Quando \xe8 attivo il \"Non disturbare\", la ricarica automatica \xe8 annullata, gli avvisi vocali sono silenziati, le spie sono affievolite e lo svuotamento automatico \xe8 sospeso.",charging_dust_collection:"Ritorno alla base e raccolta della polvere",robot_will_begin_collect_dust_tip:"Lo svuotamento far\xe0 molto rumore. Svuotare comunque?",flow_led_status_title:"Spia di stato",timer_guide_title_tip2:"* Il robot non deve essere in fase di pulizia quando sta per partire una pulizia programmata",timer_guide_title_tip1:"* Il robot deve essere acceso e la carica deve essere superiore al 20%",timer_guide_title_info:"Programma la pulizia in base ai tuoi impegni",timer_guide_title:"Pulizia programmata",custom_mode_panel_has_custom_data_tip:"Il robot pulisce ogni stanza in base alle impostazioni della modalit\xe0 di pulizia.",custom_mode_panel_zoneclean_notwork_tip:"La pulizia a zone verr\xe0 effettuata secondo le modalit\xe0 predefinite.",structure_light_tip_3:"Prevedere in anticipo pareti e mobili per ridurre gli urti frontali. Potrebbe causare la mancata scansione in alcuni spazi ristretti.",carpet_bubble_name:"Tappeto",setting_page_device_share:"Condivisione dispositivo",dust_collection_status_1:"Polvere raccolta",map_object_bubble_tip_regonized:"Riconosciuto",soundpackage_valid_end_time_title:"Valido fino al:",soundpackage_select_special_sound_title:"Toni personalizzati",setting_timezone_phone:"Fuso orario del telefono",clean_method_clean_and_mop:"Asp e poi lavaggio",clean_method_mop:"Lavaggio",clean_method_clean:"Aspirazione",dust_collection_title:"Svuotamento automatico",wifi_debug_mode_title2:"Ho letto e accetto il contenuto di cui sopra",wifi_debug_mode_title1:"Modalit\xe0 debug WiFi",error_clear_waterbo