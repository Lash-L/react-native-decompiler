u0442\u0430\u043d\u0446\u0438\u0438 \u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430",water_updown_self_clean_desc:"\u041c\u043e\u0435\u0442 \u043f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u0438 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 \u0441\u043b\u0438\u0432\u043d\u043e\u0439 \u0431\u0430\u043a \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430; \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430.",water_updown_self_clean_button_title:"\u041d\u0430\u0447\u0430\u0442\u044c \u0430\u0432\u0442\u043e\u043e\u0447\u0438\u0441\u0442\u043a\u0443",water_updown_drain_title:"\u0421\u043b\u0438\u0432 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430",water_updown_drain_desc:"\u0421\u043b\u0435\u0439\u0442\u0435 \u043e\u0441\u0442\u0430\u0442\u043a\u0438 \u0432\u043e\u0434\u044b \u0438\u0437 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0433\u043e \u043a\u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0431\u0430\u043a\u0430.",water_updown_drain_button_title:"\u041d\u0430\u0447\u0430\u0442\u044c \u0441\u043b\u0438\u0432",water_up_down_setting_item_title:"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430",water_up_down_setting_item_desc:"\u041c\u043e\u0435\u0442 \u043f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430.",product_info_dock_sn:"\u0421\u0435\u0440\u0438\u0439\u043d\u044b\u0439 \u2116 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u0438",product_info_dock_version:"\u0412\u0435\u0440\u0441\u0438\u044f \u043f\u0440\u043e\u0448\u0438\u0432\u043a\u0438 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u0438",error_up_water_title:"\u041e\u0448\u0438\u0431\u043a\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f",error_up_water_desc:"\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u043b\u0438 \u043a\u0440\u0430\u043d, \u0438 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u0432\u043e\u0434\u0430 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0449\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c.",error_up_water_detail:"\u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432\u043e\u0434\u043e\u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u0443\u0435\u0442. \u0415\u0441\u043b\u0438 \u044d\u0442\u043e \u0442\u0430\u043a, \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043a\u0430\u0431\u0435\u043b\u044c \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0441\u043b\u0438\u0432\u0430 \u0438 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e, \u0441\u0432\u044f\u0436\u0438\u0442\u0435\u0441\u044c \u0441\u043e \u0441\u043b\u0443\u0436\u0431\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438.",error_drain_water_title:"\u041e\u0448\u0438\u0431\u043a\u0430 \u0441\u043b\u0438\u0432\u0430",error_drain_water_desc:"\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u043d\u0435 \u0437\u0430\u0441\u043e\u0440\u0435\u043d\u043e \u043b\u0438 \u0441\u043b\u0438\u0432\u043d\u043e\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435, \u0438 \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435 \u0437\u0430\u0441\u043e\u0440.",error_drain_water_detail:"\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u043d\u0435 \u0437\u0430\u0441\u043e\u0440\u0435\u043d\u043e \u043b\u0438 \u0441\u043b\u0438\u0432\u043d\u043e\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435, \u0438 \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435 \u0437\u0430\u0441\u043e\u0440. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e, \u0441\u0432\u044f\u0436\u0438\u0442\u0435\u0441\u044c \u0441\u043e \u0441\u043b\u0443\u0436\u0431\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438.",error_clean_carousel_unsetuped_title:"\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438.",error_clean_carousel_unsetuped_desc:"\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u043d\u0430 \u043c\u0435\u0441\u0442\u043e.",error_clean_carousel_unsetuped_detail:"1.\xa0\u0417\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0439\u0442\u0435 \u043f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435. 2.\xa0\u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u043e\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0434\u043b\u044f \u0432\u043e\u0434\u044b \u043d\u0430 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043d\u0435 \u0437\u0430\u0441\u043e\u0440\u0435\u043d\u043e. 3.\xa0\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0438 \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0439\u0442\u0435 \u043a\u0440\u044b\u0448\u043a\u0443 \u0431\u0430\u043a\u0430 \u0434\u043b\u044f \u0433\u0440\u044f\u0437\u043d\u043e\u0439 \u0432\u043e\u0434\u044b.",error_clean_carousel_water_full_title:"\u041f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d.",error_clean_carousel_water_full_desc:"\u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u0432\u044b\u043f\u0443\u0441\u043a\u043d\u043e\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0434\u043b\u044f \u0432\u043e\u0434\u044b \u043d\u0435 \u0437\u0430\u0441\u043e\u0440\u0435\u043d\u043e; \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435 \u0437\u0430\u0441\u043e\u0440.",error_clean_carousel_water_full_detail:"\u0412\u044b\u043f\u0443\u0441\u043a\u043d\u043e\u0435 \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0434\u043b\u044f \u0432\u043e\u0434\u044b \u043d\u0430 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0437\u0430\u0441\u043e\u0440\u0435\u043d\u043e; \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0438 \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435 \u0437\u0430\u0441\u043e\u0440. \u0415\u0441\u043b\u0438 \u0437\u0430\u0441\u043e\u0440 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442, \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0438 \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0439\u0442\u0435 \u043a\u0440\u044b\u0448\u043a\u0443 \u0438 \u0437\u0430\u0449\u0435\u043b\u043a\u0443 \u0431\u0430\u043a\u0430 \u0434\u043b\u044f \u0433\u0440\u044f\u0437\u043d\u043e\u0439 \u0432\u043e\u0434\u044b.",map_edit_map_unsave:"\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u0443, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u043f\u043e\u043f\u044b\u0442\u043a\u0443.",charger_type_name_special:"\u0414\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u044f",valley_electricity_not_set_hint:"* \u0412\u0440\u0435\u043c\u044f \u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u043e. \u0424\u0443\u043d\u043a\u0446\u0438\u044f \u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u0432\u043d\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u043e\u0432 \u043f\u0438\u043a\u043e\u0432\u043e\u0439 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0430.",dock_kit_setting0:"5\xa0\u0447",washing_mode_updown_water_selfcleaning:"\u0421\u0430\u043c\u043e\u043e\u0447\u0438\u0441\u0442\u043a\u0430",washing_mode_updown_water_drain:"\u0421\u043b\u0438\u0432 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430",wash_towel_mode_title_4:"\u0421\u0432\u0435\u0440\u0445\u0433\u043b\u0443\u0431\u043e\u043a\u0430\u044f",wash_towel_mode_desc_4:"\u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0434\u043b\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u0441\u0430\u043b\u0444\u0435\u0442\u043a\u0438.",dock_panel_function_section_title:"\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u0435\u0439",dock_info_clear_water_box_title:"\u0411\u0430\u043a \u0434\u043b\u044f \u0447\u0438\u0441\u0442\u043e\u0439 \u0432\u043e\u0434\u044b",dock_info_clear_water_box_exception1:"\u0417\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0430\u0441\u044c \u0432\u043e\u0434\u0430",dock_info_dirty_water_box_title:"\u0411\u0430\u043a \u0434\u043b\u044f \u0433\u0440\u044f\u0437\u043d\u043e\u0439 \u0432\u043e\u0434\u044b",dock_info_dirty_water_box_exception1:"\u041f\u043e\u043b\u043d\u0430/\u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d",dock_info_clean_fluid_title:"\u041a\u0430\u0440\u0442\u0440\u0438\u0434\u0436 \u0434\u043b\u044f \u043c\u043e\u044e\u0449\u0435\u0433\u043e \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430",dock_info_clean_fluid_exception:"\u041d\u0438\u0437\u043a\u0438\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430",dock_info_water_box_filter_title:"\u0412\u043e\u0434\u044f\u043d\u043e\u0439 \u0444\u0438\u043b\u044c\u0442\u0440",dock_info_item_gone_exception:"\u041d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d",dock_info_dust_bag_exception:"\u041f\u043e\u043b\u043d\u0430",toast_clean_then_mop_24hour:"\u0427\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0447\u0440\u0435\u0437\u043c\u0435\u0440\u043d\u043e\u0435 \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d\u0438\u0435 \u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0443\u0431\u043e\u0440\u043a\u0438, \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0441\u0443\u0445\u0443\u044e \u0443\u0431\u043e\u0440\u043a\u0443 \u043f\u0435\u0440\u0435\u0434 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435\u043c \u0432\u043b\u0430\u0436\u043d\u043e\u0439 \u0443\u0431\u043e\u0440\u043a\u0438.",cliff_zones_save_failed:"\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0437\u0430\u043f\u0440\u0435\u0442\u043d\u0443\u044e \u0437\u043e\u043d\u0443 \u0434\u043b\u044f \u0443\u0441\u0442\u0443\u043f\u043e\u0432.",inner_error_desc_151:"\u041e\u0448\u0438\u0431\u043a\u0430 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0430 \u0441\u0443\u0448\u043a\u0438",inner_error_desc_152:"\u041d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0438 \u0441\u043b\u0438\u0432\xa0\u2014 \u043e\u0448\u0438\u0431\u043a\u0430 \u0441\u043b\u0438\u0432\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u043e\u0441\u0430.",inner_error_desc_153:"\u041d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0438 \u0441\u043b\u0438\u0432\xa0\u2014 \u043e\u0448\u0438\u0431\u043a\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0433\u043e \u043a\u043b\u0430\u043f\u0430\u043d\u0430 \u0432\u043f\u0443\u0441\u043a\u043d\u043e\u0433\u043e \u043e\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044f \u0434\u043b\u044f \u0432\u043e\u0434\u044b/\u043e\u0448\u0438\u0431\u043a\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0425\u043e\u043b\u043b\u0430 \u0434\u043b\u044f \u0443\u0440\u043e\u0432\u043d\u044f \u0447\u0438\u0441\u0442\u043e\u0439 \u0432\u043e\u0434\u044b",inner_error_desc_154:"\u041e\u0448\u0438\u0431\u043a\u0430 \u0431\u043e\u043a\u043e\u0432\u043e\u0439 \u0449\u0435\u0442\u043a\u0438",inner_error_desc_158:"\u041d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0438 \u0441\u043b\u0438\u0432\xa0\u2014 \u043e\u0448\u0438\u0431\u043a\u0430 \u0434\u0430\u0442\u0447\u0438\u043a\u0430 \u0425\u043e\u043b\u043b\u0430 \u0434\u043b\u044f \u0443\u0440\u043e\u0432\u043d\u044f \u0433\u0440\u044f\u0437\u043d\u043e\u0439 \u0432\u043e\u0434\u044b",inner_error_desc_159:"\u041d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0438 \u0441\u043b\u0438\u0432\xa0\u2014 \u043e\u0448\u0438\u0431\u043a\u0430 \u0441\u0432\u044f\u0437\u0438",map_edit_furniture_floor_mirror:"\u0417\u0435\u0440\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u043b",map_edit_split_too_small:"\u041f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0435, \u043d\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u0435\u043b\u0438\u0442\u044c.",setting_auto_avoid_obstacle_title:"\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0431\u0445\u043e\u0434\u0430 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0439 Reactive",setting_auto_avoid_obstacle_desc:"\u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0441\u0432\u0435\u0442\u0430 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0440\u043e\u0431\u043e\u0442\u0443 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0442\u044c \u0438 \u043e\u0431\u0445\u043e\u0434\u0438\u0442\u044c \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u044f \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u043d\u0438\u044f.",error_water_carriage_drop_title:"\u041e\u0442\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u043b\u0441\u044f \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u044c \u0441\u0430\u043b\u0444\u0435\u0442\u043a\u0438. ",error_water_carriage_drop_desc:"\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043d\u0430 \u043c\u0435\u0441\u0442\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f.",error_water_carriage_drop_detail:"\u0412\u044b\u043f\u0430\u043b \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u043e\u0442\u0438\u0440\u043e\u0447\u043d\u043e\u0439 \u0441\u0430\u043b\u0444\u0435\u0442\u043a\u0438. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043d\u0430 \u043c\u0435\u0441\u0442\u043e \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f.",supplies_pearl_strainer_name:"\u041f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438",supplies_pearl_strainer_description:"\u041a\u0440\u0443\u043f\u043d\u044b\u0435 \u0447\u0430\u0441\u0442\u0438\u0446\u044b, \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u0441\u0430\u043b\u0444\u0435\u0442\u043a\u0438, \u043e\u0441\u0442\u0430\u043d\u0443\u0442\u0441\u044f \u0432 \u043f\u043e\u0434\u0434\u043e\u043d\u0435 \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0437\u0430\u0441\u043e\u0440\u0435\u043d\u0438\u0435 \u0442\u0440\u0443\u0431. \u041c\u043e\u0439\u0442\u0435 \u043f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0440\u0430\u0437 \u0432 \u043c\u0435\u0441\u044f\u0446.",alert_pause_current_task_then_selfclean:"\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u0438 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0430\u0432\u0442\u043e\u043e\u0447\u0438\u0441\u0442\u043a\u0443?",alert_pause_current_task_then_drain:"\u0420\u043e\u0431\u043e\u0442 \u0435\u0449\u0435 \u043d\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u0443\u0431\u043e\u0440\u043a\u0443. \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u0434 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u044d\u0442\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438.",close_auto_dry_alert_desc:"\u041f\u0440\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0441\u0443\u0448\u043a\u0438 \u043f\u0440\u043e\u0442\u0438\u0440\u043e\u0447\u043d\u0430\u044f \u0441\u0430\u043b\u0444\u0435\u0442\u043a\u0430 \u043c\u043e\u0436\u0435\u0442 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e \u043f\u0430\u0445\u043d\u0443\u0442\u044c. \u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c?",drain_left_water_tip1:"1. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0440\u043e\u0431\u043e\u0442-\u043f\u044b\u043b\u0435\u0441\u043e\u0441 \u043d\u0430 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u044e \u0438 \u0441\u043b\u0435\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u0431\u044b\u043b \u0437\u0430\u0440\u044f\u0436\u0435\u043d. \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u0431\u0430\u043a \u0434\u043b\u044f \u0433\u0440\u044f\u0437\u043d\u043e\u0439 \u0432\u043e\u0434\u044b (\u0438\u043b\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430) \u0438 \u043f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u044b. \u0421\u043d\u0438\u043c\u0438\u0442\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u044c \u043f\u0440\u043e\u0442\u0438\u0440\u043e\u0447\u043d\u043e\u0439 \u0441\u0430\u043b\u0444\u0435\u0442\u043a\u0438.",drain_left_water_tip2:"2. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \xab\u041d\u0430\u0447\u0430\u0442\u044c \u0441\u043b\u0438\u0432 \u043e\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044f \u0432\u043e\u0434\u044b\xbb \u0438 \u0434\u043e\u0436\u0434\u0438\u0442\u0435\u0441\u044c \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u044d\u0442\u043e\u0439 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.",drain_left_water_tip3:"3. \u041f\u0440\u043e\u0446\u0435\u0441\u0441 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 5\u201310\xa0\u043c\u0438\u043d\u0443\u0442. \u041d\u0435 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0439\u0442\u0435 \u0440\u043e\u0431\u043e\u0442\u0430 \u0438 \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u044e.",drain_left_water_tip4:"4. \u041f\u0440\u043e\u0437\u0432\u0443\u0447\u0438\u0442 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \xab\u0421\u043b\u0438\u0432 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\xbb. \u042d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043e \u0432\u0441\u044f \u0432\u043e\u0434\u0430 \u0431\u044b\u043b\u0430 \u0441\u043b\u0438\u0442\u0430 \u0438\u0437 \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u041e\u043f\u0443\u0441\u0442\u043e\u0448\u0438\u0442\u0435 \u0431\u0430\u043a \u0434\u043b\u044f \u0433\u0440\u044f\u0437\u043d\u043e\u0439 \u0432\u043e\u0434\u044b (\u0438\u043b\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438 \u0441\u043b\u0438\u0432\u0430). ",drain_left_water_title:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043b\u0438\u0442\u044c \u043e\u0441\u0442\u0430\u0432\u0448\u0443\u044e\u0441\u044f \u0432\u043e\u0434\u0443",left_water_is_draining:"\u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0441\u043b\u0438\u0432 \u0432\u043e\u0434\u044b \u0438\u0437 \u0440\u043e\u0431\u043e\u0442\u0430",start_drain_left_water:"\u041d\u0430\u0447\u0430\u0442\u044c \u0441\u043b\u0438\u0432 \u043e\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044f \u0432\u043e\u0434\u044b",left_water_drain_page_title:"\u0420\u0435\u0436\u0438\u043c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432",inner_error_desc_128:"\u041a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u0437\u0430\u043c\u044b\u043a\u0430\u043d\u0438\u0435 \u0432 \u043c\u043e\u0434\u0443\u043b\u0435 \u0432\u043b\u0430\u0436\u043d\u043e\u0439 \u0443\u0431\u043e\u0440\u043a\u0438.",inner_error_desc_129:"\u041c\u043e\u0434\u0443\u043b\u044c \u0432\u043b\u0430\u0436\u043d\u043e\u0439 \u0443\u0431\u043e\u0440\u043a\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d.",setting_carpet_first_switch_title:"\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0443\u0431\u043e\u0440\u043a\u0430 \u043a\u043e\u0432\u0440\u0430",setting_carpet_first_switch_desc:"\u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0443\u0431\u043e\u0440\u043a\u0438 \u0440\u043e\u0431\u043e\u0442 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u043f\u044b\u043b\u0435\u0441\u043e\u0441\u0438\u0442 \u043a\u043e\u0432\u0435\u0440, \u043d\u0435 \u0441\u043c\u0430\u0447\u0438\u0432\u0430\u044f \u043f\u0440\u043e\u0442\u0438\u0440\u043e\u0447\u043d\u0443\u044e \u0441\u0430\u043b\u0444\u0435\u0442\u043a\u0443. \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0440\u043e\u0431\u043e\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0437\u0430\u0434\u0430\u043d\u0438\u0435.\n*\xa0\u041d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u043a\u043e\u0432\u0440\u043e\u0432.",skip_current_cleanarea_buttontitle:"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043e\u0431\u043b\u0430\u0441\u0442\u044c",pearl_supplies_strainer_reset_content:"\u041f\u043e\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043f\u0440\u043e\u043c\u044b\u0432\u043a\u0438 \u043f\u043e\u043c\u044b\u0442. \u041e\u041a?",setting_back_wash_interval:"${minute}\xa0\u043c\u0438\u043d",inner_error_desc_156:"\u041e\u0448\u0438\u0431\u043a\u0430 ODD \u0434\u043e\u043a-\u0441\u0442\u0430\u043d\u0446\u0438\u0438",robot_is_warm_up_tip_try:"\u041f\u0440\u043e\u0433\u0440\u0435\u0432 \u0440\u043e\u0431\u043e\u0442\u0430, \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u043f\u043e\u0437\u0436\u0435.",localization_strings_Main_MainPage_12:"\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c",unsave_map_alert_mess:"\u041c\u043d\u043e\u0433\u043e \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u043d\u0430 \u043a\u0430\u0440\u0442\u0435. \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0443\u044e \u043a\u0430\u0440\u0442\u0443?",unsave_map_alert_chargeroffset:"\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043a\u0430\u0440\u0442\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u04