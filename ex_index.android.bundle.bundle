ocalization_strings_Setting_Timer_Common_5:"niedziela",localization_strings_Setting_Timer_Common_4:"W\u0142asne",localization_strings_Setting_Timer_Common_3:"Weekendy",localization_strings_Setting_Timer_Common_2:"Dni robocze",localization_strings_Setting_Timer_Common_1:"Codziennie",localization_strings_Setting_Timer_Common_0:"Raz",localization_strings_Setting_Supplies_index_6:"Szacunkowe pozosta\u0142o ${hour} godzin",localization_strings_Setting_Supplies_DetailsPage_22:"Zresetuj filtr",localization_strings_Setting_Supplies_DetailsPage_21:"Upewnij si\u0119, \u017ce wymieniono szczotk\u0119 g\u0142\xf3wn\u0105",localization_strings_Setting_Supplies_DetailsPage_20:"Upewnij si\u0119, \u017ce wymieniono szczotk\u0119 boczn\u0105",localization_strings_Setting_Supplies_DetailsPage_19:"Upewnij si\u0119, \u017ce wymieniono filtr",localization_strings_Setting_Supplies_DetailsPage_15:"Kup teraz",localization_strings_Setting_Supplies_DetailsPage_13:"B\u0142\u0105d dzia\u0142ania. Sprawd\u017a po\u0142\u0105czenie z sieci\u0105",localization_strings_Setting_Supplies_DetailsPage_5:"Pozosta\u0142o",localization_strings_Setting_Supplies_DetailsPage_4:"Zu\u017cycie",localization_strings_Setting_Supplies_Common_5:"Szczotka g\u0142\xf3wna przesuwa zanieczyszczenia do zbiornika na odpady. W\u0142osie zu\u017cywa si\u0119 z biegiem czasu. Nale\u017cy j\u0105 wymienia\u0107 po ka\u017cdych 300 godzinach pracy urz\u0105dzenia.",localization_strings_Setting_Supplies_Common_4:"Szczotka g\u0142\xf3wna",localization_strings_Setting_Supplies_Common_3:"Szczotka boczna przesuwa zanieczyszczenia z rog\xf3w w kierunku szczotki g\u0142\xf3wnej. W\u0142osie zu\u017cywa si\u0119 z biegiem czasu. Nale\u017cy j\u0105 wymienia\u0107 po ka\u017cdych 200 godzinach pracy urz\u0105dzenia.",localization_strings_Setting_Supplies_Common_2:"Szczotka boczna",localization_strings_Setting_Supplies_Common_1:"D\u0142ugotrwa\u0142a praca mo\u017ce spowodowa\u0107 zablokowanie filtra. Filtr nale\u017cy czy\u015bci\u0107 co dwa tygodnie i wymienia\u0107 po ka\u017cdych 150 godzinach pracy urz\u0105dzenia.",localization_strings_Setting_Supplies_Common_0:"Filtr",localization_strings_Setting_index_23:"Zdalne sterowanie",localization_strings_Setting_index_21:"Ustawienia",localization_strings_Setting_index_19:"Odtwarzanie komunikatu g\u0142osowego",localization_strings_Setting_index_9:"Konserwacja",localization_strings_Setting_index_3:"Zegar",localization_strings_Setting_index_2:"Znajd\u017a odkurzacz",localization_strings_Setting_History_index_15:"Sprz\u0105tanie zosta\u0142o przerwane",localization_strings_Setting_History_index_12:"\u0141\u0105czna liczba",localization_strings_Setting_History_index_8:"Ca\u0142kowity czas",localization_strings_Setting_History_index_2:"Historia sprz\u0105tania",localization_strings_Setting_History_index_1:"Przekroczono czas po\u0142\u0105czenia. Sprawd\u017a po\u0142\u0105czenie z sieci\u0105.",localization_strings_Setting_Guide_index_21:"E-mail serwisowy",localization_strings_Setting_Guide_index_20:"WeChat",localization_strings_Setting_Guide_index_19:"Telefon serwisowy",localization_strings_Setting_Guide_index_8:"Numer seryjny",localization_strings_Setting_Guide_GuideDetailPage_0:"Instrukcja obs\u0142ugi",localization_strings_Setting_General_NetInfoPage_2:"Adres MAC",localization_strings_Setting_General_NetInfoPage_1:"Adres IP",localization_strings_Setting_General_NetInfoPage_0:"Nazwa WiFi",localization_strings_Setting_General_index_4:"Usu\u0144 odkurzacz",localization_strings_Setting_DoNotDisturbPage_13:"W trybie DND robot zatrzyma sprz\u0105tanie z uzupe\u0142nianiem wody, alerty g\u0142osowe b\u0119d\u0105 cichsze, a kontrolka zasilania b\u0119dzie wygaszona.",localization_strings_Setting_DoNotDisturbPage_12:"Tryb DND (nie przeszkadza\u0107)",localization_strings_Setting_DoNotDisturbPage_1:"Koniec",localization_strings_Setting_DoNotDisturbPage_0:"Start",localization_strings_Setting_CleanModePage_5:"Tryb sprz\u0105tania",localization_strings_Setting_CleanModePage_3:"Pobieranie danych nie powiod\u0142o si\u0119",localization_strings_Main_Views_ImprovementPage_0:"Polityka prywatno\u015bci",localization_strings_Main_Views_AgreementPage_0:"Umowa u\u017cytkownika robota odkurzaj\u0105cego Roborock",localization_strings_Main_MainPage_11:"Anuluj",localization_strings_Main_MainPage_8:"Zako\u0144czono ustawianie.",localization_strings_Main_MainPage_3:"Sprz\u0105taj",localization_strings_Main_MainPage_1:"Stacja dokuj\u0105ca",localization_strings_Main_Error_ErrorDetailPage_3:"OK",localization_strings_Main_Error_ErrorDetailPage_0:"Szczeg\xf3\u0142y",localization_strings_Main_Constants_102:"Rozpocz\u0119cie mycia pod\u0142ogi. Upewnij si\u0119, \u017ce w zbiorniku jest wystarczaj\u0105ca ilo\u015b\u0107 wody.",localization_strings_Main_Constants_98:"Gdy akumulator jest w pe\u0142ni na\u0142adowany odkurzacz powinien pozostawa\u0107 w stacji dokuj\u0105cej, aby wyd\u0142u\u017cy\u0107 \u017cywotno\u015b\u0107 akumulatora.",localization_strings_Main_Constants_97:"Pe\u0142ne na\u0142adowanie",localization_strings_Main_Constants_96:"Odkurzacz nie wznowi sprz\u0105tania i nie b\u0119dzie odtwarza\u0142 komunikat\xf3w g\u0142osowych w trybie DND",localization_strings_Main_Constants_95:"W\u0142\u0105czony tryb DND.",localization_strings_Main_Constants_92:"Oczy\u015bci\u0107 lub wymie\u0144 filtr.",localization_strings_Main_Constants_91:"Zablokowany filtr.",localization_strings_Main_Constants_84:"Poziom na\u0142adowania spad\u0142 poni\u017cej 20%. Anulowano zaplanowane sprz\u0105tanie.",localization_strings_Main_Constants_82:"Rozpoczynanie zaplanowanego sprz\u0105tania.",localization_strings_Main_Constants_80:"Stacja dokuj\u0105ca niedost\u0119pna. Usu\u0144 wszystkie przeszkody i wyczy\u015b\u0107 styczniki \u0142adowania.",localization_strings_Main_Constants_78:"Niski poziom na\u0142adowania akumulatora. Powr\xf3t do stacji dokuj\u0105cej.",localization_strings_Main_Constants_73:"Akumulator na\u0142adowany. Wznawianie sprz\u0105tania",localization_strings_Main_Constants_72:"Stacja dokuj\u0105ca niedost\u0119pna.  Pozycja startowa niedost\u0119pna.",localization_strings_Main_Constants_71:"Stacja dokuj\u0105ca niedost\u0119pna. Powr\xf3t do pozycji startowej.",localization_strings_Main_Constants_70:"\u0141adowanie",localization_strings_Main_Constants_68:"Zako\u0144czono cykl sprz\u0105tania",localization_strings_Main_Constants_67:"Niski poziom na\u0142adowania akumulatora, na\u0142aduj odkurzacz.",localization_strings_Main_Constants_66:"Na\u0142aduj odkurzacz",localization_strings_Main_Constants_65:"Zbiornik na odpady nie by\u0142 d\u0142ugo opr\xf3\u017cniany. Opr\xf3\u017cnij go teraz.",localization_strings_Main_Constants_64:"Zbiornik na odpady nale\u017cy opr\xf3\u017cnia\u0107 regularnie.",localization_strings_Main_Constants_63:"Opr\xf3\u017cnij zbiornik na odpady",localization_strings_Main_Constants_62:"Usterka spowodowana b\u0142\u0119dem wewn\u0119trznym. Zresetuj odkurzacz.",localization_strings_Main_Constants_60:"B\u0142\u0105d wewn\u0119trzny",localization_strings_Main_Constants_56:"Przew\xf3d zasilania mo\u017ce by\u0107 niepoprawnie wpi\u0119ty do stacji dokuj\u0105cej. Pod\u0142\u0105cz przew\xf3d jeszcze raz i spr\xf3buj ponownie.",localization_strings_Main_Constants_55:"Upewnij si\u0119, \u017ce przew\xf3d zasilania jest wpi\u0119ty to gniazdka.",localization_strings_Main_Constants_54:"Stacja dokuj\u0105ca nie jest pod\u0142\u0105czona do zasilania.",localization_strings_Main_Constants_53:"Zresetuj odkurzacz.",localization_strings_Main_Constants_51:"B\u0142\u0105d wentylatora",localization_strings_Main_Constants_50:"Awaria szczotki bocznej. Zresetuj odkurzacz.",localization_strings_Main_Constants_49:"Zresetuj odkurzacz.",localization_strings_Main_Constants_48:"B\u0142\u0105d bocznej szczotki",localization_strings_Main_Constants_47:"Odkurzacz jest przechylony. Przenie\u015b odkurzacz na p\u0142ask\u0105 powierzchni\u0119 i uruchom ponownie.",localization_strings_Main_Constants_46:"Ustaw odkurzacz na p\u0142askiej powierzchni i uruchom ponownie.",localization_strings_Main_Constants_45:"Odkurzacz jest przechylony",localization_strings_Main_Constants_44:"Czujnik \u015bcian jest zabrudzony. Wyczy\u015b\u0107 czujnik \u015bcian.",localization_strings_Main_Constants_43:"Wyczy\u015b\u0107 czujnik \u015bcian",localization_strings_Main_Constants_42:"Czujnik \u015bcian jest zabrudzony.",localization_strings_Main_Constants_41:"Temperatura akumulatora jest zbyt wysoka lub zbyt niska, poczekaj a\u017c wr\xf3ci do normalnego poziomu.",localization_strings_Main_Constants_40:"Poczekaj, a\u017c temperatura akumulatora spadnie do normalnego poziomu",localization_strings_Main_Constants_39:"B\u0142\u0105d akumulatora",localization_strings_Main_Constants_38:"Wyczy\u015b\u0107 styczniki \u0142adowania na stacji dokuj\u0105cej i odkurzaczu za pomoc\u0105 suchej \u015bciereczki.",localization_strings_Main_Constants_37:"Wyczy\u015b\u0107 styki \u0142aduj\u0105ce i od\u0142\u0105cz stacj\u0119 dokuj\u0105c\u0105, a nast\u0119pnie pod\u0142\u0105cz j\u0105 i spr\xf3buj ponownie.",localization_strings_Main_Constants_34:"Odkurzacz nale\u017cy na\u0142adowa\u0107 przed u\u017cyciem.",localization_strings_Main_Constants_33:"Niski poziom na\u0142adowania akumulatora",localization_strings_Main_Constants_32:"Odkurzacz znajduje si\u0119 zbyt blisko wirtualnej \u015bciany lub silnego pola magnetycznego. Przenie\u015b odkurzacz w inne miejsce i uruchom ponownie.",localization_strings_Main_Constants_30:"Wykryto silne pole magnetyczne",localization_strings_Main_Constants_29:"Filtr jest mokry lub zablokowany. Susz filtr przez co najmniej 24 godziny. Filtr mo\u017ce r\xf3wnie\u017c wymaga\u0107 wyczyszczenia. Je\u015bli problem b\u0119dzie si\u0119 utrzymywa\u0142, spr\xf3buj wymieni\u0107 filtr.",localization_strings_Main_Constants_28:"Wysusz lub wyczy\u015b\u0107 filtr.",localization_strings_Main_Constants_27:"Filtr jest mokry lub zablokowany.",localization_strings_Main_Constants_26:"Ponownie zainstaluj zbiornik na odpady i filtr. Je\u015bli problem b\u0119dzie si\u0119 utrzymywa\u0142, spr\xf3buj wymieni\u0107 filtr.",localization_strings_Main_Constants_25:"Ponownie zainstaluj zbiornik na odpady i filtr.",localization_strings_Main_Constants_24:"Zbiornik na odpady nie jest zainstalowany.",localization_strings_Main_Constants_23:"Usu\u0144 wszystkie przeszkody znajduj\u0105ce si\u0119 w okolicy odkurzacza. Lub przenie\u015b go w inne miejsce i uruchom ponownie.",localization_strings_Main_Constants_22:"Usu\u0144 wszystkie przeszkody znajduj\u0105ce si\u0119 w okolicy odkurzacza.",localization_strings_Main_Constants_21:"Odkurzacz utkn\u0105\u0142 lub zosta\u0142 zablokowany.",localization_strings_Main_Constants_20:"Wyczy\u015b\u0107 g\u0142\xf3wne ko\u0142a, a nast\u0119pnie przenie\u015b odkurzacz w inne miejsce i uruchom ponownie.",localization_strings_Main_Constants_19:"Wyczy\u015b\u0107 g\u0142\xf3wne ko\u0142a. Lub przenie\u015b\u0107 odkurzacz w inne miejsce i uruchom ponownie.",localization_strings_Main_Constants_18:"Odkurzacz utkn\u0105\u0142 lub ko\u0142a zosta\u0142y zablokowane.",localization_strings_Main_Constants_17:"Zdemontuj boczn\u0105 szczotk\u0119, wyczy\u015b\u0107 j\u0105 i uruchom ponownie.",localization_strings_Main_Constants_16:"Zdemontuj i wyczy\u015bci\u0107 boczn\u0105 szczotk\u0119.",localization_strings_Main_Constants_15:"Zablokowana boczna szczotka.",localization_strings_Main_Constants_14:"Zdemontuj g\u0142\xf3wn\u0105 szczotk\u0119, a nast\u0119pnie wyczy\u015b\u0107 szczotk\u0119 i uruchom ponownie.",localization_strings_Main_Constants_13:"Zdemontuj g\u0142\xf3wn\u0105 szczotk\u0119, a nast\u0119pnie wyczy\u015b\u0107 szczotk\u0119 i \u0142o\u017cysko.",localization_strings_Main_Constants_12:"Zablokowana g\u0142\xf3wna szczotka.",localization_strings_Main_Constants_11:"Odkurzacz si\u0119 zawiesi\u0142. Przenie\u015b odkurzacz w inne miejsce i uruchom ponownie. B\u0142\u0105d mo\u017ce by\u0107 r\xf3wnie\u017c powodowany przez brudne czujniki kraw\u0119dzi, wyczy\u015b\u0107 czujniki kraw\u0119dzi i uruchom odkurzacz ponownie.",localization_strings_Main_Constants_10:"Wyczy\u015b\u0107 czujniki kraw\u0119dzi i przenie\u015b odkurzacz w inne miejsce, a nast\u0119pnie uruchom go ponownie.",localization_strings_Main_Constants_9:"B\u0142\u0105d czujnika kraw\u0119dzi",localization_strings_Main_Constants_7:"Przenie\u015b odkurzacz w inne miejsce i uruchom ponownie.",localization_strings_Main_Constants_6:"Zawieszone ko\u0142a",localization_strings_Main_Constants_5:"Zablokowany zderzak. Delikatnie stuknij w zderzak kilka razy, aby usun\u0105\u0107 zablokowane przedmioty. Je\u015bli nic nie wypadnie, przenie\u015b odkurzacz w inne miejsce i uruchom ponownie.",localization_strings_Main_Constants_4:"Oczy\u015b\u0107 i delikatnie stuknij w zderzak",localization_strings_Main_Constants_3:"Zablokowany zderzak",localization_strings_Main_Constants_2:"Zablokowany LDS. Usu\u0144 przeszkody, przenie\u015b odkurzacz w inne miejsce i uruchom ponownie.",localization_strings_Main_Constants_1:"Obr\xf3\u0107 czujnik laserowy i sprawd\u017a czy obraca si\u0119 swobodnie.",localization_strings_Main_Constants_0:"B\u0142\u0105d czujnika laserowego",localization_strings_CommonModules_NumberView_2:"Czas",localization_strings_CommonModules_NumberView_1:"Akumulator",localization_strings_CommonModules_NumberView_0:"Obszar",localization_strings_Common_Protocol_4:"Delikatny",localization_strings_Common_Protocol_3:"Maksymalny",localization_strings_Common_Protocol_2:"Turbo",localization_strings_Common_Protocol_1:"Zr\xf3wnowa\u017cony",localization_strings_Common_Protocol_0:"Cichy",localization_strings_Common_Constants_19:"\u0141adowanie",localization_strings_Common_Constants_18:"Nieaktywny",localization_strings_Common_Constants_17:"Na\u0142adowany",localization_strings_Common_Constants_15:"Aktualizacja",localization_strings_Common_Constants_13:"B\u0142\u0105d",localization_strings_Common_Constants_12:"Sprz\u0105tanie miejscowe",localization_strings_Common_Constants_11:"jeda",localization_strings_Common_Constants_8:"\u0141adowanie",localization_strings_Common_Constants_6:"Wracanie do doku",localization_strings_Common_Constants_4:"Sterowanie zdalne",localization_strings_Common_Constants_3:"Gotowy",localization_strings_Common_Constants_2:"U\u015bpienie",localization_strings_Common_Constants_1:"Sprz\u0105tanie",localization_strings_Common_Constants_0:"Pobieranie danych",map_edit_furniture_sofa_single:"Pojedyncza sofa",map_edit_furniture_sofa_double:"Podw\xf3jna sofa",map_edit_furniture_sofa_three:"Sofa wieloosobowa",map_edit_furniture_sofa_sectional:"Modu\u0142owa sofa",map_edit_furniture_shoe_cabinet:"Stojak na buty",map_edit_furniture_wardrobe:"Szafa na ubrania",map_edit_furniture_night_stand:"Stolik nocny",voice_chat_tips:"Aby zapewni\u0107 bezpiecze\u0144stwo, wideo zostanie automatycznie od\u0142\u0105czone po godzinie rozmowy, w\u0142\u0105cz je ponownie.",back_wash_title1:"Wed\u0142ug pokoju",back_wash_title2:"Z czasem",accessibility_back:"Powr\xf3t",accessibility_guide:"Pomoc",accessibility_add:"Doda\u0107",map_edit_furniture_rect_table:"Kwadratowy st\xf3\u0142",map_obstacles_title18:"Przeszkoda",accessibility_on:"otwarty",map_type_2d:"2D",map_type_3d:"3D",map_type_ar:"Matrix",map_furniture_guide_title:"Rozpoznawanie mebli",map_furniture_guide_detail:"Liczba rozpoznanych mebli: ${count}. Stuknij, aby wy\u015bwietli\u0107.",map_furniture_guide_save_tip:"Modele mebli po zapisaniu zostan\u0105 dodane do mapy. Prosz\u0119 sprawdzi\u0107, czy meble s\u0105 ustawione prawid\u0142owo.",home_sepecial_tip_for_only_mop:"Tylko mopowanie | Jednokrotne u\u017cycie",home_sepecial_tip_for_only_clean:"Tylko odkurzanie | Jednokrotne u\u017cycie",switch_ar_map_when_map_unsaved_tip:"Zapisz map\u0119 przed u\u017cyciem tej funkcji",home_new_control_start_collect:"Opr\xf3\u017cnij zbiornik",robot_status_egg_attack:"\u0142\xf3w",reset_privacy_dialog_content:"Wycofa\u0107 autoryzacj\u0119?",new_dock_charging_or_full_charging_title:"Stacja dokuj\u0105ca",robot_status_wait_charge:"Oczekuje na \u0142adowanie",robot_status_wait_charge1:"\u0141adowanie poza godzinami szczytu",robot_status_wait_charge2:"Robot zostanie w pe\u0142ni na\u0142adowany wy\u0142\u0105cznie poza godzinami szczytu.\xa0W pozosta\u0142ych godzinach utrzymywana b\u0119dzie minimalna moc. ",robot_status_wait_charge3:"Uwaga: \u0141adowanie poza godzinami szczytu jest traktowane priorytetowo",robot_status_wait_charge4:"1. \u0141adowanie w godzinach szczytu mo\u017ce by\u0107 wymagane, aby wykona\u0107 pe\u0142ne sprz\u0105tanie.",robot_status_wait_charge5:"2. \u0141adowanie b\u0119dzie si\u0119 odbywa\u0107 w godzinach szczytu, aby zu\u017cycie energii by\u0142o minimalne.",robot_status_wait_charge6:"* Ustalony okres \u0142adowania musi by\u0107 d\u0142u\u017cszy ni\u017c 6 godzin.",home_special_tip_for_wait_charge:"\u0141adowanie wstrzymane w godzinach szczytu.",voice_chat_alert:"Rozpocz\u0119cie po\u0142\u0105czenia spowoduje zatrzymanie sprz\u0105tania. Zostanie ono wznowione po zako\u0144czeniu po\u0142\u0105czenia.",home_special_tip_for_charger_offset:"Stacja dokuj\u0105ca zosta\u0142a przeniesiona, ale mapa nie zosta\u0142a zaktualizowana.\xa0Dotknij, aby uzyska\u0107 szczeg\xf3\u0142y.",choose_map_hint_old_map:"Zapisane mapy",dock_kit_setting1:"4\xa0godz.",dock_kit_setting2:"2\xa0godz.",dock_kit_setting3:"3\xa0godz.",dock_kit_setting4:"Ustawienia suszenia",dock_kit_setting5:"Automatyczne suszenie",dock_kit_setting6:"Czas trwania",dock_kit_setting9:"Zatrzymaj suszenie",home_special_tip_for_new_map:"Odnaleziono niezapisan\u0105 map\u0119. Dotknij, aby obejrze\u0107.",backup_map:"Kopia zapasowa",recover_map:"Przywr\xf3\u0107",delete_map_hint_title:"Usun\u0105\u0107 map\u0119?",map_edit_delete:"Usu\u0144",backup_success_hint:"Kopia robocza bie\u017c\u0105cej mapa zosta\u0142a wykonana w robocie. U\u017cyj funkcji Przywr\xf3\u0107 Map\u0119, aby za\u0142adowa\u0107 ponownie map\u0119.",privacy_access_failure:"Za\u0142adowanie tre\u015bci Umowy z u\u017cytkownikiem nieudane. Uzyskaj dost\u0119p do wtyczki i spr\xf3buj ponownie.",dock_kit_setting11:"Instrukcje dotycz\u0105ce modu\u0142u osuszacza",dock_kit_setting12:"1. Modu\u0142 osuszacza jest sprzedawany osobno. \n2. W razie potrzeby robot b\u0119dzie suszony po mopowaniu. Suszenie mo\u017cna te\u017c uruchomi\u0107 r\u0119cznie.",dock_kit_setting14:"Zakupiono",supplies_floor_cleaning_fluid:"Roztw\xf3r do sprz\u0105tania pod\u0142\xf3g",supplies_floor_cleaning_fluid1:"Specjalnie opracowany roztw\xf3r czyszcz\u0105cy pozwala na dok\u0142adne oczyszczanie mopa i skuteczne usuwanie plam z pod\u0142ogi. Zaleca si\u0119 jego dodanie w miar\u0119 potrzeb.",map_edit_floor_wood_tile:"Rodzaj pod\u0142ogi",smart_scene_custom_commands:"Moje Przep\u0142ywy pracy",smart_scene_recommend_commands:"Zalecane Przep\u0142yw pracy",smart_scene_more:"Wi\u0119cej",smart_scene_input_dialog_title:"Wprowad\u017a nazw\u0119 Przep\u0142ywu pracy",smart_scene_edit_title:"Edytuj Przep\u0142yw pracy",smart_scene_reached_max_command_count_toast_hint:"Dodaj maks. 10 Przep\u0142yw\xf3w pracy",smart_scene_add_command_success:"Dodano",smart_scene_add_dining_room_and_kitchen_hint:"Wybierz kuchni\u0119 i jadalni\u0119",smart_scene_add_command_button_title:"Dodaj ulubione Przep\u0142ywy pracy",smart_scene_edit_switch_map_warning_title:"Zmiana mapy spowoduje usuni\u0119cie wszystkich Przep\u0142yw\xf3w pracy i Harmonogram\xf3w.",smart_scene_edit_button_title_done:"Zako\u0144cz",smart_scene_delete_timer:"Usu\u0144 harmonogram",smart_scene_rename:"Zmie\u0144 nazw\u0119",smart_scene_recommend_global_clean_title:"Pe\u0142ne sprz\u0105tanie",smart_scene_recommend_clean_after_meal:"Po posi\u0142kach",localization_strings_Setting_General_index_1:"Nazwa odkurzacza",map_edit_custom_mode:"Ustawienie trybu",smart_scene_add_command:"Dodaj Przep\u0142yw pracy",unsave_map_reason_1:"Stacja dokuj\u0105ca zosta\u0142a przeniesiona. Mapa nie zosta\u0142a zapisana.",unsave_map_reason_2:"Pozycjonowanie nie powiod\u0142o si\u0119. Ponowne mapowanie. ",unsave_map_reason_3:"Osi\u0105gni\u0119to maksymaln\u0105 liczb\u0119 map. Mapa nie zosta\u0142a zapisana.",unsave_map_reason_4:"Sprz\u0105tanie nie zosta\u0142o zako\u0144czone. Mapa nie zosta\u0142a zapisana.",unsave_map_reason_5:"Sprz\u0105tanie nie rozpocz\u0119\u0142o si\u0119 ze stacji dokuj\u0105cej. Mapa nie zosta\u0142a zapisana.",unsave_map_reason_6:"Nie mo\u017cna dotrze\u0107 do stacji dokuj\u0105cej. Mapa nie zosta\u0142a zapisana.",unsave_map_alert_content:"Mapa czyszczenia mog\u0142a zosta\u0107 zmieniona podczas czyszczenia. Czy chcesz odzyska\u0107 zapisan\u0105 map\u0119?",robot_setting_self_cleaning_title:"Ustawienia stacji dokuj\u0105cej",mainpage_unknown_segment_click_tips:"Nie mo\u017cna wybra\u0107 wskazanego obszaru. Przejd\u017a do sekcji \u201eEdytuj pok\xf3j\u201d w swojej aplikacji i zdefiniuj r\u0119cznie ten obszar jako pok\xf3j, aby mo\u017cna by\u0142o go wybra\u0107.",dock_kit_setting15:"Wybierz intensywno\u015b\u0107 mycia, zale\u017cnie od czysto\u015bci pod\u0142ogi.",dock_kit_setting16:"Wybierz cz\u0119stotliwo\u015b\u0107, z jak\u0105 robot b\u0119dzie powraca\u0142 do mycia mopem. ",dock_kit_setting17:"W\u0142\u0105cz/wy\u0142\u0105cz automatyczne suszenie po przeprowadzonym myciu.",history_mark_zone_exceed_limit:"Osi\u0105gni\u0119to maksymaln\u0105 liczb\u0119 oznacze\u0144",localization_strings_Setting_DoNotDisturbPage_3:"Wy\u0142\u0105cz automatyczne wznawianie pracy",localization_strings_Setting_DoNotDisturbPage_4:"Wycisz alarmy g\u0142osowe",localization_strings_Setting_DoNotDisturbPage_5:"Przyciemnij \u015bwiat\u0142a wska\u017anika",localization_strings_Setting_DoNotDisturbPage_6:"Wy\u0142\u0105cz automatyczne opr\xf3\u017cnianie",localization_strings_Setting_DoNotDisturbPage_7:"Wy\u0142\u0105cz automatyczne osuszanie",localization_strings_Setting_DoNotDisturbPage_8:"Dostosuj tryb \u201eNie przeszkadza\u0107\u201d",setting_section_title2:"Kontrola urz\u0105dzenia",map_edit_select_one_map:"Mapy",home_sepecial_tip_for_only_mop_collectdusk:"Tylko mopowanie | Jednokrotne u\u017cycie",build_map_finish_guide_title:"Mapa zapisana. Inteligentne rozpoznawanie otoczenia.",build_map_finish_guide_content:"Mapa zostanie zaktualizowana podczas mycia; rozpocznij pe\u0142ne mycie, aby utworzy\u0107 map\u0119 z pe\u0142n\u0105 identyfikacj\u0105 pokoju.",build_map_map_edit_guide_title:"Edytuj map\u0119, aby robot dowiedzia\u0142 si\u0119 wi\u0119cej o \u015brodowisku domowym.",build_map_map_edit_guide_content:"Przejd\u017a na stron\u0119 edycji mapy, aby ustawi\u0107 cz\u0119stotliwo\u015b\u0107 czyszczenia i strefy wykluczone, a tak\u017ce aby edytowa\u0107 pok\xf3j pod k\u0105tem lepszego czyszczenia. ",home_new_control_start_dry:"Suchy",map_edit_door_sill_title:"Pr\xf3g blokuj\u0105cy",map_edit_door_sill_slide:"Pr\xf3g ograniczaj\u0105cy przejazd",map_edit_door_sill_stone:"Progi kamienne",error_temperature_protection_desc:"Przenie\u015b robota w miejsce o temperaturze pokojowej i odczekaj pewien czas.",error_temperature_protection_title:"Ochrona temperatury jednostki",map_edit_add_ai_zone:"Ustaw stref\u0119 zakazan\u0105",map_edit_add_door_sill:"Ustaw pr\xf3g",map_edit_cliff_zone_adjust:"Dostosuj stref\u0119 zakazan\u0105",map_edit_door_sill_title2:"Inteligentnie przeje\u017cd\u017ca nad progiem, co pozwala unika\u0107 zablokowania",map_edit_door_sill_detail:"Robot przeje\u017cd\u017ca w inteligentny i ostro\u017cny spos\xf3b nad progami blokuj\u0105cymi bez sprz\u0105tania tych miejsc.",map_edit_stuck_zone_title:"Obszar zablokowania",map_edit_stuck_zone_detail:"W tym miejscu robot jest blokowany. Ustaw stref\u0119 zakazan\u0105, aby robot j\u0105 omin\u0105\u0142. *Je\u015bli nie chcesz tego zrobi\u0107, dotknij \u201eZignoruj\u201d.",map_edit_cliff_zone_title:"Strefa zakazana przy kraw\u0119dzi",map_edit_cliff_zone_detail:"Kraw\u0119d\u017a jest stale wykrywana w tym miejscu. Strefa zakazana zosta\u0142a wygenerowana automatycznie. Ustawienie kraw\u0119dzi jako strefy zakazanej pozwala na wydajniejsz\u0105 prac\u0119 robota.\r\n*Je\u015bli nie ma ryzyka, \u017ce robot w tym miejscu spadnie, mo\u017cesz to zignorowa\u0107.\r\n*Je\u015bli rozmiar i lokalizacja strefy zakazanej s\u0105 niew\u0142a\u015bciwe, odpowiednio je dostosuj.",setting_carpet_deep_clean_switch_title:"G\u0142\u0119bokie czyszczenie dywanu",setting_carpet_deep_clean_switch_desc:"Po posprz\u0105taniu pokoju robot oddzielnie wyczy\u015bci dywany w ka\u017cdym pokoju. \n*Nie obejmuje mat.",map_ai_zone_bubble_set:"Dotknij, aby potwierdzi\u0107 obszar zablokowania",map_ai_zone_bubble_adjust:"Dotknij, aby dostosowa\u0107 stref\u0119 zakazan\u0105",warning_for_will_delete_wifi:"Po usuni\u0119ciu robot przestanie pr\xf3bowa\u0107 nawi\u0105za\u0107 po\u0142\u0105czenie z t\u0105 sieci\u0105 WiFi.",wifi_page_current_wifi:"Obecne po\u0142\u0105czenie WiFi",wifi_page_others_wifi:"Inne po\u0142\u0105czenia WiFi",wifi_page_title:"WiFi",map_edit_floor_wood_width:"Pod\u0142oga (poziomo)",map_edit_floor_wood_longti:"Pod\u0142oga (pionowo)",ground_material_clean_direction_title:"Sprz\u0105taj wzd\u0142u\u017c kierunku pod\u0142ogi",ground_material_clean_direction_detail:"W przypadku pe\u0142nego sprz\u0105tania lub selektywnego sprz\u0105tania pomieszcze\u0144 robot posprz\u0105ta pod\u0142og\u0119 wzd\u0142u\u017c jej kierunku, aby zminimalizowa\u0107 potencjalne zadrapania po\u0142\u0105cze\u0144 pod\u0142ogi.\r\n*Aby ta funkcja dzia\u0142a\u0142a, okre\u015bl materia\u0142 pod\u0142ogi. Robot mo\u017ce sprz\u0105ta\u0107 tylko w jednym kierunku.",map_edit_door_sill_exceed_limit:"Osi\u0105gni\u0119to maksymaln\u0105 liczb\u0119 prog\xf3w drzwi.",map_cliff_zone_guide_text:"W tym miejscu jest stale wykrywana kraw\u0119d\u017a. Strefa zakazana zosta\u0142a ustawiona automatycznie.",map_stuck_point_guide_text:"W tym miejscu robot stale si\u0119 blokuje. Ustaw stref\u0119 zakazan\u0105.",map_door_sill_guide_text:"W tym miejscu wykryto pr\xf3g. Ustaw stref\u0119 progu.",clean_route_fast_mode_title:"Szybko",wifi_rssi_title:"Si\u0142a sygna\u0142u",map_object_desc_sanxian:"Funkcja unikania przewod\xf3w/kabli zapobiegaj\u0105ca spl\u0105taniu. Mo\u017ce jednak doj\u015b\u0107 do spl\u0105tania z d\u0142ugimi, cienkimi przewodami.",map_object_desc_chongwu:"Wykryto zwierz\u0119ta, co pozwala zapobiec niepokojeniu ich i zderzeniom.",map_object_desc_zhituan:"Wykryto tkanin\u0119 / papierowe kulki, co zapobiega zapl\u0105taniu i zablokowaniu.",map_object_name_loosewire:"Przewody/kable",map_object_name_cat:"Zwierz\u0119",map_object_name_dog:"Zwierz\u0119",map_object_name_curledfabric:"Tkanina / papierowe kulki",auto_delivery_cleaning_fluid_title:"Inteligentne uzupe\u0142nianie roztworu czyszcz\u0105cego",auto_delivery_cleaning_fluid_desc:"Roztw\xf3r do mycia pod\u0142\xf3g jest dodawany automatycznie podczas mopowania i nape\u0142niania zbiornika.",clean_route_fast_mode_guide_title:"Tryb szybkiego sprz\u0105tania o wy\u017cszej wydajno\u015bci.",clean_route_fast_mode_guide_desc:"Robot poznaje dane miejsce i dostosowuje odpowiednio swoj\u0105 tras\u0119, aby zapewni\u0107 wydajniejsze sprz\u0105tanie. Granice pomieszcze\u0144 zostan\u0105 pomini\u0119te. Ta funkcja jest przeznaczona do okazjonalnego wykorzystania.",clean_route_fast_mode_is_work:"Tryb szybkiego sprz\u0105tania",home_sepecial_tip_cleanmop_fastroute:"Tryb szybkiego sprz\u0105tania | Pojedyncze u\u017cycie",livecall_autosoundoff_whenmoving_alerttitle:"Po\u0142\u0105czenie w trakcie ruchu",livecall_autosoundoff_whenmoving_alertdesc:"Po\u0142\u0105czenie jest rozpoczynane w trakcie ruchu. Domy\u015blnie jest wyciszone. Wy\u0142\u0105cz wyciszenie, je\u015bli to konieczne.",carpet_clean_mode_detail4:"Opcja ta ma zastosowanie do mat lub niewielkich dywan\xf3w. Gdy dywan zostanie wykryty, mop zostanie podniesiony, a przep\u0142yw wody zatrzymany, \u017ceby umo\u017cliwi\u0107 odkurzenie dywanu.",clean_route_setting_title:"Trasa",map_object_desc_general_1:"Wykorzystuj\u0105c laser wspomagany przez szereg innych czujnik\xf3w, robot mo\u017ce identyfikowa\u0107 i unika\u0107 wielu r\xf3\u017cnych przeszk\xf3d.",robot_play_soundpackage_exception:"Pr\xf3bny ods\u0142uch zako\u0144czony niepowodzeniem. Spr\xf3buj u\u017cy\u0107 go bezpo\u015brednio.",offline_map_guide_title:"Mapa offline",offline_map_guide_desc1:"Urz\u0105dzenie wy\u0142\u0105czy si\u0119 automatycznie, je\u015bli nie b\u0119dzie \u0142adowane przez wi\u0119cej ni\u017c 12 godzin. W\u0142\u0105czenie mapy offline pozwala si\u0119 dowiedzie\u0107, gdzie urz\u0105dzenie si\u0119 znajdowa\u0142o przed przej\u015bciem w tryb offline.",offline_map_tips_title:"Lokalizacja urz\u0105dzenia przed przej\u015bciem w tryb offline",offline_map_tips_subtitle:"Urz\u0105dzenie zosta\u0142o zlokalizowane w tym miejscu przed przej\u015bciem w tryb offline. Umie\u015b\u0107 je ponownie w stacji dokuj\u0105cej, a uruchomi si\u0119 i po\u0142\u0105czy z sieci\u0105 w automatyczny spos\xf3b.",upgrade_progress_view_title:"Aktualizacja oprogramowania sprz\u0119towego",upgrade_progress_view_desc:"\u017badne operacje nie s\u0105 dozwolone. Prosimy czeka\u0107.",offline_map_tips_off_line_date:"Czas pozostawania w trybie offline",home_sepcial_info_airdry_finish_time_minute:"Osuszanie mopa, szacunkowe zako\u0144czenie po ${minute} min",map_edit_furniture_open_cattoilet:"Pojemnik na nieczysto\u015bci po kocie",map_edit_furniture_cat_toilet:"Zamkni\u0119ty pojemnik na nieczysto\u015bci",map_edit_furniture_pet_cage:"Klatka dla zwierz\u0105t",map_edit_furniture_pet_waterloo:"Pos\u0142anie dla zwierz\u0105t",map_edit_furniture_pet_bowl:"Miska dla zwierz\u0105t",unlock_clean_route_fast_mode_guide_title:"Odblokuj tryb szybkiego sprz\u0105tania",unlock_clean_route_fast_mode_guide_desc:"Robot musi zna\u0107 dane miejsce, aby u\u017cy\u0107 tego trybu. Zapisz map\u0119 przed wypr\xf3bowaniem tego trybu.",water_updown_self_clean_title:"Dokowanie oraz samodzielne czyszczenie elementu do nape\u0142niania i odprowadzania",water_updown_self_clean_desc:"P\u0142ukanie zlewu czyszcz\u0105cego i wbudowanego zbiornika na nieczysto\u015bci dla elementu do nape\u0142niania i odprowadzania; przeprowadzenie autotestu elementu.",water_updown_self_clean_button_title:"Uruchom samodzielne czyszczenia",water_updown_drain_title:"Opr\xf3\u017cnienie elementu do nape\u0142niania i odprowadzania",water_updown_drain_desc:"Spu\u015bci\u0107 pozosta\u0142\u0105 wod\u0119 z wbudowanego zbiornika na \u015bcieki.",water_updown_drain_button_title:"Uruchom odprowadzenie",water_up_down_setting_item_title:"Ustawienia nape\u0142niania i odprowadzania",water_up_down_setting_item_desc:"Op\u0142ukuje zlew czyszcz\u0105cy; przeprowadza autotest elementu.",product_info_dock_sn:"Numer seryjny stacji dokuj\u0105cej",product_info_dock_version:"Wersja oprogramowania sprz\u0119towego stacji dokuj\u0105cej",error_up_water_title:"B\u0142\u0105d nape\u0142niania",error_up_water_desc:"Sprawd\u017a, czy kran jest otwarty, i upewnij si\u0119, czy woda normalnie przep\u0142ywa.",error_up_water_detail:"Sprawd\u017a, czy woda jest doprowadzona. Je\u015bli tak, ponownie pod\u0142\u0105cz kabel do elementu do nape\u0142niania i odprowadzania i spr\xf3buj jeszcze raz. Je\u015bli problem nie ust\u0119puje, skontaktuj si\u0119 z obs\u0142ug\u0105 klienta.",error_drain_water_title:"B\u0142\u0105d odprowadzania",error_drain_water_desc:"Sprawd\u017a, czy co\u015b nie blokuje odp\u0142ywu, i usu\u0144 przeszkod\u0119.",error_drain_water_detail:"Sprawd\u017a, czy co\u015b nie blokuje odp\u0142ywu, i usu\u0144 przeszkod\u0119. Je\u015bli problem nie ust\u0119puje, skontaktuj si\u0119 z obs\u0142ug\u0105 klienta.",error_clean_carousel_unsetuped_title:"Sprawd\u017a tac\u0119 czyszcz\u0105c\u0105.",error_clean_carousel_unsetuped_desc:"Ponownie zamontuj tac\u0119 czyszcz\u0105c\u0105.",error_clean_carousel_unsetuped_detail:"1. Zabezpiecz tac\u0119 czyszcz\u0105c\u0105 w miejscu; 2. Sprawd\u017a, czy nic nie utkn\u0119\u0142o w wylocie wody w stacji dokuj\u0105cej; 3.Sprawd\u017a i zabezpiecz pokryw\u0119 zbiornika brudnej wody.",error_clean_carousel_water_full_title:"Taca czyszcz\u0105ca pe\u0142na.",error_clean_carousel_water_full_desc:"Sprawd\u017a, czy nic nie blokuje wylotu wody, i usu\u0144 przeszkod\u0119",error_clean_carousel_water_full_detail:"Wylot wody w stacji dokuj\u0105cej mo\u017ce by\u0107 zablokowany, sprawd\u017a i usu\u0144 przeszkod\u0119. Je\u015bli nie jest zablokowany, sprawd\u017a i zabezpiecz pokryw\u0119 zbiornika na brudn\u0105 wod\u0119 oraz zatrzask.",map_edit_map_unsave:"Zapisz map\u0119 przed ponown\u0105 pr\xf3b\u0105.",charger_type_name_special:"Stacja dokuj\u0105ca",valley_electricity_not_set_hint:"* Nie ustawiono czasu \u0142adowania. \u0141adowanie poza godzinami szczytu nieaktywne.",dock_kit_setting0:"5 godz.",washing_mode_updown_water_selfcleaning:"Samo czyszcz\u0105cy",washing_mode_updown_water_drain:"Opr\xf3\u017cnianie elementu do nape\u0142niania i odprowadzania",wash_towel_mode_title_4:"Ultrag\u0142\u0119bokie",wash_towel_mode_desc_4:"Nadaje si\u0119 do instalacji elementu do nape\u0142niania i odprowadzania, poprawia efekty mycia mopa.",dock_panel_function_section_title:"Sterowanie stacj\u0105 dokuj\u0105c\u0105",dock_info_clear_water_box_title:"Zbiornik na czyst\u0105 wod\u0119",dock_info_clear_water_box_exception1:"Brak wody ",dock_info_dirty_water_box_title:"Zbiornik na brudn\u0105 wod\u0119",dock_info_dirty_water_box_exception1:"Pe\u0142no / Nie zainstalowano",dock_info_clean_fluid_title:"Kartrid\u017c z detergentem",dock_info_clean_fluid_exception:"Niski poziom p\u0142ynu",dock_info_water_box_filter_title:"Filtr wody",dock_info_item_gone_exception:"Nie zainstalowano",dock_info_dust_bag_exception:"Pe\u0142no ",toast_clean_then_mop_24hour:"Aby zapobiega\u0107 nadmiernemu gromadzeniu si\u0119 brudu i zadba\u0107 o jak najlepsz\u0105 wydajno\u015b\u0107 czyszczenia, odkurz pod\u0142og\u0119 przed rozpocz\u0119ciem mopowania.",cliff_zones_save_failed:"B\u0142\u0105d strefy zakazanej przy kraw\u0119dzi",inner_error_desc_151:"B\u0142\u0105d wentylatora osuszaj\u0105cego",inner_error_desc_152:"Nape\u0142nianie i odprowadzanie \u2013 b\u0142\u0105d pompy opr\xf3\u017cniaj\u0105cej",inner_error_desc_153:"Nape\u0142nianie i odprowadzanie \u2013 b\u0142\u0105d zaworu wlotu wody / czujnika poziomu czystej wody",inner_error_desc_154:"B\u0142\u0105d szczotki bocznej",inner_error_desc_158:"Nape\u0142nianie i odprowadzanie \u2013 b\u0142\u0105d czujnika poziomu brudnej wody",inner_error_desc_159:"Nape\u0142nianie i odprowadzanie \u2013 b\u0142\u0105d komunikacji",map_edit_furniture_floor_mirror:"Odzwierciedlanie pod\u0142ogi",map_edit_split_too_small:"Obszar pokoju jest zbyt ma\u0142y i\xa0nie zaleca si\u0119 jego dzielenia.",setting_auto_avoid_obstacle_title:"Reaktywne omijanie przeszk\xf3d",setting_auto_avoid_obstacle_desc:"Algorytm \u015bwiat\u0142a strukturalnego umo\u017cliwia wykrywanie przeszk\xf3d przez robota i unikanie kolizji w czasie rzeczywistym, co dodatkowo ogranicza do minimum ryzyko utkni\u0119cia.",error_water_carriage_drop_title:"Mocowanie mopa odpad\u0142o. ",error_water_carriage_drop_desc:"Zamontuj ponownie, aby wznowi\u0107 prac\u0119.",error_water_carriage_drop_detail:"Mocowanie \u015bciereczki mopa odpad\u0142o, zamontuj je ponownie, aby wznowi\u0107 prac\u0119.",supplies_pearl_strainer_name:"Taca czyszcz\u0105ca",supplies_pearl_strainer_description:"Du\u017ce cz\u0105stki odnalezione podczas mycia mopa pozostan\u0105 w\xa0tacy czyszcz\u0105cej, aby zapobiega\u0107 blokowaniu instalacji wodnej. Co najmniej raz w\xa0miesi\u0105cu nale\u017cy wyp\u0142uka\u0107 tac\u0119 czyszcz\u0105c\u0105.",alert_pause_current_task_then_selfclean:"Czy chcesz zako\u0144czy\u0107 obecne zadanie i\xa0rozpocz\u0105\u0107 samodzielne czyszczenie?",alert_pause_current_task_then_drain:"Robot odkurzaj\u0105cy nie sko\u0144czy\u0142 sprz\u0105tania. Przed skorzystaniem z tej funkcji nale\u017cy zako\u0144czy\u0107 bie\u017c\u0105ce zadanie.",close_auto_dry_alert_desc:"\u015aciereczka mopa mo\u017ce charakteryzowa\u0107 si\u0119 nieprzyjemnym zapachem, je\u015bli funkcja suszenia jest wy\u0142\u0105czona. Czy na pewno chcesz j\u0105 wy\u0142\u0105czy\u0107?",drain_left_water_tip1:"1. Umie\u015b\u0107 robota w\xa0stacji dokuj\u0105cej, zadbaj o\xa0jego na\u0142adowanie. Upewnij si\u0119, \u017ce zbiornik na brudn\u0105 wod\u0119 (lub element nape\u0142niania i\xa0odprowadzania) oraz taca czyszcz\u0105ca s\u0105 zamontowane na miejscu i\xa0usu\u0144 mocowanie \u015bciereczki mopa.",drain_left_water_tip2:"2. Wybierz opcj\u0119 \u201eRozpocznij opr\xf3\u017cnianie pozosta\u0142ej wody\u201d i\xa0poczekaj na automatyczne zako\u0144czenie tego procesu;",drain_left_water_tip3:"3. Zajmuje to od 5 do 10 minut. W tym czasie nie przeno\u015b robota i\xa0stacji dokuj\u0105cej;",drain_left_water_tip4:"4. Pojawi si\u0119 alert g\u0142osowy robota \u201eOsuszanie zako\u0144czone\u201d, informuj\u0105cy o\xa0tym, \u017ce pozosta\u0142a woda zosta\u0142a opr\xf3\u017cniona. Opr\xf3\u017cnij zbiornik na brudn\u0105 wod\u0119 (lub element nape\u0142niania i\xa0odprowadzania). ",drain_left_water_title:"Automatycznie opr\xf3\u017cnij pozosta\u0142\u0105 wod\u0119",left_water_is_draining:"Robot jest osuszany",start_drain_left_water:"Rozpocznij opr\xf3\u017cnianie pozosta\u0142ej wody",left_water_drain_page_title:"Tryb wsparcia klienta",inner_error_desc_128:"Modu\u0142 mopuj\u0105cy zosta\u0142 skr\xf3cony.",inner_error_desc_129:"Modu\u0142 mopuj\u0105cy zosta\u0142 od\u0142\u0105czony.",setting_carpet_first_switch_title:"Priorytetowe czyszczenie dywanu",setting_carpet_first_switch_desc:"Po rozpocz\u0119ciu zadania czyszczenia, robot b\u0119dzie traktowa\u0142 priorytetowo odkurzanie obszaru pokrytego dywanem, bez namaczania \u015bciereczki mopa. Nast\u0119pnie b\u0119dzie kontynuowa\u0142 zadanie czyszczenia.\n* Nie uwzgl\u0119dnia mat.",skip_current_cleanarea_buttontitle:"Pomi\u0144 obecn\u0105 stref\u0119",pearl_supplies_strainer_reset_content:"Op\u0142ukana taca czyszcz\u0105ca. OK?",setting_back_wash_interval:"${minute} min",inner_error_desc_156:"B\u0142\u0105d ODD stacji dokuj\u0105cej",robot_is_warm_up_tip_try:"Rozgrzewam robota, spr\xf3buj ponownie p\xf3\u017aniej.",localization_strings_Main_MainPage_12:"Przywr\xf3\u0107",unsave_map_alert_mess:"Mapa znacz\u0105co si\u0119 zmieni\u0142a. Czy chcesz przywr\xf3ci\u0107 ostatni\u0105 map\u0119?",unsave_map_alert_chargeroffset:"Mapa mog\u0142a si\u0119 zmieni\u0107. Czy chcesz przywr\xf3ci\u0107 ostatni\u0105 map\u0119?",donot_disturb_same_time_warning:"Czasy rozpocz\u0119cia i zako\u0144czenia s\u0105 takie same. Dostosuj je.",add_supplement_area_buttontitle:"Dodaj obszar",goto_supplememt_cleanarea_title:"Przeprowad\u017a czyszczenie uzupe\u0142niaj\u0105ce",home_page_pearl_supplies_strainer_upgrade_tip:"Taca czyszcz\u0105ca nie by\u0142a czyszczona od d\u0142u\u017cszego czasu. Wyczy\u015b\u0107 j\u0105.",pearl_slow_mop_guide_title:"Intensywne mopowanie rog\xf3w",pearl_slow_mop_guide_detail:"Robot porusza si\u0119 wzd\u0142u\u017c \u015bcie\u017cki w kszta\u0142cie \u0142uku przy zredukowanej szybko\u015bci, obracaj\u0105c si\u0119 w celu poprawy usuwania uporczywych plam. Tryb jest odpowiedni do powierzchni po zako\u0144czonym zamiataniu.",floor_map_name_no_emoji:"Nazwa nie mo\u017ce zawiera\u0107 emotikon.",smart_scene_sort:"Sortowanie",supplement_zone_hint_view_title:"Przeprowad\u017a czyszczenie uzupe\u0142niaj\u0105ce wybranego obszaru",supplement_zone_hint_view_desc:"Kontynuuj obecne zadanie czyszczenia po czyszczeniu uzupe\u0142niaj\u0105cym ",skip_current_area_alert_tip:"Czy chcesz pomin\u0105\u0107 obecny obszar i przej\u015b\u0107 do nast\u0119pnego obszaru? \n* Tym razem pomi\u0144 obecny obszar.",corner_clean_switch_title:"Mopowanie rog\xf3w o du\u017cej intensywno\u015bci",corner_clean_switch_desc:"Robot zako\u0144czy podlegaj\u0105cy pojedynczemu u\u017cyciu tryb G\u0142\u0119bokiego czyszczenia w rogach.",cannot_cornerclean_withfastclean_toast:"Robot nie sprz\u0105ta granic w trybie Szybkim, a Intensywne mopowanie rog\xf3w nie mo\u017ce by\u0107 u\u017cywane.",switchfastroute_withcornerclean_toast:"Wy\u0142\u0105cz Intensywne mopowanie rog\xf3w przed u\u017cyciem trybu Szybkiego sprz\u0105tania. ",sub_cleanstatus_supplement_clean:"Czyszczenie uzupe\u0142niaj\u0105ce",sub_cleanstatus_dirtyrepeat_clean:"Ponowne mopowanie",toast_supplementclean_status_notready:"Czyszczenie uzupe\u0142niaj\u0105ce nie jest teraz obs\u0142ugiwane",toast_supplementclean_finish:"Czyszczenie uzupe\u0142niaj\u0105ce zosta\u0142o zako\u0144czone. Wzn\xf3w czyszczenie innych obszar\xf3w.",toast_supplementclean_notreach:"Nie mo\u017cna dotrze\u0107 do obszaru przeznaczonego do czyszczenia uzupe\u0142niaj\u0105cego ",toast_supplementclean_partly_notreach:"Nie mo\u017cna dotrze\u0107 do cz\u0119\u015bci obszaru przeznaczonego do czyszczenia uzupe\u0142niaj\u0105cego ",alert_new_supplementcleantask_willoverride_oldtask:"Po rozpocz\u0119ciu czyszczenia uzupe\u0142niaj\u0105cego obecnie ustawione zadanie czyszczenia uzupe\u0142niaj\u0105cego zostanie zako\u0144czone.",home_specialtip_for_maxplus_clean:"Max+ | Jednokrotne u\u017cycie",charging_resume_clean_page_title:"Do\u0142adowanie i wznowienie",reminder_second_page_check:"Rozumiem",reminder_second_page_stop_task:"Zako\u0144cz bie\u017c\u0105ce zadanie",mode_panel_cleancount_title:"Licznik czyszczenia",clean_count_times:"${count} raz(y)",mode_setting_panel_cleanmop_tip:"Dzienne odkurzanie i mopowanie",mode_setting_panel_pureclean_tip:"Tylko odkurzanie, jeden raz",mode_setting_panel_puremop_tip:"Tylko mopowanie, jeden raz",cleanmode_maxplus_footnote:"Du\u017cy pob\xf3r energii, skr\xf3cona \u017cywotno\u015b\u0107 akumulatora.",charging_dialog_title:"W\u0142\u0105cz zdalny podgl\u0105d tylko wtedy, gdy robot jest \u0142adowany.",setting_realtime_video_switch_detail:"Po w\u0142\u0105czeniu mo\u017cesz sprawdza\u0107 sw\xf3j dom w czasie rzeczywistym.",real_time_video_call_volume_title_text:"G\u0142o\u015bno\u015b\u0107 po\u0142\u0105czenia",real_time_video_call_volume_subtitle_text:"Dostosuj g\u0142o\u015bnik robota pod wzgl\u0119dem poziomu g\u0142o\u015bno\u015bci w\xa0trakcie po\u0142\u0105czenia",real_time_video_waiting_dialog_before_top_title:"Oczekuje na aktywacj\u0119\u2026",recommend_global_hint:"G\u0142\u0119bokie czyszczenie. Odpowiednie w\xa0przypadku dok\u0142adnego czyszczenia w weekendy.",recommend_dining_area_hint:"Czyszczenie kuchni i\xa0jadalni. Odpowiednie do sprz\u0105tania po jedzeniu.",recommend_clean_then_mop_hint:"Powoduje jednorazowe przeprowadzenie pe\u0142nego odkurzania i\xa0pe\u0142nego mopowania z\xa0my\u015bl\u0105 o\xa0wy\u017cszym poziomie higieny.",setting_carpet_first_switch_desc_nocarpet:"Na obecnej mapie brak dywanu, przejd\u017a do cz\u0119\u015bci Edytuj powierzchni\u0119, aby ustawi\u0107 dywan.",setting_ground_clean_setting:"Ustawienia sprz\u0105tania pod\u0142\xf3g",setting_ground_clean_setting_title:"Edytuj powierzchni\u0119",setting_ground_clean_setting_detail:"Popraw materia\u0142 pod\u0142ogi, aby oczyszczanie by\u0142o skuteczniejsze.",setting_ground_dirty_replenish_title:"Automatyczne ponowne mopowanie",setting_ground_dirty_replenish_detail:"Kiedy brudny obszar zostanie wykryty w trakcie mopowania, robot powr\xf3ci do stacji dokuj\u0105cej w celu umycia mopa i nast\u0119pnie przeprowadzi podw\xf3jne mopowanie.",toast_start_goto_supplementzone:"Rozpocznij zmierzanie w kierunku obszaru czyszczenia uzupe\u0142niaj\u0105cego",toast_will_leave_skipped_area:"Natychmiast opu\u015b\u0107 obecny obszar",wash_towel_mode_title_5:"Inteligentne",wash_towel_mode_des_5:"Automatycznie dostosuj ilo\u015b\u0107 wody oraz czas trwania mycia mopa na podstawie poziomu brudu.",home_bottom_menu_command_tab:"Przep\u0142yw pracy",avoid_collision_mode_title_close:"Brak",avoid_collision_mode_des_close:"Wyczy\u015b\u0107 rogi w ca\u0142ym pomieszczeniu. W razie natrafienia na meble, nogi sto\u0142u lub krzese\u0142 robot zwolni, dotknie rogu, a nast\u0119pnie skr\u0119ci, aby zadba\u0107 o wyczyszczenie rog\xf3w.",avoid_collision_mode_title_normal:"Standard",avoid_collision_mode_des_normal:"Unikaj bezpo\u015brednich kolizji z meblami w takim stopniu, jak to mo\u017cliwe. Mog\u0105 si\u0119 zdarzy\u0107 drobne zderzenia z nogami sto\u0142\xf3w, krzese\u0142 oraz \u0142\xf3\u017cek i pomini\u0119cia w\u0105skich przestrzeni.",avoid_collision_mode_title_sensitive:"Du\u017cy",avoid_collision_mode_des_sensitive:"Staraj si\u0119 unika\u0107 kolizji z meblami, sto\u0142ami, krzes\u0142ami oraz nogami \u0142\xf3\u017cek, co mo\u017ce spowodowa\u0107 pomini\u0119cie skanowania obszar\xf3w wok\xf3\u0142 sto\u0142\xf3w i krzese\u0142 oraz n\xf3g sto\u0142\xf3w i krzese\u0142.",map_edit_zone_tag_entryway:"Hol",ground_material_clean_direction_warn:"Aby ta funkcja dzia\u0142a\u0142a, okre\u015bl kierunek pod\u0142ogi. Przejd\u017a do cz\u0119\u015bci Edytuj powierzchni\u0119, aby okre\u015bli\u0107 ustawienia.",localization_strings_setting_voice_tone:"J\u0119zyk",localization_strings_setting_voice_record:"Historia czatu",localization_strings_setting_voice_assistant:"Asystent g\u0142osowy",localization_strings_setting_voice_skill:"Asystent g\u0142osowy",localization_strings_setting_voice_assistant_switch:"Po w\u0142\u0105czeniu robot mo\u017ce rozpoznawa\u0107 komendy g\u0142osowe oraz przeprowadza\u0107 odpowiadaj\u0105ce im akcje.",whether_to_delete_all_the_recorded:"Zgoda na usuni\u0119cie wszystkich nagra\u0144",add_smart_command:"Dodaj Przep\u0142ywy pracy",powerful_clean:"Intensywne zamiatanie",slow_mop:"G\u0142\u0119bokie+",recommend_deep_clean_hint:"G\u0142\u0119bokie czyszczenie. Odpowiednie w\xa0przypadku dok\u0142adnego czyszczenia w weekendy.",recommend_powerful_clean:"Intensywne odkurzanie, kt\xf3re pozwala wyczy\u015bci\u0107 pod\u0142og\u0119 bez mopowania.",recommend_slow_mop:"Dok\u0142adne czyszc