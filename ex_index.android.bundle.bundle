0639\u0627\u062a \u0627\u0644\u0630\u0631\u0648\u0629. \u0633\u064a\u062a\u0645 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u0627\u0644\u0637\u0627\u0642\u0629 \u0641\u064a \u0623\u0648\u0642\u0627\u062a \u0623\u062e\u0631\u0649.",robot_status_wait_charge3:"\u0645\u0644\u0627\u062d\u0638\u0629:\xa0\u064a\u0641\u0636\u0644 \u0627\u0644\u0634\u062d\u0646 \u0641\u064a \u063a\u064a\u0631 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0630\u0631\u0648\u0629",robot_status_wait_charge4:"1. \u0642\u062f \u064a\u0644\u0632\u0645 \u0627\u0644\u0634\u062d\u0646 \u062e\u0644\u0627\u0644 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0630\u0631\u0648\u0629 \u0644\u0625\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0641.",robot_status_wait_charge5:"2. \u0633\u064a\u062a\u0645 \u0627\u0644\u0634\u062d\u0646 \u0641\u064a \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0630\u0631\u0648\u0629 \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u0627\u0644\u0637\u0627\u0642\u0629.",robot_status_wait_charge6:"* \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0641\u062a\u0631\u0629 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0623\u0637\u0648\u0644 \u0645\u0646 6 \u0633\u0627\u0639\u0627\u062a.",home_special_tip_for_wait_charge:"\u062a\u0648\u0642\u0641 \u0627\u0644\u0634\u062d\u0646 \u0645\u0624\u0642\u062a\u064b\u0627 \u062e\u0644\u0627\u0644 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0630\u0631\u0648\u0629.",voice_chat_alert:"\u0633\u064a\u0624\u062f\u064a \u0628\u062f\u0621 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629 \u0625\u0644\u0649 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0645\u0624\u0642\u062a\u064b\u0627. \u0633\u064a\u062a\u0645 \u0627\u0644\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0628\u0639\u062f \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629.",home_special_tip_for_charger_offset:"\u062a\u0645 \u0646\u0642\u0644 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0648\u0644\u0643\u0646 \u0644\u0645 \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u062e\u0631\u064a\u0637\u0629.\xa0\u0627\u0646\u0642\u0631 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644.",choose_map_hint_old_map:"\u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629",dock_kit_setting1:"\u0633\u0627\u0639\u0629 \u0648\u0627\u062d\u062f\u0629",dock_kit_setting2:"\u0633\u0627\u0639\u062a\u0627\u0646",dock_kit_setting3:"\u062b\u0644\u0627\u062b \u0633\u0627\u0639\u0627\u062a",dock_kit_setting4:"\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u062c\u0641\u064a\u0641",dock_kit_setting5:"\u0627\u0644\u062a\u062c\u0641\u064a\u0641 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a",dock_kit_setting6:"\u0627\u0644\u0645\u062f\u0629",dock_kit_setting9:"\u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062a\u062c\u0641\u064a\u0641",home_special_tip_for_new_map:"\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u062e\u0631\u064a\u0637\u0629 \u063a\u064a\u0631 \u0645\u062d\u0641\u0648\u0638\u0629. \u0627\u0646\u0642\u0631 \u0644\u0644\u0645\u0631\u0627\u062c\u0639\u0629.",backup_map:"\u0646\u0633\u062e \u0627\u062d\u062a\u064a\u0627\u0637\u064a",recover_map:"\u0627\u0633\u062a\u0639\u0627\u062f\u0629",delete_map_hint_title:"\u0647\u0644 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \u0627\u0644\u062e\u0631\u064a\u0637\u0629\u061f",map_edit_delete:"\u062d\u0630\u0641",backup_success_hint:"\u062a\u0645 \u0646\u0633\u062e \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u064b\u0627 \u0625\u0644\u0649 \u0627\u0644\u0631\u0648\u0628\u0648\u062a. \u0627\u0633\u062a\u062e\u062f\u0645 \u0648\u0638\u064a\u0641\u0629 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u062e\u0631\u064a\u0637\u062a\u0643.",privacy_access_failure:"\u0641\u0634\u0644 \u062a\u062d\u0645\u064a\u0644 \u0627\u062a\u0641\u0627\u0642\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645. \u0642\u0645 \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0643\u0648\u0646 \u0627\u0644\u0625\u0636\u0627\u0641\u064a \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",dock_kit_setting11:"\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0648\u062d\u062f\u0629 \u0627\u0644\u0645\u062c\u0641\u0641",dock_kit_setting12:"1. \u0648\u062d\u062f\u0629 \u0627\u0644\u0645\u062c\u0641\u0641 \u062a\u064f\u0628\u0627\u0639 \u0628\u0634\u0643\u0644 \u0645\u0646\u0641\u0635\u0644. \n2. \u0633\u064a\u0642\u0648\u0645 \u0627\u0644\u0631\u0648\u0628\u0648\u062a \u0628\u0627\u0644\u062a\u062c\u0641\u064a\u0641 \u062d\u0633\u0628 \u0627\u0644\u0636\u0631\u0648\u0631\u0629 \u0628\u0639\u062f \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0628\u0627\u0644\u0645\u0645\u0633\u062d\u0629. \u064a\u0645\u0643\u0646 \u0623\u064a\u0636\u064b\u0627 \u0628\u062f\u0621 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062c\u0641\u064a\u0641 \u064a\u062f\u0648\u064a\u064b\u0627.",dock_kit_setting14:"\u062a\u0645 \u0627\u0644\u0634\u0631\u0627\u0621",supplies_floor_cleaning_fluid:"\u0645\u062d\u0644\u0648\u0644 \u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0623\u0631\u0636\u064a\u0627\u062a",supplies_floor_cleaning_fluid1:"\u064a\u0645\u0643\u0646 \u0644\u0645\u062d\u0644\u0648\u0644 \u0627\u0644\u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0645\u064f\u0635\u0645\u0645 \u062e\u0635\u064a\u0635\u064b\u0627 \u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0645\u0645\u0633\u062d\u0629 \u0628\u0639\u0645\u0642 \u0648\u0625\u0632\u0627\u0644\u0629 \