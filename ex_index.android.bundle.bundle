__d(function(e,a,o,i,t,r,n){t.exports={recover_map_hint:"Cuando se restaura un mapa de la copia de seguridad, se deben volver a crear todas las rutinas y programas relacionados.",invalid_task_detected_hint:"Existen una o varias tareas inv\xe1lidas.",map_edit_ground_material_title:"Editar superficie",map_edit_split_restriction_point_adjust:"Ajuste la l\xednea divisoria hasta que aparezca una l\xednea s\xf3lida",home_new_control_start_wash:"Fregona de lavado",home_new_control_back_charge:"Base",home_new_control_dock_unfold_title:"Base",terminate_current_task_then_wash:"Fregona de lavado",smart_custom_order_guide_tip_text:"Ajusta autom\xe1ticamente la secuencia de limpieza de habitaciones seg\xfan los tipos de habitaci\xf3n.",smart_custom_mode_guide_tip_text:"Establece autom\xe1ticamente un modo de limpieza seg\xfan los tipos de piso y habitaci\xf3n.",tanos_s_mop_mode_info2:"En el modo Profunda+, el robot se mover\xe1 m\xe1s lentamente y har\xe1 menos ruido.",video_error116_resolve:"No se puede acceder a la visualizaci\xf3n remota. Vaciado en curso.",map_element_furnitures:"Muebles",map_element_custom_props:"Personalizar",map_element_room_props:"N. hab.",map_element_switcher_title:"Detalles de mapa",default_room_name:"Habitaci\xf3n",mop_method_careful_slow:"Profunda+",realtime_video_sub_title_3_6:"Las alertas de voz sonar\xe1n cada 15 segundos durante Visualizaci\xf3n remota.",realtime_video_sub_title_3_5:"Las alertas de voz sonar\xe1n al ingresar y salir de Visualizaci\xf3n remota.",egg_page_attack_title:"Buscar",egg_page_stop_button_title:"Detener",start_egg_attack_with_other_task_tip:"Si se ejecuta esta acci\xf3n se finalizar\xe1 la limpieza actual. ",egg_page_title:"Modo Cupido",defender_mode_introduction:"Presentamos el modo Cupido, donde su Roborock puede expresar sus verdaderos sentimientos hacia otras aspiradoras robot. No discrimina por marca o color. Cuando su S7 MaxV ve a otro robot, expresar\xe1 su amor con un tierno beso.\n\nADVERTENCIA: Roborock no se hace responsable de ninguna aspiradora robot beb\xe9 o rebeli\xf3n de las m\xe1quinas.",egg_attack_start_title:"Iniciar",armap_match_failed:"Mapa coincidente",armap_match_success:"Coincidencia fallida",armap_delete_confirm:"\xbfEst\xe1 seguro de que desea eliminar el mapa de Matrix?",armap_scan_save_mesh_failed_toast:"Error al guardar",armap_scan_stop_confirm:"\xbfDetener mapeo de Matrix?",monitor_voice_privacy_dialog_title:"Pol\xedtica de privacidad de videollamadas",camera_monitor_voice_privacy_title:"Pol\xedtica de privacidad de videollamadas ",armap_guide_title3:"3. Finalice el escaneo y el mapeo, luego, espere la coincidencia.",armap_guide_title2:"2. Mu\xe9vase por la habitaci\xf3n y aseg\xfarese de escanear todas las paredes, pisos y esquinas.",armap_guide_title1:"1. Haga un escaneo de Matrix del mapa actual.",armap_guide_title:"Gu\xeda de usuario de mapeo de Matrix",armap_privacy_dialog_title1:"Una vez que se utiliza, el modelo 3D se almacenar\xe1 en el tel\xe9fono para el mapeo de Matrix. Consulte la ",armap_privacy_dialog_title:"Pol\xedtica de privacidad para Matrix Mapping",smart_scene_clean_mode_setting_item_title:"Modo de limpieza",main_control_pause_quick_build_map:"Pausa",main_control_resume_quick_build_map:"Mapeando",go_update:"Actualizar",clean_mode_max_plus:"MAX+",go_to_settings:"Ir al set",quick_create_map_alert_title:"No se puede realizar un mapeo r\xe1pido en el modo de evitaci\xf3n de alfombras",led_alert_detail:"Los resultados de reconocimiento de objetos se ver\xe1n afectados cuando la luz de relleno se apague.",tap_charge_when_quick_building_map_tip:"Mapeo incompleto. El mapa no ser\xe1 guardado.",robot_status_quick_building_map:"Mapeando",map_edit_mode_smart_tip_detail:"Primero establezca el tipo de habitaci\xf3n. Pulse \"Aceptar\" para ir a Ajustes.",map_edit_order_smart_tip:"Establece autom\xe1ticamente la secuencia de limpieza de habitaciones seg\xfan los tipos de habitaci\xf3n.",multi_map_start_build_text_4:"4. El robot no evita alfombras p