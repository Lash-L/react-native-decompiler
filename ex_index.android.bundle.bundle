0437\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u0443 \u0437\u043e\u043d\u0443, \u0449\u043e\u0431 \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u0439\u043e\u0433\u043e \u043e\u0431\u2019\u0457\u0436\u0434\u0436\u0430\u0432.\n*\xa0\u042f\u043a\u0449\u043e \u0432\u0438 \u043d\u0435 \u0445\u043e\u0447\u0435\u0442\u0435 \u0446\u044c\u043e\u0433\u043e \u0440\u043e\u0431\u0438\u0442\u0438, \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \xab\u0406\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u0442\u0438\xbb.",map_edit_cliff_zone_title:"\u0417\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u0430 \u0437\u043e\u043d\u0430 \u0437 \u043f\u0435\u0440\u0435\u043f\u0430\u0434\u043e\u043c \u0432\u0438\u0441\u043e\u0442\u0438",map_edit_cliff_zone_detail:"\u0423 \u0446\u044c\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e \u0432\u0438\u044f\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u043f\u0435\u0440\u0435\u043f\u0430\u0434 \u0432\u0438\u0441\u043e\u0442\u0438. \u0417\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u0443 \u0437\u043e\u043d\u0443 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e. \u041f\u043e\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u043f\u0430\u0434\u0443 \u0432\u0438\u0441\u043e\u0442\u0438 \u044f\u043a \u0437\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u043e\u0457 \u0437\u043e\u043d\u0438 \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u0440\u043e\u0431\u043e\u0442\u0443-\u043f\u0438\u043b\u043e\u0441\u043e\u0441\u0443 \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0448\u0435.\n*\xa0\u042f\u043a\u0449\u043e \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043f\u0430\u0434\u0456\u043d\u043d\u044f \u0440\u043e\u0431\u043e\u0442\u0430-\u043f\u0438\u043b\u043e\u0441\u043e\u0441\u0430 \u0432 \u0446\u044c\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u043d\u0435\u043c\u0430\u0454, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u043e\u0456\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u0442\u0438 \u0446\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f.\n*\xa0\u042f\u043a\u0449\u043e \u0440\u043e\u0437\u043c\u0456\u0440 \u0456 \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u043e\u0457 \u0437\u043e\u043d\u0438 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456, \u0432\u0438\u043f\u0440\u0430\u0432\u0442\u0435 \u0457\u0445 \u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431.",setting_carpet_deep_clean_switch_title:"\u0420\u0435\u0442\u0435\u043b\u044c\u043d\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u0438\u043b\u0438\u043c\u0456\u0432",setting_carpet_deep_clean_switch_desc:"\u041f\u0456\u0441\u043b\u044f \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u0456\u043c\u043d\u0430\u0442\u0438 \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u043e\u043a\u0440\u0435\u043c\u043e \u043f\u0440\u0438\u0431\u0435\u0440\u0435 \u043a\u0438\u043b\u0438\u043c\u0438 \u0432 \u043a\u043e\u0436\u043d\u0456\u0439 \u043a\u0456\u043c\u043d\u0430\u0442\u0456. \n*\xa0\u0417\u0430 \u0432\u0438\u043d\u044f\u0442\u043a\u043e\u043c \u0434\u0432\u0435\u0440\u043d\u0438\u0445 \u043a\u0438\u043b\u0438\u043c\u043a\u0456\u0432.",map_ai_zone_bubble_set:"\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f, \u0449\u043e\u0431 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0434\u0456\u043b\u044f\u043d\u043a\u0443 \u0437\u0430\u0441\u0442\u0440\u044f\u0433\u0430\u043d\u043d\u044f",map_ai_zone_bubble_adjust:"\u0422\u043e\u0440\u043a\u043d\u0456\u0442\u044c\u0441\u044f, \u0449\u043e\u0431 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u0443 \u0437\u043e\u043d\u0443",warning_for_will_delete_wifi:"\u041f\u0456\u0441\u043b\u044f \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u0437\u0443\u043f\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0454 \u0437\u2019\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0456\u0437 \u0446\u0456\u0454\u044e \u0442\u043e\u0447\u043a\u043e\u044e WiFi.",wifi_page_current_wifi:"\u041f\u043e\u0442\u043e\u0447\u043d\u0435 WiFi-\u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f",wifi_page_others_wifi:"\u0406\u043d\u0448\u0456 WiFi-\u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f",wifi_page_title:"WiFi",map_edit_floor_wood_width:"\u041f\u0456\u0434\u043b\u043e\u0433\u0430 (\u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e)",map_edit_floor_wood_longti:"\u041f\u0456\u0434\u043b\u043e\u0433\u0430 (\u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e)",ground_material_clean_direction_title:"\u041f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u0432 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u0448\u0432\u0456\u0432 \u043f\u0456\u0434\u043b\u043e\u0433\u0438",ground_material_clean_direction_detail:"\u0423 \u0440\u0435\u0436\u0438\u043c\u0430\u0445 \xab\u041f\u043e\u0432\u043d\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f\xbb \u0430\u0431\u043e \xab\u0412\u0438\u0431\u0456\u0440\u043a\u043e\u0432\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u0456\u043c\u043d\u0430\u0442\xbb \u0440\u043e\u0431\u043e\u0442 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438\u043c\u0435 \u0432 \u0446\u044c\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u0434\u043b\u044f \u0437\u0430\u043f\u043e\u0431\u0456\u0433\u0430\u043d\u043d\u044f \u043f\u043e\u0434\u0440\u044f\u043f\u0438\u043d\u0430\u043c \u0443 \u043c\u0456\u0441\u0446\u044f\u0445 \u0448\u0432\u0456\u0432 \u043f\u0456\u0434\u043b\u043e\u0433\u043e\u0432\u043e\u0433\u043e \u043f\u043e\u043a\u0440\u0438\u0442\u0442\u044f.\r\n*\xa0\u0414\u043b\u044f \u0443\u043c\u043e\u0436\u043b\u0438\u0432\u043b\u0435\u043d\u043d\u044f \u0446\u0456\u0454\u0457 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0432\u043a\u0430\u0436\u0456\u0442\u044c \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b \u043f\u0456\u0434\u043b\u043e\u0433\u0438. \u0420\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u043c\u043e\u0436\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u043b\u0438\u0448\u0435 \u0432 \u043e\u0434\u043d\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443.",map_edit_door_sill_exceed_limit:"\u0414\u043e\u0441\u044f\u0433\u043d\u0443\u0442\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0457 \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u043f\u043e\u0440\u043e\u0433\u0456\u0432.",map_cliff_zone_guide_text:"\u0423 \u0446\u044c\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0435\u0440\u0435\u043f\u0430\u0434 \u0432\u0438\u0441\u043e\u0442. \u0417\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u0443 \u0437\u043e\u043d\u0443 \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e.",map_stuck_point_guide_text:"\u0423 \u0446\u044c\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u0440\u043e\u0431\u043e\u0442-\u043f\u0438\u043b\u043e\u0441\u043e\u0441 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u0437\u0430\u0441\u0442\u0440\u044f\u0433\u0430\u0454. \u041f\u0440\u0438\u0437\u043d\u0430\u0447\u0442\u0435 \u0437\u0430\u0431\u043e\u0440\