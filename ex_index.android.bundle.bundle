456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u0438\u0441\u044f \u043d\u0435 \u0437\u043e\u0432\u0441\u0456\u043c \u0442\u043e\u0447\u043d\u0435 \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u043e\u0431\u043e\u0442\u0430.",optical_flow_sensor_error_title:"\u041e\u043f\u0442\u0438\u0447\u043d\u0438\u0439 \u0434\u0430\u0442\u0447\u0438\u043a \u043f\u043e\u0442\u043e\u043a\u0443 \u0437\u0430\u0431\u0440\u0443\u0434\u043d\u0435\u043d\u043e.",optical_flow_sensor_error_subtitle:"\u041f\u0440\u043e\u0442\u0440\u0456\u0442\u044c \u0434\u0430\u0442\u0447\u0438\u043a \u0441\u0443\u0445\u043e\u044e \u0442\u043a\u0430\u043d\u0438\u043d\u043e\u044e \u0442\u0430 \u043f\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u0440\u043e\u0431\u043e\u0442\u0430.",optical_flow_sensor_error_description:"\u041f\u0440\u043e\u0442\u0440\u0456\u0442\u044c \u0434\u0430\u0442\u0447\u0438\u043a \u0441\u0443\u0445\u043e\u044e \u0442\u043a\u0430\u043d\u0438\u043d\u043e\u044e \u0442\u0430 \u043f\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u0440\u043e\u0431\u043e\u0442\u0430.",electron_hatch_off_error_title:"\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0437\u0430\u043a\u0440\u0438\u0442\u0438 \u043a\u0440\u0438\u0448\u043a\u0443 \u043d\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u0456.",electron_hatch_off_error_subtitle:"\u041e\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043a\u0440\u0438\u0448\u043a\u0443 \u0439 \u0437\u0430\u043a\u0440\u0438\u0439\u0442\u0435 \u0457\u0457 \u0432\u0440\u0443\u0447\u043d\u0443.",electron_hatch_off_error_description:"\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0437\u0430\u043a\u0440\u0438\u0442\u0438 \u043a\u0440\u0438\u0448\u043a\u0443 \u043d\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u0456. \u041c\u043e\u0436\u043b\u0438\u0432\u043e, \u0432\u043e\u043d\u0430 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0430. \u0423\u0441\u0443\u043d\u044c\u0442\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0439 \u0437\u0430\u043a\u0440\u0438\u0439\u0442\u0435 \u043a\u0440\u0438\u0448\u043a\u0443 \u0432\u0440\u0443\u0447\u043d\u0443.",electron_hatch_on_error_title:"\u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u043a\u0440\u0438\u0448\u043a\u0443 \u043d\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u0456.",electron_hatch_on_error_subtitle:"\u041e\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043a\u0440\u0438\u0448\u043a\u0443 \u0439 \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0457\u0457 \u0432\u0440\u0443\u0447\u043d\u0443.",electron_hatch_on_error_description:"\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u043a\u0440\u0438\u0448\u043a\u0443 \u043d\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043f\u0440\u0438\u0432\u043e\u0434\u0456. \u041c\u043e\u0436\u043b\u0438\u0432\u043e, \u0432\u043e\u043d\u0430 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0430. \u0423\u0441\u0443\u043d\u044c\u0442\u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0439 \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u043a\u0440\u0438\u0448\u043a\u0443 \u0432\u0440\u0443\u0447\u043d\u0443.",dock_selfclean_clean_title:"C\u0430\u043c\u043e\u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0432 \u0431\u0430\u0437\u043e\u0432\u0456\u0439 \u0441\u0442\u0430\u043d\u0446\u0456\u0457",dock_selfclean_clean_desc:"\u041f\u0440\u043e\u043c\u0438\u0432\u0430\u0454 \u043b\u043e\u0442\u043e\u043a \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438, \u0432\u0438\u043a\u043e\u043d\u0443\u0454 \u0441\u0430\u043c\u043e\u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430.",dock_selfclean_drain_title:"\u0417\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0439 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f",dock_selfclean_drain_desc:"\u0417\u043b\u0438\u0432\u0430\u0454 \u0437\u0430\u043b\u0438\u0448\u043a\u0438 \u0432\u043e\u0434\u0438 \u0437 \u043b\u043e\u0442\u043a\u0430 \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0439 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u0431\u0430\u043a\u0430 \u0434\u043b\u044f \u0431\u0440\u0443\u0434\u043d\u043e\u0457 \u0432\u043e\u0434\u0438.",dock_setting_clean_carousel_selfcleaning_desc:"\u0421\u0430\u043c\u043e\u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f. \u0426\u0435 \u0437\u0430\u0439\u043c\u0435 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e 3\xa0\u0445\u0432\u0438\u043b\u0438\u043d\u0438.",dock_setting_clean_carousel_startselfclean_desc:"\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u043f\u0456\u0434\u0434\u043e\u043d\u0430 \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0431\u0430\u0437\u043e\u0432\u043e\u0457 \u0441\u0442\u0430\u043d\u0446\u0456\u0457 \u0434\u043b\u044f \u0443\u0441\u0443\u043d\u0435\u043d\u043d\u044f \u0431\u0440\u0443\u0434\u0443.",dock_setting_clean_carousel_selfclean_title:"\u0421\u0430\u043c\u043e\u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u043f\u0456\u0434\u0434\u043e\u043d\u0430 \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438",start_cleancarousel_selfclean:"\u0420\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0441\u0430\u043c\u043e\u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f",stop_cleancarousel_selfclean:"\u0417\u0443\u043f\u0438\u043d\u0438\u0442\u0438 \u0441\u0430\u043c\u043e\u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f",clean_smart_animation_text1:"\u041f\u0435\u0440\u0435\u0445\u0456\u0434 \u0443 \u0440\u0435\u0436\u0438\u043c SmartPlan",clean_smart_animation_text2:"\u041a\u043e\u0440\u0438\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0436\u0438\u043c\u0443 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f",clean_smart_animation_text3:"\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f",setting_page_matter_title:"\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0438 \u0434\u043e \u043c\u0435\u0440\u0435\u0436\u0456 Matter",carpet_clean_mode_setting_global_settip:"\u0426\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435 \u0431\u0443\u0434\u0435 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u0438\u043b\u0438\u043c\u0430, \u0434\u043b\u044f \u044f\u043a\u043e\u0433\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f.",tap_zone_clean_button_without_map_tip:"\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043a\u0430\u0440\u0442\u0443, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0434\u043e\u0434\u0430\u0442\u0438 \u0437\u043e\u043d\u0443.",error_57_title:"\u0429\u0456\u0442\u043a\u0430 \u0434\u043b\u044f \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0432 \u043f\u0456\u0434\u0434\u043e\u043d\u0456 \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0430",error_57_desc:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435, \u0447\u0438 \u043d\u0435 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e \u0449\u0456\u0442\u043a\u0443 \u0434\u043b\u044f \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u0432 \u043f\u0456\u0434\u0434\u043e\u043d\u0456 \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438.",error_57_detail:"\u0417\u043d\u0456\u043c\u0456\u0442\u044c \u0439 \u043e\u0447\u0438\u0441\u0442\u0456\u0442\u044c \u043f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438. \u041f\u043e\u0442\u0456\u043c \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u043d\u0430\u0432\u043a\u043e\u043b\u043e \u0449\u0456\u0442\u043a\u0438 \u0434\u043b\u044f \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u043d\u0435\u043c\u0430\u0454 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456\u0445 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0456\u0432, \u044f\u043a\u0456 \u0431\u043b\u043e\u043a\u0443\u044e\u0442\u044c \u0448\u0432\u0430\u0431\u0440\u0443. \u0417\u0430 \u043d\u0430\u044f\u0432\u043d\u043e\u0441\u0442\u0456 \u0443\u0441\u0443\u043d\u044c\u0442\u0435 \u0457\u0445.",setting_optimize_batter_detail:"\u041f\u0456\u0441\u043b\u044f \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u0457 \u0440\u0456\u0432\u0435\u043d\u044c \u0437\u0430\u0440\u044f\u0434\u0443 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430 \u0431\u0443\u0434\u0435 \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u0442\u043e\u0447\u043d\u0456\u0448\u0435. \u0427\u0430\u0441 \u0440\u043e\u0431\u043e\u0442\u0438 \u043c\u043e\u0436\u0435 \u0441\u043a\u043e\u0440\u043e\u0442\u0438\u0442\u0438\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0446\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f.",setting_optimize_batter_title:"\u0421\u043a\u043e\u0440\u0438\u0433\u043e\u0432\u0430\u043d\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c \u0437\u0430\u0440\u044f\u0434\u0443 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0430",map_edit_eraser:"\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438",map_edit_eraser_add:"\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f",ground_clean_direct_plus:"\u0421\u0445\u0435\u043c\u0430 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f",ground_clean_direct_plus_tip:"\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u043f\u043e\u0442\u043e\u0447\u043d\u0443 \u0441\u0445\u0435\u043c\u0443, \u0437\u0430 \u044f\u043a\u043e\u044e \u0440\u043e\u0431\u043e\u0442 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0454 \u043a\u043e\u0436\u043d\u0443 \u043a\u0456\u043c\u043d\u0430\u0442\u0443.",ground_clean_direct_plus_long:"\u0406\u043d\u0442\u0435\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c ",ground_clean_direct_plus_long_tip:"\u0423 \u0440\u0435\u0436\u0438\u043c\u0456 \u043f\u043e\u0432\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u0447\u0438 \u0432\u0438\u0431\u0456\u0440\u043a\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u0456\u043c\u043d\u0430\u0442 \u0440\u043e\u0431\u043e\u0442 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438\u043c\u0435 \u043f\u0456\u0434\u043b\u043e\u0433\u0443 \u0432\u0437\u0434\u043e\u0432\u0436 \u0432\u0456\u0434\u043d\u043e\u0441\u043d\u043e \u0434\u043e\u0432\u0448\u043e\u0433\u043e \u0431\u043e\u043a\u0443 \u043a\u043e\u0436\u043d\u043e\u0457 \u043a\u0456\u043c\u043d\u0430\u0442\u0438 \u0434\u043b\u044f \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u0457 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f.",ground_clean_direct_plus_switch:"\u0417\u043c\u0456\u0448\u0430\u043d\u0430 \u0441\u0445\u0435\u043c\u0430 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f",ground_clean_direct_plus_switch_tip:"\u0414\u043b\u044f \u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u044f\u043a\u043e\u0441\u0442\u0456 \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0440\u043e\u0431\u043e\u0442 \u0440\u0443\u0445\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443, \u043f\u0435\u0440\u043f\u0435\u043d\u0434\u0438\u043a\u0443\u043b\u044f\u0440\u043d\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u0433\u043e \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f.\r\n*\xa0\u0422\u0440\u0438\u0432\u0430\u043b\u0456\u0448\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f.",ground_clean_direct_plus_floor:"\u041f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u0432 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u0448\u0432\u0456\u0432 \u043f\u0456\u0434\u043b\u043e\u0433\u0438",ground_clean_direct_plus_floor_tip:"\u0423 \u0440\u0435\u0436\u0438\u043c\u0430\u0445 \xab\u041f\u043e\u0432\u043d\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f\xbb \u0430\u0431\u043e \xab\u0412\u0438\u0431\u0456\u0440\u043a\u043e\u0432\u0435 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u0456\u043c\u043d\u0430\u0442\xbb \u0440\u043e\u0431\u043e\u0442 \u043f\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438\u043c\u0435 \u0432 \u0446\u044c\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443 \u0434\u043b\u044f \u0437\u0430\u043f\u0