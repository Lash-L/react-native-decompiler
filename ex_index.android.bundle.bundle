05da \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e1\u05e4\u05e7 \u05d1\u05d9\u05e6\u05d5\u05e2\u05d9 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d8\u05d5\u05d1\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8.",guide_welcome_slogan:"Innovation for Better Living",guide_preparation_tip_1_title:"\u05d0\u05d9\u05df \u05dc\u05e9\u05d0\u05d5\u05d1 \u05d7\u05e4\u05e6\u05d9\u05dd \u05d7\u05d3\u05d9\u05dd.",guide_preparation_tip_1_desc:"\u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05de\u05e0\u05d5\u05e2 \u05e0\u05d6\u05e7 \u05dc\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d0\u05d5 \u05dc\u05e8\u05e6\u05e4\u05d4.",guide_preparation_tip_2_title:"\u05d0\u05d9\u05df \u05dc\u05e9\u05e4\u05d5\u05da \u05e0\u05d5\u05d6\u05dc\u05d9\u05dd \u05e2\u05dc \u05d4\u05e8\u05e6\u05e4\u05d4.",guide_preparation_tip_3_title:"\u05d0\u05d9\u05df \u05dc\u05e9\u05d8\u05d5\u05e3 \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05e2\u05dd \u05de\u05d9\u05dd.",guide_preparation_tip_4_title:"\u05d9\u05e9 \u05dc\u05e9\u05d0\u05d5\u05d1 \u05d0\u05d1\u05e7 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d8\u05d9\u05e4\u05ea \u05d4\u05e8\u05e6\u05e4\u05d4.",guide_preparation_tip_2_desc:"\u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05de\u05e0\u05d5\u05e2 \u05e0\u05d6\u05e7 \u05dc\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05de\u05d9\u05dd.",guide_preparation_tip_3_desc:"\u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05de\u05e0\u05d5\u05e2 \u05e0\u05d6\u05e7 \u05dc\u05e8\u05d5\u05d1\u05d5\u05d8 \u05d0\u05d5 \u05dc\u05ea\u05d7\u05e0\u05ea \u05d4\u05d8\u05e2\u05d9\u05e0\u05d4 \u05de\u05de\u05d9\u05dd.",guide_preparation_tip_4_desc:"\u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df, \u05d9\u05e9 \u05dc\u05e9\u05d0\u05d5\u05d1 \u05d0\u05ea \u05d4\u05d0\u05d1\u05e7 \u05de\u05d4\u05e8\u05e6\u05e4\u05d5\u05ea \u05e9\u05dc\u05d5\u05e9 \u05e4\u05e2\u05de\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e9\u05d8\u05d9\u05e4\u05d4.",guide_preparation_title:"\u05d9\u05e9 \u05dc\u05d4\u05db\u05d9\u05df \u05d0\u05ea \u05d4\u05d0\u05d6\u05d5\u05e8 \u05dc\u05e0\u05d9\u05e7\u05d5\u05d9.",guide_preparation_desc:"\u05d9\u05e9 \u05dc\u05e1\u05d3\u05e8 \u05d5\u05dc\u05e4\u05ea\u05d5\u05d7 \u05d0\u05ea \u05d4\u05d3\u05dc\u05ea. \u05d4\u05db\u05df \u05d0\u05ea \u05d4\u05d0\u05d6\u05d5\u05e8 \u05dc\u05e0\u05d9\u05e7\u05d5\u05d9.",guide_preparation_more:"\u05d0\u05d6\u05d4\u05e8\u05d4",guide_preparation_alert_title:"\u05d0\u05d6\u05d4\u05e8\u05d4",guide_environment_title:"\u05dc\u05de\u05d3 \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea",guide_silent_mode_title:"\u05de\u05d6\u05e2\u05d5\u05e8 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea",guide_map_save_title:"\u05e9\u05de\u05d5\u05e8 \u05de\u05e4\u05d4",guide_map_save_desc:"\u05dc\u05d0\u05d7\u05e8 \u05d4\u05e4\u05e2\u05dc\u05ea \u05e9\u05de\u05d9\u05e8\u05ea \u05de\u05e4\u05d5\u05ea, \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05d0\u05d6\u05d5\u05e8\u05d9 No-go (\u05d0\u05d9\u05df \u05de\u05e2\u05d1\u05e8), \u05e7\u05d9\u05e8\u05d5\u05ea \u05d1\u05dc\u05ea\u05d9 \u05e0\u05e8\u05d0\u05d9\u05dd \u05d5\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d0\u05d6\u05d5\u05e8 \u05d9\u05d4\u05d9\u05d5 \u05d6\u05de\u05d9\u05e0\u05d5\u05ea.",pet_area_clean:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05dc\u05de\u05d5\u05e6\u05e8\u05d9 \u05d7\u05d9\u05d5\u05ea \u05de\u05d7\u05de\u05d3",recommend_pet_area_clean:"\u05de\u05d1\u05e6\u05e2 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05e1\u05d1\u05d9\u05d1 \u05de\u05d5\u05e6\u05e8\u05d9 \u05d7\u05d9\u05d5\u05ea \u05de\u05d7\u05de\u05d3.",carpet_clean_mode_setting_way_detail:"\u05d9\u05e9 \u05dc\u05e9\u05e0\u05d5\u05ea \u05d0\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e9\u05d8\u05d9\u05d7\u05d9\u05dd.",real_time_setting_two_keys_activation_text_top:"\u05dc\u05d4\u05e4\u05e2\u05dc\u05ea \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05d4\u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7 \u05d9\u05e9 \u05dc\u05dc\u05d7\u05d5\u05e5 \u05e2\u05dc \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e2\u05dc \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8.",real_time_setting_two_keys_activation_text_content:"\u05dc\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea, \u05d9\u05e9 \u05dc\u05dc\u05d7\u05d5\u05e5 \u05e2\u05dc \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05ea\u05d5\u05da \u05d3\u05e7\u05d4. \u05db\u05d0\u05e9\u05e8 \u05e0\u05e9\u05de\u05e2\u05ea \u05d4\u05d5\u05d3\u05e2\u05d4 \u05e7\u05d5\u05dc\u05d9\u05ea, \u05d4\u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7 \u05de\u05d5\u05e4\u05e2\u05dc\u05ea.",real_time_setting_old_three_keys_activation_text_top:"\u05d9\u05e9 \u05dc\u05dc\u05d7\u05d5\u05e5 \u05d1\u05d5-\u05d6\u05de\u05e0\u05d9\u05ea \u05e2\u05dc \u05d4\u05dc\u05d7\u05e6\u05df \"Dock\", \u05e2\u05dc \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05d5\u05d4\u05db\u05e4\u05ea\u05d5\u05e8 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e0\u05e7\u05d5\u05d3\u05ea\u05d9.",real_time_setting_old_three_keys_activation_text_content:"\u05dc\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea, \u05d9\u05e9 \u05dc\u05dc\u05d7\u05d5\u05e5 \u05de\u05de\u05d5\u05e9\u05db\u05d5\u05ea \u05e2\u05dc \u05d4\u05dc\u05d7\u05e6\u05df \"Dock\", \u05e2\u05dc \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05d5\u05d4\u05db\u05e4\u05ea\u05d5\u05e8 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e0\u05e7\u05d5\u05d3\u05ea\u05d9. \u05db\u05d0\u05e9\u05e8 \u05e0\u05e9\u05de\u05e2\u05ea \u05d4\u05d5\u05d3\u05e2\u05d4 \u05e7\u05d5\u05dc\u05d9\u05ea, \u05d4\u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7 \u05de\u05d5\u05e4\u05e2\u05dc\u05ea.",real_time_setting_new_three_keys_activation_text_top:"\u05d9\u05e9 \u05dc\u05dc\u05d7\u05d5\u05e5 \u05de\u05de\u05d5\u05e9\u05db\u05d5\u05ea \u05d1\u05d5-\u05d6\u05de\u05e0\u05d9\u05ea \u05e2\u05dc \u05d4\u05dc\u05d7\u05e6\u05df \"Dock\", \u05e2\u05dc \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05d5\u05d4\u05db\u05e4\u05ea\u05d5\u05e8 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e0\u05e7\u05d5\u05d3\u05ea\u05d9.",real_time_setting_new_three_keys_activation_text_content:"\u05dc\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea, \u05d9\u05e9 \u05dc\u05dc\u05d7\u05d5\u05e5 \u05de\u05de\u05d5\u05e9\u05db\u05d5\u05ea \u05e2\u05dc \u05d4\u05dc\u05d7\u05e6\u05df \"Dock\", \u05e2\u05dc \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05d5\u05d4\u05db\u05e4\u05ea\u05d5\u05e8 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e0\u05e7\u05d5\u05d3\u05ea\u05d9. \u05db\u05d0\u05e9\u05e8 \u05e0\u05e9\u05de\u05e2\u05ea \u05d4\u05d5\u05d3\u05e2\u05d4 \u05e7\u05d5\u05dc\u05d9\u05ea, \u05d4\u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7 \u05de\u05d5\u05e4\u05e2\u05dc\u05ea.",real_time_setting_activation_button_text:"\u05d4\u05e4\u05e2\u05dc \u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7",real_time_setting_activation_page_title:"\u05d4\u05e4\u05e2\u05dc \u05e6\u05e4\u05d9\u05d9\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7",real_time_setting_activation_page_activate_fail_text:"\u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e0\u05db\u05e9\u05dc\u05d4. \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",real_time_setting_activation_page_start:"\u05d4\u05e4\u05e2\u05dc",real_time_setting_activation_page_agree:"\u05e7\u05e8\u05d0\u05ea\u05d9 \u05d5\u05d4\u05e0\u05e0\u05d9 \u05de\u05e1\u05db\u05d9\u05dd/\u05de\u05e1\u05db\u05d9\u05de\u05d4 \u05dc\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea.",map_edit_fb_wall_adjust:"\u05e2\u05e8\u05d5\u05da \u05e7\u05d9\u05e8 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05e8\u05d0\u05d4",map_ai_pop_room_goto_clean:"\u05e0\u05d9\u05e7\u05d5\u05d9",matter_pair_network_description:"\u05e1\u05e8\u05d5\u05e7 \u05d0\u05ea \u05e7\u05d5\u05d3 \u05d4-QR \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e9\u05ea\u05d5\u05de\u05db\u05ea \u05d1-Matter. \u05d4\u05e7\u05d5\u05d3 \u05ea\u05e7\u05e3 \u05dc\u05de\u05e9\u05da 15 \u05d3\u05e7\u05d5\u05ea \u05d5\u05d0\u05dd \u05d4\u05d5\u05d0 \u05de\u05ea\u05d0\u05e4\u05e1, \u05d4\u05ea\u05d7\u05dc\u05d5  \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05d7\u05d3\u05e9.",matter_join_network_title:"\u05e7\u05d5\u05d3 \u05d4\u05d2\u05d3\u05e8\u05d4 \u05e8\u05d0\u05e9\u05d9",matter_join_failed_desc:"\u05d4\u05e2\u05d1\u05e8 \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05dc\u05d0\u05d6\u05d5\u05e8 \u05e2\u05dd \u05e7\u05dc\u05d9\u05d8\u05ea wifi \u05d8\u05d5\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1.",matter_join_failed_title:"\u05d4\u05e9\u05d2\u05ea \u05e7\u05d5\u05d3 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d9 \u05e0\u05db\u05e9\u05dc\u05d4",matter_request_loading_title:"\u05d4\u05e9\u05d2\u05ea \u05e7\u05d5\u05d3 \u05d4\u05d2\u05d3\u05e8\u05d4 \u05e8\u05d0\u05e9\u05d9",matter_qrcode_save_success_tip:"\u05e0\u05e9\u05de\u05e8",matter_join_network_success_toast:"\u05d4\u05ea\u05d7\u05d1\u05e8 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4",matter_save_qrcode_button_title:"\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05e7\u05d5\u05d3 \u05d4-QR",matter_reset_button_title:"\u05e6\u05d0 \u05de\u05d4\u05e8\u05e9\u05ea \u05e9\u05d4\u05e6\u05d8\u05e8\u05e4\u05ea \u05d0\u05dc\u05d9\u05d4",matter_reset_desc:"\u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05d7\u05d5\u05d1\u05e8 \u05dc\u05e8\u05e9\u05ea Matter. \u05dc\u05d7\u05e5 \u05db\u05d0\u05df \u05db\u05d3\u05d9 \u05dc\u05e6\u05d0\u05ea \u05de\u05d4\u05e8\u05e9\u05ea \u05e9\u05d4\u05e6\u05d8\u05e8\u05e4\u05ea \u05d0\u05dc\u05d9\u05d4.",dock_selfclean_title:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05ea\u05d7\u05e0\u05ea \u05d8\u05e2\u05d9\u05e0\u05d4",dock_selfclean_start_clean:"\u05d4\u05ea\u05d7\u05dc\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9",dock_selfclean_cleaning:"\u05d1\u05de\u05d4\u05dc\u05da \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9",dock_selfclean_start_drain:"\u05d4\u05ea\u05d7\u05dc\u05ea \u05e8\u05d9\u05e7\u05d5\u05df",dock_selfclean_draining:"\u05e8\u05d9\u05e7\u05d5\u05df",guide_map_save_detail_desc:"\u05d7\u05e4\u05e6\u05d9\u05dd \u05e8\u05e4\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (\u05de\u05d7\u05d6\u05d9\u05e8\u05d9 \u05d0\u05d5\u05e8) \u05d0\u05d5 \u05e8\u05e6\u05e4\u05d5\u05ea \u05d7\u05dc\u05e7\u05d5\u05ea \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d0\u05d9\u05db\u05d5\u05ea \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05de\u05d9\u05e4\u05d5\u05d9. \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d6\u05d0\u05ea, \u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05d4\u05de\u05e4\u05d4 \u05dc\u05d0 \u05ea\u05d5\u05db\u05dc \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e0\u05db\u05d5\u05df \u05e9\u05dc \u05e8\u05d5\u05d1\u05d5\u05d8.",optical_flow_sensor_error_title:"\u05d7\u05d9\u05d9\u05e9\u05df \u05d4\u05d6\u05e8\u05d9\u05de\u05d4 \u05d4\u05d0\u05d5\u05e4\u05d8\u05d9 \u05de\u05dc\u05d5\u05db\u05dc\u05da.",optical_flow_sensor_error_subtitle:"\u05e0\u05d2\u05d1 \u05d0\u05ea \u05d4\u05d7\u05d9\u05d9\u05e9\u05df \u05e2\u05dd \u05de\u05d8\u05dc\u05d9\u05ea \u05d9\u05d1\u05e9\u05d4 \u05d5\u05d4\u05e4\u05e2\u05dc \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05d7\u05d3\u05e9.",optical_flow_sensor_error_description:"\u05e0\u05d2\u05d1 \u05d0\u05ea \u05d4\u05d7\u05d9\u05d9\u05e9\u05df \u05e2\u05dd \u05de\u05d8\u05dc\u05d9\u05ea \u05d9\u05d1\u05e9\u05d4 \u05d5\u05d4\u05e4\u05e2\u05dc \u05d0\u05ea \u05d4\u05e8\u05d5\u05d1\u05d5\u05d8 \u05de\u05d7\u05d3\u05e9.",electron_hatch_off_error_title:"\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e1\u05d2\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d3\u05dc\u05ea \u05d4\u05d7\u05e9\u05de\u05dc\u05d9\u05ea",electron_hatch_off_error_subtitle:"\u05d1\u05d3\u05d5\u05e7 \u05d5\u05e1\u05d2\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d3\u05dc\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9.",electron_hatch_off_error_description:"\u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05d4\u05d3\u05dc\u05ea \u05d4\u05d7\u05e9\u05de\u05dc\u05d9\u05ea \u05d7\u05e1\u05d5\u05de\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05e4\u05ea\u05d9\u05d7\u05d4. \u05d1\u05d3\u05d5\u05e7 \u05d0\u05d5\u05ea\u05d4 \u05dc\u05d7\u05e1\u05d9\u05de\u05d5\u05ea \u05d5\u05e1\u05d2\u05d5\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9",electron_hatch_on_error_title:"\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e4\u05ea\u05d5\u05d7 \u05d0\u05ea \u05d4\u05d3\u05dc\u05ea \u05d4\u05d7\u05e9\u05de\u05dc\u05d9\u05ea",electron_hatch_on_error_subtitle:"\u05d1\u05d3\u05d5\u05e7 \u05d5\u05e4\u05ea\u05d7 \u05d0\u05ea \u05d4\u05e6\u05d5\u05d4\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9.",electron_hatch_on_error_description:"\u05d4\u05e4\u05ea\u05d7 \u05d4\u05d7\u05e9\u05de\u05dc\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d7\u05e1\u05d5\u05dd \u05d5\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e4\u05ea\u05d5\u05d7 \u05d0\u05d5\u05ea\u05d5. \u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05d9\u05e9 \u05e1\u05ea\u05d9\u05de\u05d4 \u05db\u05dc\u05e9\u05d4\u05d9 \u05d5\u05e4\u05ea\u05d7 \u05d0\u05d5\u05ea\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05d3\u05e0\u05d9.",dock_selfclean_clean_title:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05ea\u05d7\u05e0\u05ea \u05d8\u05e2\u05d9\u05e0\u05d4",dock_selfclean_clean_desc:"\u05e9\u05d5\u05d8\u05e3 \u05d0\u05ea \u05e7\u05e2\u05e8\u05ea \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9; \u05de\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05dc\u05de\u05e0\u05d8.",dock_selfclean_drain_title:"\u05e8\u05d9\u05e7\u05d5\u05df \u05d0\u05dc\u05de\u05e0\u05d8 \u05de\u05d9\u05dc\u05d5\u05d9 \u05d5\u05e8\u05d9\u05e7\u05d5\u05df",dock_selfclean_drain_desc:"\u05e8\u05d5\u05e7\u05df \u05d0\u05ea \u05d4\u05de\u05d9\u05dd \u05e9\u05e0\u05e9\u05d0\u05e8\u05d5 \u05d1\u05e7\u05e2\u05e8\u05ea \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d5\u05de\u05db\u05dc \u05d4\u05d1\u05d9\u05d5\u05d1 \u05d4\u05de\u05d5\u05d1\u05e0\u05d4.",dock_setting_clean_carousel_selfcleaning_desc:"\u05de\u05d1\u05e6\u05e2 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9. \u05d6\u05d4 \u05d9\u05d9\u05e7\u05d7 \u05d1\u05e2\u05e8\u05da 3 \u05d3\u05e7\u05d5\u05ea.",dock_setting_clean_carousel_startselfclean_desc:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05de\u05d2\u05e9 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e9\u05dc \u05d4\u05ea\u05d7\u05e0\u05d4 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d4\u05e1\u05d9\u05e8 \u05dc\u05db\u05dc\u05d5\u05da.",dock_setting_clean_carousel_selfclean_title:"\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05e9\u05dc \u05de\u05d2\u05e9 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9",start_cleancarousel_selfclean:"\u05d4\u05ea\u05d7\u05dc\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9",stop_cleancarousel_selfclean:"\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9",clean_smart_animation_text1:"\u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05e6\u05d1 SmartPlan",clean_smart_animation_text2:"\u05d4\u05ea\u05d0\u05de\u05ea \u05de\u05e6\u05d1 \u05e0\u05d9\u05e7\u05d5\u05d9",clean_smart_animation_text3:"\u05d9\u05e6\u05d9\u05e8\u05ea \u05e0\u05ea\u05d9\u05d1 \u05e0\u05d9\u05e7\u05d5\u05d9",setting_page_matter_title:"\u05d4\u05ea\u05d7\u05d1\u05e8 \u05dc\u05e8\u05e9\u05ea Matter",carpet_clean_mode_setting_global_settip:"\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05d6\u05d0\u05ea \u05dc\u05d0 \u05ea\u05e4\u05e2\u05dc \u05e2\u05dc \u05e9\u05d8\u05d9\u05d7\u05d9\u05dd \u05e2\u05dd \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e0\u05d9\u05e7\u05d5\u05d9 \u05de\u05d5\u05ea\u05d0\u05de\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea.",tap_zone_clean_button_without_map_tip:"\u05d9\u05e9 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05de\u05e4\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d5\u05e1\u05e4\u05ea \u05d0\u05d6\u05d5\u05e8.",error_57_title:"\u05ea\u05e7\u05dc\u05d4 \u05d1\u05de\u05d1\u05e8\u05e9\u05ea \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05e9\u05dc \u05de\u05db\u05dc \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9",error_57_desc:"\u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05de\u05d1\u05e8\u05e9\u05ea \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05e9\u05dc \u05de\u05db\u05dc \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9 \u05ea\u05e7\u05d5\u05e2\u05d4.",error_57_detail:"\u05d4\u05e1\u05e8 \u05d5\u05e0\u05e7\u05d4 \u05d0\u05ea \u05de\u05d2\u05e9 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d9. \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df, \u05d1\u05d3\u05d5\u05e7 \u05d0\u05dd \u05d9\u05e9\u05e0\u05df \u05d7\u05e1\u05d9\u05de\u05d5\u05ea \u05d1\u05d0\u05d6\u05d5\u05e8 \u05de\u05d1\u05e8\u05e9\u05ea \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05d5\u05d4\u05e1\u05e8 \u05d0\u05d5\u05ea\u05df.",setting_optimize_batter_detail:"\u05d0\u05dd \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05d6\u05d0\u05ea \u05de\u05d5\u05e4\u05e2\u05dc\u05ea, \u05e8\u05de\u05ea \u05d4\u05e1\u05d5\u05dc\u05dc\u05d4 \u05ea\u05d7\u05d5\u05e9\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d3\u05d9\u05d5\u05e7. \u05d9\u05ea\u05db\u05df \u05e9\u05d6\u05de\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d9\u05e7\u05d5\u05e6\u05e8 \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d0\u05e4\u05e9\u05e8 \u05d0\u05ea \u05d4\u05d4\u05ea\u05d0\u05de\u05d4.",setting_optimize_batter_title:"\u05e8\u05de\u05ea \u05e1\u05d5\u05dc\u05dc\u05d4 \u05de\u05d5\u05ea\u05d0\u05de\u05ea",map_edit_eraser:"\u05d4\u05e1\u05e8",map_edit_eraser_add:"\u05d1\u05d7\u05e8 \u05d0\u05d6\u05d5\u05e8 \u05d4\u05e1\u05e8\u05d4