__d(function(e,a,i,t,r,o,n){r.exports={recover_map_hint:"Dup\u0103 restabilirea h\u0103r\u021bii din copia de rezerv\u0103, fluxurile de lucru \u0219i programele trebuie ref\u0103cute.",invalid_task_detected_hint:"Exist\u0103 una sau mai multe sarcini nevalide.",map_edit_ground_material_title:"Editare suprafa\u021b\u0103",map_edit_split_restriction_point_adjust:"Regla\u021bi linia de desp\u0103r\u021bire p\xe2n\u0103 c\xe2nd apare o linie continu\u0103",home_new_control_start_wash:"Sp\u0103la\u021bi mopul",home_new_control_back_charge:"\xcenc\u0103rcare",home_new_control_dock_unfold_title:"\xcenc\u0103rcare",terminate_current_task_then_wash:"Sp\u0103la\u021bi mopul",smart_custom_order_guide_tip_text:"Regleaz\u0103 automat secven\u021ba de cur\u0103\u021bare a camerei \xeen func\u021bie de tipurile de camere.",smart_custom_mode_guide_tip_text:"Seteaz\u0103 automat modul de cur\u0103\u021bare \xeen func\u021bie de tipul de podea \u0219i de camer\u0103.",tanos_s_mop_mode_info2:"La folosirea modului Profund+, robotul se va deplasa mai \xeencet \u0219i mai silen\u021bios.",video_error116_resolve:"Nu se poate vizualiza de la distan\u021b\u0103. Golire \xeen desf\u0103\u0219urare.",map_element_furnitures:"Mobila",map_element_custom_props:"Personalizat",map_element_room_props:"Nume cam.",map_element_switcher_title:"Detalii hart\u0103",default_room_name:"Camer\u0103",mop_method_careful_slow:"Intens+",realtime_video_sub_title_3_6:"Alertele vocale vor fi emise la fiecare 15 secunde \xeen timpul modului Vizualizare de la distan\u021b\u0103.",realtime_video_sub_title_3_5:"Alertele vocale vor fi emise \xeen momentul acces\u0103rii \u0219i ie\u0219irii din modul Vizualizare de la distan\u021b\u0103.",egg_page_attack_title:"C\u0103utare",egg_page_stop_button_title:"Oprire",start_egg_attack_with_other_task_tip:"Efectuarea acestei ac\u021biuni va \xeencheia cur\u0103\u021barea curent\u0103. ",egg_page_title:"Modul Cupidon",defender_mode_introduction:"V\u0103 prezent\u0103m modul Cupidon, care \xeel ajut\u0103 pe robotul Roborock s\u0103 \xee\u0219i exprime sentimentele sincere fa\u021b\u0103 de alte aspiratoare robot. Nu face discrimin\u0103ri pe motive de culoare sau marc\u0103, ci, de \xeendat\u0103 ce S7 MaxV vede un alt robot, \xee\u0219i va ar\u0103ta afec\u021biunea printr-un s\u0103rut delicat.\n\nAVERTISMENT: Roborock nu este r\u0103spunz\u0103tor pentru apari\u021bia unor bebelu\u0219i robot sau pentru \xeencurajarea suprema\u021biei robo\u021bilor.",egg_attack_start_title:"Pornire",armap_match_failed:"Hart\u0103 corelat\u0103",armap_match_success:"Corelare e\u0219uat\u0103",armap_delete_confirm:"Sigur dori\u021bi s\u0103 \u0219terge\u021bi harta Matrix?",armap_scan_save_mesh_failed_toast:"Salvarea a e\u0219uat",armap_scan_stop_confirm:"Opri\u021bi cartografierea Matrix?",monitor_voice_privacy_dialog_title:"Politica de confiden\u021bialitate pentru apelurile video",camera_monitor_voice_privacy_title:"Politica de confiden\u021bialitate pentru apelurile video ",armap_guide_title3:"3. Finaliza\u021bi scanarea \u0219i cartografierea \u0219i a\u0219tepta\u021bi corelarea acestora.",armap_guide_title2:"2. Deplasa\u021bi-v\u0103 prin camer\u0103, scan\xe2nd to\u021bi pere\u021bii, podelele \u0219i col\u021burile.",armap_guide_title1:"1. Scana\u021bi Matrix harta curent\u0103.",armap_guide_title:"Ghid de utilizare pentru cartografierea Matrix",armap_privacy_dialog_title1:"Dup\u0103 utilizare, modelul 3D va fi stocat \xeen telefon pentru cartografierea Matrix. V\u0103 rug\u0103m s\u0103 consulta\u021bi ",armap_privacy_dialog_title:"Politica de confiden\u021bialitate pentru Harta Matrix",smart_scene_clean_mode_setting_item_title:"Modul de cur\u0103\u021bare",main_control_pause_quick_build_map:"pauz\u0103",main_control_resume_quick_build_map:"Cartografiere",go_update:"Actualiza\u021bi",clean_mode_max_plus:"MAX+",go_to_settings:"Du-te la set",quick_create_map_alert_title:"Nu se poate mapa rapid \xeen modul de evitare a covorului",led_alert_detail: