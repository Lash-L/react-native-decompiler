\u0438\u0439\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u043a\u0438 \u0432\u043e\u0434\u0438 \u0437 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u043a\u0430\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0439\u043d\u043e\u0433\u043e \u0431\u0430\u043a\u0430.",water_updown_drain_button_title:"\u0420\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f",water_up_down_setting_item_title:"\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0439 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f",water_up_down_setting_item_desc:"\u041f\u0440\u043e\u043c\u0438\u0432\u0430\u0454 \u043b\u043e\u0442\u043e\u043a \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438, \u0432\u0438\u043a\u043e\u043d\u0443\u0454 \u0441\u0430\u043c\u043e\u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430.",product_info_dock_sn:"\u0421\u0435\u0440\u0456\u0439\u043d\u0438\u0439 \u043d\u043e\u043c\u0435\u0440 \u0431\u0430\u0437\u043e\u0432\u043e\u0457 \u0441\u0442\u0430\u043d\u0446\u0456\u0457",product_info_dock_version:"\u0412\u0435\u0440\u0441\u0456\u044f \u043c\u0456\u043a\u0440\u043e\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0431\u0430\u0437\u043e\u0432\u043e\u0457 \u0441\u0442\u0430\u043d\u0446\u0456\u0457",error_up_water_title:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f",error_up_water_desc:"\u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u043a\u0440\u0430\u043d \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u043e, \u0430 \u043f\u043e\u0442\u0456\u043a \u0432\u043e\u0434\u0438 \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0438\u0439.",error_up_water_detail:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u043e\u0434\u0430\u0447\u0443 \u0432\u043e\u0434\u0438 \u0443 \u0442\u043e\u0447\u0446\u0456 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f. \u042f\u043a\u0449\u043e \u0442\u0430\u043a, \u0432\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0439 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0437\u2019\u0454\u0434\u043d\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u0439 \u043a\u0430\u0431\u0435\u043b\u044c \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0439 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0443. \u042f\u043a\u0449\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043d\u0435 \u0437\u043d\u0438\u043a\u0430\u0454, \u0437\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u043b\u0443\u0436\u0431\u0438 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u043a\u043b\u0456\u0454\u043d\u0442\u0456\u0432.",error_drain_water_title:"\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f",error_drain_water_desc:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435, \u0449\u043e\u0431 \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043b\u043e \u0437\u043b\u0438\u0432\u043d\u0438\u0439 \u043e\u0442\u0432\u0456\u0440, \u0456 \u043e\u0447\u0438\u0441\u0442\u044c\u0442\u0435 \u0439\u043e\u0433\u043e.",error_drain_water_detail:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435, \u0449\u043e\u0431 \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043b\u043e \u0437\u043b\u0438\u0432\u043d\u0438\u0439 \u043e\u0442\u0432\u0456\u0440, \u0456 \u043e\u0447\u0438\u0441\u0442\u044c\u0442\u0435 \u0439\u043e\u0433\u043e. \u042f\u043a\u0449\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043d\u0435 \u0437\u043d\u0438\u043a\u0430\u0454, \u0437\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u043b\u0443\u0436\u0431\u0438 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u043a\u043b\u0456\u0454\u043d\u0442\u0456\u0432.",error_clean_carousel_unsetuped_title:"\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438.",error_clean_carousel_unsetuped_desc:"\u041f\u0435\u0440\u0435\u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u043f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438.",error_clean_carousel_unsetuped_detail:"1. \u0417\u0430\u0444\u0456\u043a\u0441\u0443\u0439\u0442\u0435 \u043f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u043d\u0430 \u043c\u0456\u0441\u0446\u0456. 2. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0437\u043b\u0438\u0432\u043d\u0438\u0439 \u043e\u0442\u0432\u0456\u0440 \u0431\u0430\u0437\u043e\u0432\u043e\u0457 \u0441\u0442\u0430\u043d\u0446\u0456\u0457 \u043d\u0435 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e. 3. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043a\u0440\u0438\u0448\u043a\u0443 \u0431\u0430\u043a\u0430 \u0434\u043b\u044f \u0431\u0440\u0443\u0434\u043d\u043e\u0457 \u0432\u043e\u0434\u0438 \u0442\u0430 \u0437\u0430\u0444\u0456\u043a\u0441\u0443\u0439\u0442\u0435 \u0457\u0457.",error_clean_carousel_water_full_title:"\u041f\u0456\u0434\u0434\u043e\u043d \u0434\u043b\u044f \u043c\u0438\u0442\u0442\u044f \u0448\u0432\u0430\u0431\u0440\u0438 \u043f\u0435\u0440\u0435\u043f\u043e\u0432\u043d\u0435\u043d\u0438\u0439.",error_clean_carousel_water_full_desc:"\u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\